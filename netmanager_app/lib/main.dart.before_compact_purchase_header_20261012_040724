                    SnackBar(
                      content: Text(
                        isArabic
                            ? 'تم حذف فاتورة المشتريات رقم $invoiceNumber بنجاح'
                            : 'Purchase invoice $invoiceNumber deleted successfully',
                      ),
                    ),
                  );
                } catch (e) {
