  bool _checkingAppUpdate = false;

  Future<void> _checkNetManagerUpdates({
    bool showNoUpdateMessage = false,
  }) async {
    if (_checkingAppUpdate || !AppUpdateService.isSupported) {
      return;
    }

    _checkingAppUpdate = true;

    try {
      final update = await AppUpdateService.checkForUpdate();

      if (!mounted) return;

      if (update != null) {
        await showNetManagerUpdateDialog(context, update);
      } else if (showNoUpdateMessage) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('التطبيق محدث إلى آخر إصدار متوفر')),
        );
      }
    } catch (e) {
      debugPrint('APP UPDATE CHECK ERROR: $e');

      if (mounted && showNoUpdateMessage) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('تعذر التحقق من التحديثات')),
        );
      }
    } finally {
      _checkingAppUpdate = false;
    }
  }

  // صلاحيات الوكيل المحملة من قاعدة البيانات.
  final Set<String> agentPermissions = <String>{};

  // هل انتهى تحميل صلاحيات الوكيل؟
  bool agentPermissionsLoaded = false;

  bool hasAgentPermission(String permissionKey) {
    // المدير والمستخدم العادي لا يخضعان لصلاحيات الوكيل.
    if (widget.currentUser.role != 'وكيل') {
      return true;
    }

    return agentPermissions.contains(permissionKey);
  }

  bool hasAccountingAccess() {
    // المدير لديه المحاسبة دائمًا.
    if (widget.currentUser.role == 'مدير') {
      return true;
    }

    // المستخدم العادي يحتاج تفعيل المدير.
    if (widget.currentUser.role == 'مستخدم') {
      return widget.currentUser.accountingEnabled;
    }

    // الوكيل يحتاج صلاحية المحاسبة من المستخدم المسؤول عنه،
    // كما يجب أن تكون المحاسبة مفعلة للمستخدم المسؤول نفسه.
    if (widget.currentUser.role == 'وكيل') {
      final parentId = widget.currentUser.parentUserId;

      if (parentId == null || parentId.isEmpty) {
        return false;
      }

      final parentIndex = users.indexWhere((user) => user.id == parentId);

      if (parentIndex == -1) {
        return false;
      }

      final parent = users[parentIndex];

      return parent.accountingEnabled &&
          agentPermissions.contains('view_accounting');
    }

    return false;
  }

  Future<void> loadAgentPermissions() async {
    agentPermissions.clear();

    debugPrint(
      'AGENT PERMISSIONS START => '
      'role=${widget.currentUser.role}, '
      'id=${widget.currentUser.id}, '
      'parent=${widget.currentUser.parentUserId}',
    );

    // المدير والمستخدم العادي لديهما صلاحياتهما الحالية كاملة.
    if (widget.currentUser.role != 'وكيل') {
      if (!mounted) return;

      setState(() {
        agentPermissionsLoaded = true;
      });

      return;
    }

    try {
      final supabase = Supabase.instance.client;

      final data = await supabase.rpc(
        'get_agent_permissions',
        params: {'p_agent_id': widget.currentUser.id},
      );

      for (final item in data as List) {
        final permission = item['permission_key']?.toString();

        if (permission != null && permission.isNotEmpty) {
          agentPermissions.add(permission);
        }
      }

      debugPrint(
        'AGENT PERMISSIONS => '
        '${agentPermissions.toList()..sort()}',
      );

      if (!mounted) return;

      setState(() {
        agentPermissionsLoaded = true;
      });

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          duration: const Duration(seconds: 8),
          content: Text(
            agentPermissions.isEmpty
                ? 'الوكيل لا يملك أي صلاحيات محفوظة'
                : 'صلاحيات الوكيل: ${agentPermissions.join(', ')}',
          ),
          backgroundColor: agentPermissions.isEmpty
              ? Colors.orange
              : Colors.green,
        ),
      );
    } catch (e) {
      debugPrint('LOAD AGENT PERMISSIONS ERROR: $e');

      if (!mounted) return;

      setState(() {
        agentPermissionsLoaded = true;
      });

      await showDialog<void>(
        context: context,
        builder: (dialogContext) {
          return AlertDialog(
            title: const Row(
              children: [
                Icon(Icons.error_outline, color: Colors.red),
                SizedBox(width: 10),
                Text('خطأ تحميل صلاحيات الوكيل'),
              ],
            ),
            content: SizedBox(width: 600, child: SelectableText(e.toString())),
            actions: [
              FilledButton(
                onPressed: () => Navigator.pop(dialogContext),
                child: const Text('إغلاق'),
              ),
            ],
          );
        },
      );
    }
  }

