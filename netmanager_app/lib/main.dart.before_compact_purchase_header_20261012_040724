                    profile.deviceId == selectedBroadbandProfileDeviceId,
              )
              .toList();

    String formatSpeed(int kbps) {
      if (kbps <= 0) return 'غير محدد';

      if (kbps % 1024 == 0) {
        return '${kbps ~/ 1024} Mbps';
      }

      final mbps = kbps / 1024.0;
      return '${mbps.toStringAsFixed(2)} Mbps';
    }

    String formatProfilePrice(BroadbandProfile profile) {
      final price = profile.price;

      final priceText = price == price.roundToDouble()
          ? price.toStringAsFixed(0)
          : price.toStringAsFixed(2);

      return '$priceText ${profile.currency}';
    }

    return RefreshIndicator(
      onRefresh: () async {
