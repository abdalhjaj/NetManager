  Widget buildAccountingVouchers() {
    final ar = widget.currentUser.language == 'ar';
    final db = Supabase.instance.client;

    Future<void> createVoucher(bool receipt) async {
      try {
        await loadAccountingCustomers();
        await loadAccountingSuppliers();
      } catch (e) {
        if (!mounted) return;
        ScaffoldMessenger.of(context)
            .showSnackBar(SnackBar(content: Text('Error: $e')));
        return;
      }

      if (!mounted) return;

      final amountController = TextEditingController();
      final notesController = TextEditingController();
      final partyController = TextEditingController();

      String partyType = 'general';
      String? partyId;
      String currency = 'USD';
      String method = 'cash';
      bool saving = false;

      await showDialog(
        context: context,
        builder: (dialogContext) => StatefulBuilder(
          builder: (dialogContext, update) {
            final parties = partyType == 'customer'
                ? accountingCustomers
                : partyType == 'supplier'
                ? accountingSuppliers
                : <Map<String, dynamic>>[];

            return AlertDialog(
              title: Text(
                receipt
                    ? (ar ? 'سند قبض جديد' : 'New Receipt')
                    : (ar ? 'سند صرف جديد' : 'New Payment'),
              ),
              content: SizedBox(
                width: 450,
                child: SingleChildScrollView(
                  child: Column(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      DropdownButtonFormField<String>(
                        initialValue: partyType,
                        decoration: InputDecoration(
                          labelText: ar ? 'نوع الجهة' : 'Party Type',
                        ),
                        items: [
                          DropdownMenuItem(
                            value: 'general',
                            child: Text(ar ? 'جهة أخرى' : 'Other'),
                          ),
                          DropdownMenuItem(
                            value: 'customer',
                            child: Text(ar ? 'عميل' : 'Customer'),
                          ),
                          DropdownMenuItem(
                            value: 'supplier',
                            child: Text(ar ? 'مورد' : 'Supplier'),
                          ),
                        ],
                        onChanged: saving
                            ? null
                            : (v) {
                                update(() {
                                  partyType = v ?? 'general';
                                  partyId = null;
                                });
                              },
                      ),
                      const SizedBox(height: 12),
                      if (partyType == 'general')
                        TextField(
                          controller: partyController,
                          decoration: InputDecoration(
                            labelText: ar ? 'اسم الجهة' : 'Party Name',
