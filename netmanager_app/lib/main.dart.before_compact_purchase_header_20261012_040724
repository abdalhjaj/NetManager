  AppUser? _findAppUserById(String userId) {
    for (final user in users) {
      if (user.id == userId) return user;
    }
    return null;
  }

  String _accountOwnerCurrency(String userId) {
    // إذا كان الحساب للمستخدم المسجل حاليًا،
    // استخدم إعدادات العملة الحالية مباشرة.
    if (userId == widget.currentUser.id) {
      return appCurrency;
    }

    // أما حسابات المستخدمين الآخرين فتستخدم عملة صاحب الحساب.
    return _findAppUserById(userId)?.currency ?? 'USD';
  }

  double _accountOwnerExchangeRate(String userId) {
    // إذا كان الحساب للمستخدم المسجل حاليًا،
    // استخدم سعر الصرف الحالي مباشرة.
    if (userId == widget.currentUser.id) {
      return usdToSypRate > 0 ? usdToSypRate : 1;
    }

    final rate = _findAppUserById(userId)?.usdToSypRate ?? 1;
    return rate > 0 ? rate : 1;
  }

  double _usdToOwnerCurrency(double amountUsd, String userId) {
    if (_accountOwnerCurrency(userId) == 'SYP') {
      return amountUsd * _accountOwnerExchangeRate(userId);
    }

    return amountUsd;
  }

  double _ownerCurrencyToUsd(double amount, String userId) {
    if (_accountOwnerCurrency(userId) == 'SYP') {
      return amount / _accountOwnerExchangeRate(userId);
    }

    return amount;
  }

  String _formatOwnerMoney(double amountUsd, String userId) {
    final currency = _accountOwnerCurrency(userId);
    final amount = _usdToOwnerCurrency(amountUsd, userId);

    if (currency == 'SYP') {
      return '${amount.toStringAsFixed(0)} SYP';
    }

    return '${amount.toStringAsFixed(2)} USD';
  }

  Future<void> collectBroadbandPayment(BroadbandAccount account) async {
    final amountController = TextEditingController();
    final discountController = TextEditingController(text: '0');

    final ownerCurrency = _accountOwnerCurrency(account.userId);

    // Broadband محفوظ داخليًا بالدولار.
    // نحوله فقط للعرض والإدخال حسب عملة صاحب الحساب.
    final priceDisplay = _usdToOwnerCurrency(account.price, account.userId);
    final paidDisplay = _usdToOwnerCurrency(account.paidAmount, account.userId);
    final remainingDisplay = _usdToOwnerCurrency(
      account.remainingAmount,
      account.userId,
    );

    // رصيد الوكيل مخزن داخليًا بالدولار.
    final isAgent = widget.currentUser.role == 'وكيل';
    final agentBalanceUsd = widget.currentUser.agentBalance;

    final agentBalanceDisplay = isAgent
        ? _usdToOwnerCurrency(agentBalanceUsd, account.userId)
        : 0.0;

    final result = await showDialog<Map<String, double>>(
      context: context,
      builder: (dialogContext) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            final amountDisplay =
                double.tryParse(amountController.text.trim()) ?? 0.0;

            final discountDisplay =
                double.tryParse(discountController.text.trim()) ?? 0.0;

            final totalSettledDisplay = amountDisplay + discountDisplay;

            final remainingAfterDisplay =
                remainingDisplay - totalSettledDisplay > 0
                ? remainingDisplay - totalSettledDisplay
                : 0.0;

            // الحسم لا يخصم من رصيد الوكيل.
            // الذي يخصم هو المبلغ المقبوض فقط.
            final agentBalanceAfterDisplay =
                agentBalanceDisplay - amountDisplay;

            final agentBalanceEnough =
