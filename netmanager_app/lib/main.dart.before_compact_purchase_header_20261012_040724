                      ),
                    );
                    return;
                  }

                  double numberValue(TextEditingController controller) {
                    return double.tryParse(
                          controller.text.trim().replaceAll(',', '.'),
                        ) ??
                        0;
                  }

                  final purchasePrice = numberValue(purchasePriceController);
                  final salePrice = numberValue(salePriceController);
                  final quantity = numberValue(quantityController);
                  final minQuantity = numberValue(minQuantityController);

                  if (purchasePrice < 0 ||
                      salePrice < 0 ||
                      quantity < 0 ||
                      minQuantity < 0) {
                    ScaffoldMessenger.of(dialogContext).showSnackBar(
                      SnackBar(
                        content: Text(
                          isArabic
                              ? 'الأسعار والكميات لا يمكن أن تكون سالبة'
                              : 'Prices and quantities cannot be negative',
                        ),
                      ),
                    );
                    return;
                  }

                  try {
                    await Supabase.instance.client
                        .from('accounting_products')
                        .update({
                          'code': codeController.text.trim().isEmpty
                              ? null
                              : codeController.text.trim(),
                          'name': name,
                          'unit': unitController.text.trim().isEmpty
