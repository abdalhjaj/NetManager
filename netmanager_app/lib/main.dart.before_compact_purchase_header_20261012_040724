    Future<void> deleteAccountingVoucher(Map<String, dynamic> item) async {
      final id = item['id']?.toString();
      if (id == null || id.isEmpty) return;

      final confirmed = await showDialog<bool>(
        context: context,
        builder: (dialogContext) => AlertDialog(
          title: const Text('تأكيد حذف السند'),
          content: const Text(
            'سيتم حذف السند وإلغاء تأثيره على رصيد العميل أو المورد. هل أنت متأكد؟',
          ),
          actions: [
            TextButton(
              onPressed: () => Navigator.pop(dialogContext, false),
              child: const Text('إلغاء'),
            ),
            FilledButton(
              onPressed: () => Navigator.pop(dialogContext, true),
              child: const Text('حذف'),
            ),
          ],
        ),
      );

      if (confirmed != true || !mounted) return;

      try {
        final deleted = await db
            .from('accounting_transactions')
            .delete()
            .eq('id', id)
            .eq('created_by', widget.currentUser.id)
            .eq('voucher_type', item['voucher_type'])
            .select('id');

        if (deleted.isEmpty) {
          throw Exception('لم يتم العثور على السند');
        }

        await refreshVoucherBalances();
      } catch (e) {
        if (!mounted) return;
        ScaffoldMessenger.of(context)
            .showSnackBar(SnackBar(content: Text('تعذر حذف السند: $e')));
      }
    }

    Future<void> printAccountingVoucher(
      Map<String, dynamic> item,
      String partyName,
    ) async {
      try {
        final regular = await PdfGoogleFonts.notoNaskhArabicRegular();
        final bold = await PdfGoogleFonts.notoNaskhArabicBold();

        final document = pw.Document();
        final receipt = item['voucher_type'] == 'receipt';
        final number = item['voucher_number']?.toString() ?? '-';
        final amount = item['amount']?.toString() ?? '0';
        final currency = item['currency']?.toString() ?? '';
        final date = item['transaction_date']?.toString() ?? '';
        final notes = item['notes']?.toString() ?? '';
        final method = item['payment_method'] == 'transfer' ? 'تحويل' : 'نقدي';

        pw.Widget detail(String label, String value) {
          return pw.Padding(
            padding: const pw.EdgeInsets.symmetric(vertical: 9),
            child: pw.Row(
              mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
              children: [
                pw.Expanded(
                  child: pw.Text(
                    value,
                    style: pw.TextStyle(font: regular, fontSize: 13),
                  ),
                ),
                pw.SizedBox(width: 20),
                pw.Text(label, style: pw.TextStyle(font: bold, fontSize: 13)),
              ],
            ),
          );
        }

        document.addPage(
          pw.Page(
            pageFormat: PdfPageFormat.a4,
            margin: const pw.EdgeInsets.all(35),
            build: (pdfContext) => pw.Directionality(
              textDirection: pw.TextDirection.rtl,
              child: pw.Column(
                crossAxisAlignment: pw.CrossAxisAlignment.stretch,
                children: [
                  pw.Center(
                    child: pw.Text(
                      'منصة قصر الحجاج',
                      style: pw.TextStyle(font: bold, fontSize: 23),
                    ),
                  ),
                  pw.SizedBox(height: 12),
                  pw.Center(
                    child: pw.Text(
                      receipt ? 'سند قبض' : 'سند صرف',
                      style: pw.TextStyle(font: bold, fontSize: 21),
                    ),
                  ),
                  pw.SizedBox(height: 18),
                  pw.Divider(thickness: 1),
                  detail('رقم السند', number),
                  detail('التاريخ', date),
                  detail('الجهة', partyName),
                  detail('المبلغ', '$amount $currency'),
                  detail('طريقة الدفع', method),
                  detail('البيان', notes),
                  pw.Divider(thickness: 1),
                  pw.SizedBox(height: 65),
                  pw.Row(
                    mainAxisAlignment: pw.MainAxisAlignment.spaceAround,
                    children: [
                      pw.Text('توقيع المستلم', style: pw.TextStyle(font: bold)),
                      pw.Text('توقيع المحاسب', style: pw.TextStyle(font: bold)),
                    ],
                  ),
                ],
              ),
            ),
          ),
        );

        await Printing.layoutPdf(
          onLayout: (format) async => document.save(),
          name: 'Voucher_$number',
        );
      } catch (e) {
        if (!mounted) return;
        ScaffoldMessenger.of(context)
            .showSnackBar(SnackBar(content: Text('خطأ في طباعة السند: $e')));
      }
    }

    return Padding(
      padding: const EdgeInsets.all(16),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              IconButton(
                onPressed: () => setState(() => selectedIndex = 14),
                icon: const Icon(Icons.arrow_back),
              ),
              Expanded(
                child: Text(
                  ar ? 'سندات القبض والصرف' : 'Receipt & Payment Vouchers',
                  style: const TextStyle(
                    fontSize: 24,
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ),
            ],
          ),
          const SizedBox(height: 16),
          Wrap(
            spacing: 12,
