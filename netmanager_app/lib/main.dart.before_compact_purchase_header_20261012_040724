                        ScaffoldMessenger.of(this.context).showSnackBar(
                          const SnackBar(
                            content: Text(
                              'السعر والمدفوع يجب أن يكونا أرقامًا صحيحة',
                            ),
                            backgroundColor: Colors.red,
                          ),
                        );
                        return;
                      }

                      if (paidInput > priceInput) {
                        ScaffoldMessenger.of(this.context).showSnackBar(
                          const SnackBar(
                            content: Text(
                              'المبلغ المدفوع لا يمكن أن يكون أكبر من السعر',
                            ),
                            backgroundColor: Colors.red,
                          ),
                        );
                        return;
                      }

                      final calculatedPaymentStatus = paidInput <= 0
                          ? 'غير مدفوع'
                          : paidInput < priceInput
                          ? 'مدفوع جزئيًا'
                          : 'مدفوع بالكامل';

                      // Hotspot مخزن داخليًا بالدولار.
                      // نحول من عملة صاحب الحساب إلى USD قبل الحفظ.
                      final priceUsd = _ownerCurrencyToUsd(
                        priceInput,
                        selectedUserId!,
                      );

                      final paidUsd = _ownerCurrencyToUsd(
                        paidInput,
                        selectedUserId!,
                      );

                      final finalExpiresAt = startAt.add(
                        Duration(days: durationDays),
                      );

                      try {
                        final supabase = Supabase.instance.client;

                        final insertedAccount = await supabase
                            .from('hotspot_accounts')
                            .insert({
                              'user_id': selectedUserId,
                              'device_id': selectedDeviceId,
                              'username': username,
                              'password': password,
                              'profile': profile.isEmpty ? null : profile,
                              'active': active,
                              'subscription_duration': durationDays,
                              'start_at': startAt.toIso8601String(),
                              'expires_at': finalExpiresAt.toIso8601String(),
                              'payment_status': calculatedPaymentStatus,
                              'price': priceUsd,
                              'paid_amount': paidUsd,
                            })
                            .select('id')
                            .single();

                        // إذا تم قبض مبلغ عند إنشاء الحساب،
                        // نسجله كدفعة مالية حتى يظهر في لوحة التحكم.
                        if (paidUsd > 0.001) {
                          await supabase.from('hotspot_payments').insert({
                            'account_id': insertedAccount['id'],
                            'user_id': selectedUserId,
                            'device_id': selectedDeviceId,
                            'amount': paidUsd,
                            'discount': 0,
                            'currency': 'USD',
                            'payment_type': 'new',
                          });
