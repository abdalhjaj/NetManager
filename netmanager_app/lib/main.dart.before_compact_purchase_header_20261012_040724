                              ),
                            );
                            return;
                          }

                          if (price == null || price < 0) {
                            ScaffoldMessenger.of(dialogContext).showSnackBar(
                              const SnackBar(
                                content: Text('أدخل سعرًا صحيحًا'),
                              ),
                            );
                            return;
                          }

                          if (duration == null || duration <= 0) {
                            ScaffoldMessenger.of(dialogContext).showSnackBar(
                              const SnackBar(
                                content: Text('أدخل مدة اشتراك صحيحة'),
                              ),
                            );
                            return;
                          }

                          if (downloadMbps == null || downloadMbps <= 0) {
                            ScaffoldMessenger.of(dialogContext).showSnackBar(
                              const SnackBar(
                                content: Text('أدخل سرعة Download صحيحة'),
                              ),
                            );
                            return;
                          }

                          if (uploadMbps == null || uploadMbps <= 0) {
                            ScaffoldMessenger.of(dialogContext).showSnackBar(
                              const SnackBar(
                                content: Text('أدخل سرعة Upload صحيحة'),
                              ),
                            );
                            return;
                          }

                          setDialogState(() {
                            saving = true;
                          });

                          try {
                            await Supabase.instance.client.rpc(
                              'update_broadband_profile',
                              params: {
                                'p_actor_id': widget.currentUser.id,
                                'p_profile_id': profile.id,
                                'p_name': name,
                                'p_price': price,
                                'p_currency': currency,
                                'p_duration_days': duration,
                                'p_download_kbps': (downloadMbps * 1024)
                                    .round(),
                                'p_upload_kbps': (uploadMbps * 1024).round(),
                                'p_mikrotik_profile_name':
                                    mikrotikNameController.text.trim().isEmpty
                                    ? null
                                    : mikrotikNameController.text.trim(),
                              },
                            );

                            if (!dialogContext.mounted) return;

                            Navigator.pop(dialogContext, true);
                          } catch (e) {
                            if (!dialogContext.mounted) return;

                            setDialogState(() {
                              saving = false;
                            });

                            var message = e.toString();

                            if (message.contains(
                              'PROFILE_NAME_ALREADY_EXISTS_ON_DEVICE',
                            )) {
                              message =
                                  'يوجد بروفايل بهذا الاسم على هذا الجهاز';
                            } else if (message.contains(
                              'AGENT_PERMISSION_DENIED',
                            )) {
                              message = 'ليس لديك صلاحية لتعديل البروفايل';
                            } else if (message.contains(
                              'PROFILE_ACCESS_DENIED',
                            )) {
                              message =
                                  'ليس لديك صلاحية للوصول إلى هذا البروفايل';
                            } else if (message.contains(
                              'PROFILE_DEVICE_NOT_ASSIGNED',
                            )) {
                              message = 'هذا البروفايل غير مرتبط بجهاز شبكة';
                            } else if (message.contains('PROFILE_NOT_FOUND')) {
                              message = 'البروفايل غير موجود';
                            } else if (message.contains('INVALID_PRICE')) {
                              message = 'السعر غير صحيح';
                            } else if (message.contains('INVALID_DURATION')) {
                              message = 'مدة الاشتراك غير صحيحة';
                            } else if (message.contains(
                              'INVALID_DOWNLOAD_SPEED',
                            )) {
                              message = 'سرعة Download غير صحيحة';
                            } else if (message.contains(
                              'INVALID_UPLOAD_SPEED',
                            )) {
                              message = 'سرعة Upload غير صحيحة';
                            }

                            ScaffoldMessenger.of(dialogContext).showSnackBar(
                              SnackBar(
                                content: Text(message),
                                backgroundColor: Colors.red,
                              ),
                            );
                          }
                        },
                  icon: saving
                      ? const SizedBox(
                          width: 18,
                          height: 18,
                          child: CircularProgressIndicator(strokeWidth: 2),
                        )
                      : const Icon(Icons.save_outlined),
                  label: Text(saving ? 'جاري الحفظ...' : 'حفظ التعديلات'),
                ),
              ],
            );
          },
        );
      },
    );

    nameController.dispose();
    priceController.dispose();
    durationController.dispose();
    downloadController.dispose();
    uploadController.dispose();
    mikrotikNameController.dispose();

    if (saved != true) return;

    await loadBroadbandProfiles();

    if (!mounted) return;

    setState(() {});

    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text('تم تعديل البروفايل بنجاح ✓'),
        backgroundColor: Colors.green,
      ),
    );
  }

  Future<void> setBroadbandProfileActive(
    BroadbandProfile profile,
    bool active,
  ) async {
    if (!hasAgentPermission('edit_broadband_profile')) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('ليس لديك صلاحية لتعديل البروفايل'),
          backgroundColor: Colors.red,
        ),
      );
      return;
    }

    try {
      await Supabase.instance.client.rpc(
        'set_broadband_profile_active',
        params: {
          'p_actor_id': widget.currentUser.id,
          'p_profile_id': profile.id,
          'p_active': active,
        },
      );

      await loadBroadbandProfiles();

      if (!mounted) return;

      setState(() {});

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            active ? 'تم تفعيل البروفايل بنجاح ✓' : 'تم إيقاف البروفايل بنجاح',
          ),
          backgroundColor: active ? Colors.green : Colors.orange,
        ),
      );
    } catch (e) {
      if (!mounted) return;

      var message = e.toString();

      if (message.contains('AGENT_PERMISSION_DENIED')) {
        message = 'ليس لديك صلاحية لتعديل البروفايل';
      } else if (message.contains('PROFILE_ACCESS_DENIED')) {
        message = 'ليس لديك صلاحية للوصول إلى هذا البروفايل';
      } else if (message.contains('PROFILE_DEVICE_NOT_ASSIGNED')) {
        message = 'هذا البروفايل غير مرتبط بجهاز شبكة';
      } else if (message.contains('PROFILE_NOT_FOUND')) {
        message = 'البروفايل غير موجود';
      }

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text(message), backgroundColor: Colors.red),
      );
    }
  }

  Widget buildBroadbandProfiles() {
    final canAdd = hasAgentPermission('add_broadband_profile');
    final canEdit = hasAgentPermission('edit_broadband_profile');

    final visibleBroadbandProfiles = selectedBroadbandProfileDeviceId == null
        ? <BroadbandProfile>[]
        : broadbandProfiles
              .where(
