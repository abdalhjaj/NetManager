                              message = 'جهاز الشبكة غير موجود';
                            } else if (message.contains('DEVICE_INACTIVE')) {
                              message = 'جهاز الشبكة متوقف';
                            } else if (message.contains('DEVICE_REQUIRED')) {
                              message = 'يجب اختيار جهاز الشبكة';
                            } else if (message.contains(
                              'AGENT_PERMISSION_DENIED',
                            )) {
                              message =
                                  'ليس لديك صلاحية لإضافة بروفايل Broadband';
                            } else if (message.contains(
                              'PROFILE_NAME_REQUIRED',
                            )) {
                              message = 'اسم البروفايل مطلوب';
                            } else if (message.contains('INVALID_PRICE')) {
                              message = 'السعر غير صحيح';
                            } else if (message.contains('INVALID_DURATION')) {
                              message = 'مدة الاشتراك غير صحيحة';
                            } else if (message.contains(
                              'INVALID_DOWNLOAD_SPEED',
                            )) {
                              message = 'سرعة Download غير صحيحة';
                            } else if (message.contains(
                              'INVALID_UPLOAD_SPEED',
                            )) {
                              message = 'سرعة Upload غير صحيحة';
                            }

                            ScaffoldMessenger.of(dialogContext).showSnackBar(
                              SnackBar(
                                content: Text(message),
                                backgroundColor: Colors.red,
                              ),
                            );
                          }
                        },
                  icon: saving
                      ? const SizedBox(
                          width: 18,
                          height: 18,
                          child: CircularProgressIndicator(strokeWidth: 2),
                        )
                      : const Icon(Icons.add),
                  label: Text(saving ? 'جاري الحفظ...' : 'إضافة'),
                ),
              ],
            );
          },
        );
      },
    );

    nameController.dispose();
    priceController.dispose();
    durationController.dispose();
    downloadController.dispose();
    uploadController.dispose();
    mikrotikNameController.dispose();

    if (saved != true) return;

    await loadBroadbandProfiles();

    if (!mounted) return;

    setState(() {});

    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text('تم إنشاء بروفايل Broadband بنجاح ✓'),
        backgroundColor: Colors.green,
      ),
    );
  }

  final List<NetworkDevice> broadbandProfileDevices = [];
  String? selectedBroadbandProfileDeviceId;

  Future<void> loadBroadbandProfileDevices() async {
    broadbandProfileDevices.clear();

    final ownerId = widget.currentUser.role == 'وكيل'
        ? widget.currentUser.parentUserId
        : widget.currentUser.id;

    if (ownerId == null || ownerId.isEmpty) {
      selectedBroadbandProfileDeviceId = null;
      return;
    }

    final data = await Supabase.instance.client
        .from('network_devices')
        .select()
        .eq('user_id', ownerId)
        .order('name');

    for (final item in data) {
      broadbandProfileDevices.add(
        NetworkDevice.fromJson(Map<String, dynamic>.from(item)),
      );
    }

    // إذا كان الجهاز المختار سابقًا لم يعد موجودًا، نختار أول جهاز.
    final selectedStillExists =
        selectedBroadbandProfileDeviceId != null &&
        broadbandProfileDevices.any(
          (device) => device.id == selectedBroadbandProfileDeviceId,
        );

    if (!selectedStillExists) {
      selectedBroadbandProfileDeviceId = broadbandProfileDevices.isNotEmpty
          ? broadbandProfileDevices.first.id
          : null;
    }

    debugPrint(
      'BROADBAND PROFILE DEVICES => '
      '${broadbandProfileDevices.length}',
    );
  }

