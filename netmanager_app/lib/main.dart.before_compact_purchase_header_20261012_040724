  Widget buildDashboard() {
    final dashboardBuildTimer = Stopwatch()..start();
    WidgetsBinding.instance.addPostFrameCallback((_) {
      dashboardBuildTimer.stop();
      debugPrint(
        'DASHBOARD FRAME TIME: '
        '${dashboardBuildTimer.elapsedMilliseconds} ms',
      );
    });

    String tr(String ar, String en) =>
        widget.currentUser.language == 'en' ? en : ar;

    final now = DateTime.now();

    // الاشتراكات الحالية فقط:
    // لكل مشترك وجهاز نأخذ أحدث دورة اشتراك.
    final latestSubscriptions = <String, Subscription>{};

    for (final sub in subscriptions) {
      final key = '${sub.userId}|${sub.deviceId ?? ''}';
      final existing = latestSubscriptions[key];

      if (existing == null) {
        latestSubscriptions[key] = sub;
        continue;
      }

      final existingDate =
          existing.createdAt ?? DateTime.fromMillisecondsSinceEpoch(0);

      final currentDate =
          sub.createdAt ?? DateTime.fromMillisecondsSinceEpoch(0);

      if (currentDate.isAfter(existingDate)) {
        latestSubscriptions[key] = sub;
      }
    }

    final currentSubscriptions = latestSubscriptions.values.toList();

    final activeSubscriptionList = currentSubscriptions.where((sub) {
      return sub.dueDate != null && sub.dueDate!.isAfter(now);
    }).toList();

    final expiredSubscriptionList = currentSubscriptions.where((sub) {
      return sub.dueDate == null || sub.dueDate!.isBefore(now);
    }).toList();

    final activeSubscriptions = activeSubscriptionList.length;
    final expiredSubscriptions = expiredSubscriptionList.length;

    // حسابات Broadband الخاصة بالمستخدم الحالي.
    final myBroadbandAccounts = broadbandAccounts
        .where((account) => account.userId == widget.currentUser.id)
        .toList();

    // حسابات Hotspot الخاصة بالمستخدم الحالي.
    final myHotspotAccounts = hotspotAccounts
        .where((account) => account.userId == widget.currentUser.id)
        .toList();

    // إحصائيات Broadband.
    final activeBroadband = myBroadbandAccounts.where((account) {
      return account.active &&
          (account.expiresAt == null || account.expiresAt!.isAfter(now));
    }).length;

    final expiredBroadband = myBroadbandAccounts.where((account) {
      return account.expiresAt != null && account.expiresAt!.isBefore(now);
    }).length;

    final stoppedBroadband = myBroadbandAccounts.where((account) {
      return !account.active;
    }).length;

    final broadbandDebt = myBroadbandAccounts
        .where((account) => account.remainingAmount > 0.001)
        .fold<double>(0, (sum, account) => sum + account.remainingAmount);

    // إحصائيات Hotspot.
    final activeHotspot = myHotspotAccounts.where((account) {
      return account.active &&
          (account.expiresAt == null || account.expiresAt!.isAfter(now));
    }).length;

    final expiredHotspot = myHotspotAccounts.where((account) {
      return account.expiresAt != null && account.expiresAt!.isBefore(now);
    }).length;

    final stoppedHotspot = myHotspotAccounts.where((account) {
      return !account.active;
    }).length;

    final hotspotDebt = myHotspotAccounts
        .where((account) => account.remainingAmount > 0.001)
        .fold<double>(0, (sum, account) => sum + account.remainingAmount);

    // ============================================================
    // النظام المالي الموحد حسب عملة حساب المستخدم الحالي
    // ============================================================

    // سعر الصرف: قيمة 1 USD بالليرة السورية.
    final exchangeRate = usdToSypRate > 0 ? usdToSypRate : 1.0;

    double convertToAccountCurrency(double amount, String sourceCurrency) {
      if (sourceCurrency == appCurrency) {
        return amount;
      }

      if (sourceCurrency == 'USD' && appCurrency == 'SYP') {
        return amount * exchangeRate;
      }

      if (sourceCurrency == 'SYP' && appCurrency == 'USD') {
        return amount / exchangeRate;
      }

      return amount;
    }

    String formatAccountMoney(double amount) {
      if (appCurrency == 'SYP') {
        return '${amount.toStringAsFixed(0)} SYP';
      }

      return '${amount.toStringAsFixed(2)} USD';
    }

    // ------------------------------------------------------------
    // تحصيل الاشتراكات العادية بعد تحويلها إلى عملة الحساب.
    // ------------------------------------------------------------

    final ordinaryCollected = widget.currentUser.role == 'وكيل'
        ? 0.0
        : paymentHistory.fold<double>(0, (sum, payment) {
            final amount = (payment['amount'] as num?)?.toDouble() ?? 0;

            final currency = payment['currency']?.toString() ?? 'USD';

            return sum + convertToAccountCurrency(amount, currency);
          });

    // ------------------------------------------------------------
    // Broadband و Hotspot مخزنان حاليًا بالدولار.
    // يتم تحويلهما فقط للعرض والتجميع.
    // ------------------------------------------------------------

    // ============================================================
    // الدفعات التي تخص هذه اللوحة
    //
    // المستخدم العادي:
    //   يرى دفعات حساباته بواسطة user_id.
    //
    // الوكيل:
    //   يرى فقط العمليات التي نفذها بنفسه بواسطة collected_by.
    // ============================================================

    final isAgentDashboard = widget.currentUser.role == 'وكيل';

    final myBroadbandPayments = broadbandPaymentHistory.where((payment) {
      if (isAgentDashboard) {
        return payment['collected_by']?.toString() == widget.currentUser.id;
      }

      return payment['user_id']?.toString() == widget.currentUser.id;
    }).toList();

    final myHotspotPayments = hotspotPaymentHistory.where((payment) {
      if (isAgentDashboard) {
        return payment['collected_by']?.toString() == widget.currentUser.id;
      }

      return payment['user_id']?.toString() == widget.currentUser.id;
    }).toList();

    // ============================================================
    // فصل عمليات الوكيل:
    //
    // payment  = تحصيل دفعة
    // renewal  = تجديد
    //
    // حتى لا يتم احتساب التجديد ضمن التحصيل العادي مرة ثانية.
    // ============================================================

    double sumPaymentType(
      List<Map<String, dynamic>> payments,
      String paymentType,
    ) {
      return payments
          .where((payment) {
            final type = payment['payment_type']?.toString() ?? 'payment';

            final method = payment['payment_method']?.toString() ?? '';

            // سداد الدين الناتج عن إيداع المحفظة
            // لا يعتبر تحصيلًا مستقلاً.
            if (method == 'wallet_deposit') {
              return false;
            }

            return type == paymentType;
          })
          .fold<double>(
            0,
            (sum, payment) =>
                sum + ((payment['amount'] as num?)?.toDouble() ?? 0),
          );
    }

    double sumDiscounts(List<Map<String, dynamic>> payments) {
      return payments.fold<double>(
        0,
        (sum, payment) =>
            sum + ((payment['discount'] as num?)?.toDouble() ?? 0),
      );
    }

    // ------------------------------------------------------------
    // التحصيلات العادية فقط - بدون التجديد
    // ------------------------------------------------------------

    final broadbandCollected = convertToAccountCurrency(
      sumPaymentType(myBroadbandPayments, 'payment'),
      'USD',
    );

    final hotspotCollected = convertToAccountCurrency(
      sumPaymentType(myHotspotPayments, 'payment'),
      'USD',
    );

    final totalAgentCollections = broadbandCollected + hotspotCollected;

    // ------------------------------------------------------------
    // التجديدات
    // ------------------------------------------------------------

    final broadbandRenewals = convertToAccountCurrency(
      sumPaymentType(myBroadbandPayments, 'renewal'),
      'USD',
    );

    final hotspotRenewals = convertToAccountCurrency(
      sumPaymentType(myHotspotPayments, 'renewal'),
      'USD',
    );

    final totalAgentRenewals = broadbandRenewals + hotspotRenewals;

    // ------------------------------------------------------------
    // الحسومات
    // الحسومات لا تعتبر مبلغًا مقبوضًا.
    // ------------------------------------------------------------

    final broadbandDiscount = convertToAccountCurrency(
      sumDiscounts(myBroadbandPayments),
      'USD',
    );

    final hotspotDiscount = convertToAccountCurrency(
      sumDiscounts(myHotspotPayments),
      'USD',
    );

    final totalDiscount = broadbandDiscount + hotspotDiscount;

    // ------------------------------------------------------------
    // إيداعات محافظ المشتركين
    //
    // هذه مبالغ نقدية مقبوضة فعليًا، لذلك تدخل في إجمالي
    // المقبوضات. السجل محمل مسبقًا حسب صلاحية المستخدم:
    //
    // الوكيل  : إيداعاته فقط.
    // المستخدم: إيداعاته + إيداعات وكلائه على حساباته.
    // المدير  : إيداعاته على حساباته فقط.
    // ------------------------------------------------------------

    final walletDepositsCollected = convertToAccountCurrency(
      subscriberWalletTransactionHistory
          .where(
            (transaction) =>
                transaction['transaction_type']?.toString() == 'deposit',
          )
          .fold<double>(
            0,
            (sum, transaction) =>
                sum + ((transaction['amount_usd'] as num?)?.toDouble() ?? 0),
          ),
      'USD',
    );

    // ------------------------------------------------------------
    // المقبوضات النقدية الخاصة بأرصدة الوكلاء
    //
    // deposit + cash:
    //   إيداع نقدي فعلي، لذلك يدخل الصندوق.
    //
    // deposit + credit:
    //   إيداع آجل، لذلك لا يدخل الصندوق الآن.
    //
    // debt_payment:
    //   تسديد دين سابق، لذلك يدخل الصندوق عند التحصيل.
    //
    // الوكيل نفسه لا نضيف له هذه القيم إلى صندوقه، لأن هذه
    // الحركات تخص صندوق صاحب الوكيل.
    // ------------------------------------------------------------

    final agentCashCollected = isAgentDashboard
        ? 0.0
        : convertToAccountCurrency(
            agentBalanceTransactionHistory
                .where((transaction) {
                  final type =
                      transaction['transaction_type']?.toString() ?? '';

                  final method =
                      transaction['payment_method']?.toString() ?? '';

                  final isCashDeposit = type == 'deposit' && method == 'cash';

                  final isDebtPayment =
                      type == 'debt_payment' || method == 'debt_payment';

                  return isCashDeposit || isDebtPayment;
                })
                .fold<double>(
                  0,
                  (sum, transaction) =>
                      sum +
                      ((transaction['amount_usd'] as num?)?.toDouble() ?? 0),
                ),
            'USD',
          );

    // ------------------------------------------------------------
    // إجمالي النقد المقبوض فعليًا
    //
    // للمستخدم العادي:
    // الاشتراكات + Broadband + Hotspot
    // + إيداعات الوكلاء النقدية + تسديد ديون الوكلاء.
    //
    // الإيداع الآجل للوكيل لا يدخل هنا.
    //
    // للوكيل:
    // التحصيل + التجديد
    // ------------------------------------------------------------

    // تسويات أرصدة الوكلاء عند حذف حساباتهم.
    // settlement_amount_usd محفوظ داخليًا بالدولار.
    // هذه المبالغ خرجت من الصندوق، لذلك تُطرح من إجمالي المقبوضات.
    final agentDeletionSettlements = isAgentDashboard
        ? 0.0
        : convertToAccountCurrency(
            agentDeletionTransactionHistory.fold<double>(
              0,
              (sum, transaction) =>
                  sum +
                  ((transaction['settlement_amount_usd'] as num?)?.toDouble() ??
                      0),
            ),
            'USD',
          );

    // إجمالي التحصيل النقدي = المقبوضات الفعلية فقط.
    // لا نطرح منه تسويات الوكلاء حتى يبقى معنى "إجمالي التحصيل" صحيحًا.
    final totalCashCollected = isAgentDashboard
        ? totalAgentCollections + totalAgentRenewals + walletDepositsCollected
        : ordinaryCollected +
              broadbandCollected +
              hotspotCollected +
              broadbandRenewals +
              hotspotRenewals +
              walletDepositsCollected +
              agentCashCollected;

    // صافي الصندوق = إجمالي التحصيل - المبالغ التي خرجت
    // لتسوية أرصدة الوكلاء عند حذف حساباتهم.
    final netCashBalance = totalCashCollected - agentDeletionSettlements;

    // ------------------------------------------------------------
    // تحويل ديون Broadband و Hotspot إلى عملة الحساب.
    // القيم الأصلية للحسابات تبقى بالدولار حاليًا.
    // ------------------------------------------------------------

    final broadbandDebtDisplay = convertToAccountCurrency(broadbandDebt, 'USD');

    final hotspotDebtDisplay = convertToAccountCurrency(hotspotDebt, 'USD');

    // ------------------------------------------------------------
    // التحصيل اليومي والشهري بعملة الحساب الحالي
    // ------------------------------------------------------------

    double todayAccountTotal = 0;
    double monthAccountTotal = 0;

    final today = DateTime(now.year, now.month, now.day);
    final firstDayOfMonth = DateTime(now.year, now.month, 1);

    void addPaymentToAccountTotals(Map<String, dynamic> payment) {
      final createdAtValue = payment['created_at'];

      if (createdAtValue == null) return;

      final createdAt = DateTime.tryParse(createdAtValue.toString());

      if (createdAt == null) return;

      final amount = (payment['amount'] as num?)?.toDouble() ?? 0;

      final currency = payment['currency']?.toString() ?? 'USD';

      final convertedAmount = convertToAccountCurrency(amount, currency);

      if (!createdAt.isBefore(today)) {
        todayAccountTotal += convertedAmount;
      }

      if (!createdAt.isBefore(firstDayOfMonth)) {
        monthAccountTotal += convertedAmount;
      }
    }

    // المستخدم الأساسي يرى تحصيل الاشتراكات العادية.
    // الوكيل يرى فقط العمليات التي نفذها بنفسه.
    if (!isAgentDashboard) {
      for (final payment in paymentHistory) {
        addPaymentToAccountTotals(payment);
      }
    }

    for (final payment in myBroadbandPayments) {
      addPaymentToAccountTotals(payment);
    }

    for (final payment in myHotspotPayments) {
      addPaymentToAccountTotals(payment);
    }

    // إيداعات المحافظ تدخل أيضًا ضمن تحصيل اليوم والشهر.
    // نستخدم amount_usd لأن سجل المحفظة يخزن القيمة بالدولار.
    for (final transaction in subscriberWalletTransactionHistory) {
      if (transaction['transaction_type']?.toString() != 'deposit') {
        continue;
      }

      addPaymentToAccountTotals({
        'amount': (transaction['amount_usd'] as num?)?.toDouble() ?? 0,
        'currency': 'USD',
        'created_at': transaction['created_at'],
      });
    }

    // ------------------------------------------------------------
    // المقبوضات النقدية من الوكلاء تدخل أيضًا ضمن اليوم والشهر.
    //
    // نقدي:
    //   deposit + cash
    //
    // تسديد دين:
    //   debt_payment
    //
    // آجل:
    //   deposit + credit => لا يدخل.
    // ------------------------------------------------------------

    if (!isAgentDashboard) {
      for (final transaction in agentBalanceTransactionHistory) {
        final type = transaction['transaction_type']?.toString() ?? '';

        final method = transaction['payment_method']?.toString() ?? '';

        final isCashDeposit = type == 'deposit' && method == 'cash';

        final isDebtPayment =
            type == 'debt_payment' || method == 'debt_payment';

        if (!isCashDeposit && !isDebtPayment) {
          continue;
        }

        addPaymentToAccountTotals({
          'amount': (transaction['amount_usd'] as num?)?.toDouble() ?? 0,
          'currency': 'USD',
          'created_at': transaction['created_at'],
