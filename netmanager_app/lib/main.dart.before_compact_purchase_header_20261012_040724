                      } catch (e) {
                        if (!mounted) return;

                        ScaffoldMessenger.of(this.context).showSnackBar(
                          SnackBar(
                            content: Text('فشل حفظ مشترك الهوتسبوت: $e'),
                            backgroundColor: Colors.red,
