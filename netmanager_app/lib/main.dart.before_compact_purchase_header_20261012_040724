    final minQuantityController = TextEditingController(text: '0');
    final notesController = TextEditingController();

    String currency = widget.currentUser.currency == 'SYP' ? 'SYP' : 'USD';

    final saved = await showDialog<bool>(
      context: context,
      builder: (dialogContext) => StatefulBuilder(
        builder: (context, setDialogState) {
          return AlertDialog(
            title: Text(isArabic ? 'إضافة مادة' : 'Add Product'),
            content: SizedBox(
              width: 520,
              child: SingleChildScrollView(
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    TextField(
                      controller: nameController,
                      autofocus: true,
                      decoration: InputDecoration(
                        labelText: isArabic ? 'اسم المادة *' : 'Product name *',
                        prefixIcon: const Icon(Icons.inventory_2_outlined),
                      ),
                    ),
                    const SizedBox(height: 12),
                    TextField(
                      controller: codeController,
                      decoration: InputDecoration(
                        labelText: isArabic ? 'كود المادة' : 'Product code',
                        prefixIcon: const Icon(Icons.qr_code_rounded),
                      ),
                    ),
                    const SizedBox(height: 12),
                    TextField(
                      controller: unitController,
                      decoration: InputDecoration(
                        labelText: isArabic ? 'الوحدة' : 'Unit',
                        hintText: isArabic
                            ? 'قطعة، متر، كغ...'
                            : 'Piece, meter, kg...',
                        prefixIcon: const Icon(Icons.straighten),
                      ),
                    ),
                    const SizedBox(height: 12),
                    TextField(
                      controller: purchasePriceController,
                      keyboardType: const TextInputType.numberWithOptions(
                        decimal: true,
                      ),
                      decoration: InputDecoration(
                        labelText: isArabic ? 'سعر الشراء' : 'Purchase price',
                        prefixIcon: const Icon(Icons.shopping_cart_outlined),
                      ),
                    ),
                    const SizedBox(height: 12),
                    TextField(
                      controller: salePriceController,
                      keyboardType: const TextInputType.numberWithOptions(
                        decimal: true,
                      ),
                      decoration: InputDecoration(
                        labelText: isArabic ? 'سعر البيع' : 'Sale price',
                        prefixIcon: const Icon(Icons.sell_outlined),
                      ),
                    ),
                    const SizedBox(height: 12),
                    TextField(
                      controller: quantityController,
                      keyboardType: const TextInputType.numberWithOptions(
                        decimal: true,
                      ),
                      decoration: InputDecoration(
                        labelText: isArabic
                            ? 'الكمية الحالية'
                            : 'Current quantity',
                        prefixIcon: const Icon(Icons.inventory_outlined),
                      ),
                    ),
                    const SizedBox(height: 12),
                    TextField(
                      controller: minQuantityController,
                      keyboardType: const TextInputType.numberWithOptions(
                        decimal: true,
                      ),
                      decoration: InputDecoration(
                        labelText: isArabic
                            ? 'الحد الأدنى للمخزون'
                            : 'Minimum stock',
                        helperText: isArabic
                            ? 'يستخدم لاحقًا لتنبيه نقص المخزون'
                            : 'Used for low-stock alerts',
                        prefixIcon: const Icon(Icons.warning_amber_rounded),
                      ),
                    ),
                    const SizedBox(height: 12),
                    DropdownButtonFormField<String>(
                      initialValue: currency,
                      decoration: InputDecoration(
                        labelText: isArabic ? 'العملة' : 'Currency',
                        prefixIcon: const Icon(Icons.currency_exchange),
                      ),
                      items: const [
                        DropdownMenuItem(value: 'USD', child: Text('USD')),
                        DropdownMenuItem(value: 'SYP', child: Text('SYP')),
                      ],
                      onChanged: (value) {
                        if (value == null) return;

                        setDialogState(() {
                          currency = value;
                        });
                      },
                    ),
                    const SizedBox(height: 12),
                    TextField(
                      controller: notesController,
                      minLines: 2,
                      maxLines: 4,
                      decoration: InputDecoration(
                        labelText: isArabic ? 'ملاحظات' : 'Notes',
                        prefixIcon: const Icon(Icons.notes),
                      ),
                    ),
                  ],
                ),
              ),
            ),
            actions: [
              TextButton(
                onPressed: () => Navigator.pop(dialogContext, false),
                child: Text(isArabic ? 'إلغاء' : 'Cancel'),
              ),
              FilledButton.icon(
                icon: const Icon(Icons.save),
                label: Text(isArabic ? 'حفظ' : 'Save'),
                onPressed: () async {
                  final name = nameController.text.trim();

                  if (name.isEmpty) {
                    ScaffoldMessenger.of(dialogContext).showSnackBar(
                      SnackBar(
                        content: Text(
                          isArabic ? 'أدخل اسم المادة' : 'Enter product name',
                        ),
                      ),
                    );
                    return;
                  }

                  double numberValue(TextEditingController controller) {
                    return double.tryParse(
                          controller.text.trim().replaceAll(',', '.'),
                        ) ??
                        0;
                  }

                  final purchasePrice = numberValue(purchasePriceController);
                  final salePrice = numberValue(salePriceController);
                  final quantity = numberValue(quantityController);
                  final minQuantity = numberValue(minQuantityController);

                  if (purchasePrice < 0 ||
                      salePrice < 0 ||
                      quantity < 0 ||
                      minQuantity < 0) {
                    ScaffoldMessenger.of(dialogContext).showSnackBar(
                      SnackBar(
                        content: Text(
                          isArabic
                              ? 'الأسعار والكميات لا يمكن أن تكون سالبة'
                              : 'Prices and quantities cannot be negative',
                        ),
                      ),
                    );
                    return;
                  }

                  try {
                    await Supabase.instance.client
                        .from('accounting_products')
                        .insert({
                          'code': codeController.text.trim().isEmpty
                              ? null
                              : codeController.text.trim(),
                          'name': name,
                          'unit': unitController.text.trim().isEmpty
                              ? 'قطعة'
                              : unitController.text.trim(),
                          'purchase_price': purchasePrice,
                          'sale_price': salePrice,
                          'quantity': quantity,
                          'min_quantity': minQuantity,
                          'currency': currency,
                          'notes': notesController.text.trim().isEmpty
                              ? null
                              : notesController.text.trim(),
                          'active': true,
                          'created_by': widget.currentUser.id,
                        });

                    if (!dialogContext.mounted) return;

                    Navigator.pop(dialogContext, true);
                  } catch (e) {
                    if (!dialogContext.mounted) return;

                    ScaffoldMessenger.of(dialogContext).showSnackBar(
                      SnackBar(
                        content: Text(
                          isArabic
                              ? 'تعذر إضافة المادة: $e'
                              : 'Unable to add product: $e',
                        ),
                        backgroundColor: Colors.red,
                      ),
                    );
                  }
                },
              ),
            ],
          );
        },
      ),
    );

    codeController.dispose();
    nameController.dispose();
    unitController.dispose();
    purchasePriceController.dispose();
    salePriceController.dispose();
    quantityController.dispose();
    minQuantityController.dispose();
    notesController.dispose();

    if (saved == true) {
      await loadAccountingProducts();
    }
  }

