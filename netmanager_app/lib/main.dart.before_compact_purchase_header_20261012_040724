  List<Map<String, dynamic>> accountingProducts = [];
  bool accountingProductsLoading = false;
  String accountingProductSearch = '';

  Future<void> loadAccountingProducts() async {
    if (accountingProductsLoading) return;

    setState(() {
      accountingProductsLoading = true;
    });

    try {
      final data = await Supabase.instance.client
          .from('accounting_products')
          .select()
          .eq('created_by', widget.currentUser.id)
          .order('created_at', ascending: false);

      if (!mounted) return;

      setState(() {
        accountingProducts = List<Map<String, dynamic>>.from(data);
      });
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            widget.currentUser.language == 'ar'
                ? 'تعذر تحميل المواد: $e'
                : 'Unable to load products: $e',
          ),
          backgroundColor: Colors.red,
        ),
      );
    } finally {
      if (mounted) {
        setState(() {
          accountingProductsLoading = false;
        });
      }
    }
  }

  Future<void> addAccountingProduct() async {
    final isArabic = widget.currentUser.language == 'ar';

    final codeController = TextEditingController();
    final nameController = TextEditingController();
    final unitController = TextEditingController(text: 'قطعة');
    final purchasePriceController = TextEditingController(text: '0');
