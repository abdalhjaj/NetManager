                                payment['_is_wallet_deposit'] == true ||
                                paymentType == 'deposit';

                            final isAgentDeletion =
                                payment['_is_agent_deletion'] == true ||
                                paymentType == 'agent_deleted';

                            // أنواع حركات رصيد الوكيل في آخر العمليات.
                            final isAgentBalanceOperation =
                                payment['_is_agent_balance_operation'] == true;

                            final isAgentCashDeposit =
                                isAgentBalanceOperation &&
                                paymentType == 'agent_cash_deposit';

                            final isAgentCreditDeposit =
                                isAgentBalanceOperation &&
                                paymentType == 'agent_credit_deposit';

                            final isAgentDebtPayment =
                                isAgentBalanceOperation &&
                                paymentType == 'agent_debt_payment';

                            final type = payment['_type']?.toString() ?? '';

                            final accountId =
                                payment['account_id']?.toString() ??
                                payment['reference_id']?.toString();

                            final description =
                                payment['description']?.toString() ?? '';

                            // منفذ عملية إيداع المحفظة.
                            // created_by يحتوي ID المستخدم أو الوكيل
                            // الذي نفذ الإيداع.
                            final createdById = payment['created_by']
                                ?.toString();

                            String performedByName = '';

                            if (isWalletDeposit &&
                                createdById != null &&
                                createdById.isNotEmpty) {
                              final performedByUser = users
                                  .where((u) => u.id == createdById)
                                  .firstOrNull;

                              performedByName =
                                  performedByUser?.name ??
                                  tr('مستخدم غير معروف', 'Unknown User');
                            }

                            String subscriberName = ownerName;

                            // في عمليات رصيد الوكيل user_id هو معرف الوكيل.
                            // لذلك نعرض اسم الوكيل نفسه.
                            if (isAgentBalanceOperation) {
                              final agentId =
                                  payment['agent_id']?.toString() ?? userId;

                              final agentUser = users
                                  .where((u) => u.id == agentId)
                                  .firstOrNull;

                              if (agentUser != null) {
                                subscriberName = agentUser.name;
                              }
                            }

                            if (isAgentDeletion) {
                              final deletedAgentName =
                                  payment['deleted_agent_name']?.toString() ??
                                  '';

                              if (deletedAgentName.trim().isNotEmpty) {
                                subscriberName = deletedAgentName.trim();
                              }
                            }

                            if (type == 'Broadband' && accountId != null) {
                              final account = broadbandAccounts
                                  .where((a) => a.id == accountId)
                                  .firstOrNull;

                              if (account != null &&
                                  account.username.trim().isNotEmpty) {
                                subscriberName = account.username;
                              }
                            } else if (type == 'Hotspot' && accountId != null) {
                              final account = hotspotAccounts
                                  .where((a) => a.id == accountId)
                                  .firstOrNull;

                              if (account != null &&
                                  account.username.trim().isNotEmpty) {
                                subscriberName = account.username;
                              }
                            }

                            final createdAt = DateTime.tryParse(
                              payment['created_at']?.toString() ?? '',
                            );

                            final dateText = createdAt == null
                                ? '-'
                                : '${createdAt.day.toString().padLeft(2, '0')}/'
                                      '${createdAt.month.toString().padLeft(2, '0')}/'
                                      '${createdAt.year} '
                                      '${createdAt.hour.toString().padLeft(2, '0')}:'
                                      '${createdAt.minute.toString().padLeft(2, '0')}';

                            IconData icon;

                            if (type == 'Broadband') {
                              icon = Icons.router;
                            } else if (type == 'Hotspot') {
                              icon = Icons.wifi_tethering;
                            } else {
                              icon = Icons.receipt_long;
                            }

                            final amountDisplay = convertToAccountCurrency(
                              amount,
                              currency,
                            );

                            final discountDisplay = convertToAccountCurrency(
                              discount,
                              currency,
                            );

                            // ==================================================
                            // تفاصيل إيداع محفظة المشترك
                            //
                            // الوصف القادم من SQL يكون مثل:
                            // | المبلغ: 6 USD
                            // | سداد دين: 5 USD
                            // | للمحفظة: 1 USD
                            // | الدين المتبقي: 0 USD
                            // ==================================================

                            double walletDescriptionValue(String label) {
                              if (description.trim().isEmpty) return 0;

                              final escapedLabel = RegExp.escape(label);

                              final match = RegExp(
                                '$escapedLabel\\s*:\\s*'
                                r'(-?[0-9]+(?:\.[0-9]+)?)',
                              ).firstMatch(description);

                              if (match == null) return 0;

                              return double.tryParse(match.group(1) ?? '') ?? 0;
                            }

                            final walletDebtPaidUsd = isWalletDeposit
                                ? walletDescriptionValue('سداد دين')
                                : 0.0;

                            final walletAddedUsd = isWalletDeposit
                                ? walletDescriptionValue('للمحفظة')
                                : 0.0;

                            final walletDebtRemainingUsd = isWalletDeposit
                                ? walletDescriptionValue('الدين المتبقي')
                                : 0.0;

                            final walletDebtPaidDisplay =
                                convertToAccountCurrency(
                                  walletDebtPaidUsd,
                                  'USD',
                                );

                            final walletAddedDisplay = convertToAccountCurrency(
                              walletAddedUsd,
                              'USD',
                            );

                            final walletDebtRemainingDisplay =
                                convertToAccountCurrency(
                                  walletDebtRemainingUsd,
                                  'USD',
                                );

                            // ألوان العمليات:
                            // التحصيل = أخضر
                            // الحسم = أزرق
                            // التجديد = أحمر
                            // إيداع المحفظة = أصفر
                            final Color operationColor;
                            final Color operationBackground;
                            final IconData operationIcon;
                            final String operationText;

                            if (isAgentDeletion) {
                              operationColor = Colors.deepPurple.shade700;
                              operationBackground = Colors.deepPurple
                                  .withValues(alpha: 0.12);
                              operationIcon = Icons.person_remove_rounded;
                              operationText = tr(
                                'حذف حساب وكيل',
                                'Agent Account Deleted',
                              );
                            } else if (isAgentCashDeposit) {
                              operationColor = Colors.green.shade700;
                              operationBackground = Colors.green.withValues(
                                alpha: 0.12,
                              );
                              operationIcon = Icons.add_card_rounded;
                              operationText = tr(
                                'إيداع نقدي للوكيل',
                                'Agent Cash Deposit',
                              );
                            } else if (isAgentCreditDeposit) {
                              operationColor = Colors.orange.shade800;
                              operationBackground = Colors.orange.withValues(
                                alpha: 0.13,
                              );
                              operationIcon = Icons.schedule_rounded;
                              operationText = tr(
                                'إيداع آجل للوكيل',
                                'Agent Credit Deposit',
                              );
                            } else if (isAgentDebtPayment) {
                              operationColor = Colors.blue.shade700;
                              operationBackground = Colors.blue.withValues(
                                alpha: 0.12,
                              );
                              operationIcon = Icons.price_check_rounded;
                              operationText = tr(
                                'تسديد دين وكيل',
                                'Agent Debt Payment',
                              );
                            } else if (isWalletDeposit) {
                              operationColor = Colors.amber.shade800;
                              operationBackground = Colors.amber.withValues(
                                alpha: 0.15,
                              );
                              operationIcon =
                                  Icons.account_balance_wallet_rounded;
                              operationText = tr('إيداع', 'Deposit');
                            } else if (isRenewal) {
                              operationColor = Colors.red.shade700;
                              operationBackground = Colors.red.withValues(
                                alpha: 0.10,
                              );
                              operationIcon = Icons.refresh_rounded;
                              operationText = tr('تجديد', 'Renewal');
                            } else {
                              operationColor = Colors.green.shade700;
                              operationBackground = Colors.green.withValues(
                                alpha: 0.10,
                              );
                              operationIcon = Icons.payments_rounded;
                              operationText = tr('تحصيل', 'Collection');
                            }

                            return Container(
                              margin: const EdgeInsets.symmetric(
                                horizontal: 8,
                                vertical: 5,
                              ),
                              decoration: BoxDecoration(
                                borderRadius: BorderRadius.circular(14),
                                border: Border.all(
                                  color: operationColor.withValues(alpha: 0.25),
                                ),
                              ),
                              child: ListTile(
                                contentPadding: const EdgeInsets.symmetric(
                                  horizontal: 14,
                                  vertical: 7,
                                ),
                                leading: CircleAvatar(
                                  backgroundColor: operationBackground,
                                  child: Icon(
                                    operationIcon,
                                    color: operationColor,
                                  ),
                                ),
                                title: Row(
                                  children: [
                                    Expanded(
                                      child: Text(
                                        subscriberName,
                                        style: const TextStyle(
                                          fontWeight: FontWeight.bold,
                                        ),
                                      ),
                                    ),
                                    Container(
                                      padding: const EdgeInsets.symmetric(
                                        horizontal: 9,
                                        vertical: 4,
                                      ),
                                      decoration: BoxDecoration(
                                        color: operationBackground,
                                        borderRadius: BorderRadius.circular(20),
                                      ),
                                      child: Text(
                                        operationText,
                                        style: TextStyle(
                                          color: operationColor,
                                          fontWeight: FontWeight.bold,
                                          fontSize: 12,
                                        ),
                                      ),
                                    ),
                                  ],
                                ),
                                subtitle: Padding(
                                  padding: const EdgeInsets.only(top: 7),
                                  child: Column(
                                    crossAxisAlignment:
                                        CrossAxisAlignment.start,
                                    children: [
                                      Text(
                                        isAgentDeletion ||
                                                isAgentBalanceOperation
                                            ? 'الوكيل: $subscriberName'
                                            : '$type • المشترك: $subscriberName',
                                      ),

                                      if (isAgentDeletion) ...[
                                        const SizedBox(height: 4),
                                        Text(
                                          amountDisplay > 0.000001
                                              ? 'تسوية الرصيد: -${formatAccountMoney(amountDisplay)}'
                                              : 'تسوية الرصيد: 0 ${appCurrency == 'SYP' ? 'SYP' : 'USD'}',
                                          style: TextStyle(
                                            color: operationColor,
                                            fontWeight: FontWeight.bold,
                                          ),
                                        ),
                                      ],

                                      if (isAgentBalanceOperation) ...[
                                        const SizedBox(height: 4),
                                        Row(
                                          children: [
                                            Icon(
                                              operationIcon,
                                              size: 17,
                                              color: operationColor,
                                            ),
                                            const SizedBox(width: 5),
                                            Text(
                                              isAgentCreditDeposit
                                                  ? 'المبلغ الآجل: ${formatAccountMoney(amountDisplay)}'
                                                  : isAgentDebtPayment
                                                  ? 'المبلغ المسدد: ${formatAccountMoney(amountDisplay)}'
                                                  : 'المبلغ النقدي: ${formatAccountMoney(amountDisplay)}',
                                              style: TextStyle(
                                                color: operationColor,
                                                fontWeight: FontWeight.bold,
                                              ),
                                            ),
                                          ],
                                        ),
                                      ],

                                      if (isWalletDeposit &&
                                          performedByName.isNotEmpty) ...[
                                        const SizedBox(height: 4),
                                        Row(
                                          children: [
                                            Icon(
                                              Icons.person_outline_rounded,
                                              size: 16,
                                              color: Colors.amber.shade800,
                                            ),
                                            const SizedBox(width: 5),
                                            Expanded(
                                              child: Text(
                                                'نفذ العملية: $performedByName',
                                                style: TextStyle(
                                                  color: Colors.amber.shade900,
                                                  fontWeight: FontWeight.w600,
                                                ),
                                              ),
                                            ),
                                          ],
                                        ),
                                      ],

                                      const SizedBox(height: 4),
                                      Text(
                                        dateText,
                                        style: TextStyle(
                                          color: Theme.of(context)
                                              .colorScheme
                                              .onSurfaceVariant,
                                          fontSize: 12,
                                        ),
                                      ),
                                      const SizedBox(height: 7),

                                      if (isWalletDeposit) ...[
                                        Row(
                                          children: [
                                            Icon(
                                              Icons
                                                  .account_balance_wallet_rounded,
                                              size: 17,
                                              color: Colors.amber.shade800,
                                            ),
                                            const SizedBox(width: 5),
                                            Text(
                                              'الإيداع: '
                                              '${formatAccountMoney(amountDisplay)}',
                                              style: TextStyle(
                                                color: Colors.amber.shade800,
                                                fontWeight: FontWeight.bold,
                                              ),
                                            ),
                                          ],
                                        ),

                                        const SizedBox(height: 7),

                                        Row(
                                          children: [
                                            Icon(
                                              Icons.receipt_long_outlined,
                                              size: 17,
                                              color: Colors.blue.shade700,
                                            ),
                                            const SizedBox(width: 5),
                                            Text(
                                              'سداد الدين: '
                                              '${formatAccountMoney(walletDebtPaidDisplay)}',
                                              style: TextStyle(
                                                color: Colors.blue.shade700,
                                                fontWeight: FontWeight.bold,
                                              ),
                                            ),
                                          ],
                                        ),

                                        const SizedBox(height: 5),

                                        Row(
                                          children: [
                                            Icon(
                                              Icons.savings_outlined,
                                              size: 17,
                                              color: Colors.teal.shade700,
                                            ),
                                            const SizedBox(width: 5),
                                            Text(
                                              'للمحفظة: '
                                              '${formatAccountMoney(walletAddedDisplay)}',
                                              style: TextStyle(
                                                color: Colors.teal.shade700,
                                                fontWeight: FontWeight.bold,
                                              ),
                                            ),
                                          ],
                                        ),

                                        const SizedBox(height: 5),

                                        Row(
                                          children: [
                                            Icon(
                                              walletDebtRemainingUsd <= 0.000001
                                                  ? Icons.check_circle_outline
                                                  : Icons.warning_amber_rounded,
                                              size: 17,
                                              color:
                                                  walletDebtRemainingUsd <=
                                                      0.000001
                                                  ? Colors.green.shade700
                                                  : Colors.red.shade700,
                                            ),
                                            const SizedBox(width: 5),
                                            Text(
                                              'الدين المتبقي: '
                                              '${formatAccountMoney(walletDebtRemainingDisplay)}',
                                              style: TextStyle(
                                                color:
                                                    walletDebtRemainingUsd <=
                                                        0.000001
                                                    ? Colors.green.shade700
                                                    : Colors.red.shade700,
                                                fontWeight: FontWeight.bold,
                                              ),
                                            ),
                                          ],
                                        ),

                                        if (walletDebtPaidUsd > 0 &&
                                            walletDebtRemainingUsd <=
                                                0.000001) ...[
                                          const SizedBox(height: 7),
                                          Container(
                                            width: double.infinity,
                                            padding: const EdgeInsets.symmetric(
                                              horizontal: 10,
                                              vertical: 7,
                                            ),
                                            decoration: BoxDecoration(
                                              color: Colors.green.withValues(
                                                alpha: 0.08,
                                              ),
                                              borderRadius:
                                                  BorderRadius.circular(9),
                                            ),
                                            child: Row(
                                              children: [
                                                Icon(
                                                  Icons.verified_rounded,
                                                  size: 17,
                                                  color: Colors.green.shade700,
                                                ),
                                                const SizedBox(width: 6),
                                                Expanded(
                                                  child: Text(
                                                    tr(
                                                      'تم تسديد الدين وتفعيل الحساب',
                                                      'Debt paid and account activated',
                                                    ),
                                                    style: TextStyle(
                                                      color:
                                                          Colors.green.shade700,
                                                      fontWeight:
                                                          FontWeight.bold,
                                                    ),
                                                  ),
                                                ),
                                              ],
                                            ),
                                          ),
                                        ],
                                      ] else if (isRenewal)
                                        Row(
                                          children: [
                                            Icon(
                                              Icons.refresh_rounded,
                                              size: 17,
                                              color: Colors.red.shade700,
                                            ),
                                            const SizedBox(width: 5),
                                            Text(
                                              'التجديد: '
                                              '${formatAccountMoney(amountDisplay)}',
                                              style: TextStyle(
                                                color: Colors.red.shade700,
                                                fontWeight: FontWeight.bold,
                                              ),
                                            ),
                                          ],
                                        )
                                      else ...[
                                        Row(
                                          children: [
                                            Icon(
                                              Icons.payments_outlined,
                                              size: 17,
                                              color: Colors.green.shade700,
                                            ),
                                            const SizedBox(width: 5),
                                            Text(
                                              'المقبوض: '
                                              '${formatAccountMoney(amountDisplay)}',
                                              style: TextStyle(
                                                color: Colors.green.shade700,
                                                fontWeight: FontWeight.bold,
                                              ),
                                            ),
                                          ],
                                        ),

                                        if (discount > 0) ...[
                                          const SizedBox(height: 5),
                                          Row(
                                            children: [
                                              Icon(
                                                Icons.discount_outlined,
                                                size: 17,
                                                color: Colors.blue.shade700,
                                              ),
                                              const SizedBox(width: 5),
                                              Text(
                                                'الحسم: '
                                                '${formatAccountMoney(discountDisplay)}',
                                                style: TextStyle(
                                                  color: Colors.blue.shade700,
                                                  fontWeight: FontWeight.bold,
                                                ),
                                              ),
                                            ],
                                          ),
                                        ],
                                      ],
                                    ],
                                  ),
                                ),
                              ),
                            );
                          }).toList(),
                        ),
                ),
              ],
            ),

          const SizedBox(height: 18),

          if (!isAgentDashboard &&
              (showDashboardDevicesTotal ||
                  showDashboardDevicesActive ||
                  showDashboardDevicesStopped))
            _dashboardExpandableSection(
              title: tr('أجهزة الشبكة', 'Network Devices'),
              icon: Icons.router_rounded,
              children: [
                Wrap(
                  spacing: 15,
                  runSpacing: 15,
                  children: [
                    if (showDashboardDevicesTotal)
                      statCard(
                        tr('أجهزة الشبكة', 'Network Devices'),
                        devices.length.toString(),
                        Icons.router,
                      ),
                    if (showDashboardDevicesActive)
                      statCard(
                        tr('الأجهزة النشطة', 'Active Devices'),
                        devices.where((d) => d.active).length.toString(),
                        Icons.wifi,
                      ),
                    if (showDashboardDevicesStopped)
                      statCard(
                        tr('الأجهزة المتوقفة', 'Stopped Devices'),
                        devices.where((d) => !d.active).length.toString(),
                        Icons.wifi_off,
                      ),
                  ],
                ),
              ],
            ),
        ],
      ),
    );
  }

