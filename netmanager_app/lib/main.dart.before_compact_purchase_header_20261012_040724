  Future<void> loadAccountingPurchases() async {
    if (accountingPurchasesLoading) return;

    setState(() {
      accountingPurchasesLoading = true;
    });

    try {
      final purchasesData = await Supabase.instance.client
          .from('accounting_purchases')
          .select()
          .eq('created_by', widget.currentUser.id)
          .order('invoice_number', ascending: false);

      final suppliersData = await Supabase.instance.client
          .from('accounting_suppliers')
          .select('id,name')
          .eq('created_by', widget.currentUser.id);

      final supplierNames = <String, String>{};

      for (final item in suppliersData) {
        final id = item['id']?.toString();

        if (id != null && id.isNotEmpty) {
          supplierNames[id] = item['name']?.toString() ?? '';
        }
      }

      final purchases = List<Map<String, dynamic>>.from(purchasesData);

      for (final purchase in purchases) {
        final supplierId = purchase['supplier_id']?.toString();

        purchase['_supplier_name'] =
            supplierNames[supplierId] ??
            (widget.currentUser.language == 'ar'
                ? 'مورد غير معروف'
                : 'Unknown supplier');
      }

      if (!mounted) return;

      setState(() {
        accountingPurchases = purchases;
      });
    } catch (e) {
      debugPrint('LOAD ACCOUNTING PURCHASES ERROR: $e');

      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            widget.currentUser.language == 'ar'
                ? 'تعذر تحميل فواتير المشتريات: $e'
                : 'Unable to load purchase invoices: $e',
          ),
          backgroundColor: Colors.red,
        ),
      );
    } finally {
      if (mounted) {
        setState(() {
          accountingPurchasesLoading = false;
        });
      }
    }
  }

  Future<void> openAccountingPurchaseInvoicePage({
    Map<String, dynamic>? existingPurchase,
  }) async {
    final isArabic = widget.currentUser.language == 'ar';

    try {
      final suppliersData = await Supabase.instance.client
          .from('accounting_suppliers')
          .select()
          .eq('created_by', widget.currentUser.id)
          .eq('active', true)
          .order('name');

      final purchasesData = await Supabase.instance.client
          .from('accounting_purchases')
          .select('invoice_number')
          .eq('created_by', widget.currentUser.id)
          .order('invoice_number', ascending: false)
          .limit(1);

      final productsData = await Supabase.instance.client
          .from('accounting_products')
          .select()
          .eq('created_by', widget.currentUser.id)
          .eq('active', true)
          .order('name');

      if (!mounted) return;

      final suppliers = List<Map<String, dynamic>>.from(suppliersData);
      final products = List<Map<String, dynamic>>.from(productsData);

      int nextInvoiceNumber = 1;

      if (purchasesData.isNotEmpty) {
        final lastNumber =
            (purchasesData.first['invoice_number'] as num?)?.toInt() ?? 0;
        nextInvoiceNumber = lastNumber + 1;
      }

      final supplierSearchController = TextEditingController();

      Map<String, dynamic>? selectedSupplier;
      List<Map<String, dynamic>> filteredSuppliers = [];

      double previousBalanceUsd = 0;
      double previousBalanceSyp = 0;
      bool searchingSupplier = false;
      bool initialEditBalanceLoaded = false;

      final invoiceItems = <Map<String, dynamic>>[];

      // نحفظ كميات الفاتورة الأصلية عند التعديل.
      // المفتاح هو product_id والقيمة هي مجموع الكمية القديمة.
      final originalPurchaseQuantities = <String, double>{};

      bool savingInvoice = false;

      final invoiceDiscountUsdController = TextEditingController(text: '0');
      final invoiceDiscountSypController = TextEditingController(text: '0');
      final paidUsdController = TextEditingController(text: '0');
      final paidSypController = TextEditingController(text: '0');

      final isEditingPurchase = existingPurchase != null;

      if (isEditingPurchase) {
        final purchaseId = existingPurchase['id']?.toString();

        if (purchaseId == null || purchaseId.isEmpty) {
          throw Exception(
            isArabic ? 'معرّف الفاتورة غير موجود' : 'Invoice ID is missing',
          );
        }

        final supplierId = existingPurchase['supplier_id']?.toString();

        if (supplierId != null && supplierId.isNotEmpty) {
          for (final supplier in suppliers) {
            if (supplier['id']?.toString() == supplierId) {
              selectedSupplier = supplier;
              supplierSearchController.text =
                  supplier['name']?.toString() ?? '';
              searchingSupplier = true;
              break;
            }
          }
        }

        paidUsdController.text =
            ((existingPurchase['paid_usd'] as num?)?.toDouble() ?? 0)
                .toStringAsFixed(2);

        paidSypController.text =
            ((existingPurchase['paid_syp'] as num?)?.toDouble() ?? 0)
                .toStringAsFixed(0);

        final savedItemsData = await Supabase.instance.client
            .from('accounting_purchase_items')
            .select()
            .eq('purchase_id', purchaseId);

        final savedItems = List<Map<String, dynamic>>.from(savedItemsData);

        // الاحتفاظ بالكميات الأصلية قبل أي تعديل يجريه المستخدم.
        for (final savedItem in savedItems) {
          final originalProductId = savedItem['product_id']?.toString() ?? '';
          final originalQuantity =
              (savedItem['quantity'] as num?)?.toDouble() ?? 0;

          if (originalProductId.isNotEmpty && originalQuantity > 0) {
            originalPurchaseQuantities[originalProductId] =
                (originalPurchaseQuantities[originalProductId] ?? 0) +
                originalQuantity;
          }
        }

        for (final savedItem in savedItems) {
          final productId = savedItem['product_id']?.toString();

          Map<String, dynamic>? product;

          for (final item in products) {
            if (item['id']?.toString() == productId) {
              product = item;
              break;
            }
          }

          if (product == null) {
            continue;
          }

          invoiceItems.add({
            'product': product,
            'searchController': TextEditingController(
              text: product['name']?.toString() ?? '',
            ),
            'quantityController': TextEditingController(
              text: ((savedItem['quantity'] as num?)?.toDouble() ?? 0)
                  .toString(),
            ),
            'priceController': TextEditingController(
              text: ((savedItem['unit_cost'] as num?)?.toDouble() ?? 0)
                  .toString(),
            ),
            'discountController': TextEditingController(
              text: ((savedItem['discount'] as num?)?.toDouble() ?? 0)
                  .toString(),
            ),
            'priceCurrency': savedItem['currency']?.toString() ?? 'USD',
            'filteredProducts': <Map<String, dynamic>>[],
          });
        }
      }

      Map<String, dynamic> createEmptyInvoiceRow() {
        return {
          'product': null,
          'searchController': TextEditingController(),
          'quantityController': TextEditingController(text: '1'),
          'priceController': TextEditingController(),
          'discountController': TextEditingController(text: '0'),
          'priceCurrency': 'USD',
          'filteredProducts': <Map<String, dynamic>>[],
        };
      }

      double rowTotal(Map<String, dynamic> row) {
        final quantity =
            double.tryParse(row['quantityController'].text.trim()) ?? 0;

        final price = double.tryParse(row['priceController'].text.trim()) ?? 0;

        var discount =
            double.tryParse(row['discountController'].text.trim()) ?? 0;

        if (discount < 0) discount = 0;
        if (discount > 100) discount = 100;

        final beforeDiscount = quantity * price;

        return beforeDiscount * (1 - discount / 100);
      }

      double invoiceItemsTotal(String currency) {
        double total = 0;

        for (final row in invoiceItems) {
          if (row['product'] == null) continue;

          final rowCurrency = row['priceCurrency']?.toString() ?? 'USD';

          if (rowCurrency == currency) {
            total += rowTotal(row);
          }
        }

        return total;
      }

      double invoiceDiscountPercent(TextEditingController controller) {
        var value = double.tryParse(controller.text.trim()) ?? 0;

        if (value < 0) value = 0;
        if (value > 100) value = 100;

        return value;
      }

      double invoiceNetTotal(
        String currency,
        TextEditingController discountController,
      ) {
        final total = invoiceItemsTotal(currency);
        final discount = invoiceDiscountPercent(discountController);

        return total * (1 - discount / 100);
      }

      await showDialog<void>(
        context: context,
        barrierDismissible: false,
        builder: (dialogContext) {
          return StatefulBuilder(
            builder: (context, setDialogState) {
              Future<void> selectSupplier(Map<String, dynamic> supplier) async {
                setDialogState(() {
                  selectedSupplier = supplier;
                  supplierSearchController.text =
                      supplier['name']?.toString() ?? '';
                  filteredSuppliers = [];
                  searchingSupplier = true;
                });

                try {
                  final supplierId = supplier['id'].toString();

                  final transactions = await Supabase.instance.client
                      .from('accounting_transactions')
                      .select()
                      .eq('supplier_id', supplierId);

                  final sales = await Supabase.instance.client
                      .from('accounting_purchases')
                      .select()
                      .eq('created_by', widget.currentUser.id)
                      .eq('supplier_id', supplierId);

                  final openingBalance =
                      (supplier['opening_balance'] as num?)?.toDouble() ?? 0;

                  final supplierCurrency =
                      supplier['currency']?.toString() ?? 'USD';

                  double balanceUsd = supplierCurrency == 'USD'
                      ? openingBalance
                      : 0;

                  double balanceSyp = supplierCurrency == 'SYP'
                      ? openingBalance
                      : 0;

                  final editingPurchaseId = existingPurchase?['id']?.toString();

                  for (final sale in sales) {
                    if (sale['status']?.toString() == 'cancelled') {
                      continue;
                    }

                    // عند تعديل فاتورة لا نحسب نفس الفاتورة
                    // ضمن الرصيد السابق.
                    if (editingPurchaseId != null &&
                        sale['id']?.toString() == editingPurchaseId) {
                      continue;
                    }

                    final totalUsd =
                        (sale['total_usd'] as num?)?.toDouble() ?? 0;

                    final totalSyp =
                        (sale['total_syp'] as num?)?.toDouble() ?? 0;

                    final paidUsd = (sale['paid_usd'] as num?)?.toDouble() ?? 0;

                    final paidSyp = (sale['paid_syp'] as num?)?.toDouble() ?? 0;

                    balanceUsd += totalUsd - paidUsd;
                    balanceSyp += totalSyp - paidSyp;
                  }

                  // الحركات القديمة ما زالت مرتبطة بعملة واحدة.
                  // نطبقها على عملة المورد فقط حتى لا نخلط العملات.
                  for (final transaction in transactions) {
                    final type = transaction['transaction_type']?.toString();

                    final amount =
                        (transaction['amount'] as num?)?.toDouble() ?? 0;

                    double effect = 0;

                    if (type == 'supplier_receipt') {
                      effect = -amount;
                    } else if (type == 'supplier_payment') {
                      effect = amount;
                    } else {
                      continue;
                    }

                    if (supplierCurrency == 'SYP') {
                      balanceSyp += effect;
                    } else {
                      balanceUsd += effect;
                    }
                  }

                  if (!dialogContext.mounted) return;

                  setDialogState(() {
                    previousBalanceUsd = balanceUsd;
                    previousBalanceSyp = balanceSyp;
                    searchingSupplier = false;
                  });
                } catch (e) {
                  if (!dialogContext.mounted) return;

                  setDialogState(() {
                    searchingSupplier = false;
                  });

                  ScaffoldMessenger.of(context).showSnackBar(
                    SnackBar(
                      content: Text(
                        isArabic ? 'تعذر تحديث رصيد المورد، حاول مرة أخرى' : 'Unable to update supplier balance. Please try again.',
                      ),
                    ),
                  );
                }
              }

              if (isEditingPurchase &&
                  selectedSupplier != null &&
                  !initialEditBalanceLoaded) {
                initialEditBalanceLoaded = true;

                WidgetsBinding.instance.addPostFrameCallback((_) {
                  if (!dialogContext.mounted) return;
                  selectSupplier(selectedSupplier!);
                });
              }

              Future<void> openInvoiceItemEditor({
                Map<String, dynamic>? existingRow,
              }) async {
                final isEditing = existingRow != null;

                Map<String, dynamic>? selectedProduct =
                    existingRow?['product'] as Map<String, dynamic>?;

                final searchController = TextEditingController(
                  text: selectedProduct?['name']?.toString() ?? '',
                );

                final quantityController = TextEditingController(
                  text: existingRow?['quantityController']?.text ?? '1',
                );

                final priceController = TextEditingController(
                  text: existingRow?['priceController']?.text ?? '',
                );

                final discountController = TextEditingController(
                  text: existingRow?['discountController']?.text ?? '0',
                );

                String priceCurrency =
                    existingRow?['priceCurrency']?.toString() ?? 'USD';

                List<Map<String, dynamic>> filteredProducts = [];

                bool saved = false;

                await showDialog<void>(
                  context: context,
                  builder: (itemDialogContext) {
                    return StatefulBuilder(
                      builder: (context, setItemState) {
                        double currentTotal() {
                          final quantity =
                              double.tryParse(quantityController.text.trim()) ??
                              0;

                          final price =
                              double.tryParse(priceController.text.trim()) ?? 0;

                          var discount =
                              double.tryParse(discountController.text.trim()) ??
                              0;

                          if (discount < 0) discount = 0;
                          if (discount > 100) discount = 100;

                          return quantity * price * (1 - discount / 100);
                        }

                        void convertPriceExpression(String value) {
                          final expression = value.trim().replaceAll('×', '*');
                          final parts = expression.split('*');

                          if (parts.length != 2) {
                            setItemState(() {});
                            return;
                          }

                          final usd = double.tryParse(parts[0].trim());
                          final rate = double.tryParse(parts[1].trim());

                          if (usd == null || rate == null || rate <= 0) {
                            setItemState(() {});
                            return;
                          }

                          final converted = usd * rate;

                          setItemState(() {
                            priceController.text = converted.toStringAsFixed(0);

                            priceController.selection = TextSelection.collapsed(
                              offset: priceController.text.length,
                            );

                            priceCurrency = 'SYP';
                          });
                        }

