  List<Map<String, dynamic>> accountingCustomers = [];
  bool accountingCustomersLoading = false;
  String accountingCustomerSearch = '';

  final Map<String, double> accountingCustomerBalances = {};

  Future<void> loadAccountingCustomers() async {
    if (accountingCustomersLoading) return;

    setState(() {
      accountingCustomersLoading = true;
    });

    try {
      final data = await Supabase.instance.client
          .from('accounting_customers')
          .select()
          .eq('created_by', widget.currentUser.id)
          .order('created_at', ascending: false);

      final customers = List<Map<String, dynamic>>.from(data);

      final balances = <String, double>{};

      // نبدأ بالرصيد الافتتاحي لكل زبون.
      for (final customer in customers) {
        final id = customer['id']?.toString();

        if (id == null || id.isEmpty) continue;

        balances[id] = (customer['opening_balance'] as num?)?.toDouble() ?? 0;
      }

      // تحميل جميع حركات الزبائن مرة واحدة.
      final transactionsData = await Supabase.instance.client
          .from('accounting_transactions')
          .select()
          .eq('created_by', widget.currentUser.id);

      final transactions = List<Map<String, dynamic>>.from(transactionsData);

      for (final transaction in transactions) {
        final customerId = transaction['customer_id']?.toString();

        if (customerId == null ||
            customerId.isEmpty ||
            !balances.containsKey(customerId)) {
          continue;
        }

        final amount = (transaction['amount'] as num?)?.toDouble() ?? 0;

        final type = transaction['transaction_type']?.toString() ?? '';

        if (type == 'customer_receipt') {
          // قبض من الزبون يخفض الدين عليه.
          balances[customerId] = (balances[customerId] ?? 0) - amount;
        } else if (type == 'customer_payment') {
          // دفع للزبون يزيد الرصيد المستحق له/عليه حسب الحالة.
          balances[customerId] = (balances[customerId] ?? 0) + amount;
        }
      }

      if (!mounted) return;

      setState(() {
        accountingCustomers = customers;

        accountingCustomerBalances
          ..clear()
          ..addAll(balances);
      });
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            widget.currentUser.language == 'ar'
                ? 'تعذر تحميل الزبائن: $e'
                : 'Unable to load customers: $e',
          ),
          backgroundColor: Colors.red,
        ),
      );
    } finally {
      if (mounted) {
        setState(() {
          accountingCustomersLoading = false;
        });
      }
    }
  }

