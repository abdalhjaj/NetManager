                              : unitController.text.trim(),
                          'purchase_price': purchasePrice,
                          'sale_price': salePrice,
                          'quantity': quantity,
                          'min_quantity': minQuantity,
                          'currency': currency,
                          'notes': notesController.text.trim().isEmpty
                              ? null
                              : notesController.text.trim(),
                          'updated_at': DateTime.now().toIso8601String(),
                        })
                        .eq('id', productId);

