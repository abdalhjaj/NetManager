                            if (message.contains(
                              'INSUFFICIENT_AGENT_BALANCE',
                            )) {
                              message =
                                  'رصيد الوكيل غير كافٍ لتنفيذ عملية السحب';
                            } else if (message.contains('NOT_AGENT_OWNER')) {
                              message =
                                  'ليس لديك صلاحية لإدارة رصيد هذا الوكيل';
                            } else if (message.contains('INVALID_AMOUNT')) {
                              message = 'المبلغ غير صحيح';
