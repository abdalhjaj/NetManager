  Future<String?> _uploadHotspotDesignLogo() async {
    try {
      final file = await FilePicker.pickFile(
        type: FileType.custom,
        allowedExtensions: const ['png', 'jpg', 'jpeg', 'webp'],
      );

      if (file == null) return null;

      final bytes = await file.readAsBytes();

      if (bytes.length > 5 * 1024 * 1024) {
        throw Exception('حجم الشعار يجب ألا يتجاوز 5 MB');
      }

      final extension = (file.extension ?? 'png').toLowerCase();

      final safeExtension =
          <String>{'png', 'jpg', 'jpeg', 'webp'}.contains(extension)
          ? extension
          : 'png';

      final contentType = safeExtension == 'png'
          ? 'image/png'
          : safeExtension == 'webp'
          ? 'image/webp'
          : 'image/jpeg';

      final fileName =
          'logo_${DateTime.now().microsecondsSinceEpoch}.$safeExtension';

      final storagePath = '${widget.currentUser.id}/card-logos/$fileName';

      final supabase = Supabase.instance.client;

      await supabase.storage
          .from('hotspot-designs')
          .uploadBinary(
            storagePath,
            bytes,
            fileOptions: FileOptions(contentType: contentType, upsert: false),
          );

      return supabase.storage.from('hotspot-designs').getPublicUrl(storagePath);
    } catch (e) {
      if (!mounted) return null;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('تعذر استيراد الشعار: $e'),
          backgroundColor: Colors.red,
        ),
      );

      return null;
    }
  }

