                    onChanged: (value) {
                      if (value == null) return;

                      setState(() {
                        selectedBroadbandUserId = value;
                        broadbandStatusFilter = 'الكل';
                      });
                    },
                  ),
                ),
              ),

            const SizedBox(height: 12),

            SingleChildScrollView(
              scrollDirection: Axis.horizontal,
              child: Row(
                children: [
                  filterChip('الكل', allCount, Colors.blue),
                  filterChip('فعال', activeCount, Colors.green),
                  filterChip('فترة سماح', graceCount, Colors.amber),
                  filterChip(
                    'موقوف بسبب الدين',
                    debtSuspendedCount,
                    Colors.red,
                  ),
                  filterChip('منتهي', expiredCount, Colors.orange),
                  filterChip('متوقف يدويًا', stoppedCount, Colors.grey),
                ],
              ),
            ),

            const SizedBox(height: 12),

            if (visibleAccounts.isEmpty)
              Expanded(
                child: Card(
                  child: Center(
                    child: Padding(
                      padding: const EdgeInsets.all(24),
                      child: Column(
                        mainAxisSize: MainAxisSize.min,
                        children: [
                          Icon(
                            Icons.language,
                            size: 64,
