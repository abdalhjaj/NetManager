  List<Map<String, dynamic>> accountingSuppliers = [];
  bool accountingSuppliersLoading = false;
  String accountingSupplierSearch = '';

  final Map<String, double> accountingSupplierBalances = {};

  Future<void> loadAccountingSuppliers() async {
    if (accountingSuppliersLoading) return;

    setState(() {
      accountingSuppliersLoading = true;
    });

    try {
      final data = await Supabase.instance.client
          .from('accounting_suppliers')
          .select()
          .eq('created_by', widget.currentUser.id)
          .order('created_at', ascending: false);

      final suppliers = List<Map<String, dynamic>>.from(data);

      final balances = <String, double>{};

      for (final supplier in suppliers) {
        final id = supplier['id']?.toString();

        if (id == null || id.isEmpty) continue;

        balances[id] = (supplier['opening_balance'] as num?)?.toDouble() ?? 0;
      }

      final transactionsData = await Supabase.instance.client
          .from('accounting_transactions')
          .select()
          .eq('created_by', widget.currentUser.id);

      final transactions = List<Map<String, dynamic>>.from(transactionsData);

      for (final transaction in transactions) {
        final supplierId = transaction['supplier_id']?.toString();

        if (supplierId == null ||
            supplierId.isEmpty ||
            !balances.containsKey(supplierId)) {
          continue;
        }

        final amount = (transaction['amount'] as num?)?.toDouble() ?? 0;

        final type = transaction['transaction_type']?.toString() ?? '';

        if (type == 'supplier_payment') {
          // دفع للمورد يخفض ما علينا.
          balances[supplierId] = (balances[supplierId] ?? 0) - amount;
        } else if (type == 'supplier_receipt') {
          // قبض من المورد يزيد ما علينا.
          balances[supplierId] = (balances[supplierId] ?? 0) + amount;
        }
      }

      if (!mounted) return;

      setState(() {
        accountingSuppliers = suppliers;

        accountingSupplierBalances
          ..clear()
          ..addAll(balances);
      });
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            widget.currentUser.language == 'ar'
                ? 'تعذر تحميل الموردين: $e'
                : 'Unable to load suppliers: $e',
          ),
          backgroundColor: Colors.red,
        ),
      );
    } finally {
      if (mounted) {
        setState(() {
          accountingSuppliersLoading = false;
        });
      }
    }
  }

