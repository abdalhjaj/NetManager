    var columns = 2;
    var rows = 5;

    final pageKeys = <GlobalKey>[];

    HotspotCardTemplate? findTemplate(HotspotAccount card) {
      if (card.cardTemplateId == null) return null;

      for (final template in hotspotCardTemplates) {
        if (template.id == card.cardTemplateId) {
          return template;
        }
      }

      return null;
    }

    String getPriceText(HotspotAccount card) {
      final ownerCurrency = _accountOwnerCurrency(card.userId);
      final priceDisplay = _usdToOwnerCurrency(card.price, card.userId);

      if (ownerCurrency == 'SYP') {
        return '${priceDisplay.toStringAsFixed(0)} SYP';
      }

      return '${priceDisplay.toStringAsFixed(2)} USD';
    }

    Widget buildA4Card(HotspotAccount card) {
      final template = findTemplate(card);
      final priceText = getPriceText(card);

      if (template == null) {
        return Container(
          color: Colors.white,
          alignment: Alignment.center,
          child: Text(
            '${card.username}\n${card.password}',
            textAlign: TextAlign.center,
          ),
        );
      }

      return _buildHotspotTemplateVisual(
        designType: template.designType,
        primaryColor: template.primaryColor,
        secondaryColor: template.secondaryColor,
        textColor: template.textColor,
        companyName: template.companyName,
        packageName: template.name,
        profile: card.profile ?? template.profile ?? '-',
        durationText:
            '${card.subscriptionDuration ?? template.durationDays} يوم',
        priceText: priceText,
        username: card.username,
        password: card.password,
        showCompanyName: template.showCompanyName,
        showProfile: template.showProfile,
        showDuration: template.showDuration,
        showPrice: template.showPrice,
        showQr: template.showQr,
        footerText: template.footerText,
        backgroundUrl: template.backgroundUrl,
        logoUrl: template.logoUrl,
        layoutConfig: template.layoutConfig,
        backgroundConfig: template.backgroundConfig,
      );
    }

    await showDialog<void>(
      context: context,
      builder: (dialogContext) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            final cardsPerPage = columns * rows;

            final pages = <List<HotspotAccount>>[];

            for (var i = 0; i < cards.length; i += cardsPerPage) {
              final pageEnd = (i + cardsPerPage < cards.length)
                  ? i + cardsPerPage
                  : cards.length;

              pages.add(cards.sublist(i, pageEnd));
            }

            while (pageKeys.length < pages.length) {
              pageKeys.add(GlobalKey());
            }

            if (pageKeys.length > pages.length) {
              pageKeys.removeRange(pages.length, pageKeys.length);
            }

            Widget buildA4Page(List<HotspotAccount> pageCards) {
              const pageContentWidth = 660.0;
              const pageContentHeight = 950.0;

              const horizontalGap = 8.0;
              const verticalGap = 8.0;

              final cardWidth =
                  (pageContentWidth - (horizontalGap * (columns - 1))) /
                  columns;

              final cardHeight =
                  (pageContentHeight - (verticalGap * (rows - 1))) / rows;

              return SizedBox(
                width: pageContentWidth,
                height: pageContentHeight,
                child: Stack(
                  clipBehavior: Clip.none,
                  children: [
                    for (var index = 0; index < pageCards.length; index++)
                      Positioned(
                        left: (index % columns) * (cardWidth + horizontalGap),
                        top: (index ~/ columns) * (cardHeight + verticalGap),
                        width: cardWidth,
                        height: cardHeight,
                        child: FittedBox(
                          fit: BoxFit.contain,
                          alignment: Alignment.center,
                          child: SizedBox(
                            width: 660,
                            height: 400,
                            child: ClipRRect(
                              borderRadius: BorderRadius.circular(10),
                              child: buildA4Card(pageCards[index]),
                            ),
                          ),
                        ),
                      ),
                  ],
                ),
              );
            }

            void updateLayout() {
              final newColumns = int.tryParse(columnsController.text.trim());
              final newRows = int.tryParse(rowsController.text.trim());

              if (newColumns == null ||
                  newRows == null ||
                  newColumns < 1 ||
                  newRows < 1) {
                return;
              }

              // حدود حماية حتى لا تصبح الصفحة ثقيلة جدًا.
              if (newColumns > 6 || newRows > 10) {
                return;
              }

              setDialogState(() {
                columns = newColumns;
                rows = newRows;
              });
            }

            return Dialog(
              insetPadding: const EdgeInsets.all(12),
              child: SizedBox(
                width: 920,
                height: 800,
                child: Column(
                  children: [
                    Padding(
                      padding: const EdgeInsets.fromLTRB(16, 10, 16, 8),
                      child: Row(
                        children: [
                          const Icon(Icons.description_outlined),
                          const SizedBox(width: 10),

                          Text(
                            'معاينة A4 — ${cards.length} بطاقة',
                            style: const TextStyle(
                              fontSize: 18,
                              fontWeight: FontWeight.bold,
                            ),
                          ),

                          const Spacer(),

                          Text(
                            '${pages.length} صفحة',
                            style: const TextStyle(fontWeight: FontWeight.bold),
                          ),

                          const SizedBox(width: 10),

                          IconButton(
                            onPressed: () => Navigator.pop(dialogContext),
                            icon: const Icon(Icons.close),
                          ),
                        ],
                      ),
                    ),

                    const Divider(height: 1),

                    Padding(
                      padding: const EdgeInsets.symmetric(
                        horizontal: 16,
                        vertical: 10,
                      ),
                      child: Row(
                        children: [
                          const Text(
                            'عدد الأعمدة:',
                            style: TextStyle(fontWeight: FontWeight.bold),
                          ),

                          const SizedBox(width: 8),

                          SizedBox(
                            width: 75,
                            child: TextField(
                              controller: columnsController,
                              keyboardType: TextInputType.number,
                              textAlign: TextAlign.center,
                              decoration: const InputDecoration(
                                isDense: true,
                                border: OutlineInputBorder(),
                                hintText: '2',
                              ),
                              onChanged: (_) => updateLayout(),
                            ),
                          ),

                          const SizedBox(width: 24),

                          const Text(
                            'عدد الصفوف:',
                            style: TextStyle(fontWeight: FontWeight.bold),
                          ),

                          const SizedBox(width: 8),

                          SizedBox(
                            width: 75,
                            child: TextField(
                              controller: rowsController,
                              keyboardType: TextInputType.number,
                              textAlign: TextAlign.center,
                              decoration: const InputDecoration(
                                isDense: true,
                                border: OutlineInputBorder(),
                                hintText: '5',
                              ),
                              onChanged: (_) => updateLayout(),
                            ),
                          ),

                          const SizedBox(width: 24),

                          Container(
                            padding: const EdgeInsets.symmetric(
                              horizontal: 14,
                              vertical: 10,
                            ),
                            decoration: BoxDecoration(
                              color: Theme.of(context)
                                  .colorScheme
                                  .primaryContainer,
                              borderRadius: BorderRadius.circular(8),
                            ),
                            child: Text(
                              'البطاقات في الصفحة: $cardsPerPage',
                              style: const TextStyle(
                                fontWeight: FontWeight.bold,
                              ),
                            ),
                          ),
                        ],
                      ),
                    ),

                    const Divider(height: 1),

                    Expanded(
                      child: Container(
                        color: Colors.grey.shade300,
                        child: SingleChildScrollView(
                          padding: const EdgeInsets.all(20),
                          child: Column(
                            children: [
                              for (
                                var pageIndex = 0;
                                pageIndex < pages.length;
                                pageIndex++
                              ) ...[
                                Center(
                                  child: SingleChildScrollView(
                                    scrollDirection: Axis.horizontal,
                                    child: RepaintBoundary(
                                      key: pageKeys[pageIndex],
                                      child: Container(
                                        width: 700,
                                        height: 990,
                                        padding: const EdgeInsets.all(20),
                                        color: Colors.white,
                                        child: buildA4Page(pages[pageIndex]),
                                      ),
                                    ),
                                  ),
                                ),
                                if (pageIndex < pages.length - 1)
                                  const SizedBox(height: 24),
                              ],
                            ],
                          ),
                        ),
                      ),
                    ),

                    const Divider(height: 1),

                    Padding(
                      padding: const EdgeInsets.all(10),
                      child: Row(
                        children: [
                          Text(
                            '$columns عمود × $rows صف'
                            ' = $cardsPerPage بطاقة في الصفحة',
                            style: const TextStyle(fontWeight: FontWeight.bold),
                          ),

                          const Spacer(),

                          TextButton(
                            onPressed: () => Navigator.pop(dialogContext),
                            child: const Text('إغلاق'),
                          ),

                          const SizedBox(width: 8),

                          FilledButton.icon(
                            onPressed: () async {
                              if (pageKeys.isEmpty) return;

                              try {
                                // ننتظر حتى يكتمل رسم جميع صفحات المعاينة.
                                await WidgetsBinding.instance.endOfFrame;

                                final document = pw.Document();

                                for (
                                  var pageIndex = 0;
                                  pageIndex < pageKeys.length;
                                  pageIndex++
                                ) {
                                  final renderObject = pageKeys[pageIndex]
                                      .currentContext
                                      ?.findRenderObject();

                                  if (renderObject is! RenderRepaintBoundary) {
                                    throw Exception(
                                      'تعذر العثور على صفحة A4 رقم ${pageIndex + 1}',
                                    );
                                  }

                                  // نلتقط نفس صفحة المعاينة كصورة.
                                  final ui.Image image = await renderObject
                                      .toImage(pixelRatio: 2.0);

                                  final byteData = await image.toByteData(
                                    format: ui.ImageByteFormat.png,
                                  );

                                  image.dispose();

                                  if (byteData == null) {
                                    throw Exception(
                                      'تعذر إنشاء صورة الصفحة ${pageIndex + 1}',
                                    );
                                  }

                                  final Uint8List imageBytes = byteData.buffer
                                      .asUint8List();

                                  final pdfImage = pw.MemoryImage(imageBytes);

                                  // كل صورة معاينة تصبح صفحة A4 كاملة.
                                  document.addPage(
                                    pw.Page(
                                      pageFormat: PdfPageFormat.a4,
                                      margin: pw.EdgeInsets.zero,
                                      build: (pdfContext) {
                                        return pw.Container(
                                          width: double.infinity,
                                          height: double.infinity,
                                          color: PdfColors.white,
                                          child: pw.Image(
                                            pdfImage,
                                            fit: pw.BoxFit.contain,
                                          ),
                                        );
                                      },
                                    ),
                                  );
                                }

                                final Uint8List pdfBytes = await document
                                    .save();

                                final savedPath = await FilePicker.saveFile(
                                  dialogTitle: 'حفظ جميع بطاقات Hotspot',
                                  fileName: 'hotspot_cards.pdf',
                                  bytes: pdfBytes,
                                );

                                if (!mounted) return;

                                if (savedPath != null) {
                                  ScaffoldMessenger.of(context).showSnackBar(
                                    SnackBar(
                                      content: Text(
                                        'تم حفظ ${pageKeys.length} صفحة A4 في ملف PDF واحد بنجاح',
                                      ),
                                      backgroundColor: Colors.green,
                                    ),
                                  );
                                }
                              } catch (e) {
                                if (!mounted) return;

                                ScaffoldMessenger.of(context).showSnackBar(
                                  SnackBar(
                                    content: Text(
                                      'حدث خطأ أثناء إنشاء PDF: $e',
                                    ),
                                    backgroundColor: Colors.red,
                                  ),
                                );
                              }
                            },
                            icon: const Icon(Icons.picture_as_pdf_outlined),
                            label: const Text('حفظ PDF'),
                          ),
                        ],
                      ),
                    ),
                  ],
                ),
              ),
            );
          },
        );
      },
    );

    columnsController.dispose();
    rowsController.dispose();
  }

  Future<void> showGeneratedHotspotCardsDialog(
    List<HotspotAccount> cards,
  ) async {
    final selectedIds = cards.map((card) => card.id).toSet();

    await showDialog<void>(
      context: context,
      builder: (dialogContext) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            final allSelected =
                cards.isNotEmpty && selectedIds.length == cards.length;

            return AlertDialog(
              title: Row(
                children: [
                  const Icon(Icons.confirmation_number_outlined),
                  const SizedBox(width: 10),
                  Expanded(child: Text('البطاقات المولدة (${cards.length})')),
                ],
              ),
              content: SizedBox(
                width: 760,
                height: 600,
                child: Column(
                  children: [
                    Card(
                      margin: EdgeInsets.zero,
                      child: Padding(
                        padding: const EdgeInsets.symmetric(
                          horizontal: 12,
                          vertical: 6,
                        ),
                        child: Row(
                          children: [
                            Checkbox(
                              value: allSelected,
                              onChanged: (value) {
                                setDialogState(() {
                                  if (value == true) {
                                    selectedIds
                                      ..clear()
                                      ..addAll(cards.map((card) => card.id));
                                  } else {
                                    selectedIds.clear();
                                  }
                                });
                              },
                            ),
                            const Text(
                              'تحديد الكل',
                              style: TextStyle(fontWeight: FontWeight.bold),
                            ),
                            const Spacer(),
                            Text(
                              'المحدد: ${selectedIds.length}',
                              style: const TextStyle(
                                fontWeight: FontWeight.bold,
                              ),
                            ),
                          ],
                        ),
                      ),
                    ),

                    const SizedBox(height: 12),

                    Expanded(
                      child: ListView.separated(
                        itemCount: cards.length,
                        separatorBuilder: (_, _) => const SizedBox(height: 10),
                        itemBuilder: (context, index) {
                          final card = cards[index];

                          final selected = selectedIds.contains(card.id);

                          HotspotCardTemplate? template;

                          final templateId = card.cardTemplateId;

                          if (templateId != null) {
                            for (final item in hotspotCardTemplates) {
                              if (item.id == templateId) {
                                template = item;
                                break;
                              }
                            }
                          }

                          final ownerCurrency = _accountOwnerCurrency(
                            card.userId,
                          );

                          final priceDisplay = _usdToOwnerCurrency(
                            card.price,
                            card.userId,
                          );

                          final priceText = ownerCurrency == 'SYP'
                              ? '${priceDisplay.toStringAsFixed(0)} SYP'
                              : '${priceDisplay.toStringAsFixed(2)} USD';

                          return Card(
                            elevation: 1,
                            margin: EdgeInsets.zero,
                            child: InkWell(
                              borderRadius: BorderRadius.circular(12),
                              onTap: () {
                                setDialogState(() {
                                  if (selected) {
                                    selectedIds.remove(card.id);
                                  } else {
                                    selectedIds.add(card.id);
                                  }
                                });
                              },
                              child: Padding(
                                padding: const EdgeInsets.all(14),
                                child: Row(
                                  crossAxisAlignment: CrossAxisAlignment.start,
                                  children: [
                                    Checkbox(
                                      value: selected,
                                      onChanged: (value) {
                                        setDialogState(() {
                                          if (value == true) {
                                            selectedIds.add(card.id);
                                          } else {
                                            selectedIds.remove(card.id);
                                          }
                                        });
                                      },
                                    ),

                                    const SizedBox(width: 8),

                                    Expanded(
                                      child: template == null
                                          ? Container(
                                              padding: const EdgeInsets.all(16),
                                              decoration: BoxDecoration(
                                                color: Theme.of(context)
                                                    .colorScheme
                                                    .surfaceContainerHighest,
                                                borderRadius:
                                                    BorderRadius.circular(14),
                                              ),
                                              child: Column(
                                                crossAxisAlignment:
                                                    CrossAxisAlignment.start,
                                                children: [
                                                  const Text(
                                                    'التصميم المرتبط غير متوفر',
                                                    style: TextStyle(
                                                      fontWeight:
                                                          FontWeight.bold,
                                                    ),
                                                  ),
                                                  const SizedBox(height: 8),
                                                  Text(
                                                    'اسم المستخدم: ${card.username}',
                                                  ),
                                                  Text(
                                                    'كلمة المرور: ${card.password}',
                                                  ),
                                                  Text('السعر: $priceText'),
