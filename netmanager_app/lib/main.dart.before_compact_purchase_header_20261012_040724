class AppUser {
  String id;
  String username;
  String password;
  String name;
  String role;
  bool active;
  String? whatsappNumber;

  // إذا كان الحساب وكيلًا فهذا هو المستخدم المسؤول عنه.
  String? parentUserId;

  // الحد الأقصى للوكلاء المسموح لهذا المستخدم.
  int maxAgents;

  // الرصيد الحالي للوكيل - محفوظ داخليًا بالدولار.
  double agentBalance;

  // الدين الحالي على الوكيل - محفوظ داخليًا بالدولار.
  double agentDebt;

  // العملة الأساسية الخاصة بحساب المستخدم.
  String currency;

  // سعر 1 دولار بالليرة السورية لهذا الحساب.
  double usdToSypRate;

  // مظهر التطبيق الخاص بالمستخدم:
  // system / light / dark
  String themeMode;

  // لون تصميم التطبيق الخاص بالمستخدم:
  // blue / green / purple / gold
  String themeColor;
  String language;

  // هل قسم المحاسبة مفعل لهذا الحساب؟
  bool accountingEnabled;

  AppUser({
    this.id = '',
    required this.username,
    required this.password,
    required this.name,
    required this.role,
    this.active = true,
    this.whatsappNumber,
    this.parentUserId,
    this.maxAgents = 0,
    this.agentBalance = 0,
    this.agentDebt = 0,
    this.currency = 'USD',
    this.usdToSypRate = 1,
    this.themeMode = 'system',
    this.themeColor = 'blue',
    this.language = 'ar',
    this.accountingEnabled = false,
  });

  Map<String, dynamic> toJson() {
    return {
      'username': username,
      'password': password,
      'name': name,
      'role': role,
      'active': active,
      'whatsapp_number': whatsappNumber,
      'parent_user_id': parentUserId,
      'max_agents': maxAgents,
      'agent_balance': agentBalance,
      'agent_debt': agentDebt,
      'currency': currency,
      'usd_to_syp_rate': usdToSypRate,
      'theme_mode': themeMode,
      'theme_color': themeColor,
      'language': language,
      'accounting_enabled': accountingEnabled,
    };
  }

  factory AppUser.fromJson(Map<String, dynamic> json) {
    return AppUser(
      id: json['id']?.toString() ?? '',
      username: json['username'] ?? '',
      password: json['password'] ?? '',
      name: json['name'] ?? '',
      role: json['role'] ?? 'مستخدم',
      active: json['active'] ?? true,
      whatsappNumber: json['whatsapp_number']?.toString(),
      parentUserId: json['parent_user_id']?.toString(),
      maxAgents: (json['max_agents'] as num?)?.toInt() ?? 0,
      agentBalance: (json['agent_balance'] as num?)?.toDouble() ?? 0,
      agentDebt: (json['agent_debt'] as num?)?.toDouble() ?? 0,
      currency: json['currency']?.toString() ?? 'USD',
      usdToSypRate: (json['usd_to_syp_rate'] as num?)?.toDouble() ?? 1,
      themeMode: json['theme_mode']?.toString() ?? 'system',
      themeColor: json['theme_color']?.toString() ?? 'blue',
      language: json['language']?.toString() ?? 'ar',
      accountingEnabled: json['accounting_enabled'] as bool? ?? false,
    );
  }
}

Future<void> loadUsers() async {
  final supabase = Supabase.instance.client;

  final data = await supabase.from('app_users').select().order('created_at');

  users.clear();

  for (final item in data) {
    users.add(AppUser.fromJson(Map<String, dynamic>.from(item)));
  }
}

Future<void> saveSubscriptions() async {
  final supabase = Supabase.instance.client;

  for (final sub in subscriptions) {
    final data = sub.toJson();

    if (sub.id.isEmpty) {
      final inserted = await supabase
          .from('subscriptions')
          .insert(data)
          .select()
          .single();

      sub.id = inserted['id']?.toString() ?? '';
      sub.createdAt = inserted['created_at'] != null
          ? DateTime.tryParse(inserted['created_at'].toString())
          : null;
    } else {
      await supabase.from('subscriptions').update(data).eq('id', sub.id);
    }
  }
}

Future<void> loadSubscriptions() async {
  final supabase = Supabase.instance.client;

  final data = await supabase
      .from('subscriptions')
      .select()
      .order('created_at');

  subscriptions.clear();

  for (final item in data) {
    final subscription = Subscription.fromJson(Map<String, dynamic>.from(item));

    print(
      'SUBSCRIPTION: id=${subscription.id}, '
      'user=${subscription.userId}, '
      'status=${subscription.status}, '
      'amount=${subscription.amount}',
    );

    subscriptions.add(subscription);
  }
}

