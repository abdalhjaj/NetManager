                            if (message.contains('duplicate') ||
                                message.contains('23505')) {
                              message = 'اسم المستخدم مستخدم مسبقًا';
                            }

                            ScaffoldMessenger.of(dialogContext).showSnackBar(
                              SnackBar(
                                content: Text(
                                  'تعذر تعديل معلومات الوكيل: $message',
