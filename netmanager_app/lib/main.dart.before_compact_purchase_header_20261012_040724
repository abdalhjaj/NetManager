  Future<void> showAddAgentDialog(String ownerUserId) async {
    AppUser? owner;

    for (final user in users) {
      if (user.id == ownerUserId) {
        owner = user;
        break;
      }
    }

    if (owner == null) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('تعذر العثور على المستخدم المسؤول عن الوكيل'),
          backgroundColor: Colors.red,
        ),
      );
      return;
    }

    final currentAgentCount = users
        .where(
          (user) => user.role == 'وكيل' && user.parentUserId == ownerUserId,
        )
        .length;

    final ownerIsManager = owner.role == 'مدير';

    // الحد الأقصى يطبق على المستخدم العادي فقط.
    // المدير يستطيع إنشاء وكلاء لنفسه دون حد.
    if (!ownerIsManager) {
      if (owner.maxAgents <= 0) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text('لم يسمح المدير بإضافة وكلاء لهذا المستخدم'),
            backgroundColor: Colors.orange,
          ),
        );
        return;
      }

      if (currentAgentCount >= owner.maxAgents) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text(
              'تم الوصول إلى الحد الأقصى للوكلاء '
              '(${owner.maxAgents})',
            ),
            backgroundColor: Colors.orange,
          ),
        );
        return;
      }
    }

    final nameController = TextEditingController();
    final usernameController = TextEditingController();
    final passwordController = TextEditingController();
    final whatsappController = TextEditingController();

    var saving = false;
    var hidePassword = true;

    // افتراضيًا نستخدم عملة صاحب الوكيل.
    var agentCurrency = owner.currency == 'SYP' ? 'SYP' : 'USD';

    final saved = await showDialog<bool>(
      context: context,
      barrierDismissible: false,
      builder: (dialogContext) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            return AlertDialog(
              title: const Row(
                children: [
                  Icon(Icons.person_add_alt_1),
                  SizedBox(width: 10),
                  Text('إضافة وكيل'),
                ],
              ),
              content: SizedBox(
                width: 480,
                child: SingleChildScrollView(
                  child: Column(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      Container(
                        width: double.infinity,
                        padding: const EdgeInsets.all(12),
                        decoration: BoxDecoration(
                          color: Theme.of(context).colorScheme.primaryContainer
                              .withValues(alpha: 0.45),
                          borderRadius: BorderRadius.circular(10),
                        ),
                        child: Text(
                          ownerIsManager
                              ? 'المسؤول: ${owner!.name}\n'
                                    'عدد وكلائك الحالي: $currentAgentCount'
                              : 'المسؤول: ${owner!.name}\n'
                                    'الوكلاء: $currentAgentCount / ${owner.maxAgents}',
                          style: const TextStyle(fontWeight: FontWeight.bold),
                        ),
                      ),

                      const SizedBox(height: 16),

                      TextField(
                        controller: nameController,
                        decoration: const InputDecoration(
                          labelText: 'اسم الوكيل',
                          prefixIcon: Icon(Icons.badge_outlined),
                          border: OutlineInputBorder(),
                        ),
                      ),

                      const SizedBox(height: 12),

                      TextField(
                        controller: usernameController,
                        decoration: const InputDecoration(
                          labelText: 'اسم المستخدم',
                          prefixIcon: Icon(Icons.person_outline),
                          border: OutlineInputBorder(),
                        ),
                      ),

                      const SizedBox(height: 12),

                      TextField(
                        controller: passwordController,
                        obscureText: hidePassword,
                        decoration: InputDecoration(
                          labelText: 'كلمة المرور',
                          prefixIcon: const Icon(Icons.lock_outline),
                          border: const OutlineInputBorder(),
                          suffixIcon: IconButton(
                            onPressed: () {
                              setDialogState(() {
                                hidePassword = !hidePassword;
