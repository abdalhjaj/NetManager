  Future<void> openNewAccountingSale() async {
    final isArabic = widget.currentUser.language == 'ar';

    try {
      final data = await Supabase.instance.client
          .from('accounting_customers')
          .select()
          .eq('created_by', widget.currentUser.id)
          .eq('active', true)
          .order('name');

      if (!mounted) return;

      final customers = List<Map<String, dynamic>>.from(data);

      final searchController = TextEditingController();

      String? customerId;

      final selectedCustomerId = await showDialog<String>(
        context: context,
        builder: (dialogContext) {
          return StatefulBuilder(
            builder: (context, setDialogState) {
              final search = searchController.text.trim().toLowerCase();

              final filteredCustomers = customers.where((customer) {
                final name = customer['name']?.toString().toLowerCase() ?? '';

                return search.isEmpty || name.contains(search);
              }).toList();

              final exactExists = customers.any((customer) {
                final name =
                    customer['name']?.toString().trim().toLowerCase() ?? '';

                return search.isNotEmpty && name == search;
              });

              return AlertDialog(
                title: Text(
                  isArabic ? 'فاتورة مبيعات جديدة' : 'New Sales Invoice',
                ),
                content: SizedBox(
                  width: 500,
                  child: Column(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      TextField(
                        controller: searchController,
                        autofocus: true,
                        decoration: InputDecoration(
                          labelText: isArabic ? 'اسم الزبون' : 'Customer name',
                          hintText: isArabic
                              ? 'اكتب اسم الزبون للبحث'
                              : 'Type customer name to search',
                          prefixIcon: const Icon(Icons.search),
                          border: const OutlineInputBorder(),
                        ),
                        onChanged: (_) {
                          setDialogState(() {
                            customerId = null;
                          });
                        },
                      ),
                      const SizedBox(height: 12),

                      if (filteredCustomers.isNotEmpty)
                        ConstrainedBox(
                          constraints: const BoxConstraints(maxHeight: 220),
                          child: ListView.builder(
                            shrinkWrap: true,
                            itemCount: filteredCustomers.length,
                            itemBuilder: (context, index) {
                              final customer = filteredCustomers[index];

                              final id = customer['id'].toString();

                              final selected = customerId == id;

                              return ListTile(
                                selected: selected,
                                leading: Icon(
                                  selected
                                      ? Icons.check_circle
                                      : Icons.person_outline,
                                ),
                                title: Text(
                                  customer['name']?.toString() ?? '-',
                                ),
                                subtitle:
                                    customer['phone'] == null ||
                                        customer['phone'].toString().isEmpty
                                    ? null
                                    : Text(customer['phone'].toString()),
                                onTap: () {
                                  setDialogState(() {
                                    customerId = id;
                                    searchController.text =
                                        customer['name']?.toString() ?? '';
                                    searchController
                                        .selection = TextSelection.fromPosition(
                                      TextPosition(
                                        offset: searchController.text.length,
                                      ),
                                    );
                                  });
                                },
                              );
                            },
                          ),
                        ),

                      if (search.isNotEmpty && !exactExists) ...[
                        const SizedBox(height: 8),
                        ListTile(
                          leading: const Icon(Icons.person_add),
                          title: Text(
                            isArabic
                                ? 'إضافة "${searchController.text.trim()}" كزبون جديد'
                                : 'Add "${searchController.text.trim()}" as a new customer',
                          ),
                          onTap: () {
                            Navigator.pop(dialogContext, '__ADD_NEW__');
                          },
                        ),
                      ],

                      if (customers.isEmpty && search.isEmpty)
                        Padding(
                          padding: const EdgeInsets.all(12),
                          child: Text(
                            isArabic
                                ? 'اكتب اسم الزبون لإضافته'
                                : 'Type a customer name to add it',
                          ),
                        ),
                    ],
                  ),
                ),
                actions: [
                  TextButton(
                    onPressed: () {
                      Navigator.pop(dialogContext);
                    },
                    child: Text(isArabic ? 'إلغاء' : 'Cancel'),
                  ),
                  FilledButton(
                    onPressed: customerId == null
                        ? null
                        : () {
                            Navigator.pop(dialogContext, customerId);
                          },
                    child: Text(isArabic ? 'متابعة' : 'Continue'),
                  ),
                ],
              );
            },
          );
        },
      );

      final typedName = searchController.text.trim();
      searchController.dispose();

      if (!mounted || selectedCustomerId == null) {
        return;
      }

      if (selectedCustomerId == '__ADD_NEW__') {
        final newCustomer = await addAccountingCustomer(initialName: typedName);

        if (!mounted || newCustomer == null) return;

        final newCustomerId = newCustomer['id']?.toString();

        if (newCustomerId == null || newCustomerId.isEmpty) {
          return;
        }

        await openAccountingSaleProducts(newCustomerId);

        return;
      }

      await openAccountingSaleProducts(selectedCustomerId);
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            isArabic
                ? 'تعذر تحميل الزبائن: $e'
                : 'Unable to load customers: $e',
          ),
        ),
      );
    }
  }

  Widget buildAccountingSales() {
    final isArabic = widget.currentUser.language == 'ar';
    final colorScheme = Theme.of(context).colorScheme;

    String customerNameForSale(Map<String, dynamic> sale) {
      final loadedName = sale['_customer_name']?.toString() ?? '';

      if (loadedName.isNotEmpty) {
        return loadedName;
      }

      final customerId = sale['customer_id']?.toString();

      for (final customer in accountingCustomers) {
        if (customer['id']?.toString() == customerId) {
          return customer['name']?.toString() ??
              (isArabic ? 'بدون اسم' : 'No name');
        }
      }

      return isArabic ? 'عميل غير معروف' : 'Unknown customer';
    }

    String formatInvoiceDate(dynamic value) {
      if (value == null) return '-';

      final date = DateTime.tryParse(value.toString());

      if (date == null) return value.toString();

      return '${date.day.toString().padLeft(2, '0')}/'
          '${date.month.toString().padLeft(2, '0')}/'
          '${date.year}';
    }

