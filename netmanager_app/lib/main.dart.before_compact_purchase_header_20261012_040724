                              'التسديد يخفض دين الوكيل ولا يغير رصيده، ويعتبر مبلغًا نقديًا مستلمًا.',
                              style: TextStyle(fontSize: 13),
                            ),
                          ),
                        ],
                      ),
                    ),
                  ],
                ),
              ),
              actions: [
                TextButton(
                  onPressed: saving
                      ? null
                      : () => Navigator.pop(dialogContext, false),
                  child: const Text('إلغاء'),
                ),
                FilledButton.icon(
                  onPressed: saving
                      ? null
                      : () async {
                          final amount = double.tryParse(
                            amountController.text.trim().replaceAll(',', '.'),
                          );

                          if (amount == null || amount <= 0) {
                            ScaffoldMessenger.of(dialogContext).showSnackBar(
                              const SnackBar(
                                content: Text(
                                  'يرجى إدخال مبلغ صحيح أكبر من صفر',
                                ),
                                backgroundColor: Colors.orange,
                              ),
                            );
                            return;
                          }

                          if (amount > currentDebt + 0.000001) {
                            ScaffoldMessenger.of(dialogContext).showSnackBar(
                              SnackBar(
                                content: Text(
                                  'المبلغ أكبر من الدين المستحق (${_agentDebtText(agent)})',
                                ),
                                backgroundColor: Colors.orange,
                              ),
                            );
                            return;
                          }

                          setDialogState(() {
                            saving = true;
                          });

                          try {
                            final supabase = Supabase.instance.client;

                            await supabase.rpc(
                              'pay_agent_debt',
                              params: {
                                'p_agent_id': agent.id,
                                'p_created_by': widget.currentUser.id,
                                'p_amount': amount,
                                'p_currency': currency,
                                'p_description':
                                    descriptionController.text.trim().isEmpty
                                    ? null
                                    : descriptionController.text.trim(),
                              },
                            );

                            // تحديث المستخدمين بعد تسديد الدين.
                            await loadUsers();

                            // مهم:
                            // إعادة تحميل سجل حركات الوكلاء فورًا لأن لوحة
                            // التحكم تعتمد عليه في:
                            // 1- إجمالي التحصيل النقدي
                            // 2- صافي الصندوق
                            // 3- تحصيل اليوم والشهر
                            // 4- آخر العمليات
                            await loadAgentBalanceTransactionHistory();

                            for (final user in users) {
                              if (user.id == agent.id) {
                                agent.agentBalance = user.agentBalance;
                                agent.agentDebt = user.agentDebt;
                                agent.active = user.active;
                                agent.currency = user.currency;
                                agent.usdToSypRate = user.usdToSypRate;
                                break;
                              }
                            }

                            if (!dialogContext.mounted) return;

                            Navigator.pop(dialogContext, true);
                          } catch (e) {
                            if (!dialogContext.mounted) return;

                            setDialogState(() {
                              saving = false;
                            });

                            var message = e.toString();

                            if (message.contains(
                              'PAYMENT_EXCEEDS_AGENT_DEBT',
                            )) {
                              message = 'المبلغ أكبر من الدين المتبقي';
                            } else if (message.contains('NO_AGENT_DEBT')) {
                              message = 'لا يوجد دين مستحق على الوكيل';
                            }

                            ScaffoldMessenger.of(dialogContext).showSnackBar(
                              SnackBar(
                                content: Text('تعذر تسديد الدين: $message'),
                                backgroundColor: Colors.red,
                              ),
                            );
                          }
                        },
                  icon: saving
                      ? const SizedBox(
                          width: 18,
                          height: 18,
                          child: CircularProgressIndicator(strokeWidth: 2),
                        )
                      : const Icon(Icons.check_circle_outline),
                  label: Text(saving ? 'جاري التسديد...' : 'تأكيد التسديد'),
                ),
              ],
            );
          },
        );
      },
    );

    amountController.dispose();
    descriptionController.dispose();

    if (saved != true) {
      return false;
    }

    if (mounted) {
      setState(() {});

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('تم تسديد دين الوكيل بنجاح ✓'),
          backgroundColor: Colors.green,
        ),
      );
    }

    return true;
  }

