    // ========================================================
    // Universal Template Engine
    // ========================================================
    if (designType == 'universal') {
      final pattern = backgroundConfig?['pattern']?.toString() ?? 'waves';

      final decoration = backgroundConfig?['decoration']?.toString() ?? pattern;

      final variant =
          int.tryParse(backgroundConfig?['variant']?.toString() ?? '') ?? 1;

      final cycle =
          int.tryParse(backgroundConfig?['cycle']?.toString() ?? '') ?? 0;

      Widget circleDecoration({
        required double left,
        required double top,
        required double size,
        required Color color,
        double opacity = 0.18,
      }) {
        return Positioned(
          left: left,
          top: top,
          child: Container(
            width: size,
            height: size,
            decoration: BoxDecoration(
              shape: BoxShape.circle,
              color: color.withValues(alpha: opacity),
            ),
          ),
        );
      }

      Widget lineDecoration({
        required double left,
        required double top,
        required double width,
        required double height,
        required double angle,
        required Color color,
      }) {
        return Positioned(
          left: left,
          top: top,
          child: Transform.rotate(
            angle: angle,
            child: Container(
              width: width,
              height: height,
              decoration: BoxDecoration(
                color: color.withValues(alpha: 0.18),
                borderRadius: BorderRadius.circular(height),
              ),
            ),
          ),
        );
      }

      List<Widget> decorationsFor(BoxConstraints constraints) {
        final w = constraints.maxWidth;
        final h = constraints.maxHeight;

        switch (decoration) {
          case 'diamonds':
          case 'geometric':
            return [
              Positioned(
                right: -w * 0.08,
                top: -h * 0.20,
                child: Transform.rotate(
                  angle: 0.65,
                  child: Container(
                    width: w * 0.36,
                    height: w * 0.36,
                    decoration: BoxDecoration(
                      color: secondary.withValues(alpha: 0.22),
                      borderRadius: BorderRadius.circular(24),
                    ),
                  ),
                ),
              ),
              Positioned(
                left: w * 0.08,
                bottom: -h * 0.22,
                child: Transform.rotate(
                  angle: 0.65,
                  child: Container(
                    width: w * 0.30,
                    height: w * 0.30,
                    decoration: BoxDecoration(
                      border: Border.all(
                        color: foreground.withValues(alpha: 0.20),
                        width: 3,
                      ),
                      borderRadius: BorderRadius.circular(20),
                    ),
                  ),
                ),
              ),
            ];

          case 'circles':
          case 'bubbles':
          case 'orbs':
            return [
              circleDecoration(
                left: -w * 0.08,
                top: -h * 0.12,
                size: w * 0.34,
                color: secondary,
                opacity: 0.25,
              ),
              circleDecoration(
                left: w * 0.72,
                top: h * 0.12,
                size: w * 0.22,
                color: foreground,
                opacity: 0.10,
              ),
              circleDecoration(
                left: w * 0.62,
                top: h * 0.68,
                size: w * 0.42,
                color: secondary,
                opacity: 0.18,
              ),
            ];

          case 'network':
          case 'grid':
            return [
              for (var i = 0; i < 6; i++)
                Positioned(
                  left: w * (0.06 + i * 0.16),
                  top: h * (0.14 + (i % 3) * 0.22),
                  child: Container(
                    width: 7,
                    height: 7,
                    decoration: BoxDecoration(
                      color: secondary.withValues(alpha: 0.65),
                      shape: BoxShape.circle,
                      boxShadow: [
                        BoxShadow(
                          color: secondary.withValues(alpha: 0.25),
                          blurRadius: 12,
                          spreadRadius: 4,
                        ),
                      ],
                    ),
                  ),
                ),
              lineDecoration(
                left: w * 0.05,
                top: h * 0.32,
                width: w * 0.78,
                height: 2,
                angle: -0.15,
                color: secondary,
              ),
              lineDecoration(
                left: w * 0.20,
                top: h * 0.62,
                width: w * 0.72,
                height: 2,
                angle: 0.12,
                color: secondary,
              ),
            ];

          case 'lines':
            return [
              lineDecoration(
                left: -w * 0.08,
                top: h * 0.16,
                width: w * 0.70,
                height: 8,
                angle: -0.25,
                color: secondary,
              ),
              lineDecoration(
                left: w * 0.38,
                top: h * 0.68,
                width: w * 0.70,
                height: 5,
                angle: -0.25,
                color: secondary,
              ),
              circleDecoration(
                left: w * 0.78,
                top: -h * 0.10,
                size: w * 0.26,
                color: secondary,
                opacity: 0.15,
              ),
            ];

          case 'curves':
          case 'waves':
            return [
              Positioned(
                left: -w * 0.20,
                bottom: -h * 0.34,
                child: Container(
                  width: w * 1.25,
                  height: h * 0.58,
                  decoration: BoxDecoration(
                    color: secondary.withValues(alpha: 0.20),
                    borderRadius: BorderRadius.circular(w),
                  ),
                ),
              ),
              Positioned(
                right: -w * 0.34,
                top: -h * 0.30,
                child: Container(
                  width: w * 0.82,
                  height: h * 0.54,
                  decoration: BoxDecoration(
                    color: foreground.withValues(alpha: 0.08),
                    borderRadius: BorderRadius.circular(w),
                  ),
                ),
              ),
            ];

          case 'neon':
            return [
              Positioned(
                left: w * 0.04,
                top: h * 0.08,
                child: Container(
                  width: w * 0.90,
                  height: h * 0.82,
                  decoration: BoxDecoration(
                    borderRadius: BorderRadius.circular(20),
                    border: Border.all(
                      color: secondary.withValues(alpha: 0.55),
                      width: 2,
                    ),
                    boxShadow: [
                      BoxShadow(
                        color: secondary.withValues(alpha: 0.20),
                        blurRadius: 18,
                      ),
                    ],
                  ),
                ),
              ),
              circleDecoration(
                left: w * 0.72,
                top: h * 0.12,
                size: w * 0.18,
                color: secondary,
                opacity: 0.22,
              ),
            ];

          case 'soft':
            return [
              circleDecoration(
                left: -w * 0.10,
                top: -h * 0.20,
                size: w * 0.46,
                color: secondary,
                opacity: 0.12,
              ),
              circleDecoration(
                left: w * 0.68,
                top: h * 0.62,
                size: w * 0.40,
                color: secondary,
                opacity: 0.10,
              ),
            ];

          case 'abstract':
          default:
            return [
              circleDecoration(
                left: -w * 0.12,
                top: h * 0.52,
                size: w * 0.42,
                color: secondary,
                opacity: 0.22,
              ),
              lineDecoration(
                left: w * 0.45,
                top: h * 0.18,
                width: w * 0.62,
                height: 16,
                angle: -0.42,
                color: secondary,
              ),
            ];
        }
      }

      return Container(
        clipBehavior: Clip.hardEdge,
        decoration: BoxDecoration(
          borderRadius: BorderRadius.circular(22),
          gradient: LinearGradient(
            begin: variant.isEven ? Alignment.topLeft : Alignment.topRight,
            end: variant.isEven ? Alignment.bottomRight : Alignment.bottomLeft,
            colors: [
              primary,
              Color.lerp(secondary, primary, (cycle % 4) * 0.08) ?? secondary,
            ],
          ),
          border: pattern == 'premium' || pattern == 'neon'
              ? Border.all(color: secondary.withValues(alpha: 0.70), width: 2)
              : null,
        ),
        child: LayoutBuilder(
          builder: (context, constraints) {
            Widget positionedText({
              required String element,
              required String value,
              required double defaultX,
              required double defaultY,
              required double defaultSize,
              double minSize = 0.025,
              double maxSize = 0.12,
              FontWeight weight = FontWeight.w900,
              bool shadow = true,
            }) {
              final x = layoutValue(element, 'x', defaultX);
              final y = layoutValue(element, 'y', defaultY);
              final size = layoutValue(
                element,
                'size',
                defaultSize,
              ).clamp(minSize, maxSize);

              return Positioned(
                left: x * constraints.maxWidth,
                top: y * constraints.maxHeight,
                child: Container(
                  constraints: BoxConstraints(
                    maxWidth: constraints.maxWidth * 0.72,
                  ),
                  child: Text(
                    value,
                    maxLines: 1,
                    overflow: TextOverflow.ellipsis,
                    style: TextStyle(
                      color: foreground,
                      fontSize: size * constraints.maxWidth,
                      fontWeight: weight,
                      shadows: shadow
                          ? const [Shadow(color: Colors.black38, blurRadius: 4)]
                          : null,
                    ),
                  ),
                ),
              );
            }

            return Stack(
              fit: StackFit.expand,
              children: [
                ...decorationsFor(constraints),

                // اسم القالب يبقى جزءًا من النموذج.
                if (showCompanyName)
                  positionedText(
                    element: 'company',
                    value: companyName,
                    defaultX: 0.20,
                    defaultY: 0.08,
                    defaultSize: 0.05,
                  ),

                positionedText(
                  element: 'username',
                  value: 'اسم المستخدم: $username',
                  defaultX: 0.55,
                  defaultY: 0.43,
                  defaultSize: 0.045,
                ),

                positionedText(
                  element: 'password',
                  value: 'كلمة المرور: $password',
                  defaultX: 0.55,
                  defaultY: 0.52,
                  defaultSize: 0.045,
                ),

                if (showProfile)
                  positionedText(
                    element: 'profile',
                    value: 'الباقة: $profile',
                    defaultX: 0.08,
                    defaultY: 0.68,
                    defaultSize: 0.04,
                  ),

                if (showDuration)
                  positionedText(
                    element: 'duration',
                    value: 'المدة: $durationText',
                    defaultX: 0.40,
                    defaultY: 0.68,
                    defaultSize: 0.04,
                  ),

                if (showPrice)
                  positionedText(
                    element: 'price',
                    value: 'السعر: $priceText',
                    defaultX: 0.68,
                    defaultY: 0.68,
                    defaultSize: 0.04,
                  ),

                if ((footerText?.trim() ?? '').isNotEmpty)
                  positionedText(
                    element: 'footer',
                    value: footerText!.trim(),
                    defaultX: 0.20,
                    defaultY: 0.90,
                    defaultSize: 0.03,
                    minSize: 0.018,
                    maxSize: 0.10,
                    weight: FontWeight.w600,
                  ),

                if (showQr)
                  Positioned(
                    left: layoutValue('qr', 'x', 0.76) * constraints.maxWidth,
                    top: layoutValue('qr', 'y', 0.72) * constraints.maxHeight,
                    child: Container(
                      width:
                          layoutValue('qr', 'size', 0.16).clamp(0.08, 0.35) *
                          constraints.maxWidth,
                      height:
                          layoutValue('qr', 'size', 0.16).clamp(0.08, 0.35) *
                          constraints.maxWidth,
                      padding: const EdgeInsets.all(3),
                      decoration: BoxDecoration(
                        color: Colors.white,
                        borderRadius: BorderRadius.circular(5),
                      ),
                      child: const FittedBox(
                        child: Icon(
                          Icons.qr_code_2_rounded,
                          color: Colors.black,
                        ),
                      ),
                    ),
                  ),

                Positioned(
                  left: layoutValue('logo', 'x', 0.06) * constraints.maxWidth,
                  top: layoutValue('logo', 'y', 0.07) * constraints.maxHeight,
                  child: logoWidget(
                    size:
                        layoutValue('logo', 'size', 0.14).clamp(0.08, 0.35) *
                        constraints.maxWidth,
                  ),
                ),
              ],
            );
          },
        ),
      );
    }

    // ========================================================
    // 01 - Classic
    // ========================================================
    if (designType == 'classic') {
      final hasCustomLayout = layoutConfig != null && layoutConfig.isNotEmpty;

      final classicBase = Container(
        decoration: BoxDecoration(
          color: Colors.white,
          borderRadius: BorderRadius.circular(22),
          border: Border.all(color: primary.withValues(alpha: 0.35)),
        ),
        child: Column(
          children: [
            Container(
              padding: const EdgeInsets.symmetric(horizontal: 18, vertical: 14),
              decoration: BoxDecoration(
                color: primary,
                borderRadius: const BorderRadius.vertical(
                  top: Radius.circular(21),
                ),
              ),
              child: hasCustomLayout
                  ? const SizedBox(height: 28)
                  : companyHeader(color: primaryText),
            ),
            Expanded(
              child: Padding(
                padding: const EdgeInsets.all(17),
                child: Column(
                  children: [
                    Text(
                      packageName,
                      style: TextStyle(
                        color: primary,
                        fontSize: 21,
                        fontWeight: FontWeight.w900,
                      ),
                    ),
                    const Spacer(),
                    if (!hasCustomLayout) loginBox(),
                    const Spacer(),
                    if (!hasCustomLayout) information(color: primary),
                    const SizedBox(height: 6),
                    if (!hasCustomLayout) footer(primary),
                  ],
                ),
              ),
            ),
          ],
