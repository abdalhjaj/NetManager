      final transactionType = transaction['transaction_type']?.toString() ?? '';

      if (transactionType != 'deposit') {
        continue;
      }

      final accountType =
          transaction['account_type']?.toString().toLowerCase() ?? '';

      if (accountType != 'broadband' && accountType != 'hotspot') {
        continue;
      }

      recentPayments.add({
        ...transaction,

        // توحيد أسماء الحقول مع واجهة آخر العمليات.
        'amount': (transaction['amount_usd'] as num?)?.toDouble() ?? 0,

        'currency': 'USD',
        'discount': 0,
        'payment_type': 'deposit',

        // account_id موجود أصلًا في سجل المحفظة.
        'account_id': transaction['account_id'],

        // user_id تحتاجه الواجهة لمعرفة صاحب الحساب.
        'user_id': transaction['owner_user_id'],

        '_type': accountType == 'broadband' ? 'Broadband' : 'Hotspot',

        '_is_wallet_deposit': true,
