  String _agentBalanceText(AppUser agent) {
    final currency = agent.currency == 'SYP' ? 'SYP' : 'USD';

    if (currency == 'SYP') {
      final rate = agent.usdToSypRate > 0 ? agent.usdToSypRate : 1;
      final amount = agent.agentBalance * rate;
      return '${amount.toStringAsFixed(0)} SYP';
    }

    return '${agent.agentBalance.toStringAsFixed(2)} USD';
  }

  String _agentDebtText(AppUser agent) {
    final currency = agent.currency == 'SYP' ? 'SYP' : 'USD';

    if (currency == 'SYP') {
      final rate = agent.usdToSypRate > 0 ? agent.usdToSypRate : 1;
      final amount = agent.agentDebt * rate;
      return '${amount.toStringAsFixed(0)} SYP';
    }

    return '${agent.agentDebt.toStringAsFixed(2)} USD';
  }

