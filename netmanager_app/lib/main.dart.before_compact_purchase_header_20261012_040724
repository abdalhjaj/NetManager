                          if (priceInput < 0) {
                            ScaffoldMessenger.of(context).showSnackBar(
                              const SnackBar(
                                content: Text('سعر البطاقة غير صحيح'),
                                backgroundColor: Colors.red,
                              ),
                            );
                            return;
