  Widget buildAccountingPurchases() {
    final isArabic = widget.currentUser.language == 'ar';
    final colorScheme = Theme.of(context).colorScheme;

    String formatPurchaseDate(dynamic value) {
      if (value == null) return '-';

      final date = DateTime.tryParse(value.toString());

      if (date == null) return value.toString();

      return '${date.day.toString().padLeft(2, '0')}/'
          '${date.month.toString().padLeft(2, '0')}/'
          '${date.year}';
    }

    Widget moneyCell({
      required double usd,
      required double syp,
      bool emphasize = false,
    }) {
      final style = TextStyle(
        fontSize: emphasize ? 14 : 13,
        fontWeight: emphasize ? FontWeight.w600 : FontWeight.w500,
      );

      return Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          Text('${usd.toStringAsFixed(2)} USD', style: style),
          const SizedBox(height: 3),
          Text(
            '${syp.toStringAsFixed(0)} SYP',
            style: style.copyWith(
              fontSize: emphasize ? 13 : 12,
              color: colorScheme.onSurfaceVariant,
            ),
          ),
        ],
      );
    }

    Widget headerCell(String text, {int flex = 1}) {
      return Expanded(
        flex: flex,
