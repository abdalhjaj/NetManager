  Future<void> loadAccountingSales() async {
    if (accountingSalesLoading) return;

    setState(() {
      accountingSalesLoading = true;
    });

    try {
      final salesData = await Supabase.instance.client
          .from('accounting_sales')
          .select()
          .eq('created_by', widget.currentUser.id)
          .order('invoice_number', ascending: false);

      final customersData = await Supabase.instance.client
          .from('accounting_customers')
          .select();

      final transactionsData = await Supabase.instance.client
          .from('accounting_transactions')
          .select()
          .eq('created_by', widget.currentUser.id);

      final sales = List<Map<String, dynamic>>.from(salesData);
      final customers = List<Map<String, dynamic>>.from(customersData);
      final transactions = List<Map<String, dynamic>>.from(transactionsData);

      final customersById = <String, Map<String, dynamic>>{};

      for (final customer in customers) {
        final id = customer['id']?.toString();

        if (id != null && id.isNotEmpty) {
          customersById[id] = customer;
        }
      }

      for (final sale in sales) {
        final customerId = sale['customer_id']?.toString() ?? '';
        final customer = customersById[customerId];

        sale['_customer_name'] = customer?['name']?.toString() ?? '';

        double previousUsd = 0;
        double previousSyp = 0;

        // الرصيد الافتتاحي للعميل.
        final openingBalance =
            (customer?['opening_balance'] as num?)?.toDouble() ?? 0;

        final customerCurrency = customer?['currency']?.toString() ?? 'USD';

        if (customerCurrency == 'SYP') {
          previousSyp += openingBalance;
        } else {
          previousUsd += openingBalance;
        }

        final currentInvoiceNumber =
            (sale['invoice_number'] as num?)?.toInt() ?? 0;

        // إضافة أرصدة الفواتير السابقة فقط.
        for (final oldSale in sales) {
          if (oldSale['customer_id']?.toString() != customerId) {
            continue;
          }

          if (oldSale['status']?.toString() == 'cancelled') {
            continue;
          }

          final oldInvoiceNumber =
              (oldSale['invoice_number'] as num?)?.toInt() ?? 0;

          if (oldInvoiceNumber >= currentInvoiceNumber) {
            continue;
          }

          final totalUsd = (oldSale['total_usd'] as num?)?.toDouble() ?? 0;

          final totalSyp = (oldSale['total_syp'] as num?)?.toDouble() ?? 0;

          final paidUsd = (oldSale['paid_usd'] as num?)?.toDouble() ?? 0;

          final paidSyp = (oldSale['paid_syp'] as num?)?.toDouble() ?? 0;

          previousUsd += totalUsd - paidUsd;
          previousSyp += totalSyp - paidSyp;
        }

        // إضافة الحركات التي تمت قبل تاريخ الفاتورة.
        final invoiceDate = DateTime.tryParse(
          sale['invoice_date']?.toString() ?? '',
        );

        for (final transaction in transactions) {
          if (transaction['customer_id']?.toString() != customerId) {
            continue;
          }

          final transactionDate = DateTime.tryParse(
            transaction['transaction_date']?.toString() ?? '',
          );

          if (invoiceDate != null &&
              transactionDate != null &&
              !transactionDate.isBefore(invoiceDate)) {
            continue;
          }

          final amount = (transaction['amount'] as num?)?.toDouble() ?? 0;

          final type = transaction['transaction_type']?.toString() ?? '';

          if (customerCurrency == 'SYP') {
            if (type == 'customer_receipt') {
              previousSyp -= amount;
            } else if (type == 'customer_payment') {
              previousSyp += amount;
            }
          } else {
            if (type == 'customer_receipt') {
              previousUsd -= amount;
            } else if (type == 'customer_payment') {
              previousUsd += amount;
            }
          }
        }

        sale['_previous_balance_usd'] = previousUsd;
        sale['_previous_balance_syp'] = previousSyp;
      }

      if (!mounted) return;

      setState(() {
        accountingCustomers = customers;
        accountingSales = sales;
      });
    } catch (e) {
      debugPrint('LOAD ACCOUNTING SALES ERROR: $e');
    } finally {
      if (mounted) {
        setState(() {
          accountingSalesLoading = false;
        });
      }
    }
  }

