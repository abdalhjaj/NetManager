                        ) ??
                        0;

                    if (discountPercent < 0) {
                      discountPercent = 0;
                    }

                    if (discountPercent > 100) {
                      discountPercent = 100;
                    }

                    final unitCost =
                        (product['purchase_price'] as num?)?.toDouble() ?? 0;

                    final currency = row['priceCurrency']?.toString() ?? 'USD';

                    itemRows.add({
                      'sale_id': saleId,
                      'product_id': product['id'],
                      'quantity': quantity,
                      'unit_price': unitPrice,
                      'unit_cost': unitCost,
                      'discount': discountPercent,
                      'total': rowTotal(row),
                      'currency': currency,
                    });
                  }

                  await Supabase.instance.client
                      .from('accounting_sale_items')
                      .insert(itemRows);

                  // المرحلة الأولى:
                  // عند إنشاء فاتورة جديدة فقط، نخصم الكميات من المخزون
                  // ونسجل حركة sale مرتبطة بمعرّف الفاتورة.
