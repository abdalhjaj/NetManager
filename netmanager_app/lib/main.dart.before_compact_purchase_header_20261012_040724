              children: [
                Text(
                  'المستخدم: ${owner.name}',
                  style: const TextStyle(fontWeight: FontWeight.bold),
                ),
                const SizedBox(height: 6),
                Text('الحد الحالي: ${owner.maxAgents}'),
                const SizedBox(height: 16),
                TextField(
                  controller: controller,
                  autofocus: true,
                  keyboardType: TextInputType.number,
                  decoration: const InputDecoration(
                    labelText: 'الحد الأقصى للوكلاء',
                    prefixIcon: Icon(Icons.groups_outlined),
                    border: OutlineInputBorder(),
                    helperText: 'أدخل 0 لمنع إضافة وكلاء جدد',
                  ),
                ),
              ],
            ),
          ),
          actions: [
            TextButton(
              onPressed: () => Navigator.pop(dialogContext, false),
              child: const Text('إلغاء'),
            ),
            FilledButton.icon(
              onPressed: () async {
                final value = int.tryParse(controller.text.trim());

                if (value == null || value < 0) {
                  ScaffoldMessenger.of(dialogContext).showSnackBar(
                    const SnackBar(
                      content: Text('يرجى إدخال عدد صحيح يساوي 0 أو أكبر'),
                      backgroundColor: Colors.orange,
                    ),
                  );
                  return;
                }

                // لا نسمح بتخفيض الحد لأقل من عدد الوكلاء الموجودين.
                final existingAgents = users
                    .where(
                      (user) =>
                          user.role == 'وكيل' && user.parentUserId == owner.id,
                    )
                    .length;

                if (value < existingAgents) {
                  ScaffoldMessenger.of(dialogContext).showSnackBar(
                    SnackBar(
                      content: Text(
                        'لا يمكن جعل الحد $value لأن المستخدم لديه '
                        '$existingAgents وكيل حاليًا',
                      ),
                      backgroundColor: Colors.orange,
                    ),
                  );
                  return;
                }

                try {
                  final supabase = Supabase.instance.client;

                  await supabase
                      .from('app_users')
                      .update({'max_agents': value})
                      .eq('id', owner.id);

                  if (!dialogContext.mounted) return;

                  Navigator.pop(dialogContext, true);
                } catch (e) {
                  if (!dialogContext.mounted) return;

                  ScaffoldMessenger.of(dialogContext).showSnackBar(
                    SnackBar(
                      content: Text('تعذر تحديث عدد الوكلاء: $e'),
                      backgroundColor: Colors.red,
                    ),
                  );
                }
              },
              icon: const Icon(Icons.save_outlined),
              label: const Text('حفظ'),
            ),
          ],
        );
      },
    );

    controller.dispose();

    if (saved != true) return;

    await loadUsers();

    if (!mounted) return;

    setState(() {});

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text('تم تحديث الحد الأقصى لوكلاء ${owner.name} بنجاح'),
        backgroundColor: Colors.green,
      ),
    );
  }

