                          if (usernameLength < 4 || usernameLength > 16) {
                            ScaffoldMessenger.of(context).showSnackBar(
                              const SnackBar(
                                content: Text(
                                  'طول اسم المستخدم يجب أن يكون بين 4 و 16',
                                ),
                                backgroundColor: Colors.red,
                              ),
                            );
                            return;
                          }

                          if (passwordLength < 4 || passwordLength > 16) {
                            ScaffoldMessenger.of(context).showSnackBar(
                              const SnackBar(
                                content: Text(
                                  'طول كلمة المرور يجب أن يكون بين 4 و 16',
                                ),
                                backgroundColor: Colors.red,
                              ),
                            );
                            return;
                          }

                          setDialogState(() {
                            saving = true;
                          });

                          try {
                            const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';

                            String makeCode(int length, int seed) {
                              final now =
                                  DateTime.now().microsecondsSinceEpoch + seed;

                              var value = now.abs();

                              final buffer = StringBuffer();

                              for (var i = 0; i < length; i++) {
                                final index =
                                    (value + (i * 17) + (seed * 31)) %
                                    chars.length;

                                buffer.write(chars[index]);

                                value =
                                    (value ~/ chars.length) +
                                    (seed + 1) * 97 +
                                    i * 13;
                              }

                              return buffer.toString();
                            }

                            final priceUsd = _ownerCurrencyToUsd(
                              priceInput,
                              userId,
                            );

                            final startAt = DateTime.now();

                            final rows = <Map<String, dynamic>>[];

                            final usedUsernames = <String>{};

                            for (var i = 0; i < count; i++) {
                              var username = makeCode(usernameLength, i + 1);

                              var attempt = 0;

                              while (usedUsernames.contains(username)) {
                                attempt++;

                                username = makeCode(
                                  usernameLength,
                                  i + 1 + (attempt * 1000),
                                );
                              }

                              usedUsernames.add(username);

                              final password = makeCode(
                                passwordLength,
                                i + count + 10000,
                              );

                              rows.add({
                                'user_id': userId,
                                'device_id': deviceId,
                                'card_template_id': templateId,
                                'username': username,
                                'password': password,
                                'profile': profile,
                                'active': true,
                                'subscription_duration': duration,
                                'start_at': startAt.toIso8601String(),
                                'expires_at': startAt
                                    .add(Duration(days: duration))
                                    .toIso8601String(),
                                'payment_status': 'غير مدفوع',
                                'price': priceUsd,
                                'paid_amount': 0,
                                'service_status': 'active',
                              });
                            }

                            final insertedRows = await supabase
                                .from('hotspot_accounts')
                                .insert(rows)
                                .select();

                            generatedCards.clear();

                            for (final item in insertedRows) {
                              generatedCards.add(
                                HotspotAccount.fromJson(
                                  Map<String, dynamic>.from(item),
                                ),
                              );
                            }

                            if (!dialogContext.mounted) return;

                            Navigator.pop(dialogContext, true);
                          } catch (e) {
                            if (!dialogContext.mounted) return;

                            setDialogState(() {
                              saving = false;
                            });

                            ScaffoldMessenger.of(context).showSnackBar(
                              SnackBar(
                                content: Text(
                                  'حدث خطأ أثناء توليد البطاقات: $e',
                                ),
                                backgroundColor: Colors.red,
                              ),
                            );
                          }
                        },
                  icon: saving
                      ? const SizedBox(
                          width: 18,
                          height: 18,
                          child: CircularProgressIndicator(strokeWidth: 2),
                        )
                      : const Icon(Icons.auto_awesome),
                  label: Text(saving ? 'جاري التوليد...' : 'توليد البطاقات'),
                ),
              ],
            );
          },
        );
      },
    );

    countController.dispose();
    profileController.dispose();
    durationController.dispose();
    priceController.dispose();
    usernameLengthController.dispose();
    passwordLengthController.dispose();

    if (saved != true) return;

    await loadHotspotAccounts();
    await loadHotspotCardTemplates();

    if (!mounted) return;

    setState(() {});

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(
          'تم توليد ${generatedCards.length} بطاقة Hotspot بنجاح ✓',
        ),
        backgroundColor: Colors.green,
      ),
    );

    if (generatedCards.isNotEmpty) {
      await showGeneratedHotspotCardsDialog(generatedCards);
    }
  }

