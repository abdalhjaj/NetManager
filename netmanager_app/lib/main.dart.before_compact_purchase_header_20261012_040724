  Future<void> loadAppSettings() async {
    final supabase = Supabase.instance.client;

    try {
      // العملة وسعر الصرف مصدرهما حساب المستخدم العام.
      final userData = await supabase
          .from('app_users')
          .select('currency, usd_to_syp_rate')
          .eq('id', widget.currentUser.id)
          .maybeSingle();

      if (userData != null) {
        debugPrint(
          'SETTINGS USER => '
          'id=${widget.currentUser.id}, '
          'dbCurrency=${userData['currency']}, '
          'dbRate=${userData['usd_to_syp_rate']}',
        );

        widget.currentUser.currency = userData['currency']?.toString() ?? 'USD';

        widget.currentUser.usdToSypRate =
            (userData['usd_to_syp_rate'] as num?)?.toDouble() ?? 1;

        currentUser?.currency = widget.currentUser.currency;
        currentUser?.usdToSypRate = widget.currentUser.usdToSypRate;

        // مزامنة نفس المستخدم داخل القائمة العامة users
        // حتى تستخدم صفحات Broadband العملة وسعر الصرف المحدثين.
        for (final user in users) {
          if (user.id == widget.currentUser.id) {
            user.currency = widget.currentUser.currency;
            user.usdToSypRate = widget.currentUser.usdToSypRate;
            break;
          }
        }
      }

      final data = await supabase
          .from('app_settings')
          .select()
          .eq('user_id', widget.currentUser.id)
          .maybeSingle();

      if (data == null) {
        await supabase.from('app_settings').insert({
          'user_id': widget.currentUser.id,
          'default_currency': widget.currentUser.currency,
          'debt_grace_days': 3,
          'allow_debt': true,
          'profile_edit_allowed': true,
          'backup_enabled': true,
        });

        if (!mounted) return;

        setState(() {
          appCurrency = widget.currentUser.currency;
          usdToSypRate = widget.currentUser.usdToSypRate;
          debtGraceDays = 3;
          allowDebt = true;
          profileEditAllowed = true;
          backupEnabled = true;
        });

        return;
      }

      if (!mounted) return;

      setState(() {
        appCurrency = widget.currentUser.currency;
        usdToSypRate = widget.currentUser.usdToSypRate;

        debtGraceDays = (data['debt_grace_days'] as num?)?.toInt() ?? 3;

        allowDebt = data['allow_debt'] as bool? ?? true;

        profileEditAllowed = data['profile_edit_allowed'] as bool? ?? true;

        backupEnabled = data['backup_enabled'] as bool? ?? true;
      });
    } catch (e) {
      debugPrint('LOAD APP SETTINGS ERROR: $e');
    }
  }

