              Future<void> saveAccountingPurchaseInvoice() async {
                if (savingInvoice) return;

                if (selectedSupplier == null) {
                  ScaffoldMessenger.of(context).showSnackBar(
                    SnackBar(
                      content: Text(
                        isArabic
                            ? 'اختر المورد أولاً'
                            : 'Select a supplier first',
                      ),
                    ),
                  );
                  return;
                }

                final validItems = invoiceItems.where((row) {
                  return row['product'] != null;
                }).toList();

                if (validItems.isEmpty) {
                  ScaffoldMessenger.of(context).showSnackBar(
                    SnackBar(
                      content: Text(
                        isArabic
                            ? 'أضف مادة واحدة على الأقل إلى الفاتورة'
                            : 'Add at least one invoice item',
                      ),
                    ),
                  );
                  return;
                }

                for (final row in validItems) {
                  final product = row['product'] as Map<String, dynamic>?;

                  if (product == null) continue;

                  final quantity =
                      double.tryParse(row['quantityController'].text.trim()) ??
                      0;

                  if (quantity <= 0) {
                    ScaffoldMessenger.of(context).showSnackBar(
                      SnackBar(
                        content: Text(
                          isArabic
                              ? 'توجد مادة بكمية غير صحيحة'
                              : 'An item has an invalid quantity',
                        ),
                      ),
                    );
                    return;
                  }
                }

                setDialogState(() {
                  savingInvoice = true;
                });

                String? createdPurchaseId;

                try {
                  final usdTotal = invoiceItemsTotal('USD');
                  final sypTotal = invoiceItemsTotal('SYP');

                  final hasUsd = validItems.any(
                    (row) =>
                        (row['priceCurrency']?.toString() ?? 'USD') == 'USD',
                  );

                  final hasSyp = validItems.any(
                    (row) =>
                        (row['priceCurrency']?.toString() ?? 'USD') == 'SYP',
                  );

                  final legacyCurrency = hasSyp && !hasUsd ? 'SYP' : 'USD';

                  final legacyTotal = legacyCurrency == 'SYP'
                      ? sypTotal
                      : usdTotal;

                  final paidUsd =
                      (double.tryParse(paidUsdController.text.trim()) ?? 0)
                          .clamp(0, double.infinity);

                  final paidSyp =
                      (double.tryParse(paidSypController.text.trim()) ?? 0)
                          .clamp(0, double.infinity);

                  final purchaseData = <String, dynamic>{
                    'supplier_id': selectedSupplier!['id'],
                    'subtotal': legacyTotal,
                    'discount': 0,
                    'total': legacyTotal,
                    'paid_amount': 0,
                    'currency': legacyCurrency,
                    'subtotal_usd': usdTotal,
                    'subtotal_syp': sypTotal,
                    'discount_usd': 0,
                    'discount_syp': 0,
                    'total_usd': usdTotal,
                    'total_syp': sypTotal,
                    'paid_usd': paidUsd,
                    'paid_syp': paidSyp,
                    'status': 'posted',
                  };

                  String purchaseId;
                  dynamic invoiceNumber;

                  if (isEditingPurchase) {
                    final existingPurchaseId = existingPurchase['id']
                        ?.toString();

                    if (existingPurchaseId == null ||
                        existingPurchaseId.isEmpty) {
                      throw Exception(
                        isArabic
                            ? 'معرّف الفاتورة غير موجود'
                            : 'Invoice ID is missing',
                      );
                    }

                    // نحافظ على تاريخ ورقم الفاتورة الأصليين.
                    final updatedPurchase = await Supabase.instance.client
                        .from('accounting_purchases')
                        .update(purchaseData)
                        .eq('id', existingPurchaseId)
                        .select('id, invoice_number')
                        .single();

                    purchaseId = updatedPurchase['id'].toString();
                    invoiceNumber = updatedPurchase['invoice_number'];

                    // استبدال بنود الفاتورة القديمة بالبنود المعدلة.
                    await Supabase.instance.client
                        .from('accounting_purchase_items')
                        .delete()
                        .eq('purchase_id', purchaseId);
                  } else {
                    purchaseData['invoice_date'] = DateTime.now()
                        .toIso8601String();

                    purchaseData['created_by'] = widget.currentUser.id;

                    final createdPurchase = await Supabase.instance.client
                        .from('accounting_purchases')
                        .insert(purchaseData)
                        .select('id, invoice_number')
                        .single();

                    createdPurchaseId = createdPurchase['id']?.toString();

                    if (createdPurchaseId == null ||
                        createdPurchaseId.isEmpty) {
                      throw Exception(
                        isArabic
                            ? 'لم يتم إرجاع رقم الفاتورة المحفوظة'
                            : 'Saved invoice ID was not returned',
                      );
                    }

                    purchaseId = createdPurchaseId;
                    invoiceNumber = createdPurchase['invoice_number'];
                  }

                  final itemRows = <Map<String, dynamic>>[];

                  for (final row in validItems) {
                    final product = row['product'] as Map<String, dynamic>;

                    final quantity =
                        double.tryParse(
                          row['quantityController'].text.trim(),
                        ) ??
                        0;

                    final unitPrice =
                        double.tryParse(row['priceController'].text.trim()) ??
                        0;

                    var discountPercent =
                        double.tryParse(
                          row['discountController'].text.trim(),
                        ) ??
                        0;

                    if (discountPercent < 0) {
                      discountPercent = 0;
                    }

                    if (discountPercent > 100) {
                      discountPercent = 100;
                    }

                    final currency = row['priceCurrency']?.toString() ?? 'USD';

                    itemRows.add({
                      'purchase_id': purchaseId,
                      'product_id': product['id'],
                      'quantity': quantity,
                      'unit_cost': unitPrice,
                      'discount': discountPercent,
                      'total': rowTotal(row),
                      'currency': currency,
                    });
                  }

                  await Supabase.instance.client
                      .from('accounting_purchase_items')
                      .insert(itemRows);

                  // =====================================================
                  // تعديل فاتورة مشتريات موجودة:
                  // نطبق على المخزون فرق الكمية فقط بين القديم والجديد.
                  // =====================================================
                  if (isEditingPurchase) {
                    final newPurchaseQuantities = <String, double>{};

                    // تجميع الكميات الجديدة لكل مادة.
                    for (final row in validItems) {
                      final product = row['product'] as Map<String, dynamic>?;

                      if (product == null) continue;

                      final productId = product['id']?.toString() ?? '';

                      final quantity =
                          double.tryParse(
                            row['quantityController'].text.trim(),
                          ) ??
                          0;

                      if (productId.isEmpty || quantity <= 0) continue;

                      newPurchaseQuantities[productId] =
                          (newPurchaseQuantities[productId] ?? 0) + quantity;
                    }

                    // نجمع كل المواد القديمة والجديدة حتى نعالج:
                    // تغيير الكمية، حذف مادة، أو إضافة مادة جديدة.
                    final allProductIds = <String>{
                      ...originalPurchaseQuantities.keys,
                      ...newPurchaseQuantities.keys,
                    };

                    for (final productId in allProductIds) {
                      final oldQuantity =
                          originalPurchaseQuantities[productId] ?? 0;

                      final newQuantity = newPurchaseQuantities[productId] ?? 0;

                      final quantityDifference = newQuantity - oldQuantity;

                      // لا يوجد أي تغيير لهذه المادة.
                      if (quantityDifference.abs() < 0.000001) {
                        continue;
                      }

                      final freshProduct = await Supabase.instance.client
                          .from('accounting_products')
                          .select('quantity, name')
                          .eq('id', productId)
                          .eq('created_by', widget.currentUser.id)
                          .single();

                      final quantityBefore =
                          (freshProduct['quantity'] as num?)?.toDouble() ?? 0;

                      final productName =
                          freshProduct['name']?.toString() ?? '';

                      // الفرق الموجب يزيد المخزون.
                      // الفرق السالب ينقص المخزون.
                      final quantityAfter = quantityBefore + quantityDifference;

                      if (quantityAfter < 0) {
                        throw Exception(
                          isArabic
                              ? 'لا يمكن تعديل الفاتورة لأن الكمية المتوفرة من $productName لا تكفي لإلغاء فرق المشتريات'
                              : 'Cannot update invoice because available stock of $productName is insufficient to reverse the purchase difference',
                        );
                      }

                      await Supabase.instance.client
                          .from('accounting_products')
                          .update({
                            'quantity': quantityAfter,
                            'updated_at': DateTime.now().toIso8601String(),
                          })
                          .eq('id', productId)
                          .eq('created_by', widget.currentUser.id);

                      try {
                        await Supabase.instance.client
                            .from('accounting_inventory_movements')
                            .insert({
                              'product_id': productId,
                              'movement_type': 'purchase',
                              'quantity': quantityDifference.abs(),
                              'quantity_before': quantityBefore,
                              'quantity_after': quantityAfter,
                              'reference_id': purchaseId,
                              'notes': isArabic
                                  ? 'تعديل شراء - فاتورة رقم $invoiceNumber - الفرق: $quantityDifference'
                                  : 'Purchase adjustment - Invoice $invoiceNumber - Difference: $quantityDifference',
                              'movement_date': DateTime.now().toIso8601String(),
                              'created_by': widget.currentUser.id,
                            });
                      } catch (_) {
                        // إذا فشل تسجيل الحركة نعيد المخزون كما كان.
                        await Supabase.instance.client
                            .from('accounting_products')
                            .update({
                              'quantity': quantityBefore,
                              'updated_at': DateTime.now().toIso8601String(),
                            })
                            .eq('id', productId)
                            .eq('created_by', widget.currentUser.id);

                        rethrow;
                      }

                      // تحديث نسخة المادة المحلية إن كانت موجودة.
                      for (final product in products) {
                        if (product['id']?.toString() == productId) {
                          product['quantity'] = quantityAfter;
                          break;
                        }
                      }
                    }
                  }

                  // =====================================================
                  // فاتورة مشتريات جديدة:
                  // نضيف كامل الكمية إلى المخزون.
                  // =====================================================
                  if (!isEditingPurchase) {
                    for (final row in validItems) {
                      final product = row['product'] as Map<String, dynamic>;

                      final productId = product['id']?.toString() ?? '';

                      final quantity =
                          double.tryParse(
                            row['quantityController'].text.trim(),
                          ) ??
                          0;

                      if (productId.isEmpty || quantity <= 0) {
                        continue;
                      }

                      // نقرأ الكمية الحالية مباشرة من قاعدة البيانات
                      // ثم نضيف إليها الكمية المشتراة.
                      final freshProduct = await Supabase.instance.client
                          .from('accounting_products')
                          .select('quantity')
                          .eq('id', productId)
                          .eq('created_by', widget.currentUser.id)
                          .single();

                      final quantityBefore =
                          (freshProduct['quantity'] as num?)?.toDouble() ?? 0;

                      // فاتورة المشتريات تزيد المخزون.
                      final quantityAfter = quantityBefore + quantity;

                      await Supabase.instance.client
                          .from('accounting_products')
                          .update({
                            'quantity': quantityAfter,
                            'updated_at': DateTime.now().toIso8601String(),
                          })
                          .eq('id', productId)
                          .eq('created_by', widget.currentUser.id);

                      try {
                        await Supabase.instance.client
                            .from('accounting_inventory_movements')
                            .insert({
                              'product_id': productId,
                              'movement_type': 'purchase',
                              'quantity': quantity,
                              'quantity_before': quantityBefore,
                              'quantity_after': quantityAfter,
                              'reference_id': purchaseId,
                              'notes': isArabic
                                  ? 'شراء - فاتورة رقم $invoiceNumber'
                                  : 'Purchase - Invoice $invoiceNumber',
                              'movement_date': DateTime.now().toIso8601String(),
                              'created_by': widget.currentUser.id,
                            });
                      } catch (_) {
                        // إذا فشل تسجيل حركة المخزون نعيد الكمية كما كانت.
                        await Supabase.instance.client
                            .from('accounting_products')
                            .update({
                              'quantity': quantityBefore,
                              'updated_at': DateTime.now().toIso8601String(),
                            })
                            .eq('id', productId)
                            .eq('created_by', widget.currentUser.id);

                        rethrow;
                      }

                      // تحديث النسخة المحلية أيضًا.
                      product['quantity'] = quantityAfter;
                    }
                  }

                  await loadAccountingPurchases();

                  if (!mounted) return;

                  Navigator.of(dialogContext).pop();

                  ScaffoldMessenger.of(context).showSnackBar(
                    SnackBar(
                      content: Text(
                        isEditingPurchase
                            ? (isArabic
                                  ? 'تم تعديل فاتورة المشتريات رقم $invoiceNumber بنجاح'
                                  : 'Purchase invoice $invoiceNumber updated successfully')
