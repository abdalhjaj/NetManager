                  onPressed: selectedIds.isEmpty
                      ? null
                      : () async {
                          final selectedCards = cards
                              .where((card) => selectedIds.contains(card.id))
                              .toList();

                          await showHotspotA4ExportDialog(selectedCards);
                        },
                  icon: const Icon(Icons.save_alt),
                  label: Text('حفظ المحدد (${selectedIds.length})'),
                ),
              ],
            );
          },
        );
      },
    );
  }

  Widget _buildHotspotTemplateVisual({
    required String designType,
    required String primaryColor,
    required String secondaryColor,
    required String textColor,
    required String companyName,
    required String packageName,
    required String profile,
    required String durationText,
    required String priceText,
    required String username,
    required String password,
    required bool showCompanyName,
    required bool showProfile,
    required bool showDuration,
    required bool showPrice,
    required bool showQr,
    String? footerText,
    String? backgroundUrl,
    String? logoUrl,
    Map<String, dynamic>? layoutConfig,
    Map<String, dynamic>? backgroundConfig,
  }) {
    final primary = _hotspotTemplateColor(primaryColor);
    final secondary = _hotspotTemplateColor(secondaryColor);
    final foreground = _hotspotTemplateColor(textColor);

    double layoutValue(String element, String axis, double fallback) {
      final data = layoutConfig?[element];

      if (data is Map) {
        final value = data[axis];
        if (value is num) {
          return value.toDouble().clamp(0.0, 1.0);
        }
      }

      return fallback;
    }

    final darkBackground = primary.computeLuminance() < 0.35;

    Color readable(Color background) {
      return background.computeLuminance() > 0.55
          ? const Color(0xFF102A43)
          : Colors.white;
    }

    final primaryText = readable(primary);

    Widget logoWidget({double size = 44}) {
      final url = logoUrl?.trim() ?? '';

      if (url.isEmpty) {
        return Icon(Icons.wifi_rounded, color: foreground, size: size);
      }

      return Container(
        width: size,
        height: size,
        padding: const EdgeInsets.all(3),
        decoration: BoxDecoration(
          color: Colors.white.withValues(alpha: 0.92),
          borderRadius: BorderRadius.circular(10),
        ),
        child: ClipRRect(
          borderRadius: BorderRadius.circular(7),
          child: Image.network(
            url,
            fit: BoxFit.contain,
            cacheWidth: 160,
            cacheHeight: 160,
            filterQuality: FilterQuality.low,
            gaplessPlayback: true,
            errorBuilder: (context, error, stackTrace) {
              return Icon(
                Icons.wifi_rounded,
                color: primary,
                size: size * 0.65,
              );
            },
          ),
        ),
      );
    }

    Widget loginBox({Color? background, Color? color, bool outlined = false}) {
      final bg = background ?? Colors.white.withValues(alpha: 0.93);
      final fg = color ?? const Color(0xFF102A43);

      return Container(
        padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 11),
        decoration: BoxDecoration(
          color: outlined ? Colors.transparent : bg,
          borderRadius: BorderRadius.circular(14),
          border: outlined
              ? Border.all(color: foreground.withValues(alpha: 0.7), width: 1.4)
              : null,
        ),
        child: Column(
          children: [
            Row(
              children: [
                Expanded(
                  child: Text(
                    'اسم المستخدم',
                    style: TextStyle(
                      color: outlined ? foreground : fg,
                      fontSize: 12,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                ),
                Text(
                  username,
                  style: TextStyle(
                    color: outlined ? foreground : fg,
                    fontSize: 15,
                    fontWeight: FontWeight.w900,
                    letterSpacing: 1,
                  ),
                ),
              ],
            ),
            const SizedBox(height: 5),
            Row(
              children: [
                Expanded(
                  child: Text(
                    'كلمة المرور',
                    style: TextStyle(
                      color: outlined ? foreground : fg,
                      fontSize: 12,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                ),
                Text(
                  password,
                  style: TextStyle(
                    color: outlined ? foreground : fg,
                    fontSize: 15,
                    fontWeight: FontWeight.w900,
                    letterSpacing: 1,
                  ),
                ),
              ],
            ),
          ],
        ),
      );
    }

    Widget information({
      Color? color,
      MainAxisAlignment alignment = MainAxisAlignment.center,
    }) {
      final c = color ?? foreground;

      return Wrap(
        alignment: WrapAlignment.center,
        spacing: 11,
        runSpacing: 5,
        children: [
          if (showProfile)
            Text(
              profile,
              style: TextStyle(color: c, fontWeight: FontWeight.bold),
            ),
          if (showDuration)
            Text(
              durationText,
              style: TextStyle(color: c, fontWeight: FontWeight.bold),
            ),
          if (showPrice)
            Text(
              priceText,
              style: TextStyle(color: c, fontWeight: FontWeight.bold),
            ),
          if (showQr) Icon(Icons.qr_code_2_rounded, color: c, size: 27),
        ],
      );
    }

    Widget footer(Color color) {
      final text = footerText?.trim() ?? '';

      if (text.isEmpty) {
        return const SizedBox.shrink();
      }

      return Text(
        text,
        textAlign: TextAlign.center,
        maxLines: 1,
        overflow: TextOverflow.ellipsis,
        style: TextStyle(
          color: color,
          fontSize: 10,
          fontWeight: FontWeight.w500,
        ),
      );
    }

    Widget companyHeader({
      required Color color,
      IconData icon = Icons.wifi_rounded,
      MainAxisAlignment alignment = MainAxisAlignment.start,
    }) {
      return Row(
        mainAxisAlignment: alignment,
        children: [
          if ((logoUrl?.trim() ?? '').isNotEmpty)
            logoWidget(size: 42)
          else
            Icon(icon, color: color, size: 31),
          if (showCompanyName) ...[
            const SizedBox(width: 8),
            Flexible(
              child: Text(
                companyName,
                maxLines: 1,
                overflow: TextOverflow.ellipsis,
                style: TextStyle(
                  color: color,
                  fontSize: 17,
                  fontWeight: FontWeight.w900,
                ),
              ),
            ),
          ],
        ],
      );
    }

    // ========================================================
    // Custom imported background
    // ========================================================
    final importedBackground = backgroundUrl?.trim() ?? '';

    if (importedBackground.isNotEmpty) {
      return Container(
        clipBehavior: Clip.hardEdge,
        decoration: BoxDecoration(
          color: primary,
          borderRadius: BorderRadius.circular(22),
        ),
        child: Stack(
          fit: StackFit.expand,
          children: [
            Image.network(
              importedBackground,
              fit: BoxFit.cover,
              cacheWidth: 1000,
              filterQuality: FilterQuality.low,
              gaplessPlayback: true,
              errorBuilder: (context, error, stackTrace) {
