  Future<void> refreshDashboard() async {
    if (isRefreshingDashboard) return;

    setState(() {
      isRefreshingDashboard = true;
    });

    try {
      await Future.wait([
        loadUsers(),
        loadSubscriptions(),
        loadPaymentHistory(),
        loadDevices(),
        loadBroadbandProfiles(),
        loadBroadbandAccounts(),
        loadHotspotAccounts(),
        loadBroadbandPaymentHistory(),
        loadHotspotPaymentHistory(),
        loadSubscriberWalletTransactionHistory(),
        loadAgentDeletionTransactionHistory(),
        loadUsageSessions(),
      ]);

      // سجل حركات الوكيل نحمله بعد بقية البيانات.
      if (widget.currentUser.role == 'وكيل') {
        // مزامنة المستخدم العام مع المستخدم الفعلي للصفحة.
        currentUser = widget.currentUser;

        await loadAgentBalanceTransactionHistory();
      }

      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text('تم تحديث البيانات بنجاح ✓'),
            backgroundColor: Colors.green,
