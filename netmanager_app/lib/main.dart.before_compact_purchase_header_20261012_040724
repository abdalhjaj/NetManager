                ),
                FilledButton.icon(
                  onPressed: () async {
                    if (selectedUserId == null) {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(content: Text('يرجى اختيار المشترك')),
                      );
                      return;
                    }

                    if (selectedDeviceId == null) {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(
                          content: Text('يرجى اختيار جهاز MikroTik'),
                        ),
                      );
                      return;
                    }

                    if (selectedProfileId == null) {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(
                          content: Text('يرجى اختيار بروفايل Broadband'),
                        ),
                      );
                      return;
                    }

                    BroadbandProfile? profileForSave;

                    for (final profile in broadbandProfiles) {
                      if (profile.id == selectedProfileId &&
                          profile.deviceId == selectedDeviceId &&
                          profile.active) {
                        profileForSave = profile;
                        break;
                      }
                    }

                    if (profileForSave == null) {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(
                          content: Text(
                            'البروفايل غير صالح لهذا الجهاز أو غير فعال',
                          ),
                        ),
                      );
                      return;
                    }

                    if (usernameController.text.trim().isEmpty) {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(
                          content: Text('يرجى إدخال اسم المستخدم'),
                        ),
                      );
                      return;
                    }

                    if (passwordController.text.trim().isEmpty) {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(content: Text('يرجى إدخال كلمة المرور')),
                      );
                      return;
                    }

                    final durationDays =
                        int.tryParse(durationController.text.trim()) ?? 0;

                    if (durationDays <= 0) {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(
                          content: Text('مدة البروفايل غير صحيحة'),
                        ),
                      );
                      return;
                    }

                    final priceInput = getPrice();

                    final paidInput = paymentStatus == 'مدفوع'
                        ? getPaid()
                        : 0.0;

                    if (priceInput <= 0) {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(
                          content: Text(
                            'سعر البروفايل غير صحيح أو تعذر تحويل العملة',
                          ),
                        ),
                      );
                      return;
                    }

                    if (paidInput > priceInput) {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(
                          content: Text(
                            'المبلغ المقبوض لا يمكن أن يكون أكبر من قيمة الاشتراك',
                          ),
                        ),
                      );
                      return;
                    }

                    // Broadband مخزن داخليًا بالدولار.
                    final priceUsd = _ownerCurrencyToUsd(
                      priceInput,
                      selectedUserId!,
                    );

                    final paidUsd = _ownerCurrencyToUsd(
                      paidInput,
                      selectedUserId!,
                    );

                    final expiresAt = startAt.add(Duration(days: durationDays));

                    try {
                      final supabase = Supabase.instance.client;

                      await supabase.from('broadband_accounts').insert({
                        'user_id': selectedUserId,
                        'device_id': selectedDeviceId,
                        'username': usernameController.text.trim(),
                        'password': passwordController.text.trim(),

                        // العلاقة الجديدة الحقيقية مع البروفايل.
                        'profile_id': profileForSave.id,

                        // نبقي الاسم أيضًا للتوافق مع الكود القديم.
                        'profile': profileForSave.name,

                        'whatsapp_number':
                            whatsappController.text.trim().isEmpty
                            ? null
                            : whatsappController.text.trim(),
                        'active': active,
                        'subscription_duration': durationDays,
                        'start_at': startAt.toIso8601String(),
                        'expires_at': expiresAt.toIso8601String(),
                        'payment_status': paymentStatus,
                        'price': priceUsd,
                        'paid_amount': paidUsd,
                      });

                      await loadBroadbandAccounts();

                      if (mounted) {
                        setState(() {});
                      }

                      if (dialogContext.mounted) {
                        Navigator.pop(dialogContext, true);
                      }

                      if (mounted) {
                        ScaffoldMessenger.of(context).showSnackBar(
                          const SnackBar(
                            content: Text('تم حفظ حساب Broadband بنجاح'),
                            backgroundColor: Colors.green,
                          ),
                        );
                      }
                    } catch (e) {
                      if (dialogContext.mounted) {
                        ScaffoldMessenger.of(dialogContext).showSnackBar(
                          SnackBar(content: Text('خطأ أثناء حفظ الحساب: $e')),
                        );
                      }
                    }
                  },
                  icon: const Icon(Icons.save),
                  label: const Text('حفظ المشترك'),
                ),
              ],
            );
          },
        );
      },
    );

    usernameController.dispose();
    passwordController.dispose();
    whatsappController.dispose();
    priceController.dispose();
    paidController.dispose();
    durationController.dispose();

    if (result == true && mounted) {
      setState(() {});
    }
  }

