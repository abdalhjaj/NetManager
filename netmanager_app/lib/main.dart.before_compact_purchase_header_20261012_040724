                      ),
                    ],
                  ),
                ),
              ),
              actions: [
                TextButton(
                  onPressed: saving
                      ? null
                      : () => Navigator.pop(dialogContext, false),
                  child: const Text('إلغاء'),
                ),

                FilledButton.icon(
                  onPressed: saving
                      ? null
                      : () async {
                          final name = nameController.text.trim();
                          final username = usernameController.text.trim();
                          final password = passwordController.text;
                          final whatsapp = whatsappController.text.trim();

                          if (name.isEmpty ||
                              username.isEmpty ||
                              password.trim().isEmpty) {
                            ScaffoldMessenger.of(dialogContext).showSnackBar(
                              const SnackBar(
                                content: Text(
                                  'يرجى إدخال الاسم واسم المستخدم وكلمة المرور',
                                ),
                                backgroundColor: Colors.orange,
                              ),
                            );
                            return;
                          }

                          setDialogState(() {
                            saving = true;
                          });

                          try {
                            final supabase = Supabase.instance.client;

                            await supabase.rpc(
                              'create_agent',
                              params: {
                                'p_owner_user_id': ownerUserId,
                                'p_created_by': widget.currentUser.id,
                                'p_username': username,
                                'p_password': password,
                                'p_name': name,
                                'p_whatsapp_number': whatsapp.isEmpty
                                    ? null
                                    : whatsapp,
                                'p_currency': agentCurrency,
                              },
                            );

                            if (!dialogContext.mounted) return;

                            Navigator.pop(dialogContext, true);
                          } catch (e) {
                            if (!dialogContext.mounted) return;

                            setDialogState(() {
                              saving = false;
                            });

                            var message = e.toString();

                            if (message.contains('MAX_AGENTS_REACHED')) {
                              message = 'تم الوصول إلى الحد الأقصى للوكلاء';
                            } else if (message.contains(
