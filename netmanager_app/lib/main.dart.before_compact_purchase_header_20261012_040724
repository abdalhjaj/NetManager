  Widget statCard(
    String title,
    String value,
    IconData icon, {
    VoidCallback? onTap,
  }) {
    final theme = Theme.of(context);
    final primary = theme.colorScheme.primary;

    Color accent = primary;

    if (title.contains('دين') || title.contains('Debt')) {
      accent = const Color(0xFFC94A57);
    } else if (title.contains('تحصيل') ||
        title.contains('Cash') ||
        title.contains('Collected')) {
      accent = const Color(0xFF16836D);
    } else if (title.contains('منته') || title.contains('Expired')) {
      accent = const Color(0xFFC58B36);
    } else if (title.contains('متوقف') || title.contains('Stopped')) {
      accent = const Color(0xFF77778C);
    } else if (title.contains('فعال') ||
        title.contains('ساري') ||
        title.contains('نشط') ||
        title.contains('Active')) {
      accent = const Color(0xFF16836D);
    }

    return LayoutBuilder(
      builder: (context, constraints) {
        final screenWidth = MediaQuery.sizeOf(context).width;
        final availableWidth = constraints.maxWidth;

        final desiredWidth = screenWidth < 600
            ? (screenWidth - 55) / 2
            : screenWidth < 1000
            ? 205.0
            : 225.0;

        final cardWidth = availableWidth.isFinite
            ? desiredWidth.clamp(0.0, availableWidth)
            : desiredWidth;

        return SizedBox(
          width: cardWidth,
          child: Card(
            margin: EdgeInsets.zero,
            elevation: 0,
            color: theme.colorScheme.surface,
            shape: RoundedRectangleBorder(
              borderRadius: BorderRadius.circular(20),
              side: BorderSide(
                color: theme.colorScheme.outlineVariant.withValues(alpha: 0.65),
              ),
            ),
            clipBehavior: Clip.antiAlias,
            child: InkWell(
              onTap: onTap,
              child: Padding(
                padding: const EdgeInsets.all(14),
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Container(
                      width: 42,
                      height: 42,
                      decoration: BoxDecoration(
                        color: accent.withValues(alpha: 0.10),
                        borderRadius: BorderRadius.circular(13),
                      ),
                      child: Icon(icon, size: 22, color: accent),
                    ),
                    const SizedBox(height: 12),
                    Text(
                      title,
                      maxLines: 2,
                      overflow: TextOverflow.ellipsis,
                      style: TextStyle(
                        color: theme.colorScheme.onSurfaceVariant,
                        fontSize: screenWidth < 600 ? 12 : 13,
                        fontWeight: FontWeight.w600,
                      ),
                    ),
                    const SizedBox(height: 6),
                    Text(
                      value,
                      softWrap: true,
                      style: TextStyle(
                        color: theme.colorScheme.onSurface,
                        fontSize: screenWidth < 600 ? 17 : 20,
                        fontWeight: FontWeight.bold,
                        height: 1.25,
                      ),
                    ),
                  ],
                ),
              ),
            ),
          ),
        );
      },
    );
  }

  Widget buildDebtsPage() {
    final String ownerUserId = widget.currentUser.role == 'وكيل'
        ? (widget.currentUser.parentUserId ?? widget.currentUser.id)
        : widget.currentUser.id;

    final broadbandWithDebt = broadbandAccounts
        .where(
          (account) =>
              account.userId == ownerUserId && account.remainingAmount > 0.001,
        )
        .toList();

    final hotspotWithDebt = hotspotAccounts
        .where(
          (account) =>
              account.userId == ownerUserId && account.remainingAmount > 0.001,
        )
        .toList();

    final broadbandDebt = broadbandWithDebt.fold<double>(
      0,
      (sum, account) => sum + account.remainingAmount,
    );

    final hotspotDebt = hotspotWithDebt.fold<double>(
      0,
      (sum, account) => sum + account.remainingAmount,
    );

    final ownerCurrency = _accountOwnerCurrency(ownerUserId);

    String money(double amountUsd) {
      final value = _usdToOwnerCurrency(amountUsd, ownerUserId);

      if (ownerCurrency == 'SYP') {
        return '${value.toStringAsFixed(0)} SYP';
      }

      return '${value.toStringAsFixed(2)} USD';
    }

