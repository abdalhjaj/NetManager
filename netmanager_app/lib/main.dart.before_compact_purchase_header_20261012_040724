                          DropdownMenuItem(value: 'USD', child: Text('USD')),
                          DropdownMenuItem(value: 'SYP', child: Text('SYP')),
                        ],
                        onChanged: saving
                            ? null
                            : (v) {
                                update(() => currency = v ?? 'USD');
                              },
                      ),
                      const SizedBox(height: 12),
                      DropdownButtonFormField<String>(
                        initialValue: method,
                        decoration: InputDecoration(
                          labelText: ar ? 'طريقة الدفع' : 'Payment Method',
                        ),
                        items: [
                          DropdownMenuItem(
                            value: 'cash',
                            child: Text(ar ? 'نقدي' : 'Cash'),
                          ),
                          DropdownMenuItem(
                            value: 'transfer',
                            child: Text(ar ? 'تحويل' : 'Transfer'),
                          ),
                        ],
                        onChanged: saving
                            ? null
                            : (v) {
                                update(() => method = v ?? 'cash');
                              },
                      ),
                      const SizedBox(height: 12),
                      TextField(
                        controller: notesController,
                        maxLines: 3,
                        decoration: InputDecoration(
                          labelText: ar ? 'البيان والملاحظات' : 'Notes',
                        ),
                      ),
                    ],
                  ),
                ),
              ),
              actions: [
                TextButton(
                  onPressed: saving ? null : () => Navigator.pop(dialogContext),
                  child: Text(ar ? 'إلغاء' : 'Cancel'),
                ),
                FilledButton(
                  onPressed: saving
                      ? null
                      : () async {
                          final amount = double.tryParse(
                            amountController.text.trim().replaceAll(',', '.'),
                          );

                          if (amount == null ||
                              !amount.isFinite ||
                              amount <= 0 ||
                              (partyType != 'general' && partyId == null)) {
                            ScaffoldMessenger.of(dialogContext).showSnackBar(
                              SnackBar(
                                content: Text(
                                  ar
                                      ? 'تحقق من المبلغ والجهة'
                                      : 'Check amount and party',
                                ),
                              ),
                            );
                            return;
                          }

                          update(() => saving = true);

                          final type = partyType == 'customer'
                              ? (receipt
                                    ? 'customer_receipt'
                                    : 'customer_payment')
                              : partyType == 'supplier'
                              ? (receipt
                                    ? 'supplier_receipt'
                                    : 'supplier_payment')
                              : (receipt ? 'cash_in' : 'cash_out');

                          try {
                            final inserted = await db
                                .from('accounting_transactions')
                                .insert({
                                  'transaction_type': type,
                                  'customer_id': partyType == 'customer'
                                      ? partyId
                                      : null,
                                  'supplier_id': partyType == 'supplier'
                                      ? partyId
                                      : null,
                                  'amount': amount,
                                  'currency': currency,
                                  'payment_method': method,
                                  'party_name': partyType == 'general'
                                      ? partyController.text.trim()
                                      : null,
                                  'voucher_type': receipt
                                      ? 'receipt'
                                      : 'payment',
                                  'notes': notesController.text.trim(),
                                  'transaction_date': DateTime.now()
                                      .toIso8601String(),
                                  'created_by': widget.currentUser.id,
                                })
                                .select('id')
                                .single();

                            final id = inserted['id'].toString();
                            final number =
                                'V-${id.replaceAll('-', '').substring(0, 12).toUpperCase()}';

                            try {
                              await db
                                  .from('accounting_transactions')
                                  .update({'voucher_number': number})
                                  .eq('id', id)
                                  .eq('created_by', widget.currentUser.id);
                            } catch (e) {
                              debugPrint('Voucher number update: $e');
                            }

                            if (!dialogContext.mounted) return;
                            Navigator.pop(dialogContext);

                            if (!mounted) return;
                            await loadAccountingCustomers();
                            await loadAccountingSuppliers();
                            if (mounted) setState(() {});
                          } catch (e) {
                            if (!dialogContext.mounted) return;
                            update(() => saving = false);
                            ScaffoldMessenger.of(dialogContext).showSnackBar(
                              SnackBar(content: Text('Error: $e')),
                            );
                          }
                        },
                  child: Text(ar ? 'حفظ السند' : 'Save Voucher'),
                ),
              ],
            );
          },
        ),
      );

      amountController.dispose();
      notesController.dispose();
      partyController.dispose();
    }

