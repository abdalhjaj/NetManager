                        );

                        updateData['price'] = newPriceUsd;
                        updateData['paid_amount'] = packagePaidUsd;
                        updateData['subscription_duration'] =
                            profileForSave.durationDays;

                        // تحديث حالة الدفع حسب الجزء الذي تم دفعه للباقة.
                        updateData['payment_status'] =
                            packagePaidOwnerCurrency >=
                                profilePriceOwnerCurrency
                            ? 'مدفوع'
                            : packagePaidOwnerCurrency > 0
                            ? 'مدفوع جزئياً'
                            : 'غير مدفوع';

                        // نخزن قيمة الزيادة مؤقتًا داخل updateData
                        // ثم نحذفها قبل إرسال update إلى Supabase.
                        updateData['_wallet_extra_usd'] = walletExtraUsd;
                        updateData['_wallet_extra_display'] =
                            walletExtraOwnerCurrency;
                      }

                      try {
                        // القيم المؤقتة الخاصة بالمحفظة لا ترسل إلى جدول الحساب.
                        final walletExtraUsd =
                            (updateData.remove('_wallet_extra_usd') as num?)
                                ?.toDouble() ??
                            0.0;

                        final walletExtraDisplay =
                            (updateData.remove('_wallet_extra_display') as num?)
                                ?.toDouble() ??
                            0.0;

                        await Supabase.instance.client
                            .from('broadband_accounts')
                            .update(updateData)
                            .eq('id', account.id);

                        // إذا كان هناك مبلغ زائد عن سعر الباقة،
                        // يودع بالكامل في محفظة المشترك.
                        if (walletExtraUsd > 0.000001) {
                          await Supabase.instance.client.rpc(
                            'deposit_subscriber_wallet',
                            params: {
                              'p_actor_id': widget.currentUser.id,
                              'p_account_type': 'broadband',
                              'p_account_id': account.id,
                              'p_amount_usd': walletExtraUsd,
                              'p_description':
                                  'زيادة دفعة تغيير الباقة - المشترك: ${usernameController.text.trim()}',
                            },
                          );

                          if (dialogContext.mounted) {
                            final owner = users
                                .where((u) => u.id == selectedUserId)
                                .firstOrNull;

                            final currency = owner?.currency ?? 'USD';

                            final formattedExtra = currency == 'SYP'
                                ? walletExtraDisplay.toStringAsFixed(0)
                                : walletExtraDisplay.toStringAsFixed(2);

                            ScaffoldMessenger.of(dialogContext).showSnackBar(
                              SnackBar(
                                content: Text(
                                  'تم إيداع $formattedExtra $currency في المحفظة بنجاح ✓',
                                ),
                                backgroundColor: Colors.green,
                              ),
                            );
                          }
                        }

                        if (dialogContext.mounted) {
                          Navigator.pop(dialogContext, true);
                        }
                      } catch (e) {
                        if (!dialogContext.mounted) return;

                        ScaffoldMessenger.of(dialogContext).showSnackBar(
                          SnackBar(
                            content: Text('فشل تعديل الحساب: $e'),
                            backgroundColor: Colors.red,
                          ),
                        );
                      }
                    },
                    icon: const Icon(Icons.save),
                    label: const Text('حفظ التعديل'),
                  ),
                ],
              ),
            );
          },
        );
      },
    );

    usernameController.dispose();
    passwordController.dispose();
    whatsappController.dispose();

    if (saved != true) return;

    await loadBroadbandAccounts();

    if (!mounted) return;

    setState(() {});

    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text('تم تعديل حساب Broadband بنجاح ✓'),
        backgroundColor: Colors.green,
      ),
    );
  }

