Future<void> loadBroadbandPaymentHistory() async {
  final supabase = Supabase.instance.client;

  broadbandPaymentHistory.clear();

  if (currentUser == null) {
    return;
  }

  dynamic data;

  if (currentUser!.role == 'مدير') {
    data = await supabase
        .from('broadband_payments')
        .select()
        .order('created_at', ascending: false);
  } else if (currentUser!.role == 'وكيل') {
    // الوكيل يرى فقط عمليات Broadband التي نفذها بنفسه.
    data = await supabase
        .from('broadband_payments')
        .select()
        .eq('collected_by', currentUser!.id)
        .order('created_at', ascending: false);
  } else {
    data = await supabase
        .from('broadband_payments')
        .select()
        .eq('user_id', currentUser!.id)
        .order('created_at', ascending: false);
  }

  for (final item in data) {
    broadbandPaymentHistory.add(Map<String, dynamic>.from(item));
  }
}

