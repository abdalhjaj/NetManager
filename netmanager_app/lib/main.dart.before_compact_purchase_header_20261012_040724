              final amount = (transaction['amount'] as num?)?.toDouble() ?? 0;

              final type = transaction['transaction_type']?.toString() ?? '';

              if (type == 'supplier_payment') {
                supplierPayments += amount;
              } else if (type == 'supplier_receipt') {
                supplierReceipts += amount;
