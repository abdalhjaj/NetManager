                                          : AspectRatio(
                                              aspectRatio: 1.65,
                                              child: RepaintBoundary(
                                                child: _buildHotspotTemplateVisual(
                                                  designType:
                                                      template.designType,
                                                  primaryColor:
                                                      template.primaryColor,
                                                  secondaryColor:
                                                      template.secondaryColor,
                                                  textColor: template.textColor,
                                                  companyName:
                                                      template.companyName,
                                                  packageName: template.name,
                                                  profile:
                                                      card.profile ??
                                                      template.profile ??
                                                      '-',
                                                  durationText:
                                                      '${card.subscriptionDuration ?? template.durationDays} يوم',
                                                  priceText: priceText,
                                                  username: card.username,
                                                  password: card.password,
                                                  showCompanyName:
                                                      template.showCompanyName,
                                                  showProfile:
