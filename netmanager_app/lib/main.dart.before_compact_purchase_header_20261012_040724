  Future<void> checkDeviceStatus(NetworkDevice device) async {
    try {
      final supabase = Supabase.instance.client;

      // فحص مبدئي (سيتم ربطه لاحقاً بفحص Ping حقيقي)
      final online = device.active;

      await supabase
          .from('network_devices')
          .update({
            'is_online': online,
            'last_check': DateTime.now().toIso8601String(),
          })
          .eq('id', device.id);

      device.isOnline = online;
      device.lastCheck = DateTime.now();

      if (mounted) {
        setState(() {});
      }

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text(online ? 'الجهاز متصل' : 'الجهاز غير متصل')),
      );
    } catch (e) {
      ScaffoldMessenger.of(context)
          .showSnackBar(SnackBar(content: Text('خطأ أثناء فحص الجهاز: $e')));
    }
  }

  Future<void> toggleUserStatus(AppUser user) async {
    final newStatus = !user.active;

    try {
      await Supabase.instance.client
          .from('app_users')
          .update({'active': newStatus})
          .eq('id', user.id);

      user.active = newStatus;

      if (!mounted) return;

      setState(() {});

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(newStatus ? 'تم تفعيل المستخدم' : 'تم إيقاف المستخدم'),
        ),
