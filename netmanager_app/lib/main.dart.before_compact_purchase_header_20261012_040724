class NetManagerApp extends StatefulWidget {
  const NetManagerApp({super.key});

  static final GlobalKey<_NetManagerAppState> appKey =
      GlobalKey<_NetManagerAppState>();

  static void changeTheme(String mode) {
    appKey.currentState?.changeTheme(mode);
  }

  static void changeThemeColor(String color) {
    appKey.currentState?.changeThemeColor(color);
  }

  static void changeLanguage(String language) {
    appKey.currentState?.changeLanguage(language);
  }

  @override
  State<NetManagerApp> createState() => _NetManagerAppState();
}

class _NetManagerAppState extends State<NetManagerApp> {
  ThemeMode _themeMode = ThemeMode.system;
  String _themeColor = 'purple';
  String _language = 'ar';

  void changeLanguage(String language) {
    if (language != 'ar' && language != 'en') return;
    if (_language == language) return;

    setState(() {
      _language = language;
    });
  }

  void changeTheme(String mode) {
    final newMode = switch (mode) {
      'light' => ThemeMode.light,
      'dark' => ThemeMode.dark,
      _ => ThemeMode.system,
    };

    if (_themeMode == newMode) return;

    setState(() {
      _themeMode = newMode;
    });
  }

  void changeThemeColor(String color) {
    if (color != 'blue' &&
        color != 'green' &&
        color != 'purple' &&
        color != 'gold') {
      return;
    }

    if (_themeColor == color) return;

    setState(() {
      _themeColor = color;
    });
  }

  // اللون الافتراضي الرسمي للمنصة هو البنفسجي.
  // اختيار المستخدم يغير ألوان الواجهة والخلفيات فقط، وليس الشعار.
  Color get _seedColor => switch (_themeColor) {
    'blue' => const Color(0xFF1976D2),
    'green' => const Color(0xFF2E7D32),
    'gold' => const Color(0xFFB8860B),
    _ => const Color(0xFF414394),
  };

  @override
  Widget build(BuildContext context) {
    final seedColor = _seedColor;

    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'منصة قصر الحجاج',

      builder: (context, child) {
        return Directionality(
          textDirection: _language == 'ar'
              ? TextDirection.rtl
              : TextDirection.ltr,
          child: child ?? const SizedBox.shrink(),
        );
      },

      themeMode: _themeMode,

      theme: ThemeData(
        useMaterial3: true,
        brightness: Brightness.light,
        scaffoldBackgroundColor: const Color(0xFFF6F6FA),
        colorScheme: ColorScheme.fromSeed(
          seedColor: seedColor,
          brightness: Brightness.light,
          surface: Colors.white,
        ),
        appBarTheme: const AppBarTheme(
          backgroundColor: Colors.white,
          foregroundColor: Color(0xFF292B62),
          centerTitle: false,
        ),
        cardTheme: CardThemeData(
          color: Colors.white,
          elevation: 0,
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(18),
            side: const BorderSide(color: Color(0xFFE8E8F0)),
          ),
        ),
        inputDecorationTheme: InputDecorationTheme(
          filled: true,
          fillColor: Colors.white,
          border: OutlineInputBorder(borderRadius: BorderRadius.circular(14)),
        ),
        filledButtonTheme: FilledButtonThemeData(
          style: FilledButton.styleFrom(
            shape: RoundedRectangleBorder(
              borderRadius: BorderRadius.circular(14),
            ),
            padding: const EdgeInsets.symmetric(horizontal: 18, vertical: 14),
          ),
        ),
      ),

      darkTheme: ThemeData(
        useMaterial3: true,
        brightness: Brightness.dark,
        colorScheme: ColorScheme.fromSeed(
          seedColor: seedColor,
          brightness: Brightness.dark,
        ),
      ),

      home: const AutoLoginGate(),
    );
  }
}

class AutoLoginGate extends StatefulWidget {
  const AutoLoginGate({super.key});

  @override
  State<AutoLoginGate> createState() => _AutoLoginGateState();
}

class _AutoLoginGateState extends State<AutoLoginGate> {
  @override
  void initState() {
    super.initState();
    _restoreSession();
  }

  Future<void> _restoreSession() async {
    final user = await restoreLoggedInUser();
    if (!mounted) return;

    if (user == null) {
      Navigator.pushReplacement(
        context,
        MaterialPageRoute(builder: (_) => const LoginPage()),
      );
      return;
    }

    currentUser = user;
    NetManagerApp.changeTheme(user.themeMode);
    NetManagerApp.changeThemeColor(user.themeColor);
    NetManagerApp.changeLanguage(user.language);

    try {
      await Future.wait([
        loadDevices(),
        loadBroadbandProfiles(),
        loadBroadbandAccounts(),
        loadHotspotAccounts(),
        loadPaymentHistory(),
        loadBroadbandPaymentHistory(),
        loadHotspotPaymentHistory(),
        loadAgentBalanceTransactionHistory(),
        loadSubscriberWalletTransactionHistory(),
        loadAgentDeletionTransactionHistory(),
        loadUsageSessions(),
      ]);
    } catch (e) {
      debugPrint('AUTO LOGIN DATA ERROR: $e');
    }

    if (!mounted) return;

    Navigator.pushReplacement(
      context,
      MaterialPageRoute(builder: (_) => DashboardPage(currentUser: user)),
    );
  }

  @override
  Widget build(BuildContext context) {
    return const Scaffold(body: Center(child: CircularProgressIndicator()));
  }
}

class LoginPage extends StatefulWidget {
  const LoginPage({super.key});

  @override
  State<LoginPage> createState() => _LoginPageState();
}

class _LoginPageState extends State<LoginPage> {
  String appVersionText = 'جاري قراءة الإصدار...';

  @override
  void initState() {
    super.initState();
    loadAppVersion();
  }

  Future<void> loadAppVersion() async {
    try {
      final info = await PackageInfo.fromPlatform();
      if (!mounted) return;
      setState(() {
        appVersionText = 'الإصدار v${info.version} (Build ${info.buildNumber})';
      });
    } catch (e) {
      debugPrint('VERSION INFO ERROR: $e');
      if (!mounted) return;
      setState(() {
        appVersionText = 'منصة قصر الحجاج';
      });
    }
  }

  final usernameController = TextEditingController();
  final passwordController = TextEditingController();

  bool hidePassword = true;

  Future<void> login() async {
    final username = usernameController.text.trim();
    final password = passwordController.text;

    if (username.isEmpty || password.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('يرجى إدخال اسم المستخدم وكلمة المرور')),
      );
      return;
    }

    try {
      // إعادة تحميل المستخدمين مباشرة من Supabase
      await loadUsers();

      AppUser? user;

      for (final item in users) {
        if (item.username.trim() == username &&
            item.password == password &&
            item.active) {
          user = item;
          break;
        }
      }

      if (user == null) {
        if (!mounted) return;

        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text(
              'اسم المستخدم أو كلمة المرور غير صحيحة أو الحساب متوقف',
            ),
          ),
        );
        return;
      }

      currentUser = user;

      // تطبيق المظهر واللون المحفوظين لهذا المستخدم مباشرة بعد تسجيل الدخول.
      NetManagerApp.changeTheme(user.themeMode);
      NetManagerApp.changeThemeColor(user.themeColor);
      NetManagerApp.changeLanguage(user.language);

      debugPrint(
        'LOGIN USER => '
        'id=${user.id}, '
        'username=${user.username}, '
        'currency=${user.currency}, '
        'rate=${user.usdToSypRate}',
      );

      try {
        final totalLoginTimer = Stopwatch()..start();
        Future<void> timedLoad(
          String name,
          Future<void> Function() loader,
        ) async {
          final timer = Stopwatch()..start();
          try {
            await loader();
          } catch (e) {
            debugPrint('LOGIN LOAD ERROR $name: $e');
          } finally {
            timer.stop();
            debugPrint('LOGIN PERF $name: ${timer.elapsedMilliseconds} ms');
          }
        }

        await Future.wait([
          timedLoad('loadDevices', loadDevices),
          timedLoad('loadBroadbandProfiles', loadBroadbandProfiles),
          timedLoad('loadBroadbandAccounts', loadBroadbandAccounts),
          timedLoad('loadHotspotAccounts', loadHotspotAccounts),
          timedLoad('loadPaymentHistory', loadPaymentHistory),
          timedLoad('loadBroadbandPaymentHistory', loadBroadbandPaymentHistory),
          timedLoad('loadHotspotPaymentHistory', loadHotspotPaymentHistory),
          timedLoad(
            'loadAgentBalanceTransactionHistory',
            loadAgentBalanceTransactionHistory,
          ),
          timedLoad(
            'loadSubscriberWalletTransactionHistory',
            loadSubscriberWalletTransactionHistory,
          ),
          timedLoad(
            'loadAgentDeletionTransactionHistory',
            loadAgentDeletionTransactionHistory,
          ),
          timedLoad('loadUsageSessions', loadUsageSessions),
        ]);
        totalLoginTimer.stop();
        debugPrint(
          'LOGIN TOTAL DATA: ${totalLoginTimer.elapsedMilliseconds} ms',
        );
      } catch (e) {
        debugPrint('LOAD DEVICES/BROADBAND/HOTSPOT ERROR: $e');
      }

      if (!mounted) return;

      await saveLoggedInUser(user.id);

      if (!mounted) return;

      Navigator.pushReplacement(
        context,
        MaterialPageRoute(builder: (_) => DashboardPage(currentUser: user!)),
      );
    } catch (e) {
      debugPrint('LOGIN ERROR: $e');

      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('تعذر الاتصال بقاعدة البيانات: $e')),
      );
    }
  }

  @override
  void dispose() {
    usernameController.dispose();
    passwordController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Colors.grey.shade100,
      body: SafeArea(
        child: Center(
          child: SingleChildScrollView(
            padding: const EdgeInsets.all(24),
            child: ConstrainedBox(
              constraints: const BoxConstraints(maxWidth: 430),
              child: Card(
                elevation: 6,
                child: Padding(
                  padding: const EdgeInsets.all(28),
                  child: Column(
                    children: [
                      Image.asset(
                        'assets/images/logo_optimized.webp',
                        width: 190,
                        height: 150,
                        fit: BoxFit.contain,
                      ),
                      const SizedBox(height: 18),
                      const Text(
                        'منصة قصر الحجاج',
                        style: TextStyle(
                          fontSize: 25,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                      const SizedBox(height: 6),
                      Text(
                        'إدارة شبكة الإنترنت',
                        style: TextStyle(color: Colors.grey.shade600),
                      ),
                      const SizedBox(height: 30),
                      TextField(
                        controller: usernameController,
                        decoration: const InputDecoration(
                          labelText: 'اسم المستخدم',
                          prefixIcon: Icon(Icons.person),
                          border: OutlineInputBorder(),
                        ),
                      ),
                      const SizedBox(height: 16),
                      TextField(
                        controller: passwordController,
                        obscureText: hidePassword,
                        onSubmitted: (_) => login(),
                        decoration: InputDecoration(
                          labelText: 'كلمة المرور',
                          prefixIcon: const Icon(Icons.lock),
                          border: const OutlineInputBorder(),
                          suffixIcon: IconButton(
                            icon: Icon(
                              hidePassword
                                  ? Icons.visibility
                                  : Icons.visibility_off,
                            ),
                            onPressed: () {
                              setState(() {
                                hidePassword = !hidePassword;
                              });
                            },
                          ),
                        ),
                      ),
                      const SizedBox(height: 22),
                      SizedBox(
                        width: double.infinity,
                        height: 52,
                        child: FilledButton.icon(
                          onPressed: login,
                          icon: const Icon(Icons.login),
                          label: const Text('تسجيل الدخول'),
                        ),
                      ),
                      const SizedBox(height: 18),
                      Text(
                        appVersionText,
                        textAlign: TextAlign.center,
                        style: TextStyle(
                          color: Colors.grey.shade500,
                          fontSize: 12,
                        ),
                      ),
                    ],
