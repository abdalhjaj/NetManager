        ),
      );
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            isArabic
                ? 'تعذر تغيير حالة الزبون: $e'
                : 'Unable to change customer status: $e',
          ),
          backgroundColor: Colors.red,
        ),
      );
    }
  }

  Future<void> deleteAccountingCustomer(Map<String, dynamic> customer) async {
    final isArabic = widget.currentUser.language == 'ar';

    final id = customer['id']?.toString();
    final name = customer['name']?.toString() ?? '';

    if (id == null || id.isEmpty) return;

    final confirmed = await showDialog<bool>(
      context: context,
      builder: (dialogContext) => AlertDialog(
        title: Text(isArabic ? 'حذف الزبون' : 'Delete Customer'),
        content: Text(
          isArabic
              ? 'هل تريد حذف الزبون "$name"؟\n\n'
                    'لن يتم الحذف إذا كان للزبون فواتير أو حركات مالية مرتبطة به.'
              : 'Delete customer "$name"?\n\n'
                    'Deletion will be blocked if the customer has invoices or financial transactions.',
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(dialogContext, false),
            child: Text(isArabic ? 'إلغاء' : 'Cancel'),
          ),
          FilledButton(
            onPressed: () => Navigator.pop(dialogContext, true),
            child: Text(isArabic ? 'حذف' : 'Delete'),
          ),
        ],
      ),
    );

    if (confirmed != true) return;

    try {
      await Supabase.instance.client
          .from('accounting_customers')
          .delete()
          .eq('id', id);

      await loadAccountingCustomers();

      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(isArabic ? 'تم حذف الزبون' : 'Customer deleted'),
          backgroundColor: Colors.green,
        ),
      );
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            isArabic
                ? 'تعذر حذف الزبون. قد تكون لديه فواتير أو حركات مالية مرتبطة به.'
                : 'Unable to delete customer. The customer may have related invoices or transactions.',
          ),
          backgroundColor: Colors.red,
        ),
      );
    }
  }

  Future<void> showAccountingCustomerStatement(
    Map<String, dynamic> customer,
  ) async {
    final isArabic = widget.currentUser.language == 'ar';

    final customerId = customer['id']?.toString();
    final customerName = customer['name']?.toString() ?? '';
    final currency = customer['currency']?.toString() ?? 'USD';

    if (customerId == null || customerId.isEmpty) return;

    bool loading = true;
    bool statementLoadStarted = false;
    List<Map<String, dynamic>> sales = [];
    List<Map<String, dynamic>> transactions = [];

    Future<void> loadStatement(
      void Function(void Function()) setDialogState,
    ) async {
      setDialogState(() {
        loading = true;
      });

      try {
        final transactionsData = await Supabase.instance.client
            .from('accounting_transactions')
            .select()
            .eq('customer_id', customerId);

        transactions = List<Map<String, dynamic>>.from(transactionsData);

        transactions.sort((a, b) {
          final aDate = DateTime.tryParse(
            a['transaction_date']?.toString() ?? '',
          );
          final bDate = DateTime.tryParse(
            b['transaction_date']?.toString() ?? '',
          );

          if (aDate == null && bDate == null) return 0;
          if (aDate == null) return 1;
          if (bDate == null) return -1;

          return bDate.compareTo(aDate);
        });

        // فواتير المبيعات ستتم إضافتها لاحقاً.
        sales = [];
      } catch (e) {
        if (!mounted) return;

        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text(
              isArabic
                  ? 'تعذر تحميل كشف الحساب: $e'
                  : 'Unable to load statement: $e',
            ),
            backgroundColor: Colors.red,
          ),
        );
      } finally {
        setDialogState(() {
          loading = false;
        });
      }
    }

    Future<void> addPayment({
      required bool receipt,
      required void Function(void Function()) setDialogState,
      required BuildContext statementContext,
    }) async {
      final amountController = TextEditingController();
      final notesController = TextEditingController();

      final saved = await showDialog<bool>(
        context: statementContext,
        builder: (paymentContext) => AlertDialog(
          title: Text(
            receipt
                ? (isArabic ? 'قبض من الزبون' : 'Customer Receipt')
                : (isArabic ? 'دفع للزبون' : 'Customer Payment'),
          ),
          content: SizedBox(
            width: 420,
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                TextField(
                  controller: amountController,
                  autofocus: true,
                  keyboardType: const TextInputType.numberWithOptions(
                    decimal: true,
                  ),
                  decoration: InputDecoration(
                    labelText: isArabic ? 'المبلغ' : 'Amount',
                    suffixText: currency,
                    prefixIcon: Icon(
                      receipt
                          ? Icons.south_west_rounded
                          : Icons.north_east_rounded,
                    ),
                  ),
                ),
                const SizedBox(height: 12),
                TextField(
                  controller: notesController,
                  maxLines: 3,
                  decoration: InputDecoration(
                    labelText: isArabic ? 'البيان / ملاحظات' : 'Notes',
                    prefixIcon: const Icon(Icons.notes),
                  ),
                ),
              ],
            ),
          ),
          actions: [
            TextButton(
              onPressed: () => Navigator.pop(paymentContext, false),
              child: Text(isArabic ? 'إلغاء' : 'Cancel'),
            ),
            FilledButton.icon(
              icon: const Icon(Icons.save),
              label: Text(isArabic ? 'حفظ' : 'Save'),
              onPressed: () async {
                final amount = double.tryParse(amountController.text.trim());

                if (amount == null || amount <= 0) {
                  ScaffoldMessenger.of(paymentContext).showSnackBar(
                    SnackBar(
                      content: Text(
                        isArabic
                            ? 'أدخل مبلغًا صحيحًا أكبر من صفر'
                            : 'Enter a valid amount greater than zero',
                      ),
                    ),
                  );
                  return;
                }

                try {
                  await Supabase.instance.client
                      .from('accounting_transactions')
                      .insert({
                        'transaction_type': receipt
                            ? 'customer_receipt'
                            : 'customer_payment',
                        'customer_id': customerId,
                        'amount': amount,
                        'currency': currency,
                        'notes': notesController.text.trim().isEmpty
                            ? null
                            : notesController.text.trim(),
                        'transaction_date': DateTime.now().toIso8601String(),
                        'created_by': widget.currentUser.id,
                      });

                  if (!paymentContext.mounted) return;
                  Navigator.pop(paymentContext, true);
                } catch (e) {
                  if (!paymentContext.mounted) return;

                  ScaffoldMessenger.of(paymentContext).showSnackBar(
                    SnackBar(
                      content: Text(
                        isArabic
                            ? 'تعذر تسجيل الحركة: $e'
                            : 'Unable to save transaction: $e',
                      ),
                      backgroundColor: Colors.red,
                    ),
                  );
                }
              },
            ),
          ],
        ),
      );

      amountController.dispose();
      notesController.dispose();

      if (saved == true) {
        await loadStatement(setDialogState);
      }
    }

    await showDialog<void>(
      context: context,
      builder: (statementContext) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            if (!statementLoadStarted) {
              statementLoadStarted = true;

              WidgetsBinding.instance.addPostFrameCallback((_) {
                if (statementContext.mounted) {
                  loadStatement(setDialogState);
                }
              });
            }

            final openingBalance =
                (customer['opening_balance'] as num?)?.toDouble() ?? 0;

            double salesDebt = 0;

            for (final sale in sales) {
              final total = (sale['total'] as num?)?.toDouble() ?? 0;
              final paid = (sale['paid_amount'] as num?)?.toDouble() ?? 0;

              salesDebt += total - paid;
            }

            double receipts = 0;
            double customerPayments = 0;

            for (final transaction in transactions) {
              final amount = (transaction['amount'] as num?)?.toDouble() ?? 0;

              final type = transaction['transaction_type']?.toString() ?? '';

              if (type == 'customer_receipt') {
                receipts += amount;
              } else if (type == 'customer_payment') {
                customerPayments += amount;
              }
            }

            // موجب = على الزبون
            // سالب = للزبون
            final currentBalance =
                openingBalance + salesDebt - receipts + customerPayments;

            final entries = <Map<String, dynamic>>[];

            for (final sale in sales) {
              entries.add({
                '_kind': 'sale',
                '_date': sale['invoice_date']?.toString() ?? '',
                ...sale,
              });
            }

            for (final transaction in transactions) {
              entries.add({
                '_kind': 'transaction',
                '_date': transaction['transaction_date']?.toString() ?? '',
                ...transaction,
              });
            }

            entries.sort((a, b) {
              final aDate =
                  DateTime.tryParse(a['_date']?.toString() ?? '') ??
                  DateTime.fromMillisecondsSinceEpoch(0);

              final bDate =
                  DateTime.tryParse(b['_date']?.toString() ?? '') ??
                  DateTime.fromMillisecondsSinceEpoch(0);

              return bDate.compareTo(aDate);
            });

            String formatStatementDate(dynamic value) {
              final date = DateTime.tryParse(value?.toString() ?? '');

              if (date == null) return '-';

              final local = date.toLocal();

              return '${local.year.toString().padLeft(4, '0')}-'
                  '${local.month.toString().padLeft(2, '0')}-'
                  '${local.day.toString().padLeft(2, '0')} '
                  '${local.hour.toString().padLeft(2, '0')}:'
                  '${local.minute.toString().padLeft(2, '0')}';
            }

            Widget summaryBox(String title, String value, IconData icon) {
              return Container(
                padding: const EdgeInsets.all(12),
                decoration: BoxDecoration(
                  color: Theme.of(context).colorScheme.surfaceContainerHighest,
                  borderRadius: BorderRadius.circular(12),
                ),
                child: Row(
                  children: [
                    Icon(icon, color: Theme.of(context).colorScheme.primary),
                    const SizedBox(width: 8),
                    Expanded(
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Text(
                            title,
                            style: Theme.of(context).textTheme.bodySmall,
                          ),
                          Text(
                            value,
                            style: const TextStyle(
                              fontWeight: FontWeight.bold,
                              fontSize: 16,
                            ),
                          ),
                        ],
                      ),
                    ),
                  ],
                ),
              );
            }

            return AlertDialog(
              title: Row(
                children: [
                  const Icon(Icons.receipt_long_rounded),
                  const SizedBox(width: 8),
                  Expanded(
                    child: Text(
                      '${isArabic ? 'كشف حساب' : 'Statement'} - '
                      '$customerName',
                    ),
                  ),
                  IconButton(
                    tooltip: isArabic ? 'تحديث' : 'Refresh',
                    onPressed: loading
                        ? null
                        : () => loadStatement(setDialogState),
                    icon: const Icon(Icons.refresh),
                  ),
                ],
              ),
              content: SizedBox(
                width: MediaQuery.sizeOf(context).width < 600
                    ? MediaQuery.sizeOf(context).width * 0.88
                    : 850,
                height: MediaQuery.sizeOf(context).height < 750
                    ? MediaQuery.sizeOf(context).height * 0.65
                    : 620,
                child: loading
                    ? const Center(child: CircularProgressIndicator())
                    : Column(
                        children: [
                          LayoutBuilder(
                            builder: (context, constraints) {
                              final boxes = [
                                summaryBox(
                                  isArabic
                                      ? 'الرصيد الافتتاحي'
                                      : 'Opening Balance',
                                  '${openingBalance.toStringAsFixed(2)} $currency',
                                  Icons.flag_outlined,
                                ),
                                summaryBox(
                                  isArabic ? 'مبيعات آجلة' : 'Sales Due',
                                  '${salesDebt.toStringAsFixed(2)} $currency',
                                  Icons.receipt_long_outlined,
                                ),
                                summaryBox(
                                  isArabic
                                      ? 'إجمالي المقبوض'
                                      : 'Total Received',
                                  '${receipts.toStringAsFixed(2)} $currency',
                                  Icons.south_west_rounded,
                                ),
                                summaryBox(
                                  isArabic
                                      ? 'الرصيد الحالي'
                                      : 'Current Balance',
                                  '${currentBalance.abs().toStringAsFixed(2)} $currency '
                                  '${currentBalance > 0
                                      ? (isArabic ? 'عليه' : 'Due')
                                      : currentBalance < 0
                                      ? (isArabic ? 'له' : 'Credit')
                                      : ''}',
                                  Icons.account_balance_wallet_outlined,
                                ),
                              ];

                              if (constraints.maxWidth >= 700) {
                                return Row(
                                  children: [
                                    for (var i = 0; i < boxes.length; i++) ...[
                                      Expanded(child: boxes[i]),
                                      if (i < boxes.length - 1)
                                        const SizedBox(width: 8),
                                    ],
                                  ],
                                );
                              }

                              return Column(
                                children: [
                                  for (var i = 0; i < boxes.length; i++) ...[
                                    boxes[i],
                                    if (i < boxes.length - 1)
                                      const SizedBox(height: 8),
                                  ],
                                ],
                              );
                            },
                          ),

                          const SizedBox(height: 14),

                          Row(
                            children: [
                              Expanded(
                                child: FilledButton.icon(
                                  onPressed: () => addPayment(
                                    receipt: true,
                                    setDialogState: setDialogState,
                                    statementContext: statementContext,
                                  ),
                                  icon: const Icon(Icons.south_west_rounded),
                                  label: Text(
                                    isArabic
                                        ? 'قبض من الزبون'
                                        : 'Receive Payment',
                                  ),
                                ),
                              ),
                              const SizedBox(width: 10),
                              Expanded(
                                child: OutlinedButton.icon(
                                  onPressed: () => addPayment(
                                    receipt: false,
                                    setDialogState: setDialogState,
                                    statementContext: statementContext,
                                  ),
                                  icon: const Icon(Icons.north_east_rounded),
                                  label: Text(
                                    isArabic ? 'دفع للزبون' : 'Pay Customer',
                                  ),
                                ),
                              ),
                            ],
                          ),

                          const SizedBox(height: 14),

                          Expanded(
                            child: entries.isEmpty
                                ? Center(
                                    child: Text(
                                      isArabic
                                          ? 'لا توجد حركات على الحساب حتى الآن'
                                          : 'No account transactions yet',
                                    ),
                                  )
                                : ListView.separated(
                                    itemCount: entries.length,
                                    separatorBuilder: (_, _) =>
                                        const Divider(height: 1),
                                    itemBuilder: (context, index) {
                                      final entry = entries[index];

                                      if (entry['_kind'] == 'sale') {
                                        final total =
                                            (entry['total'] as num?)
                                                ?.toDouble() ??
                                            0;

                                        final paid =
                                            (entry['paid_amount'] as num?)
                                                ?.toDouble() ??
                                            0;

                                        final due = total - paid;

                                        return ListTile(
                                          leading: const CircleAvatar(
                                            child: Icon(Icons.receipt_long),
                                          ),
                                          title: Text(
                                            '${isArabic ? 'فاتورة مبيعات' : 'Sales Invoice'} '
                                            '#${entry['invoice_number'] ?? ''}',
                                          ),
                                          subtitle: Text(
                                            formatStatementDate(
                                              entry['invoice_date'],
                                            ),
                                          ),
                                          trailing: Text(
                                            '+${due.toStringAsFixed(2)} $currency',
                                            style: const TextStyle(
                                              fontWeight: FontWeight.bold,
                                            ),
                                          ),
                                        );
                                      }

                                      final type =
                                          entry['transaction_type']
                                              ?.toString() ??
                                          '';

                                      final amount =
                                          (entry['amount'] as num?)
                                              ?.toDouble() ??
                                          0;

                                      final isReceipt =
                                          type == 'customer_receipt';

                                      return ListTile(
                                        leading: CircleAvatar(
                                          child: Icon(
                                            isReceipt
                                                ? Icons.south_west_rounded
                                                : Icons.north_east_rounded,
                                          ),
                                        ),
                                        title: Text(
                                          isReceipt
                                              ? (isArabic
                                                    ? 'قبض من الزبون'
                                                    : 'Customer Receipt')
                                              : (isArabic
                                                    ? 'دفع للزبون'
                                                    : 'Customer Payment'),
                                        ),
                                        subtitle: Text(
                                          [
                                            formatStatementDate(
                                              entry['transaction_date'],
                                            ),
                                            if ((entry['notes']?.toString() ??
                                                    '')
                                                .isNotEmpty)
                                              entry['notes'].toString(),
                                          ].join(' • '),
                                        ),
                                        trailing: Text(
                                          '${isReceipt ? '-' : '+'}'
                                          '${amount.toStringAsFixed(2)} $currency',
                                          style: const TextStyle(
                                            fontWeight: FontWeight.bold,
                                          ),
                                        ),
                                      );
                                    },
                                  ),
                          ),
                        ],
                      ),
              ),
              actions: [
                TextButton(
                  onPressed: () => Navigator.pop(statementContext),
                  child: Text(isArabic ? 'إغلاق' : 'Close'),
                ),
              ],
            );
          },
        );
      },
    );

    await loadAccountingCustomers();
  }

