class Subscription {
  String id;
  String userId;
  String? deviceId;
  double amount;
  String currency;
  DateTime? createdAt;
  DateTime? dueDate;
  String status;

  Subscription({
    this.id = '',
    required this.userId,
    this.deviceId,
    required this.amount,
    required this.currency,
    this.createdAt,
    this.dueDate,
    this.status = 'غير مدفوع',
  });

  factory Subscription.fromJson(Map<String, dynamic> json) {
    return Subscription(
