  Future<void> depositSubscriberWallet({
    required String accountType,
    required String accountId,
    required String username,
    required String ownerUserId,
    required double currentWalletUsd,
  }) async {
    final amountController = TextEditingController();

    final isAgent = widget.currentUser.role == 'وكيل';

    final owner = users.where((u) => u.id == ownerUserId).firstOrNull;

    final ownerCurrency = owner?.currency ?? 'USD';

    final currentWalletDisplay = _usdToOwnerCurrency(
      currentWalletUsd,
      ownerUserId,
    );

    final agentBalanceUsd = widget.currentUser.agentBalance;

    final result = await showDialog<double>(
      context: context,
      builder: (dialogContext) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            final amountDisplay =
                double.tryParse(amountController.text.trim()) ?? 0;

            final amountUsd = _ownerCurrencyToUsd(amountDisplay, ownerUserId);

            final walletAfterDisplay = currentWalletDisplay + amountDisplay;

            final agentBalanceAfterUsd = agentBalanceUsd - amountUsd;

            final agentBalanceDisplay = _usdToOwnerCurrency(
              agentBalanceUsd,
              ownerUserId,
            );

            final agentBalanceAfterDisplay = _usdToOwnerCurrency(
              agentBalanceAfterUsd,
              ownerUserId,
            );

            String money(double value) {
              if (ownerCurrency == 'SYP') {
                return '${value.toStringAsFixed(0)} SYP';
              }

              return '${value.toStringAsFixed(2)} USD';
            }

            return AlertDialog(
              title: Row(
                children: [
                  const Icon(Icons.account_balance_wallet_outlined),
                  const SizedBox(width: 8),
                  Expanded(child: Text('إيداع رصيد - $username')),
                ],
              ),
              content: SizedBox(
                width: 430,
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  crossAxisAlignment: CrossAxisAlignment.stretch,
                  children: [
                    Container(
                      padding: const EdgeInsets.all(12),
                      decoration: BoxDecoration(
                        color: Colors.blue.withValues(alpha: 0.08),
                        borderRadius: BorderRadius.circular(12),
                      ),
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Text(
                            'رصيد محفظة المشترك الحالي',
                            style: TextStyle(color: Colors.grey.shade700),
                          ),
                          const SizedBox(height: 4),
                          Text(
                            money(currentWalletDisplay),
                            style: const TextStyle(
                              fontSize: 20,
                              fontWeight: FontWeight.bold,
                            ),
                          ),
                        ],
                      ),
                    ),

                    const SizedBox(height: 16),

                    TextField(
                      controller: amountController,
                      autofocus: true,
                      keyboardType: const TextInputType.numberWithOptions(
                        decimal: true,
                      ),
                      decoration: InputDecoration(
                        labelText: 'مبلغ الإيداع',
                        suffixText: ownerCurrency,
                        border: const OutlineInputBorder(),
                      ),
                      onChanged: (_) => setDialogState(() {}),
                    ),

                    const SizedBox(height: 14),

                    Text(
                      'رصيد المحفظة بعد الإيداع: '
                      '${money(walletAfterDisplay)}',
                      style: const TextStyle(fontWeight: FontWeight.bold),
                    ),

                    if (isAgent) ...[
                      const SizedBox(height: 18),
                      const Divider(),
                      const SizedBox(height: 8),

                      Text(
                        'رصيد الوكيل',
                        style: TextStyle(
                          color: Colors.grey.shade700,
                          fontWeight: FontWeight.bold,
                        ),
                      ),

                      const SizedBox(height: 8),

                      Text('قبل العملية: ${money(agentBalanceDisplay)}'),

                      const SizedBox(height: 5),

                      Text(
                        'بعد العملية: ${money(agentBalanceAfterDisplay)}',
                        style: TextStyle(
                          color: agentBalanceAfterUsd < -0.000001
                              ? Colors.red
                              : Colors.green.shade700,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                    ],
                  ],
                ),
              ),
              actions: [
                TextButton(
                  onPressed: () => Navigator.pop(dialogContext),
                  child: const Text('إلغاء'),
                ),
                FilledButton.icon(
                  onPressed: () {
                    final amountDisplay =
                        double.tryParse(amountController.text.trim()) ?? 0;

                    if (amountDisplay <= 0) {
                      ScaffoldMessenger.of(dialogContext).showSnackBar(
                        const SnackBar(
                          content: Text('أدخل مبلغ إيداع أكبر من صفر'),
                        ),
                      );
                      return;
                    }

                    final amountUsd = _ownerCurrencyToUsd(
                      amountDisplay,
                      ownerUserId,
                    );

                    if (isAgent && amountUsd > agentBalanceUsd + 0.000001) {
                      ScaffoldMessenger.of(dialogContext).showSnackBar(
                        const SnackBar(
                          content: Text('رصيد الوكيل غير كافٍ لتنفيذ الإيداع'),
                          backgroundColor: Colors.red,
                        ),
                      );
                      return;
                    }

                    Navigator.pop(dialogContext, amountUsd);
                  },
                  icon: const Icon(Icons.add_card),
                  label: const Text('إيداع'),
                ),
              ],
            );
          },
        );
      },
    );

    amountController.dispose();

    if (result == null || result <= 0) return;

    try {
      final supabase = Supabase.instance.client;

      await supabase.rpc(
        'deposit_subscriber_wallet',
        params: {
          'p_actor_id': widget.currentUser.id,
          'p_account_type': accountType,
          'p_account_id': accountId,
          'p_amount_usd': result,
          'p_description':
              'إيداع رصيد '
              '${accountType == 'hotspot' ? 'Hotspot' : 'Broadband'}'
              ' - المشترك: $username',
        },
      );

      // إعادة تحميل الحساب وسجل الدفعات بعد الإيداع.
      // الإيداع قد يسدد جزءًا أو كامل الدين، لذلك نحدث الاثنين.
      if (accountType == 'hotspot') {
        await loadHotspotAccounts();
        await loadHotspotPaymentHistory();
      } else {
        await loadBroadbandAccounts();
        await loadBroadbandPaymentHistory();
      }

      // تحديث سجل إيداعات محفظة المشترك مباشرة
      // حتى تظهر العملية في آخر العمليات بدون الحاجة للخروج.
      await loadSubscriberWalletTransactionHistory();

      // إذا كان المنفذ وكيلًا:
      // 1) تحديث رصيد الوكيل.
      // 2) تحديث سجل حركاته حتى يظهر الإيداع الأصفر فورًا
      //    في "آخر عمليات الوكيل".
      if (isAgent) {
        await loadUsers();
        await loadAgentBalanceTransactionHistory();

        for (final user in users) {
          if (user.id == widget.currentUser.id) {
            widget.currentUser.agentBalance = user.agentBalance;
            currentUser?.agentBalance = user.agentBalance;
            break;
          }
        }
      }

      if (!mounted) return;

      setState(() {});

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('تم إيداع الرصيد في محفظة $username بنجاح ✓'),
          backgroundColor: Colors.green,
        ),
      );
    } catch (e) {
      if (!mounted) return;

      String message = e.toString();

      if (message.contains('INSUFFICIENT_AGENT_BALANCE')) {
        message = 'رصيد الوكيل غير كافٍ لتنفيذ الإيداع';
      } else if (message.contains('ACCOUNT_NOT_OWNED_BY_AGENT_OWNER')) {
        message = 'هذا المشترك غير تابع لصاحب الوكيل';
      } else if (message.contains('ACCOUNT_ACCESS_DENIED')) {
        message = 'ليس لديك صلاحية على هذا الحساب';
      } else if (message.contains('INVALID_AMOUNT')) {
        message = 'مبلغ الإيداع غير صحيح';
      }

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text(message), backgroundColor: Colors.red),
      );
    }
  }

