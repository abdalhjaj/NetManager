                    savingInvoice = false;
                  });

                  ScaffoldMessenger.of(context).showSnackBar(
                    SnackBar(
                      content: Text(
                        isArabic
                            ? 'تعذر حذف الفاتورة'
                            : 'Unable to delete invoice',
                      ),
                    ),
                  );
                }
