  Future<void> renewBroadbandAccount(BroadbandAccount account) async {
    final ownerCurrency = _accountOwnerCurrency(account.userId);

    final oldDebtUsd = account.remainingAmount > 0
        ? account.remainingAmount
        : 0.0;

    final oldDebtDisplay = _usdToOwnerCurrency(oldDebtUsd, account.userId);

    final currentPriceDisplay = _usdToOwnerCurrency(
      account.price,
