        recentPayments.add({
          'amount': (transaction['amount_usd'] as num?)?.toDouble() ?? 0,
          'currency': 'USD',
          'created_at': transaction['created_at'],
          'description': transaction['description'],
          'created_by': transaction['created_by'],
