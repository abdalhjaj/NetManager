  Future<String?> _uploadHotspotDesignBackground() async {
    try {
      final file = await FilePicker.pickFile(
        type: FileType.custom,
        allowedExtensions: const ['png', 'jpg', 'jpeg', 'webp'],
      );

      if (file == null) return null;

      final bytes = await file.readAsBytes();

      if (bytes.length > 8 * 1024 * 1024) {
        throw Exception('حجم الصورة يجب ألا يتجاوز 8 MB');
      }

      final extension = (file.extension ?? 'jpg').toLowerCase();

      final safeExtension =
          <String>{'png', 'jpg', 'jpeg', 'webp'}.contains(extension)
          ? extension
          : 'jpg';

      final contentType = safeExtension == 'png'
          ? 'image/png'
          : safeExtension == 'webp'
          ? 'image/webp'
          : 'image/jpeg';

      final fileName =
          'background_${DateTime.now().microsecondsSinceEpoch}.$safeExtension';

      final storagePath = '${widget.currentUser.id}/card-backgrounds/$fileName';

