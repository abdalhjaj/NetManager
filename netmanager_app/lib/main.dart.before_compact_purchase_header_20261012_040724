    setState(() {
      widget.currentUser.themeColor = color;

      if (currentUser?.id == widget.currentUser.id) {
        currentUser!.themeColor = color;
      }
    });

    NetManagerApp.changeThemeColor(color);

    try {
      await Supabase.instance.client
          .from('app_users')
          .update({'theme_color': color})
          .eq('id', widget.currentUser.id);

