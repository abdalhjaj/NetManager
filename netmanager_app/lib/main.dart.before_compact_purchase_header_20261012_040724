                        ? 'إيداع'
                        : 'سحب',
                  ),
                ),
              ],
            );
          },
        );
      },
    );

    amountController.dispose();
    descriptionController.dispose();

    if (saved != true) return false;

    if (mounted) {
      setState(() {});
    }

    return true;
  }

