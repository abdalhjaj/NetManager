                                .eq('parent_user_id', widget.currentUser.id);

                            await loadUsers();

                            final updatedAgent = users
                                .where((u) => u.id == agent.id)
                                .firstOrNull;

                            if (updatedAgent != null) {
                              agent.name = updatedAgent.name;
                              agent.username = updatedAgent.username;
                              agent.password = updatedAgent.password;
