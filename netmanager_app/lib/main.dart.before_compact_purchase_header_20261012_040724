  }) async {
    final items = cartItems ?? <Map<String, dynamic>>[];
    final isArabic = widget.currentUser.language == 'ar';

    try {
      final data = await Supabase.instance.client
          .from('accounting_products')
          .select()
          .eq('created_by', widget.currentUser.id)
          .eq('active', true)
          .order('name');

      if (!mounted) return;

      final products = List<Map<String, dynamic>>.from(data);

      if (products.isEmpty) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text(
              isArabic ? 'لا توجد مواد فعالة.' : 'No active products.',
            ),
          ),
        );
        return;
      }

      String? productId;
      final quantityController = TextEditingController(text: '1');
      final salePriceController = TextEditingController();

      final saleItem = await showDialog<Map<String, dynamic>>(
        context: context,
        builder: (dialogContext) {
          return StatefulBuilder(
            builder: (context, setDialogState) {
              Map<String, dynamic>? selectedProduct;

              if (productId != null) {
                for (final product in products) {
                  if (product['id'].toString() == productId) {
                    selectedProduct = product;
                    break;
                  }
                }
              }

              final stock =
                  (selectedProduct?['quantity'] as num?)?.toDouble() ?? 0;

              final defaultSalePrice =
                  (selectedProduct?['sale_price'] as num?)?.toDouble() ?? 0;

              final salePrice =
                  double.tryParse(salePriceController.text.trim()) ?? 0;

              final quantity =
                  double.tryParse(quantityController.text.trim()) ?? 0;

              final total = quantity * salePrice;

              return AlertDialog(
                title: Text(isArabic ? 'إضافة مادة للفاتورة' : 'Add Product'),
                content: SizedBox(
                  width: 500,
                  child: Column(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      DropdownButtonFormField<String>(
                        initialValue: productId,
                        decoration: InputDecoration(
                          labelText: isArabic ? 'المادة' : 'Product',
                          border: const OutlineInputBorder(),
                        ),
                        items: products.map((product) {
                          return DropdownMenuItem<String>(
                            value: product['id'].toString(),
                            child: Text(product['name']?.toString() ?? '-'),
                          );
                        }).toList(),
                        onChanged: (value) {
                          setDialogState(() {
                            productId = value;

                            if (value == null) {
                              salePriceController.clear();
                              return;
                            }

                            for (final product in products) {
                              if (product['id'].toString() == value) {
                                final price =
                                    (product['sale_price'] as num?)
                                        ?.toDouble() ??
                                    0;

                                salePriceController.text = price
                                    .toStringAsFixed(2);
                                break;
                              }
                            }
                          });
                        },
                      ),
                      const SizedBox(height: 12),
                      if (selectedProduct != null)
                        Align(
                          alignment: AlignmentDirectional.centerStart,
                          child: Text(
                            '${isArabic ? 'المخزون' : 'Stock'}: '
                            '${stock.toStringAsFixed(2)}'
                            '   •   '
                            '${isArabic ? 'السعر الافتراضي' : 'Default Price'}: '
                            '${defaultSalePrice.toStringAsFixed(2)}',
                          ),
                        ),
                      const SizedBox(height: 12),
                      TextField(
                        controller: salePriceController,
                        keyboardType: const TextInputType.numberWithOptions(
                          decimal: true,
                        ),
                        decoration: InputDecoration(
                          labelText: isArabic
                              ? 'سعر البيع في الفاتورة'
                              : 'Invoice Sale Price',
                          border: const OutlineInputBorder(),
                        ),
                        onChanged: (_) {
                          setDialogState(() {});
                        },
                      ),
                      const SizedBox(height: 12),
                      TextField(
                        controller: quantityController,
                        keyboardType: const TextInputType.numberWithOptions(
                          decimal: true,
                        ),
                        decoration: InputDecoration(
                          labelText: isArabic ? 'الكمية' : 'Quantity',
                          border: const OutlineInputBorder(),
                        ),
                        onChanged: (_) {
                          setDialogState(() {});
                        },
                      ),
                      const SizedBox(height: 12),
                      Align(
                        alignment: AlignmentDirectional.centerStart,
                        child: Text(
                          '${isArabic ? 'الإجمالي' : 'Total'}: '
                          '${total.toStringAsFixed(2)}',
                          style: const TextStyle(fontWeight: FontWeight.bold),
                        ),
                      ),
                    ],
                  ),
                ),
                actions: [
                  TextButton(
                    onPressed: () {
                      Navigator.pop(dialogContext);
                    },
                    child: Text(isArabic ? 'إلغاء' : 'Cancel'),
                  ),
                  FilledButton(
                    onPressed:
                        productId == null || quantity <= 0 || salePrice < 0
                        ? null
                        : () {
                            if (quantity > stock) {
                              ScaffoldMessenger.of(context).showSnackBar(
                                SnackBar(
                                  content: Text(
                                    isArabic
                                        ? 'الكمية أكبر من المخزون المتاح'
                                        : 'Quantity exceeds available stock',
                                  ),
                                ),
                              );
                              return;
                            }

                            if (selectedProduct == null) return;

                            Navigator.pop(dialogContext, <String, dynamic>{
                              'product_id': selectedProduct['id'],
                              'name': selectedProduct['name'],
                              'quantity': quantity,
                              'unit_price': salePrice,
                              'unit_cost':
                                  (selectedProduct['purchase_price'] as num?)
                                      ?.toDouble() ??
                                  0,
                              'stock': stock,
                              'total': quantity * salePrice,
                            });
                          },
                    child: Text(isArabic ? 'إضافة' : 'Add'),
                  ),
                ],
              );
            },
          );
        },
      );

      quantityController.dispose();
      salePriceController.dispose();

      if (saleItem != null) {
        final existingIndex = items.indexWhere(
          (item) =>
              item['product_id']?.toString() ==
              saleItem['product_id']?.toString(),
        );

        if (existingIndex >= 0) {
          final existing = items[existingIndex];

          final oldQuantity = (existing['quantity'] as num?)?.toDouble() ?? 0;
          final addedQuantity = (saleItem['quantity'] as num?)?.toDouble() ?? 0;
          final availableStock = (saleItem['stock'] as num?)?.toDouble() ?? 0;

          final newQuantity = oldQuantity + addedQuantity;

          if (newQuantity > availableStock) {
            if (!mounted) return;

            ScaffoldMessenger.of(context).showSnackBar(
              SnackBar(
                content: Text(
                  isArabic
                      ? 'إجمالي الكمية لهذه المادة أكبر من المخزون المتاح'
                      : 'Total quantity exceeds available stock',
                ),
              ),
            );

            await openAccountingSaleCart(customerId, items);
            return;
          }

          existing['quantity'] = newQuantity;
          existing['unit_price'] = saleItem['unit_price'];
          existing['unit_cost'] = saleItem['unit_cost'];
          existing['stock'] = saleItem['stock'];
          existing['total'] =
              newQuantity * ((saleItem['unit_price'] as num?)?.toDouble() ?? 0);
        } else {
          items.add(Map<String, dynamic>.from(saleItem));
        }

        if (!mounted) return;
        await openAccountingSaleCart(customerId, items);
      }
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            isArabic ? 'تعذر تحميل المواد: $e' : 'Unable to load products: $e',
          ),
        ),
      );
    }
  }

