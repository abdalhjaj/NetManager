  Future<void> addAccountingInventoryMovement(
    Map<String, dynamic> product,
  ) async {
    final isArabic = widget.currentUser.language == 'ar';

    final productId = product['id']?.toString() ?? '';
    final productName = product['name']?.toString() ?? '';
    final unit = product['unit']?.toString() ?? (isArabic ? 'قطعة' : 'Piece');

    if (productId.isEmpty) return;

    final currentQuantity = (product['quantity'] as num?)?.toDouble() ?? 0;

    final quantityController = TextEditingController();
    final notesController = TextEditingController();

    String movementType = 'stock_in';
    bool saving = false;

    final saved = await showDialog<bool>(
      context: context,
      barrierDismissible: false,
      builder: (dialogContext) => StatefulBuilder(
        builder: (context, setDialogState) {
          return AlertDialog(
            title: Text(
              '${isArabic ? 'حركة مخزون' : 'Inventory Movement'} - $productName',
            ),
            content: SizedBox(
              width: 460,
              child: SingleChildScrollView(
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    ListTile(
                      contentPadding: EdgeInsets.zero,
                      leading: const Icon(Icons.inventory_2_outlined),
                      title: Text(
                        isArabic ? 'الكمية الحالية' : 'Current quantity',
                      ),
                      trailing: Text(
                        '${currentQuantity.toStringAsFixed(2)} $unit',
                        style: const TextStyle(fontWeight: FontWeight.bold),
                      ),
                    ),
                    const SizedBox(height: 12),
                    DropdownButtonFormField<String>(
                      initialValue: movementType,
                      decoration: InputDecoration(
                        labelText: isArabic ? 'نوع الحركة' : 'Movement type',
                        prefixIcon: const Icon(Icons.swap_vert_rounded),
                      ),
                      items: [
                        DropdownMenuItem(
                          value: 'stock_in',
                          child: Text(
                            isArabic ? 'إدخال إلى المخزون' : 'Stock In',
                          ),
                        ),
                        DropdownMenuItem(
                          value: 'stock_out',
                          child: Text(
                            isArabic ? 'إخراج من المخزون' : 'Stock Out',
                          ),
                        ),
                      ],
                      onChanged: saving
                          ? null
                          : (value) {
                              if (value == null) return;

                              setDialogState(() {
                                movementType = value;
                              });
                            },
                    ),
                    const SizedBox(height: 12),
                    TextField(
                      controller: quantityController,
                      enabled: !saving,
                      autofocus: true,
                      keyboardType: const TextInputType.numberWithOptions(
                        decimal: true,
                      ),
                      decoration: InputDecoration(
                        labelText: isArabic ? 'الكمية' : 'Quantity',
                        suffixText: unit,
                        prefixIcon: const Icon(Icons.numbers_rounded),
                      ),
                    ),
                    const SizedBox(height: 12),
                    TextField(
                      controller: notesController,
                      enabled: !saving,
                      minLines: 2,
                      maxLines: 4,
                      decoration: InputDecoration(
                        labelText: isArabic ? 'البيان / ملاحظات' : 'Notes',
                        prefixIcon: const Icon(Icons.notes),
                      ),
                    ),
                  ],
                ),
              ),
            ),
            actions: [
              TextButton(
                onPressed: saving
                    ? null
                    : () => Navigator.pop(dialogContext, false),
                child: Text(isArabic ? 'إلغاء' : 'Cancel'),
              ),
              FilledButton.icon(
                icon: saving
                    ? const SizedBox(
                        width: 18,
                        height: 18,
                        child: CircularProgressIndicator(strokeWidth: 2),
                      )
                    : const Icon(Icons.save),
                label: Text(
                  saving
                      ? (isArabic ? 'جارٍ الحفظ...' : 'Saving...')
                      : (isArabic ? 'حفظ الحركة' : 'Save'),
                ),
                onPressed: saving
                    ? null
                    : () async {
                        final quantity = double.tryParse(
                          quantityController.text.trim().replaceAll(',', '.'),
                        );

                        if (quantity == null || quantity <= 0) {
                          ScaffoldMessenger.of(dialogContext).showSnackBar(
                            SnackBar(
                              content: Text(
                                isArabic ? 'أدخل كمية صحيحة أكبر من صفر' : 'Enter a valid quantity greater than zero',
                              ),
                            ),
                          );
                          return;
                        }

                        final isStockIn = movementType == 'stock_in';

                        final quantityAfter = isStockIn
                            ? currentQuantity + quantity
                            : currentQuantity - quantity;

                        if (quantityAfter < 0) {
                          ScaffoldMessenger.of(dialogContext).showSnackBar(
                            SnackBar(
                              content: Text(
                                isArabic
                                    ? 'الكمية المطلوبة أكبر من الكمية الموجودة في المخزون'
                                    : 'Requested quantity exceeds available stock',
                              ),
                              backgroundColor: Colors.red,
                            ),
                          );
                          return;
                        }

                        setDialogState(() {
                          saving = true;
                        });

                        try {
                          // تحديث كمية المادة.
                          await Supabase.instance.client
                              .from('accounting_products')
                              .update({
                                'quantity': quantityAfter,
                                'updated_at': DateTime.now().toIso8601String(),
                              })
                              .eq('id', productId);

                          try {
                            // تسجيل الحركة في سجل المخزون.
                            await Supabase.instance.client
                                .from('accounting_inventory_movements')
                                .insert({
                                  'product_id': productId,
                                  'movement_type': movementType,
                                  'quantity': quantity,
                                  'quantity_before': currentQuantity,
                                  'quantity_after': quantityAfter,
                                  'notes': notesController.text.trim().isEmpty
                                      ? null
                                      : notesController.text.trim(),
                                  'movement_date': DateTime.now()
                                      .toIso8601String(),
                                  'created_by': widget.currentUser.id,
                                });
                          } catch (movementError) {
                            // إذا فشل تسجيل الحركة نعيد الكمية كما كانت.
                            await Supabase.instance.client
                                .from('accounting_products')
                                .update({
                                  'quantity': currentQuantity,
                                  'updated_at': DateTime.now()
                                      .toIso8601String(),
                                })
                                .eq('id', productId);

                            rethrow;
                          }

                          if (!dialogContext.mounted) return;

                          Navigator.pop(dialogContext, true);
                        } catch (e) {
                          if (!dialogContext.mounted) return;

                          setDialogState(() {
                            saving = false;
                          });

                          ScaffoldMessenger.of(dialogContext).showSnackBar(
                            SnackBar(
                              content: Text(
                                isArabic
                                    ? 'تعذر تسجيل حركة المخزون: $e'
                                    : 'Unable to save inventory movement: $e',
                              ),
                              backgroundColor: Colors.red,
                            ),
                          );
                        }
                      },
              ),
            ],
          );
        },
      ),
    );

    quantityController.dispose();
    notesController.dispose();

    if (saved == true) {
      await loadAccountingProducts();

      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            isArabic
                ? 'تم تسجيل حركة المخزون بنجاح'
                : 'Inventory movement saved successfully',
          ),
        ),
      );
    }
  }

  Future<void> showAccountingInventoryHistory(
    Map<String, dynamic> product,
  ) async {
    final isArabic = widget.currentUser.language == 'ar';

    final productId = product['id']?.toString() ?? '';
    final productName = product['name']?.toString() ?? '';
    final unit = product['unit']?.toString() ?? (isArabic ? 'قطعة' : 'Piece');

    if (productId.isEmpty) return;

    List<Map<String, dynamic>> movements = [];
    bool loading = true;
    String? errorMessage;

    String movementTypeText(String type) {
      switch (type) {
        case 'stock_in':
          return isArabic ? 'إدخال مخزون' : 'Stock In';
        case 'stock_out':
          return isArabic ? 'إخراج مخزون' : 'Stock Out';
        case 'adjustment_in':
          return isArabic ? 'تسوية زيادة' : 'Adjustment In';
        case 'adjustment_out':
          return isArabic ? 'تسوية نقص' : 'Adjustment Out';
        case 'purchase':
          return isArabic ? 'مشتريات' : 'Purchase';
        case 'sale':
          return isArabic ? 'مبيعات' : 'Sale';
        default:
          return type;
      }
    }

    IconData movementIcon(String type) {
      switch (type) {
        case 'stock_in':
        case 'adjustment_in':
        case 'purchase':
          return Icons.arrow_downward_rounded;
        case 'stock_out':
        case 'adjustment_out':
        case 'sale':
          return Icons.arrow_upward_rounded;
        default:
          return Icons.swap_vert_rounded;
      }
    }

    Future<void> loadHistory(
      void Function(void Function()) setDialogState,
    ) async {
      try {
        final data = await Supabase.instance.client
            .from('accounting_inventory_movements')
            .select()
            .eq('product_id', productId);

        final loaded = List<Map<String, dynamic>>.from(data);

        loaded.sort((a, b) {
          final aDate = DateTime.tryParse(a['movement_date']?.toString() ?? '');
          final bDate = DateTime.tryParse(b['movement_date']?.toString() ?? '');

          if (aDate == null && bDate == null) return 0;
          if (aDate == null) return 1;
          if (bDate == null) return -1;

          return bDate.compareTo(aDate);
        });

        setDialogState(() {
          movements = loaded;
          loading = false;
          errorMessage = null;
        });
      } catch (e) {
        setDialogState(() {
          loading = false;
          errorMessage = e.toString();
        });
      }
    }

    bool historyLoadStarted = false;

    await showDialog<void>(
      context: context,
      builder: (dialogContext) => StatefulBuilder(
        builder: (context, setDialogState) {
          if (!historyLoadStarted) {
            historyLoadStarted = true;

            WidgetsBinding.instance.addPostFrameCallback((_) {
              if (dialogContext.mounted) {
                loadHistory(setDialogState);
              }
            });
          }

          return AlertDialog(
            title: Row(
              children: [
                const Icon(Icons.history_rounded),
                const SizedBox(width: 10),
                Expanded(
                  child: Text(
                    '${isArabic ? 'سجل حركات' : 'Movement History'} - $productName',
                  ),
                ),
              ],
            ),
            content: SizedBox(
              width: 650,
              height: 520,
              child: loading
                  ? const Center(child: CircularProgressIndicator())
                  : errorMessage != null
                  ? Center(
                      child: Column(
                        mainAxisSize: MainAxisSize.min,
                        children: [
                          const Icon(Icons.error_outline, size: 48),
                          const SizedBox(height: 12),
                          Text(
                            isArabic
                                ? 'تعذر تحميل سجل الحركات'
                                : 'Unable to load movement history',
                          ),
                          const SizedBox(height: 8),
                          Text(errorMessage!, textAlign: TextAlign.center),
                        ],
                      ),
                    )
                  : movements.isEmpty
                  ? Center(
                      child: Column(
                        mainAxisSize: MainAxisSize.min,
                        children: [
                          const Icon(Icons.history_toggle_off, size: 64),
                          const SizedBox(height: 12),
                          Text(
                            isArabic
                                ? 'لا توجد حركات لهذه المادة'
                                : 'No movements for this product',
                          ),
                        ],
                      ),
                    )
                  : ListView.separated(
                      itemCount: movements.length,
                      separatorBuilder: (_, _) => const Divider(height: 1),
                      itemBuilder: (context, index) {
                        final movement = movements[index];

                        final type =
                            movement['movement_type']?.toString() ?? '';

                        final quantity =
                            (movement['quantity'] as num?)?.toDouble() ?? 0;

                        final before =
                            (movement['quantity_before'] as num?)?.toDouble() ??
                            0;

                        final after =
                            (movement['quantity_after'] as num?)?.toDouble() ??
                            0;

                        final notes = movement['notes']?.toString() ?? '';

                        final date = DateTime.tryParse(
                          movement['movement_date']?.toString() ?? '',
                        );

                        final formattedDate = date == null
                            ? '-'
                            : '${date.toLocal().year.toString().padLeft(4, '0')}-'
                                  '${date.toLocal().month.toString().padLeft(2, '0')}-'
                                  '${date.toLocal().day.toString().padLeft(2, '0')} '
                                  '${date.toLocal().hour.toString().padLeft(2, '0')}:'
                                  '${date.toLocal().minute.toString().padLeft(2, '0')}';

                        return ListTile(
                          leading: CircleAvatar(
                            child: Icon(movementIcon(type)),
                          ),
                          title: Text(
                            '${movementTypeText(type)} — '
                            '${quantity.toStringAsFixed(2)} $unit',
                            style: const TextStyle(fontWeight: FontWeight.bold),
                          ),
                          subtitle: Column(
                            crossAxisAlignment: CrossAxisAlignment.start,
                            children: [
                              const SizedBox(height: 4),
                              Text(
                                '${isArabic ? 'قبل الحركة' : 'Before'}: '
                                '${before.toStringAsFixed(2)} $unit'
                                '  →  '
                                '${isArabic ? 'بعد الحركة' : 'After'}: '
                                '${after.toStringAsFixed(2)} $unit',
                              ),
                              Text(
                                '${isArabic ? 'التاريخ' : 'Date'}: '
                                '$formattedDate',
                              ),
                              if (notes.isNotEmpty)
                                Text(
                                  '${isArabic ? 'البيان' : 'Notes'}: '
                                  '$notes',
                                ),
                            ],
                          ),
                          isThreeLine: notes.isNotEmpty,
                        );
                      },
                    ),
            ),
            actions: [
              IconButton(
                tooltip: isArabic ? 'تحديث' : 'Refresh',
                onPressed: loading
                    ? null
                    : () {
                        setDialogState(() {
                          loading = true;
                          errorMessage = null;
                        });

                        loadHistory(setDialogState);
                      },
                icon: const Icon(Icons.refresh),
              ),
              TextButton(
                onPressed: () => Navigator.pop(dialogContext),
                child: Text(isArabic ? 'إغلاق' : 'Close'),
              ),
            ],
          );
        },
      ),
    );
  }

