              ),
            ),
            actions: [
              TextButton(
                onPressed: () => Navigator.pop(dialogContext, false),
                child: Text(isArabic ? 'إلغاء' : 'Cancel'),
              ),
              FilledButton.icon(
                icon: const Icon(Icons.save),
                label: Text(isArabic ? 'حفظ' : 'Save'),
                onPressed: () async {
