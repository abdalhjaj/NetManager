                      ),
                    ],
                  ),
                ),
              ),
              actions: [
                TextButton(
                  onPressed: saving
                      ? null
                      : () => Navigator.pop(dialogContext, false),
                  child: const Text('إلغاء'),
                ),
                FilledButton.icon(
                  onPressed: saving
                      ? null
                      : () async {
                          final userId = selectedUserId;
                          final deviceId = selectedDeviceId;
                          final templateId = selectedTemplateId;

                          final count =
                              int.tryParse(countController.text.trim()) ?? 0;

                          final duration =
                              int.tryParse(durationController.text.trim()) ?? 0;

                          final priceInput =
                              double.tryParse(priceController.text.trim()) ??
                              -1;

                          final usernameLength =
                              int.tryParse(
                                usernameLengthController.text.trim(),
                              ) ??
                              0;

                          final passwordLength =
                              int.tryParse(
                                passwordLengthController.text.trim(),
                              ) ??
                              0;

                          final profile = profileController.text.trim();

                          if (deviceId == null) {
                            ScaffoldMessenger.of(context).showSnackBar(
                              const SnackBar(
                                content: Text('اختر الجهاز'),
                                backgroundColor: Colors.red,
                              ),
                            );
                            return;
                          }

                          if (templateId == null) {
                            ScaffoldMessenger.of(context).showSnackBar(
                              const SnackBar(
                                content: Text('اختر تصميم البطاقة'),
                                backgroundColor: Colors.red,
                              ),
                            );
                            return;
                          }

                          if (count < 1 || count > 500) {
                            ScaffoldMessenger.of(context).showSnackBar(
                              const SnackBar(
                                content: Text(
                                  'عدد البطاقات يجب أن يكون بين 1 و 500',
                                ),
                                backgroundColor: Colors.red,
                              ),
                            );
                            return;
                          }

                          if (profile.isEmpty) {
                            ScaffoldMessenger.of(context).showSnackBar(
                              const SnackBar(
                                content: Text('أدخل Profile'),
