              Future<void> deleteAccountingPurchaseInvoice() async {
                if (!isEditingPurchase || savingInvoice) return;

                final purchaseId = existingPurchase['id']?.toString();

                if (purchaseId == null || purchaseId.isEmpty) {
                  ScaffoldMessenger.of(context).showSnackBar(
                    SnackBar(
                      content: Text(
                        isArabic
                            ? 'معرّف الفاتورة غير موجود'
                            : 'Invoice ID is missing',
                      ),
                    ),
                  );
                  return;
                }

                final invoiceNumber =
                    existingPurchase['invoice_number']?.toString() ?? '';

                final confirmed = await showDialog<bool>(
                  context: dialogContext,
                  builder: (confirmContext) {
                    return AlertDialog(
                      title: Text(isArabic ? 'حذف الفاتورة' : 'Delete Invoice'),
                      content: Text(
                        isArabic
                            ? 'هل أنت متأكد من حذف فاتورة المشتريات رقم $invoiceNumber؟\n\nلا يمكن التراجع عن الحذف.'
                            : 'Are you sure you want to delete purchase invoice $invoiceNumber?\n\nThis action cannot be undone.',
                      ),
                      actions: [
                        TextButton(
                          onPressed: () {
                            Navigator.of(confirmContext).pop(false);
                          },
                          child: Text(isArabic ? 'إلغاء' : 'Cancel'),
                        ),
                        FilledButton.icon(
                          onPressed: () {
                            Navigator.of(confirmContext).pop(true);
                          },
                          icon: const Icon(Icons.delete_outline),
                          label: Text(isArabic ? 'حذف' : 'Delete'),
                        ),
                      ],
                    );
                  },
                );

                if (confirmed != true) return;

                setDialogState(() {
                  savingInvoice = true;
                });

                try {
                  // =====================================================
                  // قبل حذف فاتورة المشتريات:
                  // نقرأ بنودها ونعكس أثرها على المخزون.
                  // =====================================================
                  final purchaseItemsData = await Supabase.instance.client
                      .from('accounting_purchase_items')
                      .select('product_id, quantity')
                      .eq('purchase_id', purchaseId);

                  final purchaseItems = List<Map<String, dynamic>>.from(
                    purchaseItemsData,
                  );

                  // نجمع الكمية لكل مادة في حال تكررت المادة داخل الفاتورة.
                  final quantitiesToReverse = <String, double>{};

                  for (final item in purchaseItems) {
                    final productId = item['product_id']?.toString() ?? '';

                    final quantity =
                        (item['quantity'] as num?)?.toDouble() ?? 0;

                    if (productId.isEmpty || quantity <= 0) {
                      continue;
                    }

                    quantitiesToReverse[productId] =
                        (quantitiesToReverse[productId] ?? 0) + quantity;
                  }

                  // أولاً نفحص جميع المواد قبل تغيير أي كمية.
                  // بهذه الطريقة لا نعدل نصف الفاتورة ثم نفشل في مادة أخرى.
                  final stockBeforeDelete = <String, Map<String, dynamic>>{};

                  for (final entry in quantitiesToReverse.entries) {
                    final productId = entry.key;
                    final quantityToRemove = entry.value;

                    final freshProduct = await Supabase.instance.client
                        .from('accounting_products')
                        .select('quantity, name')
                        .eq('id', productId)
                        .eq('created_by', widget.currentUser.id)
                        .single();

                    final currentQuantity =
                        (freshProduct['quantity'] as num?)?.toDouble() ?? 0;

                    final productName = freshProduct['name']?.toString() ?? '';

                    if (currentQuantity < quantityToRemove) {
                      throw Exception(
                        isArabic
                            ? 'لا يمكن حذف الفاتورة لأن الكمية المتوفرة من $productName هي $currentQuantity بينما يجب إلغاء $quantityToRemove من المخزون'
                            : 'Cannot delete invoice because available stock of $productName is $currentQuantity while $quantityToRemove must be reversed',
                      );
                    }

                    stockBeforeDelete[productId] = {
                      'quantity': currentQuantity,
                      'name': productName,
                    };
                  }

                  // بعد نجاح الفحص لكل المواد، نعكس أثر الشراء.
                  for (final entry in quantitiesToReverse.entries) {
                    final productId = entry.key;
                    final quantityToRemove = entry.value;

                    final quantityBefore =
                        (stockBeforeDelete[productId]?['quantity'] as num?)
                            ?.toDouble() ??
                        0;

                    final quantityAfter = quantityBefore - quantityToRemove;

                    await Supabase.instance.client
                        .from('accounting_products')
                        .update({
                          'quantity': quantityAfter,
                          'updated_at': DateTime.now().toIso8601String(),
                        })
                        .eq('id', productId)
                        .eq('created_by', widget.currentUser.id);

                    try {
                      await Supabase.instance.client
                          .from('accounting_inventory_movements')
                          .insert({
                            'product_id': productId,
                            'movement_type': 'purchase',
                            'quantity': quantityToRemove,
                            'quantity_before': quantityBefore,
                            'quantity_after': quantityAfter,
                            'reference_id': purchaseId,
                            'notes': isArabic
                                ? 'إلغاء شراء بسبب حذف فاتورة رقم $invoiceNumber'
                                : 'Purchase reversal - deleted invoice $invoiceNumber',
                            'movement_date': DateTime.now().toIso8601String(),
                            'created_by': widget.currentUser.id,
                          });
                    } catch (_) {
                      // إذا فشل تسجيل الحركة نعيد هذه المادة كما كانت.
                      await Supabase.instance.client
                          .from('accounting_products')
                          .update({
                            'quantity': quantityBefore,
                            'updated_at': DateTime.now().toIso8601String(),
                          })
                          .eq('id', productId)
                          .eq('created_by', widget.currentUser.id);

                      rethrow;
                    }
                  }

                  // بعد عكس المخزون نحذف بنود الفاتورة.
                  await Supabase.instance.client
                      .from('accounting_purchase_items')
                      .delete()
                      .eq('purchase_id', purchaseId);

                  // ثم نحذف رأس الفاتورة.
                  await Supabase.instance.client
                      .from('accounting_purchases')
                      .delete()
                      .eq('id', purchaseId);

