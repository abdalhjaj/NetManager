    final paidOld = paymentHistory
        .where((payment) => payment['subscription_id']?.toString() == sub.id)
        .fold<double>(
          0,
          (sum, payment) =>
              sum + ((payment['amount'] as num?)?.toDouble() ?? 0),
        );

    final oldDebt = (sub.amount - paidOld).clamp(0, sub.amount);

    final amountController = TextEditingController(
      text: sub.amount.toStringAsFixed(2),
    );
    final paymentAmountController = TextEditingController(text: '0');
    final durationController = TextEditingController(text: '30');

    String currency = sub.currency;

    final confirmed = await showDialog<bool>(
      context: context,
      builder: (dialogContext) => StatefulBuilder(
        builder: (context, setDialogState) {
          final renewalAmount =
              double.tryParse(amountController.text.trim()) ?? 0;

          final collectedAmount =
              double.tryParse(paymentAmountController.text.trim()) ?? 0;

