                    } else if (status == 'فترة سماح') {
                      statusColor = Colors.amber.shade900;
                      statusBackground = Colors.amber.withValues(alpha: 0.15);
                      statusIcon = Icons.hourglass_bottom;

                      if (account.debtGraceUntil != null) {
                        final graceDays =
                            (account.debtGraceUntil!.difference(now).inHours /
                                    24)
                                .ceil();

                        status =
                            'فترة سماح - متبقي ${graceDays < 0 ? 0 : graceDays} يوم';
                      }
                    } else {
                      status = 'فعال';
                      statusColor = Colors.green.shade700;
                      statusBackground = Colors.green.withValues(alpha: 0.12);
                      statusIcon = Icons.check_circle;
                    }

                    final remainingDays = account.expiresAt
                        ?.difference(now)
                        .inDays;

                    return buildCompactAccountCard(
                      accountType: 'hotspot',
                      accountId: account.id,
                      username: account.username,
