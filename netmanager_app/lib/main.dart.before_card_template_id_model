  Widget buildBroadband() {
    final now = DateTime.now();

    final isManager = widget.currentUser.role == 'مدير';

    final effectiveBroadbandUserId =
        selectedBroadbandUserId ?? widget.currentUser.id;

    final filteredBroadbandAccounts = isManager
        ? broadbandAccounts
              .where((a) => a.userId == effectiveBroadbandUserId)
              .toList()
        : broadbandAccounts
              .where((a) => a.userId == widget.currentUser.id)
              .toList();

    String statusOf(BroadbandAccount account) {
      if (!account.active || account.serviceStatus == 'manual_suspended') {
        return 'متوقف يدويًا';
      }

      if (account.expiresAt != null && account.expiresAt!.isBefore(now)) {
        return 'منتهي';
      }

      if (account.remainingAmount <= 0.001) {
        return 'فعال';
      }

      if (account.serviceStatus == 'debt_suspended') {
        return 'موقوف بسبب الدين';
      }

      if (account.serviceStatus == 'grace') {
        if (account.debtGraceUntil != null &&
            !now.isBefore(account.debtGraceUntil!)) {
          return 'موقوف بسبب الدين';
        }

        return 'فترة سماح';
      }

      if (!allowDebt || debtGraceDays <= 0) {
        return 'موقوف بسبب الدين';
      }

      return 'فترة سماح';
    }

    final allCount = filteredBroadbandAccounts.length;

    final activeCount = filteredBroadbandAccounts
        .where((a) => statusOf(a) == 'فعال')
        .length;

    final graceCount = filteredBroadbandAccounts
        .where((a) => statusOf(a) == 'فترة سماح')
        .length;

    final debtSuspendedCount = filteredBroadbandAccounts
        .where((a) => statusOf(a) == 'موقوف بسبب الدين')
        .length;

    final expiredCount = filteredBroadbandAccounts
        .where((a) => statusOf(a) == 'منتهي')
        .length;

    final stoppedCount = filteredBroadbandAccounts
        .where((a) => statusOf(a) == 'متوقف يدويًا')
        .length;

    final visibleAccounts = broadbandStatusFilter == 'الكل'
        ? filteredBroadbandAccounts
        : filteredBroadbandAccounts
              .where((a) => statusOf(a) == broadbandStatusFilter)
              .toList();

    Widget filterChip(String label, int count, Color color) {
      final selected = broadbandStatusFilter == label;

      return Padding(
        padding: const EdgeInsets.only(left: 8),
        child: ChoiceChip(
          selected: selected,
          onSelected: (_) {
            setState(() {
              broadbandStatusFilter = label;
            });
          },
          label: Text('$label ($count)'),
          selectedColor: color.withValues(alpha: 0.15),
          labelStyle: TextStyle(
            color: selected ? color : null,
            fontWeight: FontWeight.bold,
          ),
          side: BorderSide(
            color: selected
                ? color.withValues(alpha: 0.45)
                : Colors.grey.withValues(alpha: 0.25),
          ),
        ),
      );
    }

    String userName(String userId) {
      final user = users.cast<AppUser?>().firstWhere(
        (u) => u?.id == userId,
        orElse: () => null,
      );
      return user?.name ?? 'غير معروف';
    }

    String deviceName(String deviceId) {
      final device = devices.cast<NetworkDevice?>().firstWhere(
        (d) => d?.id == deviceId,
        orElse: () => null,
      );
      return device?.name ?? 'غير معروف';
    }

    String formatDate(DateTime? date) {
      if (date == null) return '-';
      return '${date.day.toString().padLeft(2, '0')}/'
          '${date.month.toString().padLeft(2, '0')}/'
          '${date.year}';
    }

    return Directionality(
      textDirection: TextDirection.rtl,
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: [
            Card(
              child: Padding(
                padding: const EdgeInsets.all(18),
                child: Row(
                  children: [
                    Container(
                      padding: const EdgeInsets.all(12),
                      decoration: BoxDecoration(
                        color: Colors.blue.withValues(alpha: 0.12),
                        borderRadius: BorderRadius.circular(14),
                      ),
                      child: const Icon(
                        Icons.language,
                        size: 38,
                        color: Colors.blue,
                      ),
                    ),
                    const SizedBox(width: 14),
                    const Expanded(
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Text(
                            'Broadband',
                            style: TextStyle(
                              fontSize: 23,
                              fontWeight: FontWeight.bold,
                            ),
                          ),
                          SizedBox(height: 4),
                          Text(
                            'إدارة اشتراكات مشتركين البرودباند',
                            style: TextStyle(fontSize: 14),
                          ),
                        ],
                      ),
                    ),
                    FilledButton.icon(
                      onPressed: showAddBroadbandDialog,
                      icon: const Icon(Icons.add),
                      label: const Text('إضافة حساب'),
                    ),
                  ],
                ),
              ),
            ),
            const SizedBox(height: 12),

            if (isManager)
              Card(
                child: Padding(
                  padding: const EdgeInsets.all(12),
                  child: DropdownButtonFormField<String>(
                    initialValue: effectiveBroadbandUserId,
                    decoration: const InputDecoration(
                      labelText: 'المستخدم',
                      prefixIcon: Icon(Icons.person),
                      border: OutlineInputBorder(),
                    ),
                    items: users
                        .where((user) => user.active)
                        .map(
                          (user) => DropdownMenuItem<String>(
                            value: user.id,
                            child: Text(user.name),
                          ),
                        )
                        .toList(),
                    onChanged: (value) {
                      if (value == null) return;

                      setState(() {
                        selectedBroadbandUserId = value;
                        broadbandStatusFilter = 'الكل';
                      });
                    },
                  ),
                ),
              ),

            const SizedBox(height: 12),

            SingleChildScrollView(
              scrollDirection: Axis.horizontal,
              child: Row(
                children: [
                  filterChip('الكل', allCount, Colors.blue),
                  filterChip('فعال', activeCount, Colors.green),
                  filterChip('فترة سماح', graceCount, Colors.amber),
                  filterChip(
                    'موقوف بسبب الدين',
                    debtSuspendedCount,
                    Colors.red,
                  ),
                  filterChip('منتهي', expiredCount, Colors.orange),
                  filterChip('متوقف يدويًا', stoppedCount, Colors.grey),
                ],
              ),
            ),

            const SizedBox(height: 12),

            if (visibleAccounts.isEmpty)
              Expanded(
                child: Card(
                  child: Center(
                    child: Padding(
                      padding: const EdgeInsets.all(24),
                      child: Column(
                        mainAxisSize: MainAxisSize.min,
                        children: [
                          Icon(
                            Icons.language,
                            size: 64,
                            color: Colors.grey.shade400,
                          ),
                          const SizedBox(height: 12),
                          const Text(
                            'لا توجد حسابات Broadband',
                            style: TextStyle(
                              fontSize: 19,
                              fontWeight: FontWeight.bold,
                            ),
                          ),
                          const SizedBox(height: 8),
                          Text(
                            'اضغط على "إضافة حساب" لإضافة أول مشترك.',
                            style: TextStyle(color: Colors.grey.shade600),
                          ),
                        ],
                      ),
                    ),
                  ),
                ),
              )
            else
              Expanded(
                child: ListView.builder(
                  itemCount: visibleAccounts.length,
                  itemBuilder: (context, index) {
                    final account = visibleAccounts[index];
                    final remaining = account.remainingAmount;

                    final now = DateTime.now();

                    String status;
                    Color statusColor;
                    Color statusBackground;
                    IconData statusIcon;

                    status = statusOf(account);

                    if (status == 'متوقف يدويًا') {
                      statusColor = Colors.grey.shade700;
                      statusBackground = Colors.grey.withValues(alpha: 0.14);
                      statusIcon = Icons.block;
                    } else if (status == 'منتهي') {
                      statusColor = Colors.orange.shade800;
                      statusBackground = Colors.orange.withValues(alpha: 0.14);
                      statusIcon = Icons.event_busy;
                    } else if (status == 'موقوف بسبب الدين') {
                      statusColor = Colors.red.shade700;
                      statusBackground = Colors.red.withValues(alpha: 0.12);
                      statusIcon = Icons.money_off;
                    } else if (status == 'فترة سماح') {
                      statusColor = Colors.amber.shade900;
                      statusBackground = Colors.amber.withValues(alpha: 0.15);
                      statusIcon = Icons.hourglass_bottom;

                      if (account.debtGraceUntil != null) {
                        final graceDays =
                            (account.debtGraceUntil!.difference(now).inHours /
                                    24)
                                .ceil();

                        status =
                            'فترة سماح - متبقي ${graceDays < 0 ? 0 : graceDays} يوم';
                      }
                    } else {
                      status = 'فعال';
                      statusColor = Colors.green.shade700;
                      statusBackground = Colors.green.withValues(alpha: 0.12);
                      statusIcon = Icons.check_circle;
                    }

                    final remainingDays = account.expiresAt
                        ?.difference(now)
                        .inDays;

                    return buildCompactAccountCard(
                      accountType: 'broadband',
                      accountId: account.id,
                      username: account.username,
                      password: account.password,
                      profile: account.profile,
                      status: status,
                      statusColor: statusColor,
                      statusBackground: statusBackground,
                      statusIcon: statusIcon,
                      ownerName: userName(account.userId),
                      ownerUserId: account.userId,
