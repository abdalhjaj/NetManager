  Widget _buildHotspotTemplateVisual({
    required String designType,
    required String primaryColor,
    required String secondaryColor,
    required String textColor,
    required String companyName,
    required String packageName,
    required String profile,
    required String durationText,
    required String priceText,
    required String username,
    required String password,
    required bool showCompanyName,
    required bool showProfile,
    required bool showDuration,
    required bool showPrice,
    required bool showQr,
    String? footerText,
  }) {
    final primary = _hotspotTemplateColor(primaryColor);
    final secondary = _hotspotTemplateColor(secondaryColor);
    final foreground = _hotspotTemplateColor(textColor);

    final darkBackground = primary.computeLuminance() < 0.35;

    Color readable(Color background) {
      return background.computeLuminance() > 0.55
          ? const Color(0xFF102A43)
          : Colors.white;
    }

    final primaryText = readable(primary);

    Widget loginBox({Color? background, Color? color, bool outlined = false}) {
      final bg = background ?? Colors.white.withValues(alpha: 0.93);
      final fg = color ?? const Color(0xFF102A43);

      return Container(
        padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 11),
        decoration: BoxDecoration(
          color: outlined ? Colors.transparent : bg,
          borderRadius: BorderRadius.circular(14),
          border: outlined
              ? Border.all(color: foreground.withValues(alpha: 0.7), width: 1.4)
              : null,
        ),
        child: Column(
          children: [
            Row(
              children: [
                Expanded(
                  child: Text(
                    'اسم المستخدم',
                    style: TextStyle(
                      color: outlined ? foreground : fg,
                      fontSize: 12,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                ),
                Text(
                  username,
                  style: TextStyle(
                    color: outlined ? foreground : fg,
                    fontSize: 15,
                    fontWeight: FontWeight.w900,
                    letterSpacing: 1,
                  ),
                ),
              ],
            ),
            const SizedBox(height: 5),
            Row(
              children: [
                Expanded(
                  child: Text(
                    'كلمة المرور',
                    style: TextStyle(
                      color: outlined ? foreground : fg,
                      fontSize: 12,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                ),
                Text(
                  password,
                  style: TextStyle(
                    color: outlined ? foreground : fg,
                    fontSize: 15,
                    fontWeight: FontWeight.w900,
                    letterSpacing: 1,
                  ),
                ),
              ],
            ),
          ],
        ),
      );
    }

    Widget information({
      Color? color,
      MainAxisAlignment alignment = MainAxisAlignment.center,
    }) {
      final c = color ?? foreground;

      return Wrap(
        alignment: WrapAlignment.center,
        spacing: 11,
        runSpacing: 5,
        children: [
          if (showProfile)
            Text(
              profile,
              style: TextStyle(color: c, fontWeight: FontWeight.bold),
            ),
          if (showDuration)
            Text(
              durationText,
              style: TextStyle(color: c, fontWeight: FontWeight.bold),
            ),
          if (showPrice)
            Text(
              priceText,
              style: TextStyle(color: c, fontWeight: FontWeight.bold),
            ),
          if (showQr) Icon(Icons.qr_code_2_rounded, color: c, size: 27),
