class AccountUsageSession {
  String id;
  String accountType;
  String accountId;
  String? userId;
  String? deviceId;
  String? sessionId;

  int uploadBytes;
  int downloadBytes;
  int sessionSeconds;

  DateTime? startedAt;
  DateTime? stoppedAt;
  DateTime? updatedAt;
  DateTime? createdAt;

  AccountUsageSession({
    this.id = '',
    required this.accountType,
    required this.accountId,
    this.userId,
    this.deviceId,
    this.sessionId,
    this.uploadBytes = 0,
    this.downloadBytes = 0,
    this.sessionSeconds = 0,
    this.startedAt,
    this.stoppedAt,
    this.updatedAt,
    this.createdAt,
  });

  int get totalBytes => uploadBytes + downloadBytes;

  factory AccountUsageSession.fromJson(Map<String, dynamic> json) {
    int parseInt(dynamic value) {
      if (value == null) return 0;
      if (value is int) return value;
      return int.tryParse(value.toString()) ?? 0;
    }

    return AccountUsageSession(
      id: json['id']?.toString() ?? '',
      accountType: json['account_type']?.toString() ?? '',
      accountId: json['account_id']?.toString() ?? '',
      userId: json['user_id']?.toString(),
      deviceId: json['device_id']?.toString(),
      sessionId: json['session_id']?.toString(),
      uploadBytes: parseInt(json['upload_bytes']),
      downloadBytes: parseInt(json['download_bytes']),
      sessionSeconds: parseInt(json['session_seconds']),
      startedAt: json['started_at'] != null
          ? DateTime.tryParse(json['started_at'].toString())
          : null,
      stoppedAt: json['stopped_at'] != null
          ? DateTime.tryParse(json['stopped_at'].toString())
          : null,
      updatedAt: json['updated_at'] != null
          ? DateTime.tryParse(json['updated_at'].toString())
          : null,
      createdAt: json['created_at'] != null
          ? DateTime.tryParse(json['created_at'].toString())
          : null,
    );
  }

  Map<String, dynamic> toJson() {
    return {
      'account_type': accountType,
      'account_id': accountId,
      'user_id': userId,
      'device_id': deviceId,
      'session_id': sessionId,
      'upload_bytes': uploadBytes,
      'download_bytes': downloadBytes,
      'session_seconds': sessionSeconds,
      'started_at': startedAt?.toIso8601String(),
      'stopped_at': stoppedAt?.toIso8601String(),
      'updated_at': updatedAt?.toIso8601String(),
    };
  }
}

List<AccountUsageSession> usageSessions = [];

Future<void> loadUsageSessions() async {
  final supabase = Supabase.instance.client;

  usageSessions.clear();

  if (currentUser == null) {
    return;
  }

  dynamic data;

  if (currentUser!.role == 'مدير') {
    data = await supabase
        .from('account_usage_sessions')
        .select()
        .order('created_at', ascending: false);
  } else {
    data = await supabase
        .from('account_usage_sessions')
        .select()
        .eq('user_id', currentUser!.id)
        .order('created_at', ascending: false);
  }

  for (final item in data) {
    usageSessions.add(
      AccountUsageSession.fromJson(Map<String, dynamic>.from(item)),
    );
  }
}

