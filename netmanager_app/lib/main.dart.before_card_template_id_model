    final amountController = TextEditingController();
    final discountController = TextEditingController(text: '0');

    final ownerCurrency = _accountOwnerCurrency(account.userId);

    // Broadband محفوظ داخليًا بالدولار.
    // نحوله فقط للعرض والإدخال حسب عملة صاحب الحساب.
    final priceDisplay = _usdToOwnerCurrency(account.price, account.userId);
    final paidDisplay = _usdToOwnerCurrency(account.paidAmount, account.userId);
    final remainingDisplay = _usdToOwnerCurrency(
      account.remainingAmount,
      account.userId,
    );

    final result = await showDialog<Map<String, double>>(
      context: context,
      builder: (dialogContext) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            final amountDisplay =
                double.tryParse(amountController.text.trim()) ?? 0.0;

            final discountDisplay =
                double.tryParse(discountController.text.trim()) ?? 0.0;

            final totalSettledDisplay = amountDisplay + discountDisplay;

            final remainingAfterDisplay =
                remainingDisplay - totalSettledDisplay > 0
                ? remainingDisplay - totalSettledDisplay
                : 0.0;

            String money(double value) {
              if (ownerCurrency == 'SYP') {
                return '${value.toStringAsFixed(0)} SYP';
              }

              return '${value.toStringAsFixed(2)} USD';
            }

            return AlertDialog(
              title: const Text('تحصيل دفعة Broadband'),
              content: SingleChildScrollView(
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  crossAxisAlignment: CrossAxisAlignment.stretch,
                  children: [
                    Text('قيمة الاشتراك: ${money(priceDisplay)}'),
                    const SizedBox(height: 6),
                    Text('المسدّد سابقًا: ${money(paidDisplay)}'),
                    const SizedBox(height: 6),
                    Text('المتبقي: ${money(remainingDisplay)}'),
                    const SizedBox(height: 18),

                    TextField(
                      controller: amountController,
                      keyboardType: const TextInputType.numberWithOptions(
                        decimal: true,
                      ),
                      decoration: InputDecoration(
                        labelText: 'المبلغ المقبوض',
                        suffixText: ownerCurrency,
                        border: const OutlineInputBorder(),
                      ),
                      onChanged: (_) => setDialogState(() {}),
                    ),

                    const SizedBox(height: 12),

                    TextField(
                      controller: discountController,
                      keyboardType: const TextInputType.numberWithOptions(
                        decimal: true,
                      ),
                      decoration: InputDecoration(
                        labelText: 'الحسم',
                        suffixText: ownerCurrency,
                        border: const OutlineInputBorder(),
                      ),
                      onChanged: (_) => setDialogState(() {}),
                    ),

                    const SizedBox(height: 16),

                    Container(
                      padding: const EdgeInsets.all(12),
                      decoration: BoxDecoration(
                        color: Colors.grey.shade100,
                        borderRadius: BorderRadius.circular(12),
                      ),
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Text('المبلغ المقبوض: ${money(amountDisplay)}'),
                          const SizedBox(height: 5),
                          Text('الحسم: ${money(discountDisplay)}'),
                          const SizedBox(height: 5),
                          Text(
                            'إجمالي المسدد: ${money(totalSettledDisplay)}',
                            style: const TextStyle(fontWeight: FontWeight.bold),
                          ),
                          const SizedBox(height: 5),
                          Text(
                            'المتبقي بعد العملية: ${money(remainingAfterDisplay)}',
                            style: TextStyle(
                              color: remainingAfterDisplay > 0
                                  ? Colors.red
                                  : Colors.green,
                              fontWeight: FontWeight.bold,
                            ),
                          ),
                        ],
                      ),
                    ),
                  ],
                ),
              ),
              actions: [
                TextButton(
                  onPressed: () => Navigator.pop(dialogContext),
                  child: const Text('إلغاء'),
                ),
                FilledButton(
                  onPressed: () {
                    final amountDisplay =
                        double.tryParse(amountController.text.trim()) ?? 0.0;

                    final discountDisplay =
                        double.tryParse(discountController.text.trim()) ?? 0.0;

                    if (amountDisplay < 0 || discountDisplay < 0) {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(
                          content: Text('لا يمكن إدخال قيمة سالبة'),
                        ),
                      );
                      return;
                    }

                    if (amountDisplay <= 0 && discountDisplay <= 0) {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(content: Text('أدخل مبلغًا أو حسمًا')),
                      );
                      return;
                    }

                    if (amountDisplay + discountDisplay >
                        remainingDisplay + 0.001) {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(
                          content: Text(
                            'إجمالي المبلغ والحسم أكبر من الدين المتبقي',
                          ),
                        ),
                      );
                      return;
                    }

                    Navigator.pop(dialogContext, {
                      'amount': amountDisplay,
                      'discount': discountDisplay,
                    });
                  },
                  child: const Text('حفظ'),
                ),
              ],
            );
          },
        );
      },
    );

    if (result == null) return;

    // القيم التي أدخلها المستخدم بعملة حسابه.
    final amountDisplay = result['amount'] ?? 0.0;
    final discountDisplay = result['discount'] ?? 0.0;

    // نحولها إلى USD قبل الحفظ لأن Broadband مخزن بالدولار.
    final amount = _ownerCurrencyToUsd(amountDisplay, account.userId);

    final discount = _ownerCurrencyToUsd(discountDisplay, account.userId);

    final settledAmount = amount + discount;
    final newPaidAmount = account.paidAmount + settledAmount;
    final remaining = account.price - newPaidAmount;

    final paymentStatus = remaining <= 0.001 ? 'مدفوع' : 'غير مدفوع';

    String serviceStatus;
    DateTime? debtGraceUntil;

    if (!account.active) {
      serviceStatus = 'manual_suspended';
      debtGraceUntil = account.debtGraceUntil;
    } else if (remaining <= 0.001) {
      serviceStatus = 'active';
      debtGraceUntil = null;
    } else {
      serviceStatus = 'grace';
      debtGraceUntil = DateTime.now().add(Duration(days: debtGraceDays));
    }

    try {
      final supabase = Supabase.instance.client;

      await supabase
          .from('broadband_accounts')
          .update({
            'paid_amount': newPaidAmount,
            'payment_status': paymentStatus,
            'service_status': serviceStatus,
            'debt_grace_until': debtGraceUntil?.toIso8601String(),
          })
          .eq('id', account.id);

      await supabase.from('broadband_payments').insert({
        'account_id': account.id,
        'user_id': account.userId,
        'device_id': account.deviceId,

        // يبقى التخزين بالدولار.
        'amount': amount,
        'discount': discount,
        'currency': 'USD',
        'payment_type': 'payment',
      });

      account.paidAmount = newPaidAmount;
      account.paymentStatus = paymentStatus;
      account.serviceStatus = serviceStatus;
      account.debtGraceUntil = debtGraceUntil;

      await loadBroadbandPaymentHistory();

      if (!mounted) return;

      setState(() {});

      String money(double value) {
        if (ownerCurrency == 'SYP') {
          return '${value.toStringAsFixed(0)} SYP';
        }

        return '${value.toStringAsFixed(2)} USD';
      }

      final remainingDisplayAfter = _usdToOwnerCurrency(
        remaining > 0 ? remaining : 0,
        account.userId,
      );

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            discountDisplay > 0
                ? 'تم التحصيل ${money(amountDisplay)} وحسم ${money(discountDisplay)} ✓'
                : remaining <= 0
                ? 'تم التحصيل ${money(amountDisplay)} والحساب مسدد بالكامل ✓'
                : 'تم التحصيل ${money(amountDisplay)}، المتبقي ${money(remainingDisplayAfter)}',
          ),
          backgroundColor: Colors.green,
        ),
      );
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('حدث خطأ أثناء تسجيل الدفعة: $e'),
          backgroundColor: Colors.red,
        ),
      );
    }
  }

  Map<String, int> usageTotalsForAccount(String accountType, String accountId) {
    int upload = 0;
    int download = 0;
    int seconds = 0;

    for (final session in usageSessions) {
      if (session.accountType == accountType &&
          session.accountId == accountId) {
        upload += session.uploadBytes;
        download += session.downloadBytes;
        seconds += session.sessionSeconds;
      }
    }

    return {
      'upload': upload,
      'download': download,
      'total': upload + download,
      'seconds': seconds,
    };
  }

  String formatUsageBytes(int bytes) {
    if (bytes < 1024) {
      return '$bytes B';
    }

    final kb = bytes / 1024;

    if (kb < 1024) {
      return '${kb.toStringAsFixed(1)} KB';
    }

    final mb = kb / 1024;

    if (mb < 1024) {
      return '${mb.toStringAsFixed(2)} MB';
    }

    final gb = mb / 1024;

    if (gb < 1024) {
      return '${gb.toStringAsFixed(2)} GB';
    }

    final tb = gb / 1024;

    return '${tb.toStringAsFixed(2)} TB';
  }

  String formatUsageDuration(int totalSeconds) {
    if (totalSeconds <= 0) {
      return '0 دقيقة';
    }

    final days = totalSeconds ~/ 86400;
    final hours = (totalSeconds % 86400) ~/ 3600;
    final minutes = (totalSeconds % 3600) ~/ 60;

    if (days > 0) {
      return '$days يوم ${hours > 0 ? '$hours س' : ''}'.trim();
    }

    if (hours > 0) {
      return '$hours س ${minutes > 0 ? '$minutes د' : ''}'.trim();
    }

    return '$minutes دقيقة';
  }

