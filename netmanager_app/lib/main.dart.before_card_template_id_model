class _NetworkBackgroundPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final linePaint = Paint()
      ..color = const Color(0xFF1565C0).withValues(alpha: 0.11)
      ..strokeWidth = 1.4
      ..style = PaintingStyle.stroke;

    final nodePaint = Paint()
      ..color = const Color(0xFF1565C0).withValues(alpha: 0.16)
      ..style = PaintingStyle.fill;

    final softPaint = Paint()
      ..color = const Color(0xFF42A5F5).withValues(alpha: 0.055)
      ..style = PaintingStyle.fill;

    final nodes = <Offset>[
      Offset(size.width * 0.06, size.height * 0.15),
      Offset(size.width * 0.22, size.height * 0.08),
      Offset(size.width * 0.39, size.height * 0.20),
      Offset(size.width * 0.57, size.height * 0.09),
      Offset(size.width * 0.76, size.height * 0.18),
      Offset(size.width * 0.94, size.height * 0.08),
      Offset(size.width * 0.12, size.height * 0.48),
      Offset(size.width * 0.30, size.height * 0.38),
      Offset(size.width * 0.51, size.height * 0.50),
      Offset(size.width * 0.72, size.height * 0.39),
      Offset(size.width * 0.90, size.height * 0.52),
      Offset(size.width * 0.08, size.height * 0.82),
      Offset(size.width * 0.27, size.height * 0.70),
      Offset(size.width * 0.48, size.height * 0.86),
      Offset(size.width * 0.70, size.height * 0.72),
      Offset(size.width * 0.91, size.height * 0.86),
    ];

    final connections = <List<int>>[
      [0, 1],
      [1, 2],
      [2, 3],
      [3, 4],
      [4, 5],
      [0, 6],
      [1, 7],
      [2, 7],
      [2, 8],
      [3, 8],
      [3, 9],
      [4, 9],
      [4, 10],
      [6, 7],
      [7, 8],
      [8, 9],
      [9, 10],
      [6, 11],
      [7, 12],
      [8, 13],
      [9, 14],
      [10, 15],
      [11, 12],
      [12, 13],
      [13, 14],
      [14, 15],
    ];

    for (final connection in connections) {
      canvas.drawLine(nodes[connection[0]], nodes[connection[1]], linePaint);
    }

    for (final node in nodes) {
      canvas.drawCircle(node, 4, nodePaint);
      canvas.drawCircle(node, 10, softPaint);
    }

    // دوائر كبيرة ناعمة تعطي إحساس الشبكة والاتصال
    canvas.drawCircle(
      Offset(size.width * 0.08, size.height * 0.18),
      size.width * 0.16,
      softPaint,
    );

    canvas.drawCircle(
      Offset(size.width * 0.90, size.height * 0.78),
      size.width * 0.20,
      softPaint,
    );

    // رمز Wi-Fi كبير وشفاف
    final wifiPaint = Paint()
      ..color = const Color(0xFF1565C0).withValues(alpha: 0.07)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 8
      ..strokeCap = StrokeCap.round;

    final wifiCenter = Offset(size.width * 0.12, size.height * 0.72);

    canvas.drawArc(
      Rect.fromCircle(center: wifiCenter, radius: 75),
      -2.35,
      1.55,
      false,
      wifiPaint,
    );

    canvas.drawArc(
      Rect.fromCircle(center: wifiCenter, radius: 48),
      -2.35,
      1.55,
      false,
      wifiPaint,
    );

    canvas.drawCircle(wifiCenter, 7, wifiPaint);
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

