                            for (final item in insertedRows) {
                              generatedCards.add(
                                HotspotAccount.fromJson(
                                  Map<String, dynamic>.from(item),
                                ),
                              );
                            }

                            if (!dialogContext.mounted) return;

                            Navigator.pop(dialogContext, true);
