      await loadDevices();

      if (!mounted) return;

      setState(() {});

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(device.active ? 'تم إيقاف الجهاز' : 'تم تفعيل الجهاز'),
