  Future<void> loadAppSettings() async {
    final supabase = Supabase.instance.client;

    try {
      // العملة وسعر الصرف مصدرهما حساب المستخدم العام.
      final userData = await supabase
          .from('app_users')
          .select('currency, usd_to_syp_rate')
