            else
              Expanded(
                child: ListView.builder(
                  itemCount: visibleAccounts.length,
                  itemBuilder: (context, index) {
                    final account = visibleAccounts[index];
                    final remaining = account.remainingAmount;
                    final now = DateTime.now();

                    String status;
                    Color statusColor;
                    Color statusBackground;
                    IconData statusIcon;

                    status = statusOf(account);

                    if (status == 'متوقف يدويًا') {
                      statusColor = Colors.grey.shade700;
                      statusBackground = Colors.grey.withValues(alpha: 0.14);
                      statusIcon = Icons.block;
                    } else if (status == 'منتهي') {
                      statusColor = Colors.orange.shade800;
                      statusBackground = Colors.orange.withValues(alpha: 0.14);
                      statusIcon = Icons.event_busy;
                    } else if (status == 'موقوف بسبب الدين') {
                      statusColor = Colors.red.shade700;
                      statusBackground = Colors.red.withValues(alpha: 0.12);
