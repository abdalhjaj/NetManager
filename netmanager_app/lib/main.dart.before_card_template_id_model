                            );
                            return;
                          }

                          if (priceInput < 0) {
                            ScaffoldMessenger.of(context).showSnackBar(
                              const SnackBar(
                                content: Text('السعر غير صحيح'),
                                backgroundColor: Colors.red,
                              ),
                            );
                            return;
                          }

                          setDialogState(() {
                            saving = true;
                          });

                          try {
                            final priceUsd = _ownerCurrencyToUsd(
                              priceInput,
                              widget.currentUser.id,
                            );

