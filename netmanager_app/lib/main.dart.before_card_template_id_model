  Color _hotspotTemplateColor(String hex) {
    try {
      var value = hex.replaceAll('#', '').trim();

      if (value.length == 6) {
        value = 'FF$value';
      }

      return Color(int.parse(value, radix: 16));
    } catch (_) {
      return const Color(0xFF1565C0);
    }
  }

