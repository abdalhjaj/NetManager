      );
    }

    Widget footer(Color color) {
      final text = footerText?.trim() ?? '';

      if (text.isEmpty) {
        return const SizedBox.shrink();
      }

      return Text(
        text,
        textAlign: TextAlign.center,
        maxLines: 1,
        overflow: TextOverflow.ellipsis,
        style: TextStyle(
