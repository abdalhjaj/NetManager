          .update({'currency': appCurrency, 'usd_to_syp_rate': usdToSypRate})
          .eq('username', widget.currentUser.username)
          .select('id, username, currency, usd_to_syp_rate')
          .limit(1);

      if (savedRows.isEmpty) {
        throw Exception(
          'لم يتم العثور على المستخدم ${widget.currentUser.username}',
        );
      }

      final savedUser = Map<String, dynamic>.from(savedRows.first);

      // نعتمد القيم التي رجعت فعلًا من قاعدة البيانات.
      final correctUserId = savedUser['id']?.toString() ?? '';

      if (correctUserId.isEmpty) {
        throw Exception('لم يتم استرجاع ID المستخدم من قاعدة البيانات');
      }

      widget.currentUser.id = correctUserId;
      widget.currentUser.currency =
          savedUser['currency']?.toString() ?? appCurrency;
      widget.currentUser.usdToSypRate =
          (savedUser['usd_to_syp_rate'] as num?)?.toDouble() ?? usdToSypRate;

      appCurrency = widget.currentUser.currency;
      usdToSypRate = widget.currentUser.usdToSypRate;

      // مزامنة currentUser العام.
      if (currentUser != null &&
          currentUser!.username == widget.currentUser.username) {
        currentUser!.id = correctUserId;
        currentUser!.currency = appCurrency;
        currentUser!.usdToSypRate = usdToSypRate;
      }

      // مزامنة قائمة المستخدمين.
      for (final user in users) {
        if (user.username == widget.currentUser.username) {
          user.id = correctUserId;
          user.currency = appCurrency;
          user.usdToSypRate = usdToSypRate;
          break;
        }
      }

      final existingRows = await supabase
          .from('app_settings')
          .select('id')
          .eq('user_id', correctUserId)
          .limit(1);

      final values = {
        'default_currency': appCurrency,
        'debt_grace_days': debtGraceDays,
        'allow_debt': allowDebt,
        'profile_edit_allowed': profileEditAllowed,
        'backup_enabled': backupEnabled,
        'updated_at': DateTime.now().toIso8601String(),
      };

      if (existingRows.isEmpty) {
        await supabase.from('app_settings').insert({
          'user_id': correctUserId,
          ...values,
        });
      } else {
        await supabase
            .from('app_settings')
            .update(values)
            .eq('user_id', correctUserId);
      }

      if (!mounted) return;

      setState(() {});

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            'تم حفظ الإعدادات بنجاح ✓ — $appCurrency — '
            '${usdToSypRate.toStringAsFixed(0)}',
          ),
          backgroundColor: Colors.green,
        ),
      );
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('فشل حفظ الإعدادات: $e'),
          backgroundColor: Colors.red,
        ),
      );
    }
  }

