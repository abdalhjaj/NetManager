                              const SnackBar(
                                content: Text('سعر البطاقة غير صحيح'),
                                backgroundColor: Colors.red,
                              ),
                            );
                            return;
                          }

                          if (usernameLength < 4 || usernameLength > 16) {
                            ScaffoldMessenger.of(context).showSnackBar(
                              const SnackBar(
                                content: Text(
                                  'طول اسم المستخدم يجب أن يكون بين 4 و 16',
                                ),
