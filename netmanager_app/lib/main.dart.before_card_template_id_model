                              'footer_text':
                                  footerController.text.trim().isEmpty
                                  ? null
                                  : footerController.text.trim(),
                              'active': active,
                            };

                            if (editing) {
                              await supabase
                                  .from('hotspot_card_templates')
                                  .update(values)
                                  .eq('id', template.id);
                            } else {
                              await supabase
                                  .from('hotspot_card_templates')
                                  .insert(values);
                            }

                            if (!dialogContext.mounted) return;

                            Navigator.pop(dialogContext, true);
                          } catch (e) {
                            if (!dialogContext.mounted) return;

                            setDialogState(() {
