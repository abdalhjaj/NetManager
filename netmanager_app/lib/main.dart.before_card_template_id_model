  Widget buildPaymentHistory() {
    final exchangeRate = usdToSypRate > 0 ? usdToSypRate : 1.0;

    double convertMoney(double amount, String sourceCurrency) {
      if (sourceCurrency == appCurrency) return amount;

      if (sourceCurrency == 'USD' && appCurrency == 'SYP') {
        return amount * exchangeRate;
      }

      if (sourceCurrency == 'SYP' && appCurrency == 'USD') {
        return amount / exchangeRate;
      }

      return amount;
    }

    String formatMoney(double amount) {
      if (appCurrency == 'SYP') {
        return '${amount.toStringAsFixed(0)} SYP';
      }

      return '${amount.toStringAsFixed(2)} USD';
    }

    String formatDate(dynamic value) {
      if (value == null) return 'غير محدد';

      final date = DateTime.tryParse(value.toString());
      if (date == null) return 'غير محدد';

      final local = date.toLocal();

      return '${local.day.toString().padLeft(2, '0')}/'
          '${local.month.toString().padLeft(2, '0')}/'
          '${local.year} '
          '${local.hour.toString().padLeft(2, '0')}:'
          '${local.minute.toString().padLeft(2, '0')}';
    }

    String operationText(String source, String? type) {
      if (source == 'Broadband') {
        if (type == 'renewal') return 'تجديد Broadband';
        if (type == 'payment') return 'تحصيل Broadband';
        if (type == 'new') return 'اشتراك Broadband جديد';
        return 'دفعة Broadband';
      }

      if (source == 'Hotspot') {
        if (type == 'renewal') return 'تجديد Hotspot';
        if (type == 'payment') return 'تحصيل Hotspot';
        if (type == 'new') return 'اشتراك Hotspot جديد';
        return 'دفعة Hotspot';
      }

      if (type == 'renewal') return 'تجديد اشتراك';
      if (type == 'debt') return 'تسديد دين';

      return 'اشتراك جديد';
    }

    final allPayments = <Map<String, dynamic>>[];

    for (final payment in paymentHistory) {
      allPayments.add({...payment, '_source': 'اشتراك'});
    }

    for (final payment in broadbandPaymentHistory) {
      if (payment['user_id']?.toString() == widget.currentUser.id) {
        allPayments.add({...payment, '_source': 'Broadband'});
      }
    }

    for (final payment in hotspotPaymentHistory) {
      if (payment['user_id']?.toString() == widget.currentUser.id) {
        allPayments.add({...payment, '_source': 'Hotspot'});
      }
    }

    allPayments.sort((a, b) {
      final dateA =
          DateTime.tryParse(a['created_at']?.toString() ?? '') ??
          DateTime.fromMillisecondsSinceEpoch(0);

      final dateB =
          DateTime.tryParse(b['created_at']?.toString() ?? '') ??
          DateTime.fromMillisecondsSinceEpoch(0);

      return dateB.compareTo(dateA);
    });

    if (allPayments.isEmpty) {
      return const Center(
        child: Text(
          'لا توجد دفعات مسجلة حاليًا',
          style: TextStyle(fontSize: 20),
        ),
      );
    }

    return Padding(
      padding: const EdgeInsets.all(20),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const Text(
            'سجل الدفعات',
            style: TextStyle(fontSize: 28, fontWeight: FontWeight.bold),
          ),

          const SizedBox(height: 8),

          Text(
            'جميع المبالغ معروضة بعملة الحساب: $appCurrency',
            style: TextStyle(
              color: Colors.grey.shade700,
              fontWeight: FontWeight.w600,
            ),
          ),

          const SizedBox(height: 20),

          Expanded(
            child: ListView.builder(
              itemCount: allPayments.length,
              itemBuilder: (context, index) {
                final payment = allPayments[index];

                final userId = payment['user_id']?.toString();

                final user = users.where((u) => u.id == userId).firstOrNull;

                final userName = user?.name ?? 'مستخدم غير معروف';

                final source = payment['_source']?.toString() ?? 'اشتراك';

                final amount = (payment['amount'] as num?)?.toDouble() ?? 0;

                // Broadband و Hotspot مخزنان دائمًا بالدولار.
                final sourceCurrency =
                    source == 'Broadband' || source == 'Hotspot'
                    ? 'USD'
                    : payment['currency']?.toString() ?? 'USD';

                final displayAmount = convertMoney(amount, sourceCurrency);

                final type = payment['payment_type']?.toString();

                IconData icon;

                if (source == 'Broadband') {
                  icon = Icons.router;
                } else if (source == 'Hotspot') {
                  icon = Icons.wifi_tethering;
                } else {
                  icon = type == 'renewal' ? Icons.refresh : Icons.receipt_long;
                }

                return Card(
                  margin: const EdgeInsets.only(bottom: 10),
                  child: ListTile(
                    leading: CircleAvatar(child: Icon(icon)),
                    title: Text(
                      userName,
                      style: const TextStyle(fontWeight: FontWeight.bold),
                    ),
                    subtitle: Text(
                      '$source\n'
                      '${operationText(source, type)}\n'
                      '${formatDate(payment['created_at'])}',
                    ),
                    isThreeLine: true,
                    trailing: Text(
                      formatMoney(displayAmount),
                      style: const TextStyle(
                        fontWeight: FontWeight.bold,
                        fontSize: 15,
                      ),
                    ),
                  ),
                );
              },
            ),
          ),
        ],
      ),
    );
  }

  Widget buildUserDevices() {
    return Padding(
      padding: const EdgeInsets.all(20),
      child: ListView(
        children: [
          const Text(
            'أجهزة المستخدمين',
            style: TextStyle(fontSize: 28, fontWeight: FontWeight.bold),
          ),
          const SizedBox(height: 20),

          ...users.map((user) {
            final userDevices = devices
                .where((d) => d.userId == user.id)
                .toList();

            return Card(
              child: ExpansionTile(
                leading: const Icon(Icons.person),
                title: Text(user.name),
                subtitle: Text('${userDevices.length} جهاز'),
                children: userDevices.map((device) {
                  return ListTile(
                    leading: const Icon(Icons.router),
                    title: Text(device.name),
                    subtitle: Text(
                      '${device.deviceType} • ${device.ipAddress}',
                    ),
                    trailing: Icon(
                      device.active ? Icons.check_circle : Icons.cancel,
                    ),
                  );
                }).toList(),
              ),
            );
          }),
        ],
      ),
    );
  }

  void showUserDetails(AppUser user) {
    final userDevices = devices.where((d) => d.userId == user.id).toList();

    showDialog(
      context: context,
      builder: (context) {
        return AlertDialog(
          title: Text(user.name),
          content: SizedBox(
            width: 400,
            child: ListView(
              shrinkWrap: true,
              children: [
                Text('اسم الدخول: ${user.username}'),
                Text('الدور: ${user.role}'),
                Text(user.active ? 'الحالة: نشط' : 'الحالة: متوقف'),
                const SizedBox(height: 15),
                Text(
                  'عدد الأجهزة: ${userDevices.length}',
                  style: const TextStyle(fontWeight: FontWeight.bold),
                ),
                const SizedBox(height: 10),
                ...userDevices.map(
                  (device) => ListTile(
                    leading: const Icon(Icons.router),
                    title: Text(device.name),
                    subtitle: Text(
                      '${device.deviceType} • ${device.ipAddress}',
                    ),
                  ),
                ),
              ],
            ),
          ),
          actions: [
            TextButton(
              onPressed: () => Navigator.pop(context),
              child: const Text('إغلاق'),
            ),
          ],
        );
      },
    );
  }
