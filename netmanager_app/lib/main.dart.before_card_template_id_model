  Widget statCard(String title, String value, IconData icon) {
    Color cardColor;
    Color iconColor;

    if (title.contains('دين')) {
      cardColor = Colors.red;
      iconColor = Colors.red;
    } else if (title.contains('Hotspot')) {
      cardColor = Colors.deepPurple;
      iconColor = Colors.deepPurple;
    } else if (title.contains('Broadband')) {
      cardColor = Colors.blue;
      iconColor = Colors.blue;
    } else if (title.contains('تحصيل')) {
      cardColor = Colors.green;
      iconColor = Colors.green;
    } else if (title.contains('منته')) {
      cardColor = Colors.orange;
      iconColor = Colors.orange;
    } else if (title.contains('متوقف')) {
      cardColor = Colors.grey.shade700;
      iconColor = Colors.grey.shade700;
    } else if (title.contains('فعال') ||
        title.contains('ساري') ||
        title.contains('نشط')) {
      cardColor = Colors.green;
      iconColor = Colors.green;
    } else {
      cardColor = Theme.of(context).colorScheme.primary;
      iconColor = Theme.of(context).colorScheme.primary;
    }

    return LayoutBuilder(
      builder: (context, constraints) {
        final screenWidth = MediaQuery.of(context).size.width;

        final cardWidth = screenWidth < 600
            ? (screenWidth - 55) / 2
            : screenWidth < 1000
            ? 205.0
            : 225.0;

        return SizedBox(
          width: cardWidth.clamp(145.0, 225.0),
          child: Card(
            elevation: 2,
            margin: EdgeInsets.zero,
            shape: RoundedRectangleBorder(
              borderRadius: BorderRadius.circular(16),
            ),
            child: Container(
              padding: const EdgeInsets.all(12),
              decoration: BoxDecoration(
                borderRadius: BorderRadius.circular(16),
                color: cardColor.withValues(alpha: 0.07),
                border: Border.all(
                  color: cardColor.withValues(alpha: 0.20),
                  width: 1,
                ),
              ),
              child: Row(
                children: [
                  Container(
                    width: 42,
                    height: 42,
                    decoration: BoxDecoration(
                      color: cardColor.withValues(alpha: 0.14),
                      borderRadius: BorderRadius.circular(12),
                    ),
                    child: Icon(icon, size: 22, color: iconColor),
                  ),
                  const SizedBox(width: 10),
                  Expanded(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        Text(
                          title,
                          maxLines: 2,
                          overflow: TextOverflow.ellipsis,
                          style: TextStyle(
                            fontSize: screenWidth < 600 ? 11 : 12,
                            color: cardColor.withValues(alpha: 0.85),
                            fontWeight: FontWeight.w600,
                          ),
                        ),
                        const SizedBox(height: 4),
                        Text(
                          value,
                          maxLines: 1,
                          overflow: TextOverflow.ellipsis,
                          style: const TextStyle(
                            fontSize: 19,
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                      ],
                    ),
                  ),
                ],
              ),
            ),
          ),
        );
      },
    );
  }

