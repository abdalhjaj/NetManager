  Future<void> collectHotspotPayment(HotspotAccount account) async {
    final amountController = TextEditingController();
    final discountController = TextEditingController(text: '0');

    // العملة وسعر الصرف الخاصان بصاحب حساب Hotspot.
    final ownerCurrency = _accountOwnerCurrency(account.userId);

    final priceDisplay = _usdToOwnerCurrency(account.price, account.userId);

    final paidDisplay = _usdToOwnerCurrency(account.paidAmount, account.userId);

    final remainingDisplay = _usdToOwnerCurrency(
      account.remainingAmount,
      account.userId,
    );

    String formatOwnerAmount(double amount) {
      if (ownerCurrency == 'SYP') {
        return '${amount.toStringAsFixed(0)} SYP';
      }
      return '${amount.toStringAsFixed(2)} USD';
    }

    final result = await showDialog<Map<String, double>>(
      context: context,
      builder: (dialogContext) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            final amountDisplay =
                double.tryParse(amountController.text.trim()) ?? 0.0;

            final discountDisplay =
                double.tryParse(discountController.text.trim()) ?? 0.0;

            final totalSettledDisplay = amountDisplay + discountDisplay;

            final remainingAfterDisplay =
                remainingDisplay - totalSettledDisplay > 0
                ? remainingDisplay - totalSettledDisplay
                : 0.0;

            return AlertDialog(
              title: const Text('تحصيل دفعة Hotspot'),
              content: SingleChildScrollView(
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  crossAxisAlignment: CrossAxisAlignment.stretch,
                  children: [
                    Text('قيمة الاشتراك: ${formatOwnerAmount(priceDisplay)}'),
                    const SizedBox(height: 6),
                    Text('المسدّد سابقًا: ${formatOwnerAmount(paidDisplay)}'),
                    const SizedBox(height: 6),
                    Text(
                      'المتبقي: ${formatOwnerAmount(remainingDisplay)}',
                      style: TextStyle(
                        color: Colors.red.shade700,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                    const SizedBox(height: 18),

                    TextField(
                      controller: amountController,
                      keyboardType: const TextInputType.numberWithOptions(
                        decimal: true,
                      ),
                      autofocus: true,
                      decoration: InputDecoration(
                        labelText: 'المبلغ المستلم فعليًا',
                        suffixText: ownerCurrency,
                        prefixIcon: const Icon(Icons.payments_outlined),
                        border: const OutlineInputBorder(),
                      ),
                      onChanged: (_) => setDialogState(() {}),
                    ),

                    const SizedBox(height: 12),

                    TextField(
                      controller: discountController,
                      keyboardType: const TextInputType.numberWithOptions(
                        decimal: true,
                      ),
                      decoration: InputDecoration(
                        labelText: 'الحسم',
                        suffixText: ownerCurrency,
                        prefixIcon: const Icon(Icons.discount_outlined),
                        border: const OutlineInputBorder(),
                      ),
                      onChanged: (_) => setDialogState(() {}),
                    ),

                    const SizedBox(height: 16),

                    Container(
                      padding: const EdgeInsets.all(12),
                      decoration: BoxDecoration(
                        color: Theme.of(context).colorScheme.primaryContainer
                            .withValues(alpha: 0.45),
                        borderRadius: BorderRadius.circular(12),
                      ),
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.stretch,
                        children: [
                          Text(
                            'المبلغ المقبوض: '
                            '${formatOwnerAmount(amountDisplay)}',
                          ),
                          const SizedBox(height: 4),
                          Text(
                            'الحسم: '
                            '${formatOwnerAmount(discountDisplay)}',
                          ),
                          const Divider(),
                          Text(
                            'إجمالي المسدد: '
                            '${formatOwnerAmount(totalSettledDisplay)}',
                            style: const TextStyle(fontWeight: FontWeight.bold),
                          ),
                          const SizedBox(height: 4),
                          Text(
                            'المتبقي بعد العملية: '
                            '${formatOwnerAmount(remainingAfterDisplay)}',
                            style: TextStyle(
                              color: remainingAfterDisplay > 0
                                  ? Colors.red.shade700
                                  : Colors.green.shade700,
                              fontWeight: FontWeight.bold,
                            ),
                          ),
                        ],
                      ),
                    ),
                  ],
                ),
              ),
              actions: [
                TextButton(
                  onPressed: () => Navigator.pop(dialogContext),
                  child: const Text('إلغاء'),
                ),
                FilledButton.icon(
                  onPressed: () {
                    final amountDisplay =
                        double.tryParse(amountController.text.trim()) ?? 0.0;

                    final discountDisplay =
                        double.tryParse(discountController.text.trim()) ?? 0.0;

                    if (amountDisplay < 0 || discountDisplay < 0) {
                      ScaffoldMessenger.of(dialogContext).showSnackBar(
                        const SnackBar(
                          content: Text('لا يمكن إدخال قيمة سالبة'),
                        ),
                      );
                      return;
                    }

                    if (amountDisplay <= 0 && discountDisplay <= 0) {
                      ScaffoldMessenger.of(dialogContext).showSnackBar(
                        const SnackBar(
                          content: Text('أدخل مبلغًا أو حسمًا صحيحًا'),
                        ),
                      );
                      return;
                    }

                    if (amountDisplay + discountDisplay >
                        remainingDisplay + 0.001) {
                      ScaffoldMessenger.of(dialogContext).showSnackBar(
                        const SnackBar(
                          content: Text(
                            'مجموع الدفعة والحسم أكبر من المبلغ المتبقي',
                          ),
                        ),
                      );
                      return;
                    }

                    Navigator.pop(dialogContext, {
                      'amount': amountDisplay,
                      'discount': discountDisplay,
                    });
                  },
                  icon: const Icon(Icons.check),
                  label: const Text('تحصيل'),
                ),
              ],
            );
          },
        );
      },
    );

    amountController.dispose();
    discountController.dispose();

    if (result == null) return;
    if (account.id.isEmpty) return;

    // القيم القادمة من النافذة هي بعملة صاحب الحساب.
    final amountDisplay = result['amount'] ?? 0.0;
    final discountDisplay = result['discount'] ?? 0.0;

    // نحول إلى USD قبل التخزين.
    final amountUsd = _ownerCurrencyToUsd(amountDisplay, account.userId);

    final discountUsd = _ownerCurrencyToUsd(discountDisplay, account.userId);

    final settledAmountUsd = amountUsd + discountUsd;

    if (settledAmountUsd <= 0) return;

    try {
      final supabase = Supabase.instance.client;

      // paid_amount في Hotspot يبقى دائمًا USD.
      final newPaidAmount = account.paidAmount + settledAmountUsd;

      final remainingUsd = account.price - newPaidAmount;

      final paymentStatus = remainingUsd <= 0.001
          ? 'مدفوع بالكامل'
          : 'مدفوع جزئيًا';

      String newServiceStatus = account.serviceStatus;
      DateTime? newDebtGraceUntil = account.debtGraceUntil;

      if (account.serviceStatus == 'manual_suspended' || !account.active) {
        newServiceStatus = 'manual_suspended';
      } else if (remainingUsd <= 0.001) {
        newServiceStatus = 'active';
        newDebtGraceUntil = null;
      } else if (!allowDebt || debtGraceDays <= 0) {
        newServiceStatus = 'debt_suspended';
        newDebtGraceUntil = null;
      } else {
        final now = DateTime.now();

        if (newDebtGraceUntil == null) {
          newDebtGraceUntil = now.add(Duration(days: debtGraceDays));
          newServiceStatus = 'grace';
        } else if (now.isBefore(newDebtGraceUntil)) {
          newServiceStatus = 'grace';
        } else {
          newServiceStatus = 'debt_suspended';
        }
      }

      await supabase.from('hotspot_payments').insert({
        'account_id': account.id,
        'user_id': account.userId,
        'device_id': account.deviceId,

        // سجل الدفعات الداخلي دائمًا USD.
        'amount': amountUsd,
        'discount': discountUsd,
        'currency': 'USD',
        'payment_type': 'payment',
      });

      await supabase
          .from('hotspot_accounts')
          .update({
            'paid_amount': newPaidAmount,
            'payment_status': paymentStatus,
            'service_status': newServiceStatus,
            'debt_grace_until': newDebtGraceUntil?.toIso8601String(),
          })
          .eq('id', account.id);

      await loadHotspotAccounts();
      await loadHotspotPaymentHistory();

      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            discountDisplay > 0
                ? 'تم التحصيل '
                      '${formatOwnerAmount(amountDisplay)} '
                      'وحسم '
                      '${formatOwnerAmount(discountDisplay)} ✓'
                : remainingUsd <= 0.001
                ? 'تم تحصيل المبلغ بالكامل ✓'
                : 'تم تسجيل الدفعة بنجاح ✓',
          ),
          backgroundColor: Colors.green,
        ),
      );

      setState(() {});
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('حدث خطأ أثناء تسجيل الدفعة: $e'),
          backgroundColor: Colors.red,
        ),
      );
    }
  }

