        for (final user in users) {
          if (user.id == widget.currentUser.id) {
            user.currency = widget.currentUser.currency;
            user.usdToSypRate = widget.currentUser.usdToSypRate;
            break;
          }
        }
      }

      final data = await supabase
          .from('app_settings')
          .select()
          .eq('user_id', widget.currentUser.id)
          .maybeSingle();

      if (data == null) {
        await supabase.from('app_settings').insert({
          'user_id': widget.currentUser.id,
          'default_currency': widget.currentUser.currency,
          'debt_grace_days': 3,
          'allow_debt': true,
          'profile_edit_allowed': true,
          'backup_enabled': true,
        });

        if (!mounted) return;

        setState(() {
          appCurrency = widget.currentUser.currency;
          usdToSypRate = widget.currentUser.usdToSypRate;
          debtGraceDays = 3;
          allowDebt = true;
          profileEditAllowed = true;
          backupEnabled = true;
        });

        return;
      }

      if (!mounted) return;

      setState(() {
        appCurrency = widget.currentUser.currency;
        usdToSypRate = widget.currentUser.usdToSypRate;

        debtGraceDays = (data['debt_grace_days'] as num?)?.toInt() ?? 3;

        allowDebt = data['allow_debt'] as bool? ?? true;

        profileEditAllowed = data['profile_edit_allowed'] as bool? ?? true;

        backupEnabled = data['backup_enabled'] as bool? ?? true;
