          'dbCurrency=${userData['currency']}, '
          'dbRate=${userData['usd_to_syp_rate']}',
        );

        widget.currentUser.currency = userData['currency']?.toString() ?? 'USD';

        widget.currentUser.usdToSypRate =
            (userData['usd_to_syp_rate'] as num?)?.toDouble() ?? 1;

        currentUser?.currency = widget.currentUser.currency;
        currentUser?.usdToSypRate = widget.currentUser.usdToSypRate;

        // مزامنة نفس المستخدم داخل القائمة العامة users
