                  );

                  final parsedPayment = double.tryParse(
                    paymentAmountController.text.trim(),
                  );

                  final parsedDuration = int.tryParse(
                    durationController.text.trim(),
                  );

                  if (parsedAmount == null || parsedAmount <= 0) {
                    return;
                  }

                  final totalRequired = oldDebt + parsedAmount;

                  if (parsedPayment == null ||
                      parsedPayment < 0 ||
                      parsedPayment > totalRequired) {
                    return;
                  }

                  if (parsedDuration == null || parsedDuration <= 0) {
                    return;
                  }

                  Navigator.pop(dialogContext, true);
                },
                icon: const Icon(Icons.refresh),
                label: const Text('تأكيد التجديد'),
              ),
            ],
          );
        },
      ),
    );

    if (confirmed != true) {
      amountController.dispose();
      paymentAmountController.dispose();
      durationController.dispose();
      return;
    }

    final renewalAmount = double.tryParse(amountController.text.trim());

    final collectedAmount = double.tryParse(
      paymentAmountController.text.trim(),
    );

    final durationDays = int.tryParse(durationController.text.trim());

    if (renewalAmount == null ||
        renewalAmount <= 0 ||
        collectedAmount == null ||
        collectedAmount < 0 ||
        collectedAmount > (oldDebt + renewalAmount) ||
        durationDays == null ||
        durationDays <= 0) {
      amountController.dispose();
      paymentAmountController.dispose();
      durationController.dispose();
      return;
    }

    final now = DateTime.now();

    final baseDate = sub.dueDate != null && sub.dueDate!.isAfter(now)
        ? sub.dueDate!
        : now;

    final newDueDate = baseDate.add(Duration(days: durationDays));

    try {
      final supabase = Supabase.instance.client;

      // إنشاء دورة اشتراك جديدة مستقلة
      final newSubscription = Subscription(
        userId: sub.userId,
        deviceId: sub.deviceId,
        amount: renewalAmount,
        currency: currency,
        createdAt: now,
        dueDate: newDueDate,
      );

      subscriptions.add(newSubscription);

      await saveSubscriptions();

      if (newSubscription.id.isEmpty) {
        throw Exception('لم يتم الحصول على معرف الاشتراك الجديد');
      }

      // تسديد الدين القديم أولًا
      final oldDebtPayment = collectedAmount > oldDebt
          ? oldDebt
          : collectedAmount;

      // المبلغ المتبقي بعد تسديد الدين القديم
      // يذهب إلى الاشتراك الجديد
      final renewalPayment = collectedAmount - oldDebtPayment;

      if (oldDebtPayment > 0) {
        await supabase.from('subscription_payments').insert({
          'subscription_id': sub.id,
          'user_id': sub.userId,
          'device_id': sub.deviceId,
          'amount': oldDebtPayment,
          'currency': sub.currency,
          'duration_days': null,
          'payment_type': 'debt_payment',
        });
      }

      if (renewalPayment > 0) {
        await supabase.from('subscription_payments').insert({
          'subscription_id': newSubscription.id,
          'user_id': newSubscription.userId,
          'device_id': newSubscription.deviceId,
          'amount': renewalPayment,
          'currency': newSubscription.currency,
          'duration_days': durationDays,
          'payment_type': 'renewal',
        });
      }

      // لا نحتاج إلى تعديل الاشتراك القديم.
      // يبقى محفوظًا في قاعدة البيانات كسجل تاريخي،
      // والتطبيق يعرض أحدث دورة اشتراك فقط.

      await loadSubscriptions();
      await loadPaymentHistory();

      if (!mounted) return;

      setState(() {});

      final remainingAmount = renewalAmount - renewalPayment;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            remainingAmount <= 0.001
                ? 'تم تجديد الاشتراك وتحصيل المبلغ بالكامل ✓'
                : 'تم التجديد بنجاح. المتبقي '
                      '${remainingAmount.toStringAsFixed(2)} $currency '
                      'على المشترك',
          ),
          backgroundColor: remainingAmount <= 0.001
              ? Colors.green
              : Colors.orange,
        ),
      );
    } catch (e) {
      // إذا فشل الحفظ نحاول إزالة السجل المحلي الجديد
      subscriptions.removeWhere(
        (item) =>
            item.id.isEmpty &&
            item.userId == sub.userId &&
            item.createdAt == now,
      );

      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('خطأ أثناء تجديد الاشتراك: $e'),
          backgroundColor: Colors.red,
        ),
      );
    } finally {
      amountController.dispose();
      paymentAmountController.dispose();
      durationController.dispose();
    }
  }

