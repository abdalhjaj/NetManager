                      child: Row(
                        children: [
                          Icon(
                            remainingAmount <= 0
                                ? Icons.check_circle
                                : Icons.pending_actions,
                            color: remainingAmount <= 0
                                ? Colors.green
                                : Colors.orange,
                          ),
                          const SizedBox(width: 10),
                          Expanded(
                            child: Text(
                              remainingAmount <= 0
