                            ),
                            backgroundColor: Colors.red,
                          ),
                        );
                        return;
                      }

                      if (durationDays <= 0) {
                        ScaffoldMessenger.of(this.context).showSnackBar(
                          const SnackBar(
                            content: Text(
                              'يرجى إدخال مدة اشتراك صحيحة بالأيام',
                            ),
                            backgroundColor: Colors.red,
                          ),
                        );
                        return;
                      }

                      if (price < 0 || paid < 0) {
                        ScaffoldMessenger.of(this.context).showSnackBar(
                          const SnackBar(
                            content: Text(
                              'السعر والمدفوع يجب أن يكونا أرقامًا صحيحة',
                            ),
                            backgroundColor: Colors.red,
                          ),
                        );
                        return;
                      }

                      if (paid > price) {
                        ScaffoldMessenger.of(this.context).showSnackBar(
                          const SnackBar(
                            content: Text(
                              'المبلغ المدفوع لا يمكن أن يكون أكبر من السعر',
                            ),
                            backgroundColor: Colors.red,
                          ),
                        );
                        return;
                      }

                      final calculatedPaymentStatus = paid <= 0
                          ? 'غير مدفوع'
                          : paid < price
                          ? 'مدفوع جزئيًا'
                          : 'مدفوع بالكامل';

                      final finalExpiresAt = startAt.add(
                        Duration(days: durationDays),
                      );

                      try {
                        final supabase = Supabase.instance.client;

                        await supabase.from('hotspot_accounts').insert({
                          'user_id': selectedUserId,
                          'device_id': selectedDeviceId,
                          'username': username,
                          'password': password,
                          'profile': profile.isEmpty ? null : profile,
                          'active': active,
                          'subscription_duration': durationDays,
                          'start_at': startAt.toIso8601String(),
                          'expires_at': finalExpiresAt.toIso8601String(),
                          'payment_status': calculatedPaymentStatus,
                          'price': price,
                          'paid_amount': paid,
                        });

                        await loadHotspotAccounts();

                        if (!mounted) return;

                        Navigator.pop(dialogContext);

                        setState(() {});

                        ScaffoldMessenger.of(this.context).showSnackBar(
                          const SnackBar(
                            content: Text('تم حفظ مشترك الهوتسبوت بنجاح ✓'),
                            backgroundColor: Colors.green,
