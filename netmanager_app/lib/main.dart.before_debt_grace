  Future<void> collectHotspotPayment(HotspotAccount account) async {
    final amountController = TextEditingController();

    final amount = await showDialog<double>(
      context: context,
      builder: (dialogContext) {
        return AlertDialog(
          title: const Text('تحصيل دفعة Hotspot'),
          content: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.stretch,
            children: [
              Text(
                'قيمة الاشتراك: ${account.price.toStringAsFixed(2)} ${'USD'}',
              ),
              const SizedBox(height: 6),
              Text(
                'المدفوع سابقًا: ${account.paidAmount.toStringAsFixed(2)} ${'USD'}',
              ),
              const SizedBox(height: 6),
              Text(
                'المتبقي: ${account.remainingAmount.toStringAsFixed(2)} ${'USD'}',
                style: TextStyle(
                  color: Colors.red.shade700,
                  fontWeight: FontWeight.bold,
                ),
              ),
              const SizedBox(height: 18),
              TextField(
                controller: amountController,
                keyboardType: const TextInputType.numberWithOptions(
                  decimal: true,
                ),
                autofocus: true,
                decoration: InputDecoration(
                  labelText: 'المبلغ المستلم',
                  suffixText: 'USD',
                  prefixIcon: const Icon(Icons.payments_outlined),
                  border: const OutlineInputBorder(),
                ),
              ),
            ],
          ),
          actions: [
            TextButton(
              onPressed: () => Navigator.pop(dialogContext),
              child: const Text('إلغاء'),
            ),
            FilledButton.icon(
              onPressed: () {
                final value = double.tryParse(amountController.text.trim());

                if (value == null || value <= 0) {
                  ScaffoldMessenger.of(context).showSnackBar(
                    const SnackBar(content: Text('أدخل مبلغًا صحيحًا')),
                  );
                  return;
                }

                if (value > account.remainingAmount) {
                  ScaffoldMessenger.of(context).showSnackBar(
                    const SnackBar(
                      content: Text('المبلغ أكبر من المبلغ المتبقي'),
                    ),
                  );
                  return;
                }

                Navigator.pop(dialogContext, value);
              },
              icon: const Icon(Icons.check),
              label: const Text('تحصيل'),
            ),
          ],
        );
      },
    );

    amountController.dispose();

    if (amount == null || amount <= 0) return;
    if (account.id.isEmpty) return;

    try {
      final supabase = Supabase.instance.client;

      final newPaidAmount = account.paidAmount + amount;
      final remaining = account.price - newPaidAmount;

      final paymentStatus = remaining <= 0 ? 'مدفوع بالكامل' : 'مدفوع جزئيًا';

      await supabase.from('hotspot_payments').insert({
        'account_id': account.id,
        'user_id': account.userId,
        'device_id': account.deviceId,
        'amount': amount,
        'currency': 'USD',
        'payment_type': 'payment',
      });

      await supabase
          .from('hotspot_accounts')
          .update({
            'paid_amount': newPaidAmount,
            'payment_status': paymentStatus,
          })
          .eq('id', account.id);

      await loadHotspotAccounts();

      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            remaining <= 0
                ? 'تم تحصيل المبلغ بالكامل ✓'
                : 'تم تسجيل الدفعة بنجاح ✓',
          ),
        ),
      );

      setState(() {});
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(
        context,
      ).showSnackBar(SnackBar(content: Text('حدث خطأ أثناء تسجيل الدفعة: $e')));
    }
  }

  Widget buildHotspot() {
    final now = DateTime.now();

    final isManager = widget.currentUser.role == 'مدير';

    final effectiveHotspotUserId =
        selectedHotspotUserId ?? widget.currentUser.id;

    final filteredHotspotAccounts = isManager
        ? hotspotAccounts
              .where((a) => a.userId == effectiveHotspotUserId)
              .toList()
        : hotspotAccounts
              .where((a) => a.userId == widget.currentUser.id)
              .toList();

    String statusOf(HotspotAccount account) {
      if (!account.active) return 'متوقف';

      if (account.expiresAt != null && account.expiresAt!.isBefore(now)) {
        return 'منتهي';
      }

      if (account.remainingAmount > 0) {
        return 'عليه دين';
      }

      return 'فعال';
    }

    final allCount = filteredHotspotAccounts.length;
    final activeCount = filteredHotspotAccounts
        .where((a) => statusOf(a) == 'فعال')
        .length;
    final debtCount = filteredHotspotAccounts
        .where((a) => statusOf(a) == 'عليه دين')
        .length;
    final expiredCount = filteredHotspotAccounts
        .where((a) => statusOf(a) == 'منتهي')
        .length;
    final stoppedCount = filteredHotspotAccounts
        .where((a) => statusOf(a) == 'متوقف')
        .length;

    final visibleAccounts = hotspotStatusFilter == 'الكل'
        ? filteredHotspotAccounts
        : filteredHotspotAccounts
              .where((a) => statusOf(a) == hotspotStatusFilter)
              .toList();

    Widget filterChip(String label, int count, Color color) {
      final selected = hotspotStatusFilter == label;

      return Padding(
        padding: const EdgeInsets.only(left: 8),
        child: ChoiceChip(
          selected: selected,
          onSelected: (_) {
            setState(() {
              hotspotStatusFilter = label;
            });
          },
          label: Text('$label ($count)'),
          selectedColor: color.withValues(alpha: 0.15),
          labelStyle: TextStyle(
            color: selected ? color : null,
            fontWeight: FontWeight.bold,
          ),
          side: BorderSide(
            color: selected
                ? color.withValues(alpha: 0.45)
                : Colors.grey.withValues(alpha: 0.25),
          ),
        ),
      );
    }

    String userName(String userId) {
      final user = users.cast<AppUser?>().firstWhere(
        (u) => u?.id == userId,
        orElse: () => null,
      );
      return user?.name ?? 'غير معروف';
    }

    String deviceName(String deviceId) {
      final device = devices.cast<NetworkDevice?>().firstWhere(
        (d) => d?.id == deviceId,
        orElse: () => null,
      );
      return device?.name ?? 'غير معروف';
    }

    String formatDate(DateTime? date) {
      if (date == null) return '-';
      return '${date.day.toString().padLeft(2, '0')}/'
          '${date.month.toString().padLeft(2, '0')}/'
          '${date.year}';
    }

    return Directionality(
      textDirection: TextDirection.rtl,
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: [
            Card(
              child: Padding(
                padding: const EdgeInsets.all(18),
                child: Row(
                  children: [
                    Container(
                      padding: const EdgeInsets.all(12),
                      decoration: BoxDecoration(
                        color: Colors.green.withValues(alpha: 0.12),
                        borderRadius: BorderRadius.circular(14),
                      ),
                      child: const Icon(
                        Icons.wifi,
                        size: 38,
                        color: Colors.green,
                      ),
                    ),
                    const SizedBox(width: 14),
                    const Expanded(
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Text(
                            'مشتركين هوتسبوت',
                            style: TextStyle(
                              fontSize: 23,
                              fontWeight: FontWeight.bold,
                            ),
                          ),
                          SizedBox(height: 4),
                          Text(
                            'إدارة حسابات وبطاقات الهوتسبوت',
                            style: TextStyle(fontSize: 14),
                          ),
                        ],
                      ),
                    ),
                    FilledButton.icon(
                      onPressed: showAddHotspotDialog,
                      icon: const Icon(Icons.add),
                      label: const Text('إضافة مشترك'),
                    ),
                  ],
                ),
              ),
            ),

            const SizedBox(height: 12),

            if (isManager)
              Card(
                child: Padding(
                  padding: const EdgeInsets.all(12),
                  child: DropdownButtonFormField<String>(
                    initialValue: effectiveHotspotUserId,
                    decoration: const InputDecoration(
                      labelText: 'المستخدم',
                      prefixIcon: Icon(Icons.person),
                      border: OutlineInputBorder(),
                    ),
                    items: users
                        .where((user) => user.active)
                        .map(
                          (user) => DropdownMenuItem<String>(
                            value: user.id,
                            child: Text(user.name),
                          ),
                        )
                        .toList(),
                    onChanged: (value) {
                      if (value == null) return;

                      setState(() {
                        selectedHotspotUserId = value;
                        hotspotStatusFilter = 'الكل';
                      });
                    },
                  ),
                ),
              ),

            const SizedBox(height: 12),

