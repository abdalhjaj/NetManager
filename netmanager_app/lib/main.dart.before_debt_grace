  void addSubscription() {
    final amount = TextEditingController();
    final paymentAmount = TextEditingController();
    final durationController = TextEditingController(text: '30');

    String currency = 'USD';
    String? userId;
    String? deviceId;

    showDialog(
      context: context,
      builder: (dialogContext) => StatefulBuilder(
        builder: (context, setDialogState) {
          final subscriptionAmount = double.tryParse(amount.text.trim()) ?? 0;

          final collectedAmount =
              double.tryParse(paymentAmount.text.trim()) ?? 0;

          final remainingAmount = (subscriptionAmount - collectedAmount).clamp(
            0,
            subscriptionAmount,
          );

          return AlertDialog(
            title: const Text('إضافة اشتراك'),
            content: SingleChildScrollView(
              child: Column(
                mainAxisSize: MainAxisSize.min,
                children: [
                  DropdownButtonFormField<String>(
                    initialValue: userId,
                    decoration: const InputDecoration(labelText: 'المشترك'),
                    items: users
                        .where(
                          (u) =>
                              u.role != 'مدير' &&
                              !subscriptions.any((sub) => sub.userId == u.id),
                        )
                        .map(
                          (u) => DropdownMenuItem(
                            value: u.id,
                            child: Text(u.name),
                          ),
                        )
                        .toList(),
                    onChanged: (v) => setDialogState(() {
                      userId = v;
                      deviceId = null;
                    }),
                  ),
                  const SizedBox(height: 12),

                  TextField(
                    controller: durationController,
                    keyboardType: TextInputType.number,
                    decoration: const InputDecoration(
                      labelText: 'مدة الاشتراك بالأيام',
                      hintText: 'مثال: 30',
                      prefixIcon: Icon(Icons.calendar_month),
                    ),
                  ),
                  const SizedBox(height: 12),

                  TextField(
                    controller: amount,
                    keyboardType: const TextInputType.numberWithOptions(
                      decimal: true,
                    ),
                    decoration: const InputDecoration(
                      labelText: 'قيمة الاشتراك',
                      hintText: 'مثال: 30',
                      prefixIcon: Icon(Icons.payments),
                    ),
                    onChanged: (_) => setDialogState(() {}),
                  ),
                  const SizedBox(height: 12),

                  TextField(
                    controller: paymentAmount,
                    keyboardType: const TextInputType.numberWithOptions(
                      decimal: true,
                    ),
                    decoration: const InputDecoration(
                      labelText: 'المبلغ المحصل من المشترك',
                      hintText: 'مثال: 20',
                      prefixIcon: Icon(Icons.account_balance_wallet),
                    ),
                    onChanged: (_) => setDialogState(() {}),
                  ),
                  const SizedBox(height: 12),

                  if (subscriptionAmount > 0)
                    Container(
                      width: double.infinity,
                      padding: const EdgeInsets.all(12),
                      decoration: BoxDecoration(
                        color: remainingAmount <= 0
                            ? Colors.green.withValues(alpha: 0.08)
                            : Colors.orange.withValues(alpha: 0.08),
                        borderRadius: BorderRadius.circular(12),
                        border: Border.all(
