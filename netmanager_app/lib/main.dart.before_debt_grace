  Future<void> loadAppSettings() async {
    final supabase = Supabase.instance.client;

    try {
      final data = await supabase
          .from('app_settings')
          .select()
          .eq('user_id', widget.currentUser.id)
          .maybeSingle();

      if (data == null) {
        await supabase.from('app_settings').insert({
          'user_id': widget.currentUser.id,
          'default_currency': 'USD',
          'debt_grace_days': 3,
          'allow_debt': true,
          'profile_edit_allowed': true,
          'backup_enabled': true,
        });

        if (!mounted) return;

        setState(() {
          appCurrency = 'USD';
          debtGraceDays = 3;
          allowDebt = true;
          profileEditAllowed = true;
          backupEnabled = true;
        });

        return;
      }

      if (!mounted) return;

      setState(() {
        appCurrency = data['default_currency']?.toString() ?? 'USD';

        debtGraceDays = (data['debt_grace_days'] as num?)?.toInt() ?? 3;

        allowDebt = data['allow_debt'] as bool? ?? true;

        profileEditAllowed = data['profile_edit_allowed'] as bool? ?? true;

        backupEnabled = data['backup_enabled'] as bool? ?? true;
      });
    } catch (e) {
      debugPrint('LOAD APP SETTINGS ERROR: $e');
    }
  }

