                                        ? Colors.red.shade700
                                        : Colors.green.shade700,
                                  ),
                                ),
                              ],
                            ),
                          ),
                        ),
                      ],

                      const SizedBox(height: 8),

                      SwitchListTile(
                        contentPadding: EdgeInsets.zero,
                        title: const Text('الحساب فعال'),
                        value: active,
                        onChanged: (value) {
                          setDialogState(() {
                            active = value;
                          });
                        },
                      ),
                    ],
                  ),
                ),
              ),
              actions: [
                TextButton(
                  onPressed: () => Navigator.pop(dialogContext, false),
                  child: const Text('إلغاء'),
                ),
                FilledButton.icon(
                  onPressed: () async {
                    if (selectedUserId == null) {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(content: Text('يرجى اختيار المشترك')),
                      );
                      return;
                    }

                    if (selectedDeviceId == null) {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(
                          content: Text('يرجى اختيار جهاز MikroTik'),
                        ),
                      );
                      return;
                    }

                    if (usernameController.text.trim().isEmpty) {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(
                          content: Text('يرجى إدخال اسم المستخدم'),
                        ),
                      );
                      return;
                    }

                    if (passwordController.text.trim().isEmpty) {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(content: Text('يرجى إدخال كلمة المرور')),
                      );
                      return;
                    }

                    final durationDays =
                        int.tryParse(durationController.text.trim()) ?? 0;

                    if (durationDays <= 0) {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(
                          content: Text('يرجى إدخال مدة اشتراك صحيحة بالأيام'),
                        ),
                      );
                      return;
                    }

                    final price = getPrice();
                    final paid = paymentStatus == 'مدفوع' ? getPaid() : 0.0;

                    if (price <= 0) {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(
                          content: Text('يرجى إدخال قيمة الاشتراك'),
                        ),
                      );
                      return;
                    }

                    if (paid > price) {
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(
                          content: Text(
                            'المبلغ المقبوض لا يمكن أن يكون أكبر من قيمة الاشتراك',
                          ),
                        ),
                      );
                      return;
                    }

                    final expiresAt = startAt.add(Duration(days: durationDays));

                    try {
                      final supabase = Supabase.instance.client;

                      await supabase.from('broadband_accounts').insert({
                        'user_id': selectedUserId,
                        'device_id': selectedDeviceId,
                        'username': usernameController.text.trim(),
                        'password': passwordController.text.trim(),
                        'profile': profileController.text.trim().isEmpty
                            ? null
                            : profileController.text.trim(),
                        'active': active,
                        'subscription_duration': durationDays,
                        'start_at': startAt.toIso8601String(),
                        'expires_at': expiresAt.toIso8601String(),
                        'payment_status': paymentStatus,
                        'price': price,
                        'paid_amount': paid,
                      });

                      await loadBroadbandAccounts();

                      if (mounted) {
                        setState(() {});
                      }

                      if (dialogContext.mounted) {
                        Navigator.pop(dialogContext, true);
                      }

                      if (mounted) {
                        ScaffoldMessenger.of(context).showSnackBar(
                          const SnackBar(
                            content: Text('تم حفظ حساب Broadband بنجاح'),
                          ),
                        );
                      }
                    } catch (e) {
                      if (dialogContext.mounted) {
                        ScaffoldMessenger.of(dialogContext).showSnackBar(
                          SnackBar(content: Text('خطأ أثناء حفظ الحساب: $e')),
                        );
                      }
                    }
                  },
                  icon: const Icon(Icons.save),
                  label: const Text('حفظ المشترك'),
                ),
              ],
            );
          },
        );
      },
    );

    usernameController.dispose();
    passwordController.dispose();
    profileController.dispose();
    priceController.dispose();
    paidController.dispose();

    if (result == true && mounted) {
      setState(() {});
    }
  }

