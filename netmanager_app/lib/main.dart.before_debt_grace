Future<void> loadHotspotAccounts() async {
  final supabase = Supabase.instance.client;

  hotspotAccounts.clear();

  // قبل تسجيل الدخول لا نعرض أي حسابات
  if (currentUser == null) {
    return;
  }

  dynamic data;

  // المدير يرى جميع حسابات Hotspot
  if (currentUser!.role == 'مدير') {
    data = await supabase
        .from('hotspot_accounts')
        .select()
        .order('created_at', ascending: false);
  } else {
    // المستخدم العادي يرى حساباته فقط
    data = await supabase
        .from('hotspot_accounts')
        .select()
        .eq('user_id', currentUser!.id)
        .order('created_at', ascending: false);
  }

  for (final item in data) {
    hotspotAccounts.add(
      HotspotAccount.fromJson(Map<String, dynamic>.from(item)),
    );
  }
}

