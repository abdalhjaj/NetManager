  Widget buildDashboard() {
    final now = DateTime.now();

    // الاشتراكات الحالية فقط:
    // لكل مشترك وجهاز نأخذ أحدث دورة اشتراك.
    final latestSubscriptions = <String, Subscription>{};

    for (final sub in subscriptions) {
      final key = '${sub.userId}|${sub.deviceId ?? ''}';
      final existing = latestSubscriptions[key];

      if (existing == null) {
        latestSubscriptions[key] = sub;
        continue;
      }

      final existingDate =
          existing.createdAt ?? DateTime.fromMillisecondsSinceEpoch(0);

      final currentDate =
          sub.createdAt ?? DateTime.fromMillisecondsSinceEpoch(0);

      if (currentDate.isAfter(existingDate)) {
        latestSubscriptions[key] = sub;
      }
    }

    final currentSubscriptions = latestSubscriptions.values.toList();

    final activeSubscriptionList = currentSubscriptions.where((sub) {
      return sub.dueDate != null && sub.dueDate!.isAfter(now);
    }).toList();

    final expiredSubscriptionList = currentSubscriptions.where((sub) {
      return sub.dueDate == null || sub.dueDate!.isBefore(now);
    }).toList();

    final activeSubscriptions = activeSubscriptionList.length;
    final expiredSubscriptions = expiredSubscriptionList.length;

    // حسابات Broadband الخاصة بالمستخدم الحالي.
    final myBroadbandAccounts = broadbandAccounts
        .where((account) => account.userId == widget.currentUser.id)
        .toList();

    // حسابات Hotspot الخاصة بالمستخدم الحالي.
    final myHotspotAccounts = hotspotAccounts
        .where((account) => account.userId == widget.currentUser.id)
        .toList();

    // إحصائيات Broadband.
    final activeBroadband = myBroadbandAccounts.where((account) {
      return account.active &&
          (account.expiresAt == null || account.expiresAt!.isAfter(now));
    }).length;

    final expiredBroadband = myBroadbandAccounts.where((account) {
      return account.expiresAt != null && account.expiresAt!.isBefore(now);
    }).length;

    final stoppedBroadband = myBroadbandAccounts.where((account) {
      return !account.active;
    }).length;

    final broadbandDebt = myBroadbandAccounts
        .where((account) => account.remainingAmount > 0.001)
        .fold<double>(0, (sum, account) => sum + account.remainingAmount);

    // إحصائيات Hotspot.
    final activeHotspot = myHotspotAccounts.where((account) {
      return account.active &&
          (account.expiresAt == null || account.expiresAt!.isAfter(now));
    }).length;

    final expiredHotspot = myHotspotAccounts.where((account) {
      return account.expiresAt != null && account.expiresAt!.isBefore(now);
    }).length;

    final stoppedHotspot = myHotspotAccounts.where((account) {
      return !account.active;
    }).length;

    final hotspotDebt = myHotspotAccounts
        .where((account) => account.remainingAmount > 0.001)
        .fold<double>(0, (sum, account) => sum + account.remainingAmount);

    // ============================================================
    // النظام المالي الموحد حسب عملة حساب المستخدم الحالي
    // ============================================================

    // سعر الصرف: قيمة 1 USD بالليرة السورية.
    final exchangeRate = usdToSypRate > 0 ? usdToSypRate : 1.0;

    double convertToAccountCurrency(double amount, String sourceCurrency) {
      if (sourceCurrency == appCurrency) {
        return amount;
      }

      if (sourceCurrency == 'USD' && appCurrency == 'SYP') {
        return amount * exchangeRate;
      }

      if (sourceCurrency == 'SYP' && appCurrency == 'USD') {
        return amount / exchangeRate;
      }

      return amount;
    }

    String formatAccountMoney(double amount) {
      if (appCurrency == 'SYP') {
        return '${amount.toStringAsFixed(0)} SYP';
      }

      return '${amount.toStringAsFixed(2)} USD';
    }

    // ------------------------------------------------------------
    // تحصيل الاشتراكات العادية بعد تحويلها إلى عملة الحساب.
    // ------------------------------------------------------------

    final ordinaryCollected = paymentHistory.fold<double>(0, (sum, payment) {
      final amount = (payment['amount'] as num?)?.toDouble() ?? 0;

      final currency = payment['currency']?.toString() ?? 'USD';

      return sum + convertToAccountCurrency(amount, currency);
    });

    // ------------------------------------------------------------
    // Broadband و Hotspot مخزنان حاليًا بالدولار.
    // يتم تحويلهما فقط للعرض والتجميع.
    // ------------------------------------------------------------

    final broadbandCollected = convertToAccountCurrency(
      broadbandPaymentHistory.fold<double>(
        0,
        (sum, payment) => sum + ((payment['amount'] as num?)?.toDouble() ?? 0),
      ),
      'USD',
    );

    final hotspotCollected = convertToAccountCurrency(
      hotspotPaymentHistory.fold<double>(
        0,
        (sum, payment) => sum + ((payment['amount'] as num?)?.toDouble() ?? 0),
      ),
      'USD',
    );

    // الحسومات لا تعتبر إيرادًا.
    final broadbandDiscount = convertToAccountCurrency(
      broadbandPaymentHistory.fold<double>(
        0,
        (sum, payment) =>
            sum + ((payment['discount'] as num?)?.toDouble() ?? 0),
      ),
      'USD',
    );

    final hotspotDiscount = convertToAccountCurrency(
      hotspotPaymentHistory.fold<double>(
        0,
        (sum, payment) =>
            sum + ((payment['discount'] as num?)?.toDouble() ?? 0),
      ),
      'USD',
    );

    final totalDiscount = broadbandDiscount + hotspotDiscount;

    final totalCashCollected =
        ordinaryCollected + broadbandCollected + hotspotCollected;

    // ------------------------------------------------------------
    // تحويل ديون Broadband و Hotspot إلى عملة الحساب.
    // القيم الأصلية للحسابات تبقى بالدولار حاليًا.
    // ------------------------------------------------------------

    final broadbandDebtDisplay = convertToAccountCurrency(broadbandDebt, 'USD');

    final hotspotDebtDisplay = convertToAccountCurrency(hotspotDebt, 'USD');

    // ------------------------------------------------------------
    // التحصيل اليومي والشهري بعملة الحساب الحالي
    // ------------------------------------------------------------

    double todayAccountTotal = 0;
    double monthAccountTotal = 0;

    final today = DateTime(now.year, now.month, now.day);
    final firstDayOfMonth = DateTime(now.year, now.month, 1);

    void addPaymentToAccountTotals(Map<String, dynamic> payment) {
      final createdAtValue = payment['created_at'];

      if (createdAtValue == null) return;

      final createdAt = DateTime.tryParse(createdAtValue.toString());

      if (createdAt == null) return;

      final amount = (payment['amount'] as num?)?.toDouble() ?? 0;

      final currency = payment['currency']?.toString() ?? 'USD';

      final convertedAmount = convertToAccountCurrency(amount, currency);

      if (!createdAt.isBefore(today)) {
        todayAccountTotal += convertedAmount;
      }

      if (!createdAt.isBefore(firstDayOfMonth)) {
        monthAccountTotal += convertedAmount;
      }
    }

    for (final payment in paymentHistory) {
      addPaymentToAccountTotals(payment);
    }

    for (final payment in broadbandPaymentHistory) {
      addPaymentToAccountTotals(payment);
    }

    for (final payment in hotspotPaymentHistory) {
      addPaymentToAccountTotals(payment);
    }

    // نحافظ مؤقتًا على هذه المتغيرات لأن أجزاء أخرى من واجهة
    // لوحة التحكم قد ما زالت تستخدم الأسماء القديمة.
    final todayUsd = appCurrency == 'USD' ? todayAccountTotal : 0.0;

    final todaySyp = appCurrency == 'SYP' ? todayAccountTotal : 0.0;

    final monthUsd = appCurrency == 'USD' ? monthAccountTotal : 0.0;

    final monthSyp = appCurrency == 'SYP' ? monthAccountTotal : 0.0;

    // ------------------------------------------------------------
    // آخر عمليات التحصيل
    // ------------------------------------------------------------

    final recentPayments = <Map<String, dynamic>>[];

    for (final payment in paymentHistory) {
      recentPayments.add({...payment, '_type': 'اشتراك'});
    }

    for (final payment in broadbandPaymentHistory) {
      recentPayments.add({...payment, '_type': 'Broadband'});
    }

    for (final payment in hotspotPaymentHistory) {
      recentPayments.add({...payment, '_type': 'Hotspot'});
    }

    recentPayments.sort((a, b) {
      final dateA =
          DateTime.tryParse(a['created_at']?.toString() ?? '') ??
          DateTime.fromMillisecondsSinceEpoch(0);

      final dateB =
          DateTime.tryParse(b['created_at']?.toString() ?? '') ??
          DateTime.fromMillisecondsSinceEpoch(0);

      return dateB.compareTo(dateA);
    });

    final latestPayments = recentPayments.take(10).toList();

    // ------------------------------------------------------------
    // ديون الاشتراكات العادية
    // ------------------------------------------------------------

    double subscriptionDebt = 0;

    for (final sub in currentSubscriptions) {
      final paidAmount = paymentHistory
          .where((payment) => payment['subscription_id']?.toString() == sub.id)
          .fold<double>(
            0,
            (sum, payment) =>
                sum + ((payment['amount'] as num?)?.toDouble() ?? 0),
          );

      final debt = (sub.amount - paidAmount).clamp(0, sub.amount).toDouble();

      subscriptionDebt += convertToAccountCurrency(debt, sub.currency);
    }

    return SingleChildScrollView(
