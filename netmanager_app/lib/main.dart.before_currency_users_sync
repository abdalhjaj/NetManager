  void addSubscription() {
    final amount = TextEditingController();
    final paymentAmount = TextEditingController();
    final durationController = TextEditingController(text: '30');

    String currency = 'USD';
    String? userId;
    String? deviceId;

    showDialog(
      context: context,
      builder: (dialogContext) => StatefulBuilder(
        builder: (context, setDialogState) {
          final subscriptionAmount = double.tryParse(amount.text.trim()) ?? 0;

          final collectedAmount =
              double.tryParse(paymentAmount.text.trim()) ?? 0;

          final remainingAmount = (subscriptionAmount - collectedAmount).clamp(
            0,
            subscriptionAmount,
          );

          return AlertDialog(
            title: const Text('إضافة اشتراك'),
            content: SingleChildScrollView(
              child: Column(
                mainAxisSize: MainAxisSize.min,
                children: [
                  DropdownButtonFormField<String>(
                    initialValue: userId,
                    decoration: const InputDecoration(labelText: 'المشترك'),
                    items: users
                        .where(
                          (u) =>
                              u.role != 'مدير' &&
                              !subscriptions.any((sub) => sub.userId == u.id),
                        )
                        .map(
                          (u) => DropdownMenuItem(
                            value: u.id,
                            child: Text(u.name),
                          ),
                        )
                        .toList(),
                    onChanged: (v) => setDialogState(() {
                      userId = v;
                      deviceId = null;
                    }),
                  ),
                  const SizedBox(height: 12),

                  TextField(
                    controller: durationController,
                    keyboardType: TextInputType.number,
                    decoration: const InputDecoration(
                      labelText: 'مدة الاشتراك بالأيام',
                      hintText: 'مثال: 30',
                      prefixIcon: Icon(Icons.calendar_month),
                    ),
                  ),
                  const SizedBox(height: 12),

                  TextField(
                    controller: amount,
                    keyboardType: const TextInputType.numberWithOptions(
                      decimal: true,
                    ),
                    decoration: const InputDecoration(
                      labelText: 'قيمة الاشتراك',
                      hintText: 'مثال: 30',
                      prefixIcon: Icon(Icons.payments),
                    ),
                    onChanged: (_) => setDialogState(() {}),
                  ),
                  const SizedBox(height: 12),

                  TextField(
                    controller: paymentAmount,
                    keyboardType: const TextInputType.numberWithOptions(
                      decimal: true,
                    ),
                    decoration: const InputDecoration(
                      labelText: 'المبلغ المحصل من المشترك',
                      hintText: 'مثال: 20',
                      prefixIcon: Icon(Icons.account_balance_wallet),
                    ),
                    onChanged: (_) => setDialogState(() {}),
                  ),
                  const SizedBox(height: 12),

                  if (subscriptionAmount > 0)
                    Container(
                      width: double.infinity,
                      padding: const EdgeInsets.all(12),
                      decoration: BoxDecoration(
                        color: remainingAmount <= 0
                            ? Colors.green.withValues(alpha: 0.08)
                            : Colors.orange.withValues(alpha: 0.08),
                        borderRadius: BorderRadius.circular(12),
                        border: Border.all(
                          color: remainingAmount <= 0
                              ? Colors.green.withValues(alpha: 0.30)
                              : Colors.orange.withValues(alpha: 0.30),
                        ),
                      ),
                      child: Row(
                        children: [
                          Icon(
                            remainingAmount <= 0
                                ? Icons.check_circle
                                : Icons.pending_actions,
                            color: remainingAmount <= 0
                                ? Colors.green
                                : Colors.orange,
                          ),
                          const SizedBox(width: 10),
                          Expanded(
                            child: Text(
                              remainingAmount <= 0
                                  ? 'تم تحصيل الاشتراك بالكامل'
                                  : 'المتبقي على المشترك: '
                                        '${remainingAmount.toStringAsFixed(2)} $currency',
                              style: TextStyle(
                                fontWeight: FontWeight.bold,
                                color: remainingAmount <= 0
                                    ? Colors.green.shade700
                                    : Colors.orange.shade800,
                              ),
                            ),
                          ),
                        ],
                      ),
                    ),

                  const SizedBox(height: 12),

                  DropdownButtonFormField<String>(
                    initialValue: currency,
                    decoration: const InputDecoration(labelText: 'العملة'),
                    items: const [
                      DropdownMenuItem(value: 'USD', child: Text('دولار')),
                      DropdownMenuItem(value: 'SYP', child: Text('ليرة سورية')),
                    ],
                    onChanged: (v) {
                      if (v != null) {
                        setDialogState(() => currency = v);
                      }
                    },
                  ),
                ],
              ),
            ),
            actions: [
              TextButton(
                onPressed: () => Navigator.pop(dialogContext),
                child: const Text('إلغاء'),
              ),
              FilledButton(
                onPressed: () async {
                  if (userId == null ||
                      amount.text.trim().isEmpty ||
                      paymentAmount.text.trim().isEmpty) {
                    ScaffoldMessenger.of(context).showSnackBar(
                      const SnackBar(
                        content: Text(
                          'يرجى إدخال المشترك وقيمة الاشتراك والمبلغ المحصل',
                        ),
                      ),
                    );
                    return;
                  }

                  final parsedAmount = double.tryParse(amount.text.trim());

                  final parsedPayment = double.tryParse(
                    paymentAmount.text.trim(),
                  );

                  if (parsedAmount == null || parsedAmount <= 0) {
                    ScaffoldMessenger.of(context).showSnackBar(
                      const SnackBar(
                        content: Text('يرجى إدخال قيمة اشتراك صحيحة'),
                      ),
                    );
                    return;
                  }

                  if (parsedPayment == null || parsedPayment < 0) {
                    ScaffoldMessenger.of(context).showSnackBar(
                      const SnackBar(
                        content: Text('يرجى إدخال مبلغ محصل صحيح'),
                      ),
                    );
                    return;
                  }

                  if (parsedPayment > parsedAmount) {
                    ScaffoldMessenger.of(context).showSnackBar(
                      const SnackBar(
                        content: Text(
                          'المبلغ المحصل لا يمكن أن يكون أكبر من قيمة الاشتراك',
                        ),
                        backgroundColor: Colors.orange,
                      ),
                    );
                    return;
                  }

                  final durationDays = int.tryParse(
                    durationController.text.trim(),
                  );

                  if (durationDays == null || durationDays <= 0) {
                    ScaffoldMessenger.of(context).showSnackBar(
                      const SnackBar(
                        content: Text('أدخل مدة اشتراك صحيحة بالأيام'),
                      ),
                    );
                    return;
                  }

                  final hasExistingSubscription = subscriptions.any(
                    (sub) => sub.userId == userId,
                  );

                  if (hasExistingSubscription) {
                    ScaffoldMessenger.of(context).showSnackBar(
                      const SnackBar(
                        content: Text(
                          'لا يمكن إضافة اشتراك جديد لهذا المستخدم. '
                          'لديه اشتراك موجود بالفعل، استخدم زر التجديد.',
                        ),
                        backgroundColor: Colors.orange,
                      ),
                    );
                    return;
                  }

                  final startDate = DateTime.now();

                  final subscription = Subscription(
                    userId: userId!,
                    deviceId: deviceId,
                    amount: parsedAmount,
                    currency: currency,
                    createdAt: startDate,
                    dueDate: startDate.add(Duration(days: durationDays)),
                  );

                  try {
                    subscriptions.add(subscription);

                    await saveSubscriptions();

                    if (subscription.id.isEmpty) {
                      throw Exception('لم يتم الحصول على معرف الاشتراك');
                    }

                    if (parsedPayment > 0) {
                      await Supabase.instance.client
                          .from('subscription_payments')
                          .insert({
                            'subscription_id': subscription.id,
                            'user_id': subscription.userId,
                            'device_id': subscription.deviceId,
                            'amount': parsedPayment,
                            'currency': subscription.currency,
                            'duration_days': durationDays,
                            'payment_type': 'new',
                          });
                    }

                    await loadPaymentHistory();

                    if (context.mounted) {
                      Navigator.pop(dialogContext);

                      final remaining = parsedAmount - parsedPayment;

                      ScaffoldMessenger.of(context).showSnackBar(
                        SnackBar(
                          content: Text(
                            remaining <= 0.001
                                ? 'تم إضافة الاشتراك وتحصيل المبلغ بالكامل ✓'
                                : 'تم إضافة الاشتراك. المتبقي على المشترك '
                                      '${remaining.toStringAsFixed(2)} \$currency',
                          ),
                          backgroundColor: remaining <= 0.001
                              ? Colors.green
                              : Colors.orange,
                        ),
                      );

                      setState(() {});
                    }
                  } catch (e) {
                    subscriptions.remove(subscription);

                    ScaffoldMessenger.of(context).showSnackBar(
                      SnackBar(
                        content: Text('خطأ: $e'),
                        backgroundColor: Colors.red,
                      ),
                    );
                  }
                },
                child: const Text('حفظ'),
              ),
            ],
          );
        },
      ),
    );
  }

  Future<void> paySubscriptionDebt(Subscription sub) async {
    final supabase = Supabase.instance.client;

    final paidAmount = paymentHistory
        .where((payment) => payment['subscription_id']?.toString() == sub.id)
        .fold<double>(
          0,
          (sum, payment) =>
              sum + ((payment['amount'] as num?)?.toDouble() ?? 0),
        );

    final remainingAmount = (sub.amount - paidAmount).clamp(0, sub.amount);

    if (remainingAmount <= 0.001) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('هذا الاشتراك محصل بالكامل ولا يوجد مبلغ مستحق'),
          backgroundColor: Colors.green,
        ),
      );
      return;
    }

    final paymentController = TextEditingController();

    final payment = await showDialog<double>(
      context: context,
      builder: (dialogContext) => AlertDialog(
        title: const Text('تسديد المتبقي'),
        content: StatefulBuilder(
          builder: (context, setDialogState) {
            final enteredAmount =
                double.tryParse(paymentController.text.trim()) ?? 0;

            final enteredIsValid =
                enteredAmount > 0 && enteredAmount <= remainingAmount;

            return Column(
              mainAxisSize: MainAxisSize.min,
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Container(
                  width: double.infinity,
                  padding: const EdgeInsets.all(14),
                  decoration: BoxDecoration(
                    color: Colors.orange.withValues(alpha: 0.08),
                    borderRadius: BorderRadius.circular(12),
                    border: Border.all(
                      color: Colors.orange.withValues(alpha: 0.25),
                    ),
                  ),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      const Text(
                        'المبلغ المستحق',
                        style: TextStyle(fontSize: 13),
                      ),
                      const SizedBox(height: 4),
                      Text(
                        '${remainingAmount.toStringAsFixed(2)} ${sub.currency}',
                        style: const TextStyle(
                          fontSize: 20,
                          fontWeight: FontWeight.bold,
                          color: Colors.orange,
                        ),
                      ),
                    ],
                  ),
                ),
                const SizedBox(height: 16),
                TextField(
                  controller: paymentController,
                  autofocus: true,
                  keyboardType: const TextInputType.numberWithOptions(
                    decimal: true,
                  ),
                  decoration: InputDecoration(
                    labelText: 'قيمة التسديد',
                    hintText: 'يمكن تسديد جزء أو كامل المبلغ',
                    prefixIcon: const Icon(Icons.account_balance_wallet),
                    suffixText: sub.currency,
                    errorText:
                        paymentController.text.isNotEmpty && !enteredIsValid
                        ? 'المبلغ يجب أن يكون أكبر من صفر وألا يتجاوز المتبقي'
                        : null,
                  ),
                  onChanged: (_) => setDialogState(() {}),
                ),
              ],
            );
          },
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(dialogContext),
            child: const Text('إلغاء'),
          ),
          FilledButton.icon(
            onPressed: () {
              final value = double.tryParse(paymentController.text.trim());

              if (value == null || value <= 0 || value > remainingAmount) {
                return;
              }

              Navigator.pop(dialogContext, value);
            },
            icon: const Icon(Icons.check),
            label: const Text('تسجيل التسديد'),
          ),
        ],
      ),
    );

    paymentController.dispose();

    if (payment == null) return;

    try {
      await supabase.from('subscription_payments').insert({
        'subscription_id': sub.id,
        'user_id': sub.userId,
        'device_id': sub.deviceId,
        'amount': payment,
        'currency': sub.currency,
        'duration_days': null,
        'payment_type': 'debt_payment',
      });

      await loadPaymentHistory();

      if (!mounted) return;

      setState(() {});

      final newRemaining = remainingAmount - payment;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            newRemaining <= 0.001
                ? 'تم تسديد المبلغ بالكامل ✓'
                : 'تم تسجيل التسديد. المتبقي ${newRemaining.toStringAsFixed(2)} ${sub.currency}',
          ),
          backgroundColor: newRemaining <= 0.001 ? Colors.green : Colors.orange,
        ),
      );
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('خطأ أثناء تسجيل التسديد: $e'),
          backgroundColor: Colors.red,
        ),
      );
    }
  }

