final List<NetworkDevice> devices = [];

Future<void> loadBroadbandAccounts() async {
  final supabase = Supabase.instance.client;

  broadbandAccounts.clear();

  // قبل تسجيل الدخول لا نعرض أي حسابات
  if (currentUser == null) {
    return;
  }

  dynamic data;

  // المدير يرى جميع حسابات Broadband
  if (currentUser!.role == 'مدير') {
    data = await supabase
        .from('broadband_accounts')
        .select()
        .order('created_at', ascending: false);
  } else {
    // المستخدم العادي يرى حساباته فقط
    data = await supabase
        .from('broadband_accounts')
        .select()
        .eq('user_id', currentUser!.id)
        .order('created_at', ascending: false);
  }

  final now = DateTime.now();

  for (final item in data) {
    final account = BroadbandAccount.fromJson(Map<String, dynamic>.from(item));

    if (account.serviceStatus != 'manual_suspended' &&
        account.expiresAt != null &&
        account.expiresAt!.isBefore(now)) {
      if (account.serviceStatus != 'expired') {
        await supabase
            .from('broadband_accounts')
            .update({'service_status': 'expired'})
            .eq('id', account.id);
      }

      account.serviceStatus = 'expired';
    } else if (account.serviceStatus == 'grace' &&
        account.remainingAmount > 0.001 &&
        account.debtGraceUntil != null &&
        !now.isBefore(account.debtGraceUntil!)) {
      await supabase
          .from('broadband_accounts')
          .update({'service_status': 'debt_suspended'})
          .eq('id', account.id);

      account.serviceStatus = 'debt_suspended';
    }

    broadbandAccounts.add(account);
  }
}

Future<void> loadDevices() async {
  final supabase = Supabase.instance.client;

  devices.clear();

  // قبل تسجيل الدخول لا نعرض أي أجهزة
