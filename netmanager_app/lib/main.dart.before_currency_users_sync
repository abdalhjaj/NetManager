                          ),
                          const SizedBox(height: 4),
                          Text(
                            'المتبقي بعد العملية: ${remainingAfter.toStringAsFixed(2)} USD',
                            style: TextStyle(
                              color: remainingAfter > 0
                                  ? Colors.red.shade700
                                  : Colors.green.shade700,
                              fontWeight: FontWeight.bold,
                            ),
                          ),
                        ],
                      ),
                    ),
                  ],
