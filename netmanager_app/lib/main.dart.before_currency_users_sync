                      initialValue: deviceType,
                      decoration: const InputDecoration(
                        labelText: 'نوع الجهاز',
                        prefixIcon: Icon(Icons.device_hub),
                      ),
                      items: const [
                        DropdownMenuItem(value: 'راوتر', child: Text('راوتر')),
                        DropdownMenuItem(
                          value: 'Access Point',
                          child: Text('Access Point'),
                        ),
