List<AccountUsageSession> usageSessions = [];

Future<void> loadUsageSessions() async {
  final supabase = Supabase.instance.client;

  usageSessions.clear();

  if (currentUser == null) {
    return;
  }

  dynamic data;

  if (currentUser!.role == 'مدير') {
    data = await supabase
        .from('account_usage_sessions')
        .select()
        .order('created_at', ascending: false);
  } else {
    data = await supabase
        .from('account_usage_sessions')
        .select()
        .eq('user_id', currentUser!.id)
        .order('created_at', ascending: false);
  }

  for (final item in data) {
    usageSessions.add(
      AccountUsageSession.fromJson(Map<String, dynamic>.from(item)),
    );
  }
}

Future<void> loadHotspotAccounts() async {
  final supabase = Supabase.instance.client;

  hotspotAccounts.clear();

  // قبل تسجيل الدخول لا نعرض أي حسابات
  if (currentUser == null) {
    return;
  }

  dynamic data;

  // المدير يرى جميع حسابات Hotspot
  if (currentUser!.role == 'مدير') {
    data = await supabase
        .from('hotspot_accounts')
        .select()
        .order('created_at', ascending: false);
  } else {
    // المستخدم العادي يرى حساباته فقط
    data = await supabase
        .from('hotspot_accounts')
        .select()
        .eq('user_id', currentUser!.id)
        .order('created_at', ascending: false);
  }

  final now = DateTime.now();

  for (final item in data) {
    final account = HotspotAccount.fromJson(Map<String, dynamic>.from(item));

    if (account.serviceStatus != 'manual_suspended' &&
        account.expiresAt != null &&
        account.expiresAt!.isBefore(now)) {
      if (account.serviceStatus != 'expired') {
        await supabase
            .from('hotspot_accounts')
            .update({'service_status': 'expired'})
            .eq('id', account.id);
      }

      account.serviceStatus = 'expired';
    } else if (account.serviceStatus == 'grace' &&
        account.remainingAmount > 0.001 &&
        account.debtGraceUntil != null &&
        !now.isBefore(account.debtGraceUntil!)) {
      await supabase
          .from('hotspot_accounts')
          .update({'service_status': 'debt_suspended'})
          .eq('id', account.id);

      account.serviceStatus = 'debt_suspended';
    }

    hotspotAccounts.add(account);
  }
}

