  Widget buildPaymentHistory() {
    if (paymentHistory.isEmpty) {
      return const Center(
        child: Text(
          'لا توجد دفعات مسجلة حاليًا',
          style: TextStyle(fontSize: 20),
        ),
      );
    }

    String formatDate(dynamic value) {
      if (value == null) return 'غير محدد';

      final date = DateTime.tryParse(value.toString());
      if (date == null) return 'غير محدد';

      return '${date.day.toString().padLeft(2, '0')}/'
          '${date.month.toString().padLeft(2, '0')}/'
          '${date.year} '
          '${date.hour.toString().padLeft(2, '0')}:'
          '${date.minute.toString().padLeft(2, '0')}';
    }

    String paymentTypeText(String? type) {
      if (type == 'renewal') return 'تجديد اشتراك';
      return 'اشتراك جديد';
    }

    return Padding(
      padding: const EdgeInsets.all(20),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const Text(
            'سجل الدفعات',
            style: TextStyle(fontSize: 28, fontWeight: FontWeight.bold),
          ),
          const SizedBox(height: 20),
          Expanded(
            child: ListView.builder(
              itemCount: paymentHistory.length,
              itemBuilder: (context, index) {
                final payment = paymentHistory[index];

                final user = users.firstWhere(
                  (u) => u.id == payment['user_id']?.toString(),
                  orElse: () => AppUser(
                    id: '',
                    name: 'مستخدم غير معروف',
                    username: '',
                    password: '',
                    role: 'مستخدم',
                  ),
                );

                final amount = (payment['amount'] ?? 0).toString();

                final currency = payment['currency']?.toString() ?? '';

                final duration = payment['duration_days']?.toString() ?? '-';

                final type = payment['payment_type']?.toString();

                return Card(
                  child: ListTile(
                    leading: CircleAvatar(
                      child: Icon(
                        type == 'renewal' ? Icons.refresh : Icons.receipt_long,
                      ),
                    ),
                    title: Text(user.name),
                    subtitle: Text(
                      '$amount $currency\\n'
                      'المدة: $duration يوم\\n'
                      'العملية: ${paymentTypeText(type)}\\n'
                      'التاريخ: ${formatDate(payment['created_at'])}',
                    ),
                    isThreeLine: true,
                  ),
                );
              },
            ),
          ),
        ],
      ),
    );
  }

  Widget buildUserDevices() {
    return Padding(
      padding: const EdgeInsets.all(20),
      child: ListView(
        children: [
          const Text(
            'أجهزة المستخدمين',
            style: TextStyle(fontSize: 28, fontWeight: FontWeight.bold),
          ),
          const SizedBox(height: 20),

          ...users.map((user) {
            final userDevices = devices
                .where((d) => d.userId == user.id)
                .toList();

            return Card(
              child: ExpansionTile(
                leading: const Icon(Icons.person),
                title: Text(user.name),
                subtitle: Text('${userDevices.length} جهاز'),
                children: userDevices.map((device) {
                  return ListTile(
                    leading: const Icon(Icons.router),
                    title: Text(device.name),
                    subtitle: Text(
                      '${device.deviceType} • ${device.ipAddress}',
                    ),
                    trailing: Icon(
                      device.active ? Icons.check_circle : Icons.cancel,
                    ),
                  );
                }).toList(),
              ),
            );
          }),
        ],
      ),
    );
  }

  void showUserDetails(AppUser user) {
    final userDevices = devices.where((d) => d.userId == user.id).toList();

    showDialog(
      context: context,
      builder: (context) {
        return AlertDialog(
          title: Text(user.name),
          content: SizedBox(
            width: 400,
            child: ListView(
              shrinkWrap: true,
              children: [
                Text('اسم الدخول: ${user.username}'),
                Text('الدور: ${user.role}'),
                Text(user.active ? 'الحالة: نشط' : 'الحالة: متوقف'),
                const SizedBox(height: 15),
                Text(
                  'عدد الأجهزة: ${userDevices.length}',
                  style: const TextStyle(fontWeight: FontWeight.bold),
                ),
                const SizedBox(height: 10),
                ...userDevices.map(
                  (device) => ListTile(
                    leading: const Icon(Icons.router),
                    title: Text(device.name),
                    subtitle: Text(
                      '${device.deviceType} • ${device.ipAddress}',
