class Subscription {
  String id;
  String userId;
  String? deviceId;
  double amount;
  String currency;
  DateTime? createdAt;
  DateTime? dueDate;
  String status;

  Subscription({
    this.id = '',
    required this.userId,
    this.deviceId,
    required this.amount,
    required this.currency,
    this.createdAt,
    this.dueDate,
    this.status = 'غير مدفوع',
  });

  factory Subscription.fromJson(Map<String, dynamic> json) {
    return Subscription(
      id: json['id']?.toString() ?? '',
      userId: json['user_id'] ?? '',
      deviceId: json['device_id'],
      amount: (json['amount'] ?? 0).toDouble(),
      currency: json['currency'] ?? 'USD',
      createdAt: json['created_at'] != null
          ? DateTime.tryParse(json['created_at'])
          : null,
      dueDate: json['due_date'] != null
          ? DateTime.tryParse(json['due_date'])
          : null,
      status: json['status']?.toString() ?? 'غير مدفوع',
    );
  }

  Map<String, dynamic> toJson() {
    return {
      'user_id': userId,
      'device_id': deviceId,
      'amount': amount,
      'currency': currency,
      'due_date': dueDate?.toIso8601String(),
    };
  }
}

