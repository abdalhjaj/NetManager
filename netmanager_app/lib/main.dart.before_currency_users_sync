  AppUser? _findAppUserById(String userId) {
    for (final user in users) {
      if (user.id == userId) return user;
    }
    return null;
  }

  String _accountOwnerCurrency(String userId) {
    return _findAppUserById(userId)?.currency ?? 'USD';
  }

  double _accountOwnerExchangeRate(String userId) {
    final rate = _findAppUserById(userId)?.usdToSypRate ?? 1;
    return rate > 0 ? rate : 1;
  }

  double _usdToOwnerCurrency(double amountUsd, String userId) {
    if (_accountOwnerCurrency(userId) == 'SYP') {
      return amountUsd * _accountOwnerExchangeRate(userId);
    }

    return amountUsd;
  }

  double _ownerCurrencyToUsd(double amount, String userId) {
    if (_accountOwnerCurrency(userId) == 'SYP') {
      return amount / _accountOwnerExchangeRate(userId);
    }

    return amount;
  }

  String _formatOwnerMoney(double amountUsd, String userId) {
    final currency = _accountOwnerCurrency(userId);
    final amount = _usdToOwnerCurrency(amountUsd, userId);

    if (currency == 'SYP') {
      return '${amount.toStringAsFixed(0)} SYP';
    }

    return '${amount.toStringAsFixed(2)} USD';
  }

