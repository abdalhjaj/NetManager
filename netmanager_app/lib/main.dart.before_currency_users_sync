  Widget _subscriptionFilterButton({
    required String label,
    required IconData icon,
    required String value,
  }) {
    final selected = subscriptionFilter == value;
    final now = DateTime.now();

    // الاشتراكات الحالية فقط:
    // لكل مشترك وجهاز نأخذ أحدث دورة اشتراك.
    final latestSubscriptions = <String, Subscription>{};

    for (final sub in subscriptions) {
      if (sub.status == 'مجدد') {
        continue;
      }

      if (widget.currentUser.role != 'مدير' &&
          sub.userId != widget.currentUser.id) {
        continue;
      }

      final key = '${sub.userId}|${sub.deviceId ?? ''}';
      final existing = latestSubscriptions[key];

      if (existing == null) {
        latestSubscriptions[key] = sub;
        continue;
      }

      final existingDate =
          existing.createdAt ?? DateTime.fromMillisecondsSinceEpoch(0);

      final currentDate =
          sub.createdAt ?? DateTime.fromMillisecondsSinceEpoch(0);

      if (currentDate.isAfter(existingDate)) {
        latestSubscriptions[key] = sub;
      }
    }

    final currentSubscriptions = latestSubscriptions.values.toList();

    final count = currentSubscriptions.where((sub) {
      final dueDate = sub.dueDate;

      if (value == 'الكل') {
        return true;
      }

      if (value == 'المنتهية') {
        return dueDate == null || dueDate.isBefore(now);
      }

      if (value == 'تنتهي قريبًا') {
        if (dueDate == null || dueDate.isBefore(now)) {
          return false;
        }

        return dueDate.difference(now).inDays <= 7;
      }

      if (value == 'السارية') {
        if (dueDate == null || dueDate.isBefore(now)) {
          return false;
        }

        return dueDate.difference(now).inDays > 7;
      }

      return false;
    }).length;

    final color = value == 'السارية'
        ? Colors.green
        : value == 'تنتهي قريبًا'
        ? Colors.orange
        : value == 'المنتهية'
        ? Colors.red
        : Theme.of(context).colorScheme.primary;

    return AnimatedContainer(
      duration: const Duration(milliseconds: 200),
      child: OutlinedButton.icon(
        onPressed: () {
          setState(() {
            subscriptionFilter = value;
          });
        },
        icon: Icon(icon, size: 18, color: selected ? Colors.white : color),
        label: Text(
          '$label ($count)',
          style: TextStyle(
            color: selected ? Colors.white : color,
            fontWeight: FontWeight.bold,
          ),
        ),
        style: OutlinedButton.styleFrom(
          backgroundColor: selected ? color : null,
          side: BorderSide(color: color, width: selected ? 2 : 1),
          padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(12),
          ),
        ),
      ),
    );
  }

  Widget buildSubscriptions() {
    // نعرض أحدث اشتراك فقط لكل مشترك وجهاز.
    // لا نعتمد على status لأن تحديث status قد يكون محميًا بواسطة RLS.
    final latestSubscriptions = <String, Subscription>{};

    for (final sub in subscriptions) {
      final key = '${sub.userId}|${sub.deviceId ?? ''}';

      final existing = latestSubscriptions[key];

      if (existing == null) {
        latestSubscriptions[key] = sub;
        continue;
      }

      final existingDate =
          existing.createdAt ?? DateTime.fromMillisecondsSinceEpoch(0);

      final currentDate =
          sub.createdAt ?? DateTime.fromMillisecondsSinceEpoch(0);

      if (currentDate.isAfter(existingDate)) {
        latestSubscriptions[key] = sub;
      }
    }

    final visibleSubscriptions = latestSubscriptions.values
        .where((sub) {
          if (widget.currentUser.role == 'مدير') {
            return true;
          }

          return sub.userId == widget.currentUser.id;
        })
        .where((sub) {
          final dueDate = sub.dueDate;
          final now = DateTime.now();

          if (subscriptionFilter == 'المنتهية') {
            return dueDate == null || dueDate.isBefore(now);
          }

          if (subscriptionFilter == 'تنتهي قريبًا') {
            if (dueDate == null || dueDate.isBefore(now)) {
              return false;
            }

            return dueDate.difference(now).inDays <= 7;
          }

          if (subscriptionFilter == 'السارية') {
            if (dueDate == null || dueDate.isBefore(now)) {
              return false;
            }

            return dueDate.difference(now).inDays > 7;
