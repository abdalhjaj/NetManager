      if (accountType == 'hotspot') {
        final account = hotspotAccounts.cast<HotspotAccount?>().firstWhere(
          (a) => a?.id == accountId,
          orElse: () => null,
        );

        if (account == null) return;

        expiresAt = account.expiresAt;
        debtGraceUntil = account.debtGraceUntil;
        remaining = account.remainingAmount;
      } else {
        final account = broadbandAccounts.cast<BroadbandAccount?>().firstWhere(
          (a) => a?.id == accountId,
          orElse: () => null,
        );

        if (account == null) return;

        expiresAt = account.expiresAt;
        debtGraceUntil = account.debtGraceUntil;
        remaining = account.remainingAmount;
      }

      String serviceStatus;
      DateTime? newGraceUntil = debtGraceUntil;

      if (expiresAt != null && expiresAt.isBefore(now)) {
        serviceStatus = 'expired';
      } else if (remaining <= 0.001) {
        serviceStatus = 'active';
        newGraceUntil = null;
      } else if (allowDebt && debtGraceDays > 0) {
        if (debtGraceUntil != null && now.isBefore(debtGraceUntil)) {
          serviceStatus = 'grace';
        } else if (debtGraceUntil != null && !now.isBefore(debtGraceUntil)) {
          serviceStatus = 'debt_suspended';
        } else {
          serviceStatus = 'grace';
          newGraceUntil = now.add(Duration(days: debtGraceDays));
        }
      } else {
        serviceStatus = 'debt_suspended';
      }

      final shouldBeActive =
          serviceStatus == 'active' || serviceStatus == 'grace';

      await supabase
          .from(table)
          .update({
            'active': shouldBeActive,
            'service_status': serviceStatus,
            'debt_grace_until': newGraceUntil?.toIso8601String(),
          })
          .eq('id', accountId);

      if (accountType == 'hotspot') {
        final account = hotspotAccounts.cast<HotspotAccount?>().firstWhere(
          (a) => a?.id == accountId,
          orElse: () => null,
        );

        if (account != null) {
          account.active = shouldBeActive;
          account.serviceStatus = serviceStatus;
          account.debtGraceUntil = newGraceUntil;
        }
      } else {
        final account = broadbandAccounts.cast<BroadbandAccount?>().firstWhere(
          (a) => a?.id == accountId,
          orElse: () => null,
        );

        if (account != null) {
          account.active = shouldBeActive;
          account.serviceStatus = serviceStatus;
          account.debtGraceUntil = newGraceUntil;
        }
      }

      if (!mounted) return;
      setState(() {});

      String message;

      switch (serviceStatus) {
        case 'active':
          message = 'تم تفعيل الحساب بنجاح';
          break;
        case 'grace':
          message = 'تم تفعيل الحساب ضمن فترة السماح';
          break;
        case 'expired':
          message = 'لا يمكن تفعيل الحساب لأن الاشتراك منتهي';
          break;
        case 'debt_suspended':
          message = 'لا يمكن تفعيل الحساب بسبب وجود دين مستحق';
          break;
        default:
          message = 'تم تحديث حالة الحساب';
      }

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(message),
          backgroundColor: serviceStatus == 'active' || serviceStatus == 'grace'
              ? Colors.green
              : Colors.orange,
        ),
      );
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('حدث خطأ أثناء تغيير حالة الحساب: $e'),
          backgroundColor: Colors.red,
        ),
      );
    }
  }

  Future<void> openWhatsAppNumber(String? rawNumber) async {
    final number = (rawNumber ?? '').replaceAll(RegExp(r'[^0-9]'), '');

    if (number.isEmpty) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('لا يوجد رقم واتساب لهذا الحساب')),
      );
      return;
    }

    if (number.length < 8) {
      if (!mounted) return;
      ScaffoldMessenger.of(context)
          .showSnackBar(const SnackBar(content: Text('رقم واتساب غير صالح')));
      return;
    }

    final uri = Uri.parse('https://wa.me/$number');
    final opened = await launchUrl(uri, mode: LaunchMode.externalApplication);

    if (!opened && mounted) {
      ScaffoldMessenger.of(context)
          .showSnackBar(const SnackBar(content: Text('تعذر فتح واتساب')));
    }
  }

