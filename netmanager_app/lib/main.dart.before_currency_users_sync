  Future<void> toggleDeviceStatus(NetworkDevice device) async {
    try {
      await Supabase.instance.client
          .from('network_devices')
          .update({'active': !device.active})
          .eq('id', device.id);

      await loadDevices();

      if (!mounted) return;

      setState(() {});

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(device.active ? 'تم إيقاف الجهاز' : 'تم تفعيل الجهاز'),
        ),
      );
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(
        context,
      ).showSnackBar(SnackBar(content: Text('حدث خطأ أثناء تغيير الحالة: $e')));
    }
  }

