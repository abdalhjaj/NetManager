  Future<void> deleteNetworkAccount({
    required String accountType,
    required String accountId,
    required String username,
  }) async {
    final isHotspot = accountType == 'hotspot';
    final typeName = isHotspot ? 'Hotspot' : 'Broadband';

    double remaining = 0;

    if (isHotspot) {
      final account = hotspotAccounts.cast<HotspotAccount?>().firstWhere(
        (a) => a?.id == accountId,
        orElse: () => null,
      );

      remaining = account?.remainingAmount ?? 0;
    } else {
      final account = broadbandAccounts.cast<BroadbandAccount?>().firstWhere(
        (a) => a?.id == accountId,
        orElse: () => null,
      );

      remaining = account?.remainingAmount ?? 0;
    }

    if (remaining > 0.001) {
      if (!mounted) return;

      await showDialog<void>(
        context: context,
        builder: (dialogContext) {
          return Directionality(
            textDirection: TextDirection.rtl,
            child: AlertDialog(
              title: const Row(
                children: [
                  Icon(Icons.money_off, color: Colors.red),
                  SizedBox(width: 10),
                  Text('لا يمكن حذف الحساب'),
                ],
              ),
              content: Text(
                'لا يمكن حذف الحساب "$username" لأن عليه دينًا مستحقًا بقيمة '
                '${remaining.toStringAsFixed(2)} \$.\n\n'
                'يجب تسديد الدين كاملًا قبل حذف الحساب.',
              ),
              actions: [
                FilledButton(
                  onPressed: () => Navigator.pop(dialogContext),
                  child: const Text('حسنًا'),
                ),
              ],
            ),
          );
        },
      );

      return;
    }

    final confirmed = await showDialog<bool>(
      context: context,
      builder: (dialogContext) {
        return AlertDialog(
          title: const Row(
            children: [
              Icon(Icons.warning_amber_rounded, color: Colors.red),
              SizedBox(width: 10),
              Text('تأكيد حذف الحساب'),
            ],
          ),
          content: Text(
            'هل تريد حذف حساب "$username" نهائيًا؟\n\n'
            'لا يمكن التراجع عن هذه العملية.',
          ),
          actions: [
            TextButton(
              onPressed: () => Navigator.pop(dialogContext, false),
              child: const Text('إلغاء'),
            ),
            FilledButton.icon(
              style: FilledButton.styleFrom(
                backgroundColor: Colors.red,
                foregroundColor: Colors.white,
              ),
              onPressed: () => Navigator.pop(dialogContext, true),
              icon: const Icon(Icons.delete_forever),
              label: const Text('حذف نهائي'),
            ),
          ],
        );
      },
    );

    if (confirmed != true) return;

    try {
      final table = isHotspot ? 'hotspot_accounts' : 'broadband_accounts';

      await Supabase.instance.client.from(table).delete().eq('id', accountId);

      if (isHotspot) {
        await loadHotspotAccounts();
      } else {
        await loadBroadbandAccounts();
      }

      await loadUsageSessions();

      if (!mounted) return;

      setState(() {});

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('تم حذف حساب $typeName بنجاح ✓'),
          backgroundColor: Colors.green,
        ),
      );
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            'تعذر حذف الحساب: $e\n'
            'إذا كان للحساب سجلات مرتبطة، أرسل لي نص الخطأ لنرتب الحذف بدون فقدان السجلات المالية.',
          ),
          backgroundColor: Colors.red,
        ),
      );
    }
  }

