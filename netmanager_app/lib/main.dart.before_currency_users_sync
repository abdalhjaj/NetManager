Future<void> saveUsers() async {
  final supabase = Supabase.instance.client;

  await supabase.from('app_users').delete().not('id', 'is', null);

  if (users.isEmpty) return;

  await supabase
      .from('app_users')
      .insert(users.map((user) => user.toJson()).toList());
}

Future<void> loadUsers() async {
  final supabase = Supabase.instance.client;

  final data = await supabase.from('app_users').select().order('created_at');

  users.clear();

  for (final item in data) {
    users.add(AppUser.fromJson(Map<String, dynamic>.from(item)));
  }
}

Future<void> saveSubscriptions() async {
  final supabase = Supabase.instance.client;

  for (final sub in subscriptions) {
    final data = sub.toJson();

    if (sub.id.isEmpty) {
      final inserted = await supabase
          .from('subscriptions')
          .insert(data)
          .select()
          .single();

      sub.id = inserted['id']?.toString() ?? '';
      sub.createdAt = inserted['created_at'] != null
          ? DateTime.tryParse(inserted['created_at'].toString())
          : null;
    } else {
      await supabase.from('subscriptions').update(data).eq('id', sub.id);
    }
  }
}

Future<void> loadSubscriptions() async {
  final supabase = Supabase.instance.client;

  final data = await supabase
      .from('subscriptions')
      .select()
      .order('created_at');

  subscriptions.clear();

  for (final item in data) {
    final subscription = Subscription.fromJson(Map<String, dynamic>.from(item));

    print(
      'SUBSCRIPTION: id=${subscription.id}, '
      'user=${subscription.userId}, '
      'status=${subscription.status}, '
      'amount=${subscription.amount}',
    );

    subscriptions.add(subscription);
  }
}

