                        onChanged: (value) {
                          setDialogState(() {
                            selectedUserId = value;
                          });
                        },
                      ),
                    const SizedBox(height: 12),
                    SwitchListTile(
                      title: const Text('الجهاز نشط'),
                      value: active,
                      onChanged: (value) {
                        setDialogState(() {
                          active = value;
                        });
                      },
                    ),
                  ],
                ),
