      await Supabase.instance.client
          .from('subscriptions')
          .delete()
          .eq('id', sub.id);

      subscriptions.removeWhere((s) => s.id == sub.id);

      if (!mounted) return;

      setState(() {});

      ScaffoldMessenger.of(context)
          .showSnackBar(const SnackBar(content: Text('تم حذف الاشتراك بنجاح')));
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(context)
          .showSnackBar(SnackBar(content: Text('خطأ أثناء حذف الاشتراك: $e')));
    }
  }

  Future<void> renewSubscription(Subscription sub) async {
    final paidOld = paymentHistory
        .where((payment) => payment['subscription_id']?.toString() == sub.id)
        .fold<double>(
          0,
          (sum, payment) =>
              sum + ((payment['amount'] as num?)?.toDouble() ?? 0),
        );

    final oldDebt = (sub.amount - paidOld).clamp(0, sub.amount);

    final amountController = TextEditingController(
      text: sub.amount.toStringAsFixed(2),
    );
    final paymentAmountController = TextEditingController(text: '0');
    final durationController = TextEditingController(text: '30');

    String currency = sub.currency;

    final confirmed = await showDialog<bool>(
      context: context,
      builder: (dialogContext) => StatefulBuilder(
        builder: (context, setDialogState) {
          final renewalAmount =
              double.tryParse(amountController.text.trim()) ?? 0;

          final collectedAmount =
              double.tryParse(paymentAmountController.text.trim()) ?? 0;

          final totalRequired = oldDebt + renewalAmount;

          final remainingAmount = (totalRequired - collectedAmount).clamp(
            0,
            totalRequired,
          );

          final durationDays =
              int.tryParse(durationController.text.trim()) ?? 30;

          final now = DateTime.now();

          final baseDate = sub.dueDate != null && sub.dueDate!.isAfter(now)
              ? sub.dueDate!
              : now;

          final newDueDate = baseDate.add(
            Duration(days: durationDays > 0 ? durationDays : 30),
          );

          String formatDate(DateTime date) {
            return '${date.day.toString().padLeft(2, '0')}/'
                '${date.month.toString().padLeft(2, '0')}/'
                '${date.year}';
          }

          return AlertDialog(
            title: const Text('تجديد الاشتراك'),
            content: SingleChildScrollView(
              child: Column(
                mainAxisSize: MainAxisSize.min,
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Container(
                    width: double.infinity,
                    padding: const EdgeInsets.all(14),
                    decoration: BoxDecoration(
                      color: oldDebt > 0
                          ? Colors.red.withValues(alpha: 0.08)
                          : Colors.green.withValues(alpha: 0.08),
                      borderRadius: BorderRadius.circular(12),
                      border: Border.all(
                        color: oldDebt > 0
                            ? Colors.red.withValues(alpha: 0.30)
                            : Colors.green.withValues(alpha: 0.30),
                      ),
                    ),
                    child: Row(
                      children: [
                        Icon(
                          oldDebt > 0
                              ? Icons.warning_amber
                              : Icons.check_circle,
                          color: oldDebt > 0 ? Colors.red : Colors.green,
                        ),
                        const SizedBox(width: 10),
                        Expanded(
                          child: Text(
                            'الدين القديم: ${oldDebt.toStringAsFixed(2)} ${sub.currency}',
                            style: const TextStyle(
                              fontSize: 16,
                              fontWeight: FontWeight.bold,
                            ),
                          ),
                        ),
                      ],
                    ),
                  ),
                  const SizedBox(height: 12),

                  TextField(
                    controller: amountController,
                    keyboardType: const TextInputType.numberWithOptions(
                      decimal: true,
                    ),
                    decoration: const InputDecoration(
                      labelText: 'قيمة الاشتراك الجديد',
                      hintText: 'مثال: 30',
                      prefixIcon: Icon(Icons.payments),
                    ),
                    onChanged: (_) => setDialogState(() {}),
                  ),
                  const SizedBox(height: 12),

                  TextField(
                    controller: paymentAmountController,
                    keyboardType: const TextInputType.numberWithOptions(
                      decimal: true,
                    ),
                    decoration: const InputDecoration(
                      labelText: 'المبلغ المحصل من المشترك',
                      hintText: 'يمكن دفع جزء أو كامل المبلغ',
                      prefixIcon: Icon(Icons.account_balance_wallet),
                    ),
                    onChanged: (_) => setDialogState(() {}),
                  ),
                  const SizedBox(height: 12),

                  if (renewalAmount > 0)
                    Container(
                      width: double.infinity,
                      padding: const EdgeInsets.all(12),
                      decoration: BoxDecoration(
                        color: remainingAmount <= 0
                            ? Colors.green.withValues(alpha: 0.08)
                            : Colors.orange.withValues(alpha: 0.08),
                        borderRadius: BorderRadius.circular(12),
                        border: Border.all(
                          color: remainingAmount <= 0
                              ? Colors.green.withValues(alpha: 0.30)
                              : Colors.orange.withValues(alpha: 0.30),
                        ),
                      ),
                      child: Row(
                        children: [
                          Icon(
                            remainingAmount <= 0
                                ? Icons.check_circle
                                : Icons.pending_actions,
                            color: remainingAmount <= 0
                                ? Colors.green
                                : Colors.orange,
                          ),
                          const SizedBox(width: 10),
                          Expanded(
                            child: Text(
                              remainingAmount <= 0
                                  ? 'تم تحصيل الاشتراك الجديد بالكامل'
                                  : 'المتبقي على المشترك: '
                                        '${remainingAmount.toStringAsFixed(2)} $currency',
                              style: TextStyle(
                                fontWeight: FontWeight.bold,
                                color: remainingAmount <= 0
                                    ? Colors.green.shade700
                                    : Colors.orange.shade800,
                              ),
                            ),
                          ),
                        ],
                      ),
                    ),

                  const SizedBox(height: 12),

                  TextField(
                    controller: durationController,
                    keyboardType: TextInputType.number,
                    decoration: const InputDecoration(
                      labelText: 'مدة التجديد بالأيام',
                      hintText: 'مثال: 30',
                      prefixIcon: Icon(Icons.calendar_month),
                    ),
                    onChanged: (_) => setDialogState(() {}),
                  ),
                  const SizedBox(height: 16),

                  Text(
                    'تاريخ الاستحقاق الحالي: '
                    '${sub.dueDate == null ? 'غير محدد' : formatDate(sub.dueDate!)}',
                  ),
                  const SizedBox(height: 8),

                  Text(
                    'تاريخ الاستحقاق الجديد: '
                    '${formatDate(newDueDate)}',
                    style: const TextStyle(fontWeight: FontWeight.bold),
                  ),
                  const SizedBox(height: 8),

                  Text(
                    'مدة التجديد: '
                    '${durationDays > 0 ? durationDays : 30} يوم',
                  ),

                  const SizedBox(height: 12),

                  DropdownButtonFormField<String>(
                    initialValue: currency,
                    decoration: const InputDecoration(labelText: 'العملة'),
                    items: const [
                      DropdownMenuItem(value: 'USD', child: Text('دولار')),
                      DropdownMenuItem(value: 'SYP', child: Text('ليرة سورية')),
                    ],
                    onChanged: (value) {
                      if (value != null) {
                        setDialogState(() {
                          currency = value;
                        });
                      }
                    },
                  ),
                ],
              ),
            ),
            actions: [
              TextButton(
                onPressed: () => Navigator.pop(dialogContext, false),
                child: const Text('إلغاء'),
              ),
              FilledButton.icon(
                onPressed: () {
                  final parsedAmount = double.tryParse(
                    amountController.text.trim(),
                  );

                  final parsedPayment = double.tryParse(
                    paymentAmountController.text.trim(),
                  );

                  final parsedDuration = int.tryParse(
                    durationController.text.trim(),
                  );

                  if (parsedAmount == null || parsedAmount <= 0) {
                    return;
                  }

                  final totalRequired = oldDebt + parsedAmount;

                  if (parsedPayment == null ||
                      parsedPayment < 0 ||
                      parsedPayment > totalRequired) {
                    return;
                  }

                  if (parsedDuration == null || parsedDuration <= 0) {
                    return;
                  }

                  Navigator.pop(dialogContext, true);
                },
                icon: const Icon(Icons.refresh),
                label: const Text('تأكيد التجديد'),
              ),
            ],
          );
        },
      ),
    );

    if (confirmed != true) {
      amountController.dispose();
      paymentAmountController.dispose();
      durationController.dispose();
      return;
    }

    final renewalAmount = double.tryParse(amountController.text.trim());

    final collectedAmount = double.tryParse(
      paymentAmountController.text.trim(),
    );

    final durationDays = int.tryParse(durationController.text.trim());

    if (renewalAmount == null ||
        renewalAmount <= 0 ||
        collectedAmount == null ||
        collectedAmount < 0 ||
        collectedAmount > (oldDebt + renewalAmount) ||
        durationDays == null ||
        durationDays <= 0) {
      amountController.dispose();
      paymentAmountController.dispose();
      durationController.dispose();
      return;
    }

    final now = DateTime.now();

    final baseDate = sub.dueDate != null && sub.dueDate!.isAfter(now)
        ? sub.dueDate!
        : now;

    final newDueDate = baseDate.add(Duration(days: durationDays));

    try {
      final supabase = Supabase.instance.client;

      // إنشاء دورة اشتراك جديدة مستقلة
      final newSubscription = Subscription(
        userId: sub.userId,
        deviceId: sub.deviceId,
        amount: renewalAmount,
        currency: currency,
        createdAt: now,
        dueDate: newDueDate,
      );

      subscriptions.add(newSubscription);

      await saveSubscriptions();

      if (newSubscription.id.isEmpty) {
        throw Exception('لم يتم الحصول على معرف الاشتراك الجديد');
      }

      // تسديد الدين القديم أولًا
      final oldDebtPayment = collectedAmount > oldDebt
          ? oldDebt
          : collectedAmount;

      // المبلغ المتبقي بعد تسديد الدين القديم
      // يذهب إلى الاشتراك الجديد
      final renewalPayment = collectedAmount - oldDebtPayment;

      if (oldDebtPayment > 0) {
        await supabase.from('subscription_payments').insert({
          'subscription_id': sub.id,
          'user_id': sub.userId,
          'device_id': sub.deviceId,
          'amount': oldDebtPayment,
          'currency': sub.currency,
          'duration_days': null,
          'payment_type': 'debt_payment',
        });
      }

      if (renewalPayment > 0) {
        await supabase.from('subscription_payments').insert({
          'subscription_id': newSubscription.id,
          'user_id': newSubscription.userId,
          'device_id': newSubscription.deviceId,
          'amount': renewalPayment,
          'currency': newSubscription.currency,
          'duration_days': durationDays,
          'payment_type': 'renewal',
        });
      }

      // لا نحتاج إلى تعديل الاشتراك القديم.
      // يبقى محفوظًا في قاعدة البيانات كسجل تاريخي،
      // والتطبيق يعرض أحدث دورة اشتراك فقط.

      await loadSubscriptions();
      await loadPaymentHistory();

      if (!mounted) return;

      setState(() {});

      final remainingAmount = renewalAmount - renewalPayment;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            remainingAmount <= 0.001
                ? 'تم تجديد الاشتراك وتحصيل المبلغ بالكامل ✓'
                : 'تم التجديد بنجاح. المتبقي '
                      '${remainingAmount.toStringAsFixed(2)} $currency '
                      'على المشترك',
          ),
          backgroundColor: remainingAmount <= 0.001
              ? Colors.green
              : Colors.orange,
        ),
      );
    } catch (e) {
      // إذا فشل الحفظ نحاول إزالة السجل المحلي الجديد
      subscriptions.removeWhere(
        (item) =>
            item.id.isEmpty &&
            item.userId == sub.userId &&
            item.createdAt == now,
      );

      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('خطأ أثناء تجديد الاشتراك: $e'),
          backgroundColor: Colors.red,
        ),
      );
    } finally {
      amountController.dispose();
      paymentAmountController.dispose();
      durationController.dispose();
    }
  }

