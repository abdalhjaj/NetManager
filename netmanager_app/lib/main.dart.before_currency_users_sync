                                borderRadius: BorderRadius.circular(12),
                                border: Border.all(
                                  color: isFullyPaid
                                      ? Colors.green.withValues(alpha: 0.30)
                                      : Colors.orange.withValues(alpha: 0.30),
                                ),
                              ),
                              child: Row(
                                children: [
                                  Icon(
                                    isFullyPaid
                                        ? Icons.verified
                                        : Icons.account_balance_wallet,
                                    color: isFullyPaid
                                        ? Colors.green
                                        : Colors.orange,
                                  ),
                                  const SizedBox(width: 10),
                                  Expanded(
                                    child: Text(
                                      isFullyPaid
                                          ? '✓ تم تحصيل الاشتراك بالكامل'
                                          : 'باقي ${remainingAmount.toStringAsFixed(2)} ${sub.currency} للتحصيل',
                                      style: TextStyle(
                                        color: isFullyPaid
                                            ? Colors.green.shade700
                                            : Colors.orange.shade800,
                                        fontWeight: FontWeight.bold,
                                        fontSize: 15,
                                      ),
                                    ),
                                  ),
                                ],
                              ),
                            ),

                            if (isExpiringSoon) ...[
                              const SizedBox(height: 14),
                              Container(
                                width: double.infinity,
                                padding: const EdgeInsets.all(12),
                                decoration: BoxDecoration(
                                  color: Colors.orange.withValues(alpha: 0.10),
                                  borderRadius: BorderRadius.circular(12),
                                  border: Border.all(
                                    color: Colors.orange.withValues(
                                      alpha: 0.35,
                                    ),
                                  ),
                                ),
                                child: Row(
                                  children: [
                                    const Icon(
                                      Icons.warning_amber_rounded,
                                      color: Colors.orange,
                                    ),
                                    const SizedBox(width: 10),
                                    Expanded(
                                      child: Text(
                                        daysRemaining <= 0
                                            ? 'تنبيه: الاشتراك ينتهي اليوم'
                                            : 'تنبيه: متبقي $daysRemaining يوم${daysRemaining == 1 ? '' : 'ًا'} فقط على انتهاء الاشتراك',
                                        style: const TextStyle(
                                          color: Colors.orange,
                                          fontWeight: FontWeight.bold,
                                        ),
                                      ),
                                    ),
                                  ],
                                ),
                              ),
                            ],

                            if (isExpired) ...[
                              const SizedBox(height: 14),
                              Container(
                                width: double.infinity,
                                padding: const EdgeInsets.all(12),
                                decoration: BoxDecoration(
                                  color: Colors.red.withValues(alpha: 0.08),
                                  borderRadius: BorderRadius.circular(12),
                                ),
                                child: const Row(
                                  children: [
                                    Icon(
                                      Icons.error_outline,
                                      color: Colors.red,
                                    ),
                                    SizedBox(width: 10),
                                    Expanded(
                                      child: Text(
                                        'هذا الاشتراك منتهي ويحتاج إلى التجديد',
                                        style: TextStyle(
                                          color: Colors.red,
                                          fontWeight: FontWeight.bold,
                                        ),
                                      ),
                                    ),
                                  ],
                                ),
                              ),
                            ],

                            if (widget.currentUser.role == 'مدير') ...[
                              const SizedBox(height: 12),
                              Row(
                                mainAxisAlignment: MainAxisAlignment.end,
                                children: [
                                  if (!isFullyPaid)
                                    FilledButton.icon(
                                      onPressed: () {
                                        paySubscriptionDebt(sub);
                                      },
                                      icon: const Icon(
                                        Icons.account_balance_wallet,
                                        size: 18,
                                      ),
                                      label: const Text('تسديد المتبقي'),
                                      style: FilledButton.styleFrom(
                                        backgroundColor: Colors.orange,
                                        foregroundColor: Colors.white,
                                        padding: const EdgeInsets.symmetric(
                                          horizontal: 12,
                                          vertical: 10,
                                        ),
                                      ),
                                    ),
                                  if (!isFullyPaid) const SizedBox(width: 8),
                                  Builder(
                                    builder: (context) {
                                      final renewalNow = DateTime.now();

                                      final canRenew =
                                          sub.dueDate == null ||
                                          !sub.dueDate!.isAfter(
                                            renewalNow.add(
                                              const Duration(days: 2),
                                            ),
                                          );

                                      return IconButton(
                                        tooltip: canRenew ? 'تجديد الاشتراك' : 'يمكن التجديد قبل انتهاء الاشتراك بيومين فقط',
                                        icon: Icon(
                                          Icons.refresh,
                                          color: canRenew ? null : Colors.grey,
                                        ),
                                        onPressed: canRenew
                                            ? () {
                                                renewSubscription(sub);
                                              }
                                            : null,
                                      );
                                    },
                                  ),
                                  IconButton(
                                    tooltip: 'تعديل الاشتراك',
                                    icon: const Icon(Icons.edit),
                                    onPressed: () {
                                      editSubscription(sub);
                                    },
                                  ),
                                  IconButton(
                                    tooltip: 'حذف الاشتراك',
                                    icon: const Icon(Icons.delete),
                                    onPressed: () {
                                      deleteSubscription(sub);
                                    },
                                  ),
                                ],
                              ),
                            ],
                          ],
                        ),
                      ),
                    );
                  },
                ),
        ),
      ],
    );
  }

