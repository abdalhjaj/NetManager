  Map<String, int> usageTotalsForAccount(String accountType, String accountId) {
    int upload = 0;
    int download = 0;
    int seconds = 0;

    for (final session in usageSessions) {
      if (session.accountType == accountType &&
          session.accountId == accountId) {
        upload += session.uploadBytes;
        download += session.downloadBytes;
        seconds += session.sessionSeconds;
      }
    }

    return {
      'upload': upload,
      'download': download,
      'total': upload + download,
      'seconds': seconds,
    };
  }

  String formatUsageBytes(int bytes) {
    if (bytes < 1024) {
      return '$bytes B';
    }

    final kb = bytes / 1024;

    if (kb < 1024) {
      return '${kb.toStringAsFixed(1)} KB';
    }

    final mb = kb / 1024;

    if (mb < 1024) {
      return '${mb.toStringAsFixed(2)} MB';
    }

    final gb = mb / 1024;

    if (gb < 1024) {
      return '${gb.toStringAsFixed(2)} GB';
    }

    final tb = gb / 1024;

    return '${tb.toStringAsFixed(2)} TB';
  }

  String formatUsageDuration(int totalSeconds) {
    if (totalSeconds <= 0) {
      return '0 دقيقة';
    }

    final days = totalSeconds ~/ 86400;
    final hours = (totalSeconds % 86400) ~/ 3600;
    final minutes = (totalSeconds % 3600) ~/ 60;

    if (days > 0) {
      return '$days يوم ${hours > 0 ? '$hours س' : ''}'.trim();
    }

    if (hours > 0) {
      return '$hours س ${minutes > 0 ? '$minutes د' : ''}'.trim();
    }

    return '$minutes دقيقة';
  }

