class LoginPage extends StatefulWidget {
  const LoginPage({super.key});

  @override
  State<LoginPage> createState() => _LoginPageState();
}

class _LoginPageState extends State<LoginPage> {
  final usernameController = TextEditingController();
  final passwordController = TextEditingController();

  bool hidePassword = true;

  Future<void> login() async {
    final username = usernameController.text.trim();
    final password = passwordController.text;

    if (username.isEmpty || password.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('يرجى إدخال اسم المستخدم وكلمة المرور')),
      );
      return;
    }

    try {
      // إعادة تحميل المستخدمين مباشرة من Supabase
      await loadUsers();

      AppUser? user;

      for (final item in users) {
        if (item.username.trim() == username &&
            item.password == password &&
            item.active) {
          user = item;
          break;
        }
      }

      if (user == null) {
        if (!mounted) return;

        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text(
              'اسم المستخدم أو كلمة المرور غير صحيحة أو الحساب متوقف',
            ),
          ),
        );
        return;
      }

      currentUser = user;

      try {
        await loadDevices();
        await loadBroadbandAccounts();
        await loadHotspotAccounts();
        await loadPaymentHistory();
        await loadBroadbandPaymentHistory();
        await loadHotspotPaymentHistory();
        await loadUsageSessions();
      } catch (e) {
        debugPrint('LOAD DEVICES/BROADBAND/HOTSPOT ERROR: $e');
      }

      if (!mounted) return;

      Navigator.pushReplacement(
        context,
        MaterialPageRoute(builder: (_) => DashboardPage(currentUser: user!)),
      );
    } catch (e) {
      debugPrint('LOGIN ERROR: $e');

      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('تعذر الاتصال بقاعدة البيانات: $e')),
      );
    }
  }

  @override
  void dispose() {
    usernameController.dispose();
    passwordController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Directionality(
      textDirection: TextDirection.rtl,
      child: Scaffold(
        backgroundColor: Colors.grey.shade100,
        body: SafeArea(
          child: Center(
