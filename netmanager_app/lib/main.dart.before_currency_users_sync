  bool isRefreshingDashboard = false;

  Future<void> refreshDashboard() async {
    if (isRefreshingDashboard) return;

    setState(() {
      isRefreshingDashboard = true;
    });

    try {
      await Future.wait([
        loadUsers(),
        loadSubscriptions(),
        loadPaymentHistory(),
        loadDevices(),
        loadBroadbandAccounts(),
        loadHotspotAccounts(),
        loadBroadbandPaymentHistory(),
        loadHotspotPaymentHistory(),
        loadUsageSessions(),
      ]);

      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text('تم تحديث البيانات بنجاح ✓'),
            backgroundColor: Colors.green,
          ),
        );
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('فشل تحديث البيانات: $e'),
            backgroundColor: Colors.red,
          ),
        );
      }
    } finally {
      if (mounted) {
        setState(() {
          isRefreshingDashboard = false;
        });
      }
    }
  }

  Future<void> saveAppSettings() async {
    final supabase = Supabase.instance.client;

    if (appCurrency != 'USD' && appCurrency != 'SYP') {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('عملة الحساب غير صحيحة'),
          backgroundColor: Colors.red,
        ),
      );
      return;
    }

    if (usdToSypRate <= 0) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('يجب أن يكون سعر الصرف أكبر من صفر'),
          backgroundColor: Colors.red,
        ),
      );
      return;
    }

    try {
      // حفظ العملة وسعر الصرف في حساب المستخدم العام.
      await supabase
          .from('app_users')
          .update({'currency': appCurrency, 'usd_to_syp_rate': usdToSypRate})
          .eq('id', widget.currentUser.id);

      widget.currentUser.currency = appCurrency;
      widget.currentUser.usdToSypRate = usdToSypRate;

      if (currentUser != null && currentUser!.id == widget.currentUser.id) {
        currentUser!.currency = appCurrency;
        currentUser!.usdToSypRate = usdToSypRate;
      }

      for (final user in users) {
        if (user.id == widget.currentUser.id) {
          user.currency = appCurrency;
          user.usdToSypRate = usdToSypRate;
          break;
        }
      }

      final existing = await supabase
          .from('app_settings')
          .select('id')
          .eq('user_id', widget.currentUser.id)
          .maybeSingle();

      final values = {
        // نبقيه متزامنًا مؤقتًا حتى يتم نقل جميع أجزاء البرنامج
        // إلى العملة الموجودة في app_users.
        'default_currency': appCurrency,
        'debt_grace_days': debtGraceDays,
        'allow_debt': allowDebt,
        'profile_edit_allowed': profileEditAllowed,
        'backup_enabled': backupEnabled,
        'updated_at': DateTime.now().toIso8601String(),
      };

      if (existing == null) {
        await supabase.from('app_settings').insert({
          'user_id': widget.currentUser.id,
          ...values,
        });
      } else {
        await supabase
            .from('app_settings')
            .update(values)
            .eq('user_id', widget.currentUser.id);
      }

      if (!mounted) return;

      setState(() {});

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('تم حفظ إعدادات الحساب بنجاح ✓'),
          backgroundColor: Colors.green,
        ),
      );
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('فشل حفظ الإعدادات: $e'),
          backgroundColor: Colors.red,
        ),
      );
    }
  }

