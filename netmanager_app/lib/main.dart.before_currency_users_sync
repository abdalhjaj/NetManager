                ),
                FilledButton.icon(
                  onPressed: () {
                    final amount =
                        double.tryParse(amountController.text.trim()) ?? 0.0;
                    final discount =
                        double.tryParse(discountController.text.trim()) ?? 0.0;

                    if (amount < 0 || discount < 0) {
                      ScaffoldMessenger.of(dialogContext).showSnackBar(
                        const SnackBar(
                          content: Text('لا يمكن إدخال قيمة سالبة'),
                        ),
                      );
                      return;
                    }

                    if (amount <= 0 && discount <= 0) {
                      ScaffoldMessenger.of(dialogContext).showSnackBar(
                        const SnackBar(
                          content: Text('أدخل مبلغًا أو حسمًا صحيحًا'),
                        ),
                      );
                      return;
                    }

                    if (amount + discount > account.remainingAmount + 0.001) {
                      ScaffoldMessenger.of(dialogContext).showSnackBar(
                        const SnackBar(
                          content: Text(
                            'مجموع الدفعة والحسم أكبر من المبلغ المتبقي',
                          ),
                        ),
                      );
                      return;
                    }

                    Navigator.pop(dialogContext, {
                      'amount': amount,
                      'discount': discount,
                    });
                  },
                  icon: const Icon(Icons.check),
                  label: const Text('تحصيل'),
                ),
              ],
            );
          },
        );
      },
    );

    amountController.dispose();
    discountController.dispose();

    if (result == null) return;
    if (account.id.isEmpty) return;

    final amount = result['amount'] ?? 0.0;
    final discount = result['discount'] ?? 0.0;
    final settledAmount = amount + discount;

    if (settledAmount <= 0) return;

    try {
      final supabase = Supabase.instance.client;

      final newPaidAmount = account.paidAmount + settledAmount;
      final remaining = account.price - newPaidAmount;

      final paymentStatus = remaining <= 0.001
          ? 'مدفوع بالكامل'
          : 'مدفوع جزئيًا';

      String newServiceStatus = account.serviceStatus;
      DateTime? newDebtGraceUntil = account.debtGraceUntil;

      if (account.serviceStatus == 'manual_suspended' || !account.active) {
        newServiceStatus = 'manual_suspended';
      } else if (remaining <= 0.001) {
        newServiceStatus = 'active';
        newDebtGraceUntil = null;
      } else if (!allowDebt || debtGraceDays <= 0) {
        newServiceStatus = 'debt_suspended';
        newDebtGraceUntil = null;
      } else {
        final now = DateTime.now();

        if (newDebtGraceUntil == null) {
          newDebtGraceUntil = now.add(Duration(days: debtGraceDays));
          newServiceStatus = 'grace';
        } else if (now.isBefore(newDebtGraceUntil)) {
          newServiceStatus = 'grace';
        } else {
          newServiceStatus = 'debt_suspended';
        }
      }

      await supabase.from('hotspot_payments').insert({
        'account_id': account.id,
        'user_id': account.userId,
        'device_id': account.deviceId,
        'amount': amount,
        'discount': discount,
        'currency': 'USD',
        'payment_type': 'payment',
      });

      await supabase
          .from('hotspot_accounts')
          .update({
            'paid_amount': newPaidAmount,
            'payment_status': paymentStatus,
            'service_status': newServiceStatus,
            'debt_grace_until': newDebtGraceUntil?.toIso8601String(),
          })
          .eq('id', account.id);

      await loadHotspotAccounts();
      await loadHotspotPaymentHistory();

      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            discount > 0
                ? 'تم التحصيل ${amount.toStringAsFixed(2)} USD وحسم ${discount.toStringAsFixed(2)} USD ✓'
                : remaining <= 0
                ? 'تم تحصيل المبلغ بالكامل ✓'
                : 'تم تسجيل الدفعة بنجاح ✓',
          ),
          backgroundColor: Colors.green,
        ),
      );

      setState(() {});
    } catch (e) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('حدث خطأ أثناء تسجيل الدفعة: $e'),
          backgroundColor: Colors.red,
        ),
      );
    }
  }

  Widget buildHotspot() {
    final now = DateTime.now();

    final isManager = widget.currentUser.role == 'مدير';

    final effectiveHotspotUserId =
        selectedHotspotUserId ?? widget.currentUser.id;

    final filteredHotspotAccounts = isManager
        ? hotspotAccounts
              .where((a) => a.userId == effectiveHotspotUserId)
              .toList()
        : hotspotAccounts
              .where((a) => a.userId == widget.currentUser.id)
              .toList();

    String statusOf(HotspotAccount account) {
      if (!account.active || account.serviceStatus == 'manual_suspended') {
        return 'متوقف يدويًا';
      }

      if (account.expiresAt != null && account.expiresAt!.isBefore(now)) {
        return 'منتهي';
      }

      if (account.remainingAmount <= 0.001) {
        return 'فعال';
      }

      if (account.serviceStatus == 'debt_suspended') {
        return 'موقوف بسبب الدين';
      }

      if (account.serviceStatus == 'grace') {
        if (account.debtGraceUntil != null &&
            !now.isBefore(account.debtGraceUntil!)) {
          return 'موقوف بسبب الدين';
        }

        return 'فترة سماح';
      }

      if (!allowDebt || debtGraceDays <= 0) {
        return 'موقوف بسبب الدين';
      }

      return 'فترة سماح';
    }

    final allCount = filteredHotspotAccounts.length;

    final activeCount = filteredHotspotAccounts
        .where((a) => statusOf(a) == 'فعال')
        .length;

    final graceCount = filteredHotspotAccounts
        .where((a) => statusOf(a) == 'فترة سماح')
        .length;

    final debtSuspendedCount = filteredHotspotAccounts
        .where((a) => statusOf(a) == 'موقوف بسبب الدين')
        .length;

    final expiredCount = filteredHotspotAccounts
        .where((a) => statusOf(a) == 'منتهي')
        .length;

    final stoppedCount = filteredHotspotAccounts
        .where((a) => statusOf(a) == 'متوقف يدويًا')
        .length;

    final visibleAccounts = hotspotStatusFilter == 'الكل'
        ? filteredHotspotAccounts
        : filteredHotspotAccounts
              .where((a) => statusOf(a) == hotspotStatusFilter)
              .toList();

    Widget filterChip(String label, int count, Color color) {
      final selected = hotspotStatusFilter == label;

      return Padding(
        padding: const EdgeInsets.only(left: 8),
        child: ChoiceChip(
          selected: selected,
          onSelected: (_) {
            setState(() {
              hotspotStatusFilter = label;
            });
          },
          label: Text('$label ($count)'),
          selectedColor: color.withValues(alpha: 0.15),
          labelStyle: TextStyle(
            color: selected ? color : null,
            fontWeight: FontWeight.bold,
          ),
          side: BorderSide(
            color: selected
                ? color.withValues(alpha: 0.45)
                : Colors.grey.withValues(alpha: 0.25),
          ),
        ),
      );
    }

    String userName(String userId) {
      final user = users.cast<AppUser?>().firstWhere(
        (u) => u?.id == userId,
        orElse: () => null,
      );
      return user?.name ?? 'غير معروف';
    }

    String deviceName(String deviceId) {
      final device = devices.cast<NetworkDevice?>().firstWhere(
        (d) => d?.id == deviceId,
        orElse: () => null,
      );
      return device?.name ?? 'غير معروف';
    }

    String formatDate(DateTime? date) {
